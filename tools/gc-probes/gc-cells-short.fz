# The control twin of gc-cells: the same ten million cons cells are built, but
# in lists of a thousand, so a collection finds only a few cells live and
# copies almost nothing. It carries the mutator's instructions.
def build(0, acc), do: acc
def build(n, acc), do: build(n - 1, [n | acc])
def rounds(0, sum), do: sum
def rounds(r, sum) do
  xs = build(1000, [])
  rounds(r - 1, sum + length(xs))
end
def main(), do: dbg(rounds(10000, 0))
