# The control twin of gc-maps: the same one million maps are built, but in
# lists of a hundred, so a collection copies almost nothing. It carries the
# mutator's instructions.
def build(0, acc), do: acc
def build(n, acc), do: build(n - 1, [%{a: n, b: n + 1} | acc])
def rounds(0, sum), do: sum
def rounds(r, sum) do
  xs = build(100, [])
  rounds(r - 1, sum + length(xs))
end
def main(), do: dbg(rounds(10000, 0))
