# Isolates the collector's cost per tuple. Each round builds a list of one
# million 3-tuples that stay live while it grows, so the collections during the
# build copy a tuple and a list cell per element. Read it as gc-cells, against
# gc-structs-short.
def build(0, acc), do: acc
def build(n, acc), do: build(n - 1, [{n, n + 1, n + 2} | acc])
def rounds(0, sum), do: sum
def rounds(r, sum) do
  xs = build(1000000, [])
  rounds(r - 1, sum + length(xs))
end
def main(), do: dbg(rounds(10, 0))
