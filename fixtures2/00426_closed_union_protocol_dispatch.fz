defprotocol Sizer do
  def size(value)
end

defimpl Sizer, for: Integer do
  def size(value), do: 1
end

defimpl Sizer, for: List do
  def size(value), do: 2
end

def describe(value), do: Sizer.size(value)

def main() do
  case [7, [1, 2, 3]] do
    [a, b] -> describe(a) + describe(b)
    _ -> 0
  end
end
