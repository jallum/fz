#---
# purpose: closure call stays indirect while the surrounding flow remains direct
# root: main/0
# assert.metric.semantic.activations: 4
# assert.metric.semantic.executables: 4
# assert.metric.semantic.callsites: 6
# assert.metric.call_edges.count: 6
# assert.metric.return_type.widened: 0
# assert.edge: apply1/2[(a0_p0) -> a0_r, int] | @68-73 | closure | add_to/2#lambda@0/1
# assert.edge: main/0[] | @102-116 | direct | add_to/2
# snapshot.call_edges: call_edges
#---
def add_to(x, y), do: fn (z) -> x + y + z end
def apply1(f, x), do: f.(x)

def main() do
  dbg(apply1(add_to(10, 20), 12))
end
