# Nested tuple/list partition. Empty payload, cons payload, and atom fallback are
# distinct activations; the catch-all keeps the source total but should not
# contribute to the observed main/0 return.
#
# Expected: main() : {:empty, int, :error}

def pick({:ok, []}), do: :empty
def pick({:ok, [h | _t]}), do: h
def pick(:error), do: :error
def pick(_), do: :unreachable

def main() do
  {pick({:ok, []}), pick({:ok, [1]}), pick(:error)}
end
