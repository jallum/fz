def append([], ys), do: ys
def append([h | t], ys), do: [h | append(t, ys)]

def partition(_, [], lo, hi), do: {lo, hi}
def partition(p, [h | t], lo, hi) when h < p, do: partition(p, t, [h | lo], hi)
def partition(p, [h | t], lo, hi), do: partition(p, t, lo, [h | hi])

def qsort([]), do: []
def qsort([p | rest]) do
  {lo, hi} = partition(p, rest, [], [])
  append(qsort(lo), [p | qsort(hi)])
end

def main() do
  sorted = qsort([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5])
  dbg(sorted)

  stats = Process.heap_alloc_stats()
  dbg(stats)
  heap_bytes = stats[:list_cons_bytes] + stats[:struct_bytes] + stats[:map_bytes]
  dbg(heap_bytes)
end

def foo(), do: 42
