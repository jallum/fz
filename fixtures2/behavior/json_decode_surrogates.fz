#---
# purpose: "JSON.decode/1 joins valid Unicode surrogate pairs and rejects unpaired surrogates in values and keys"
# oracle: self
# oracle.stamp: e0ec1a6d6897929e
#---
defmodule Main do
  def main() do
    # A representative pair plus both scalar-range boundaries made by pairs.
    IO.inspect(JSON.decode("\"\\uD83D\\uDE00\""))
    IO.inspect(JSON.decode("\"\\uD800\\uDC00\""))
    IO.inspect(JSON.decode("\"\\uDBFF\\uDFFF\""))
    IO.inspect(JSON.decode("{\"\\uD83D\\uDE00\":1}"))

    # The code points immediately outside the surrogate range stay ordinary
    # three-byte UTF-8 scalars.
    IO.inspect(JSON.decode("\"\\uD7FF\""))
    IO.inspect(JSON.decode("\"\\uE000\""))

    IO.inspect(JSON.decode("\"\\uD83D\""))
    IO.inspect(JSON.decode("\"\\uD83D\\u0041\""))
    IO.inspect(JSON.decode("\"\\uD83D\\uD83D\""))
    IO.inspect(JSON.decode("\"\\uD83D\\uZZZZ\""))
    IO.inspect(JSON.decode("\"\\uD83Dx\""))
    IO.inspect(JSON.decode("\"\\uDE00\""))
    IO.inspect(JSON.decode("\"x\\uDE00\""))

    IO.inspect(JSON.decode("{\"\\uD83D\":1}"))
    IO.inspect(JSON.decode("{\"\\uDE00\":1}"))
    IO.inspect(JSON.decode("{\"\\uD83D\\u0041\":1}"))
  end
end

Main.main()
