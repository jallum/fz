#---
# purpose: "JSON.decode/1 rejects malformed UTF-8 at the offending source byte in string values and object keys"
# oracle: self
# oracle.stamp: a51bb52b26733cf3
#---
defmodule Main do
  def main() do
    IO.inspect(JSON.decode(<<34, 255, 34>>))
    IO.inspect(JSON.decode(<<123, 34, 255, 34, 58, 49, 125>>))
    IO.inspect(JSON.decode(<<34, 194, 65, 34>>))
    IO.inspect(JSON.decode(<<34, 225, 128, 65, 34>>))
    IO.inspect(JSON.decode(<<34, 241, 128, 128, 65, 34>>))
    IO.inspect(JSON.decode(<<34, 92, 110, 255, 34>>))
    IO.inspect(JSON.decode(<<34, 225, 128>>))
    IO.inspect(JSON.decode(<<34, 195, 169, 34>>))
    IO.inspect(JSON.decode(<<34, 240, 159, 152, 128, 34>>))
  end
end

Main.main()
