#---
# purpose: "Json.decode/1 rejects malformed UTF-8 at the offending source byte in string values and object keys"
# oracle: json_decode_invalid_utf8.oracle.exs
#---
fn main() do
  dbg(Json.decode(<<34, 255, 34>>))
  dbg(Json.decode(<<123, 34, 255, 34, 58, 49, 125>>))
  dbg(Json.decode(<<34, 194, 65, 34>>))
  dbg(Json.decode(<<34, 225, 128, 65, 34>>))
  dbg(Json.decode(<<34, 241, 128, 128, 65, 34>>))
  dbg(Json.decode(<<34, 92, 110, 255, 34>>))
  dbg(Json.decode(<<34, 225, 128>>))
  dbg(Json.decode(<<34, 195, 169, 34>>))
  dbg(Json.decode(<<34, 240, 159, 152, 128, 34>>))
end
