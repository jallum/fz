#---
# purpose: "list primitives from scratch — length / reverse / map / foldl exercising cons-pattern dispatch and first-class fns"
#---
def length([]), do: 0
def length([_ | t]), do: 1 + length(t)

def reverse(xs), do: reverse_acc(xs, [])
def reverse_acc([], acc), do: acc
def reverse_acc([h | t], acc), do: reverse_acc(t, [h | acc])

def map(_, []), do: []
def map(f, [h | t]), do: [f.(h) | map(f, t)]

def foldl(_, acc, []), do: acc
def foldl(f, acc, [h | t]), do: foldl(f, f.(acc, h), t)

def double(x), do: x * 2
def add(a, b), do: a + b

def main() do
  xs = [1, 2, 3, 4, 5]
  assert(length(xs) == 5, "length counts cons cells")
  assert(reverse(xs) == [5, 4, 3, 2, 1], "reverse via accumulator")
  assert(map(double, xs) == [2, 4, 6, 8, 10], "map applies a first-class fn")
  assert(foldl(add, 0, xs) == 15, "foldl sums via a first-class fn")
end
