#---
# purpose: "no-parens calls (double 21; sum3 1, 2, 3) parse and run; output matches Elixir"
# oracle: self
# oracle.stamp: de071e02f954c937
#---
#
# # no_parens_call
#
# Exercises Elixir-style no-parens calls at statement position: `double 21` and
# `sum3 1, 2, 3` are parsed as `double(21)` and `sum3(1, 2, 3)`. Elixir runs this
# file (`oracle: self`) and prints the same integers, so `expected.txt` is owned
# by the oracle.
defmodule Main do
  def double(x), do: x * 2

  def sum3(a, b, c), do: a + b + c

  def main() do
    x = double 21
    IO.inspect(x)
    y = sum3 1, 2, 3
    IO.inspect(y)
  end
end

Main.main()
