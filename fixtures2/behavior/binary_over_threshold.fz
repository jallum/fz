#---
# purpose: "a binary matches a bitstring pattern the same way whichever storage it is held in"
# oracle: oracle.exs
#---
#
# # binary_over_threshold
#
# A binary above `SHARED_BIN_THRESHOLD_BYTES` (64) is held as a shared-buffer
# ProcBin rather than an inline Bitstring. That is a storage decision. It was
# also, silently, a semantic one:
#
#     defp walk(<<_c, rest :: binary>>, n), do: walk(rest, n + 1)
#     defp walk(_b, n), do: n
#
#     64 bytes:  interp 64   run 64
#     65 bytes:  interp 65   run 0     <-- matched nothing
#
# On the native doors the Binaries axis asked `kind == BITSTRING`, so a ProcBin
# answered NO to every runtime type test and the bitstring region was never
# reached. The value fell through to the next clause with no diagnostic.
#
# The binaries here are BUILT, not written as literals, and cross the threshold
# by concatenation. That is on purpose: a matched binary LITERAL over 64 bytes
# hits a separate, older defect in the compiler-baked static shared binaries
# (fz-5xp.60), which this fixture must not be entangled with. What is under test
# is the representation split, and `<>` crosses it just as well.
defp first_byte(<<c, _rest :: binary>>), do: c
defp first_byte(_b), do: :no_match

defp prefixed(<<"aaa", rest :: binary>>), do: {:prefixed, walk(rest, 0)}
defp prefixed(_b), do: :no_match

defp walk(<<_c, rest :: binary>>, n), do: walk(rest, n + 1)
defp walk(_b, n), do: n

def main() do
  small = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  big = small <> small <> small

  dbg(first_byte(small))
  dbg(first_byte(big))

  dbg(prefixed(small))
  dbg(prefixed(big))

  dbg(walk(small, 0))
  dbg(walk(big, 0))
  dbg(walk(big <> big, 0))
end
