#---
# purpose: "multi-clause dispatch with a guard clause (`when n > 0`), plus recursive `fact`"
#---
def classify(0), do: :zero
def classify(n) when n > 0, do: :positive
def classify(_), do: :negative

def fact(0), do: 1
def fact(n), do: n * fact(n - 1)

def main() do
  dbg(classify(0))
  dbg(classify(7))
  dbg(classify(-3))
  dbg(fact(5))
end
