#---
# purpose: "two-hop process relay — main → first_relay → second_relay → main; exercises multi-process message chaining"
#---
def first_relay(next) do
  send(next, receive do x -> x + 1 end)
end

def second_relay(parent) do
  send(parent, receive do x -> x + 1 end)
end

def main() do
  parent = self()
  second = spawn(fn () -> second_relay(parent) end)
  first = spawn(fn () -> first_relay(second) end)
  send(first, 40)
  got = receive do x -> x end
  assert(got == 42, "main -> first_relay -> second_relay -> main, +1 each hop")
end
