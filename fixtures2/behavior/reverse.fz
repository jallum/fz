#---
# purpose: "source-level reverse allocation baseline for accumulator-style list traversal"
#---
#
# # reverse
#
# Pins ordinary source-level `reverse/1` and `reverse_into/2` as an
# accumulator-style list traversal. Reversing a five-element list should allocate
# only the five input literal cons cells, relinking them for the output. No tuple/struct or
# map objects are needed for the value path.
def reverse(xs), do: reverse_into(xs, [])

def reverse_into([], acc), do: acc
def reverse_into([h | t], acc), do: reverse_into(t, [h | acc])

def main() do
  out = reverse([1, 2, 3, 4, 5])
  dbg(out)

  stats = Process.heap_alloc_stats()
  dbg(stats)
  heap_bytes = stats[:list_cons_bytes] + stats[:struct_bytes] + stats[:map_bytes]
  dbg(heap_bytes)
end
