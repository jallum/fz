#---
# purpose: "pipe macro rewrite for call RHS and headless case RHS"
#---
#
# # pipe_headless_case
#
# Exercises `lhs |> f(args)` and `lhs |> case do ... end` after pipe handling
# moved into macro expansion.
fn add2(x), do: x + 2

fn main() do
  value = 1 |> add2()
  result = value |> case do
    3 -> :ok
    _ -> :bad
  end
  dbg(result)
end
