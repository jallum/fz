#---
# purpose: "Enum tier-0 functions return Elixir-style public values across List, Range, and Map"
# oracle: self
# oracle.stamp: 2b56b28c950129f5
#---
#
# The shared 20s hang guard catches nontermination; telemetry owns performance
# regression signal.
# Exercises the reduce-based public `Enum` surface that later Enum functions build
# on: `reduce/2`, `reduce/3`, `reduce_while/3`, `each/2`, `count/1`, `count/2`,
# `member?/2`, `to_list/1`, and `reverse/1,2`. The reduce family runs over List,
# Range, and Map so the "across List, Range, and Map" claim is exercised, not just
# asserted.
#
# `Enum.reduce/2` -- the no-accumulator form -- seeds the fold with `:first` and
# the reducer returns `{:acc, a}`, so the declared accumulator is `:first |
# {:acc, a}` and the seed is a member of it. The stdout expectation holds on all
# three paths without diagnostics.

defmodule Main do
  def main() do
    xs = [1, 2, 3, 4]
    range = 1..7//2
    map = %{2 => :two, 1 => :one}

    # reduce/2 across List, Range, and Map
    IO.inspect(Enum.reduce(xs, fn (x, acc) -> x * acc end))
    IO.inspect(Enum.reduce(range, fn (x, acc) -> x * acc end))
    IO.inspect(Enum.reduce(map, fn ({k, _v}, {ak, av}) -> {ak + k, av} end))
    # reduce/3 across List, Range, and Map
    IO.inspect(Enum.reduce(xs, 0, fn (x, acc) -> acc + x end))
    IO.inspect(Enum.reduce(range, 0, fn (x, acc) -> acc + x end))
    IO.inspect(Enum.reduce(map, 0, fn ({k, _v}, acc) -> acc + k end))
    # reduce_while/3 across List, Range, and Map
    IO.inspect(Enum.reduce_while(xs, 0, fn (x, acc) ->
      if x < 3 do
        {:cont, acc + x}
      else
        {:halt, acc}
      end
    end))
    IO.inspect(Enum.reduce_while(range, 0, fn (x, acc) ->
      if x < 5 do
        {:cont, acc + x}
      else
        {:halt, acc}
      end
    end))
    IO.inspect(Enum.reduce_while(map, [], fn ({k, v}, acc) ->
      if k < 2 do
        {:cont, [v | acc]}
      else
        {:halt, acc}
      end
    end))
    IO.inspect(Enum.each([:a, :b], fn (x) -> x end))
    IO.inspect(Enum.count(range))
    IO.inspect(Enum.count(xs, fn (x) -> x > 2 end))
    IO.inspect(Enum.member?(range, 5))
    IO.inspect(Enum.member?(range, 6))
    IO.inspect(Enum.member?(map, {1, :one}))
    IO.inspect(Enum.to_list(range))
    IO.inspect(Enum.to_list(map))
    IO.inspect(Enum.reverse(xs))
    IO.inspect(Enum.reverse(range, [:tail]))
  end
end

Main.main()
