#---
# purpose: runtime-selected predicate unions share boxed invocation code without merging semantic identities
#---
def positive(x), do: x > 0
def even(x), do: (x % 2) == 0
def large(x), do: x > 2

def select_left(flag), do: if flag, do: positive, else: even
def select_right(flag), do: if flag, do: large, else: even
def make_reducer(predicate) do
  fn (entry, acc) -> if predicate.(entry), do: acc + 1, else: acc end
end

def main() do
  send(self(), true)
  flag = receive do value -> value end
  left = make_reducer(select_left(flag))
  right = make_reducer(select_right(flag))
  result = left.(1, 0) + right.(3, 0)
  assert(result == 2, "each shared reducer invokes its own runtime predicate")
  result
end
