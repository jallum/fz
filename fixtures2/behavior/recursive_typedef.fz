#---
# purpose: "a recursive @type declaration resolves once as a finite denotation"
#---
#
# `t` is `:start` or a pair whose second field is another `t`. Its declaration
# resolves as one finite regular component before ordinary specialization and
# backend materialization consume the resulting `Ty`.
def main() do
  dbg(build(3))
end

@type t :: :start | {integer, t}

@spec build(integer) :: t
def build(0), do: :start
def build(n), do: {n, build(n - 1)}
