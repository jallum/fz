#---
# purpose: "unsuffixed binary literals stay binary fields in runtime-built bitstrings"
#---
@spec digit(integer) :: integer
fnp digit(n), do: 48 + n

fn main() do
  assert(<<digit(1)>> == "1", "a call result works as the first field")
  assert(<<digit(1), digit(2)>> == "12", "adjacent call results keep their fields")
  assert(<<"x", digit(1)>> == "x1", "one binary literal does not shift a following call result")
  assert(<<"x", "y", digit(1)>> == "xy1", "several binary literals still occupy one field each")
end
