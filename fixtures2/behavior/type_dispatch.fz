#---
# purpose: multi-clause function dispatches on parameter type at runtime (fz-ty1.8/1.9)
#---
def check(x :: integer) do :is_int end
def check(x) do :other end

def main() do
  assert(check(42) == :is_int, "integer arg dispatches to the TypeTest clause")
  assert(check(:foo) == :other, "atom arg falls through to the fallback clause")
end
