#---
# purpose: "one lambda closed over an int and over a float are two constructions, and the forwarder routes each to the body its captures were stored for"
# oracle: oracle.exs
#---
#
# fz-kdt.127. `P.run/2` forwards its callable, so its activation key erases the
# closure brand but retains the capture tuple. The int- and float-capturing
# constructions therefore key separate `run` and `twice` specializations.
# Their callable calls are statically grounded and need no runtime dispatch.
#
# `Q` is `P` mirrored: the float call first. Arrival order must not decide the
# answer, and each module has its own forwarder so each order is checked.
defmodule P do
  def twice(f, x), do: f.(f.(x))
  def run(f, x), do: twice(f, x)
  def mk(c), do: fn (n) -> n + c end
end

defmodule Q do
  def twice(f, x), do: f.(f.(x))
  def run(f, x), do: twice(f, x)
  def mk(c), do: fn (n) -> n + c end
end

def main() do
  dbg(P.run(P.mk(1), 10))
  dbg(P.run(P.mk(0.5), 10))
  dbg(Q.run(Q.mk(0.5), 10))
  dbg(Q.run(Q.mk(1), 10))
end
