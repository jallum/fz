#---
# purpose: "an adapter capturing a joined callable preserves callback selection"
#---
def choose(n) do
  if n > 0 do
    fn x -> x + 1 end
  else
    fn x -> x * 2 end
  end
end
def wrap(f), do: fn x -> f.(x) end
def apply_one(f, x), do: f.(x)
def main() do
  dbg(apply_one(wrap(choose(1)), 2))
  dbg(apply_one(wrap(choose(0)), 2))
end
