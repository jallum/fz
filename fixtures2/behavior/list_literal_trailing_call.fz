#---
# purpose: "list literal decodes the same regardless of which element is a call: trailing call, trailing literal, call in the middle, and every element a call"
#---
fn main() do
  assert(
    [Enum.reverse([1, 2, 3])] == [[3, 2, 1]],
    "single-element list whose only element is a call"
  )
  assert(
    [1, Enum.reverse([1, 2, 3])] == [1, [3, 2, 1]],
    "trailing element is a call"
  )
  assert(
    [Enum.reverse([1, 2, 3]), 9] == [[3, 2, 1], 9],
    "leading element is a call, trailing element is a literal"
  )
  assert(
    [Enum.reverse([1]), 2, Enum.reverse([3, 4])] == [[1], 2, [4, 3]],
    "call in the middle, call trailing"
  )
  assert(
    [Enum.reverse([1, 2, 3]), Enum.reverse([4, 5])] == [[3, 2, 1], [5, 4]],
    "every element is a call"
  )
end
