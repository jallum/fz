#---
# purpose: "source-level filter allocation baseline for guarded recursive list traversal"
#---
#
# # filter
#
# Pins a first-order source-level filter shape:
#
# ```fz
# def filter_lt([], _), do: []
# def filter_lt([h | t], limit) when h < limit, do: [h | filter_lt(t, limit)]
# def filter_lt([_ | t], limit), do: filter_lt(t, limit)
# ```
#
# Filtering `[1, 5, 2, 8, 3]` with limit `4` should allocate the five input
# literal cons cells; retained cells supply the output without new cons cells. No tuple/struct or map
# objects are needed for the value path.
def filter_lt([], _), do: []
def filter_lt([h | t], limit) when h < limit, do: [h | filter_lt(t, limit)]
def filter_lt([_ | t], limit), do: filter_lt(t, limit)

def main() do
  out = filter_lt([1, 5, 2, 8, 3], 4)
  dbg(out)

  stats = Process.heap_alloc_stats()
  dbg(stats)
  heap_bytes = stats[:list_cons_bytes] + stats[:struct_bytes] + stats[:map_bytes]
  dbg(heap_bytes)
end
