#---
# purpose: "comparing an integer against a float compares their numeric values, on every door"
# oracle: oracle.exs
#---
#
# # mixed_numeric_comparison
#
# `Kernel` gives each comparison operator the same typed clause family the
# arithmetic operators have, so an integer/float pair is answered by a clause
# typed `integer`/`float` rather than by a generic coercion behind the
# operator. This fixture is the cross product that pins it.
#
# Before that, the native door answered every mixed comparison as though the
# integer were the smaller value — `2 >= 1.0` was `false` and `1 > 0.5` was
# `false` — because the coercion path boxed the float operand and then read the
# resulting pointer as a number. The answer did not depend on the operands at
# all, which is why it was invisible to any test that only compared one pair.
#
# `==` and `!=` are part of this: Elixir's `==` compares numbers across the
# integer/float boundary, so `1 == 1.0` is `true`. `===` is the strict form and
# asks identity instead; `behavior/equality_widening_and_identity.fz` pins the
# difference. Equality between non-numbers is untouched and stays structural.
#
# ## Both halves matter
#
# The values are exercised twice. The first half uses literals, which the
# compiler can fold, and pins what the folder answers. The second half sends
# each value to the current process and receives it back, which is expressible
# in Elixir as well and denies the folder its operands — so the same answers
# have to come from the emitted comparison rather than from compile-time
# arithmetic. Both halves must agree with Elixir, and with each other.
def main() do
  dbg({1 < 1.0, 1 <= 1.0, 1 > 1.0, 1 >= 1.0, 1 == 1.0, 1 != 1.0})
  dbg({2 < 1.0, 2 <= 1.0, 2 > 1.0, 2 >= 1.0, 2 == 1.0, 2 != 1.0})
  dbg({1 < 2.0, 1 <= 2.0, 1 > 2.0, 1 >= 2.0, 1 == 2.0, 1 != 2.0})

  dbg({1.0 < 1, 1.0 <= 1, 1.0 > 1, 1.0 >= 1, 1.0 == 1, 1.0 != 1})
  dbg({1.0 < 2, 1.0 <= 2, 1.0 > 2, 1.0 >= 2, 1.0 == 2, 1.0 != 2})
  dbg({2.0 < 1, 2.0 <= 1, 2.0 > 1, 2.0 >= 1, 2.0 == 1, 2.0 != 1})

  dbg({1 > 0.5, 1 < 0.5, 0 >= 0.0, 0 <= 0.0, 0 == 0.0})

  one = launder(1)
  two = launder(2)
  one_float = launder(1.0)
  two_float = launder(2.0)

  dbg({one < one_float, one <= one_float, one > one_float, one >= one_float, one == one_float, one != one_float})
  dbg({two < one_float, two <= one_float, two > one_float, two >= one_float, two == one_float, two != one_float})
  dbg({one < two_float, one <= two_float, one > two_float, one >= two_float, one == two_float, one != two_float})
  dbg({one_float < one, one_float <= one, one_float > one, one_float >= one, one_float == one, one_float != one})
  dbg({two_float < one, two_float <= one, two_float > one, two_float >= one, two_float == one, two_float != one})

  dbg({1 == 1, 1.0 == 1.0, 2 > 1, 2.0 > 1.0})
  dbg({:a == :a, :a == :b, "x" == "x", [1, 2] == [1, 2], {1} == {1}})

  # A guard orders its operands the same way an expression does. This lowers
  # through the dispatch matcher rather than through `Kernel`, and used to be
  # compared as integers only -- a float operand failed the conversion and fell
  # through to the next clause.
  dbg({ordering(one, one_float), ordering(two, one_float), ordering(one, two_float)})
  dbg({ordering(one_float, one), ordering(two_float, one), ordering(one, two)})

  # Binaries order byte-lexicographically, shorter prefix first.
  dbg(Enum.sort(["pear", "apple", "fig", "Fig", ""]))
  dbg({"apple" < "pear", "a" < "ab", "Z" < "a", "" < "a", "abc" <= "abd"})

  # An integer never matches a float pattern, even though `==` says they are
  # equal by value: matching is not `==`.
  dbg({literal(1), literal(1.0), literal(2)})
end

defp ordering(a, b) when a < b, do: :lt
defp ordering(a, b) when a > b, do: :gt
defp ordering(_a, _b), do: :eq

defp literal(1), do: :int_one
defp literal(1.0), do: :float_one
defp literal(_other), do: :other

defp launder(value) do
  send(self(), value)

  receive do
    received -> received
  end
end
