#---
# purpose: "grounded predicate captures retain distinct semantics without boxed invocation"
# oracle: oracle.exs
#---
def reduce_plain([], acc, _reducer), do: acc
def reduce_plain([head | tail], acc, reducer), do: reduce_plain(tail, reducer.(head, acc), reducer)
def reduce_plain(_, acc, _reducer), do: acc

def gt2(x), do: x > 2
def even(x), do: (x % 2) == 0

def make_reducer(predicate) do
  fn (entry, acc) ->
    if predicate.(entry), do: acc + 1, else: acc
  end
end

def main() do
  xs = [1, 2, 3, 4]
  dbg(reduce_plain(xs, 0, make_reducer(gt2)) + reduce_plain(xs, 0, make_reducer(even)))
end
