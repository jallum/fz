#---
# purpose: "JSON.encode!/1 renders an atom value as the JSON string of its name"
# oracle: self
# oracle.stamp: 371c70bce0801f37
#---
defmodule Main do
  def main() do
    IO.inspect(JSON.encode!(:foo))
    IO.inspect(JSON.encode!([:a, :b]))
    IO.inspect(JSON.encode!(%{k: :v}))
    IO.inspect(JSON.encode!(:"with space"))
  end
end

Main.main()
