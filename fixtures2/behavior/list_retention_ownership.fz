#---
# purpose: "List construction retention preserves duplicate, joined, input, and self-tail aliases"
#---
fn duplicate(xs) do
  [h | t] = xs
  first = [h | [9]]
  second = [h | t]
  {first, second, xs}
end

fn joined(flag, xs) do
  ys = if flag, do: xs, else: []
  [h | _] = xs
  changed = [h | [9]]
  {ys, changed}
end

fn aliased_inputs(xs, ys) do
  [h | _] = xs
  changed = [h | [9]]
  {changed, ys}
end

fn prepend(xs) do
  [h | _] = xs
  [h | xs]
end

fn rewrite(xs) do
  [h | _] = xs
  [h | [9]]
end

fn retained_call_alias(xs) do
  case xs do
    [h | t] -> {rewrite(xs), [h | t]}
    _ -> {[], []}
  end
end

fn constructed_tail_alias() do
  tail = [2, 3]
  outer = [1 | tail]
  [_ | projected] = outer
  [h | _] = projected
  changed = [h | [9]]
  {tail, changed}
end

fn chained_retention_alias(xs) do
  [h | t] = xs
  retained = [h | t]
  [head | _] = retained
  changed = [head | [9]]
  {xs, changed}
end

fn main() do
  assert(duplicate([1, 2]) == {[1, 9], [1, 2], [1, 2]})
  assert(joined(true, [1, 2]) == {[1, 2], [1, 9]})
  xs = [1, 2]
  assert(aliased_inputs(xs, xs) == {[1, 9], [1, 2]})
  assert(prepend([1, 2]) == [1, 1, 2])
  assert(retained_call_alias([1, 2]) == {[1, 9], [1, 2]})
  assert(constructed_tail_alias() == {[2, 3], [2, 9]})
  assert(chained_retention_alias([1, 2]) == {[1, 2], [1, 9]})
end
