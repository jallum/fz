#---
# purpose: "send to an exited or unknown pid returns the message without delivery"
#---
def child(parent), do: send(parent, {:exiting, self()})

def main() do
  parent = self()
  child = spawn(fn () -> child(parent) end)
  receive do
    {:exiting, ^child} -> nil
  end

  dead_msg = {:dead, [1, 2]}
  unknown_msg = {:unknown, [3, 4]}
  assert(send(child, dead_msg) == dead_msg, "send to exited pid returns its message")
  assert(send(999999, unknown_msg) == unknown_msg, "send to unknown pid returns its message")
  dbg(:ok)
end
