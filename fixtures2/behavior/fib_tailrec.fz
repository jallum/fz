#---
# purpose: "fibonacci via two-accumulator tail recursion — three-clause dispatch + tail-call forwarding under load"
#---
def fib(0, a, _), do: a
def fib(1, _, b), do: b
def fib(n, a, b), do: fib(n - 1, b, a + b)

def main() do
  dbg(fib(0, 0, 1))
  dbg(fib(1, 0, 1))
  dbg(fib(10, 0, 1))
  dbg(fib(20, 0, 1))
end
