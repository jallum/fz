#---
# purpose: "first-match-wins for wildcard-then-specific patterns (multi-clause function and case)"
#---
def first(_), do: :anything
def first(0), do: :zero

def cmatch(v) do
  case v do
    _ -> :anything
    0 -> :zero
  end
end

def main() do
  assert(first(0) == :anything, "fn: wildcard precedes specific, first-match-wins")
  assert(first(7) == :anything, "fn: wildcard matches non-zero too")
  assert(cmatch(0) == :anything, "case: wildcard precedes specific, first-match-wins")
  assert(cmatch(99) == :anything, "case: wildcard matches non-zero too")
end
