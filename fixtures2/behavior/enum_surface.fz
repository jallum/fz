#---
# purpose: "the Enum functions that fz-5xp.8, .12 and .15 unblocked, checked against Elixir"
# oracle: oracle.exs
#---
#
# # enum_surface
#
# fz-5xp.16 groups the gap to Elixir by WHAT EACH FUNCTION NEEDS, and three of
# those groups were blocked on work that has since landed:
#
#   * the min/max/sort_by family needed a TOTAL TERM ORDER (fz-5xp.8). They are
#     written against `Kernel.compare/2` rather than `<=` for the same reason
#     `Enum.sort/1` is: `<=` is declared only for the operand pairs fz can
#     prove, so `Enum.max(["a", :b])` could not be expressed in terms of it at
#     all.
#   * frequencies/uniq/group_by needed a MAP that can be built up (fz-5xp.12);
#   * join/1,2 needed STRING.CHARS (fz-5xp.15), since it has to render whatever
#     it is given.
#
# The rest is the pure list/reduce group, which needed nothing new.
#
# `group_by/2,3` builds each group by PREPENDING and then reverses once per key,
# so the values come out in encounter order -- which is what Elixir promises and
# what a naive append-per-element would get right only by accident, at O(n^2).
def main() do
  dbg(Enum.max([3, 1, 2]))
  dbg(Enum.min([3, 1, 2]))
  dbg(Enum.min_max([3, 1, 2]))
  dbg(Enum.max_by(["a", "bbb", "cc"], fn (s) -> String.length(s) end))
  dbg(Enum.min_by(["a", "bbb", "cc"], fn (s) -> String.length(s) end))
  dbg(Enum.sort_by(["bbb", "a", "cc"], fn (s) -> String.length(s) end))
  dbg(Enum.join([1, 2, 3], "-"))
  dbg(Enum.join(["a", "b"]))
  dbg(Enum.sum([1, 2, 3]))
  dbg(Enum.sum_by([1, 2, 3], fn (x) -> x * 2 end))
  dbg(Enum.product([2, 3, 4]))
  dbg(Enum.fetch([1, 2, 3], 1))
  dbg(Enum.fetch([1, 2, 3], 9))
  dbg(Enum.at([1, 2, 3], 1))
  dbg(Enum.at([1, 2, 3], 9, :none))
  dbg(Enum.concat([[1, 2], [3]]))
  dbg(Enum.concat([1], [2]))
  dbg(Enum.dedup([1, 1, 2, 2, 1]))
  dbg(Enum.count_until([1, 2, 3, 4], 2))
  dbg(Enum.zip([1, 2], ["a", "b"]))
  dbg(Enum.unzip([{1, "a"}, {2, "b"}]))
  dbg(Enum.chunk_every([1, 2, 3, 4, 5], 2))
  dbg(Enum.chunk_by([1, 1, 2, 3, 3], fn (x) -> x end))
  dbg(Enum.uniq([1, 2, 1, 3]))
  dbg(Enum.frequencies(["a", "b", "a"]))
  dbg(Enum.group_by([1, 2, 3, 4], fn (x) -> rem(x, 2) end))
end
