#---
# purpose: "Nested guard plans own their prepared keys independently of caller key layouts"
#---
#
# A helper called from a guard is an ordinary function, and a function head
# has no bindings before it, so a helper cannot pin. `sized/1` still tests a
# variable-size bitstring region inside a nested plan: its size names an
# earlier field of the same bitstring, which is bound before the size is read.
def wanted(%{"key" => value}), do: value == 42
def wanted(_), do: false

def relayed(value), do: wanted(value)

def alternative(%{"alt" => value}), do: value == 42
def alternative(_), do: false
def either(value), do: wanted(value) or alternative(value)

def sized(<<n, value::integer-size(n)>>), do: value == 42
def sized(_), do: false

def receive_sized() do
  receive do
    value when sized(value) -> 42
  after
    1000 -> 0
  end
end

def receive_either() do
  receive do
    value when either(value) -> 42
  after
    1000 -> 0
  end
end

def case_plain(message) do
  case message do
    value when relayed(value) -> 42
    _ -> 7
  end
end

def case_sparse(message, expected) do
  case message do
    %{:tag => ^expected, "outer" => value} when relayed(value) -> 42
    _ -> 7
  end
end

def case_different(message) do
  case message do
    %{"other" => value} when wanted(value) -> 42
    _ -> 7
  end
end

def receive_plain() do
  receive do
    value when relayed(value) -> 42
    _ -> 7
  after
    1000 -> 0
  end
end

def receive_sparse(expected) do
  receive do
    %{:tag => ^expected, "outer" => value} when relayed(value) -> 42
    _ -> 7
  after
    1000 -> 0
  end
end

def receive_different() do
  receive do
    %{"other" => value} when wanted(value) -> 42
    _ -> 7
  after
    1000 -> 0
  end
end

def receive_only_wanted() do
  receive do
    value when relayed(value) -> 42
  after
    1000 -> 0
  end
end

def main() do
  value = %{"key" => 42}
  sparse = %{:tag => :ok, "outer" => value}
  different = %{"other" => value}
  dbg({case_plain(value), case_sparse(sparse, :ok), case_different(different)})
  send(self(), value)
  a = receive_plain()
  send(self(), sparse)
  b = receive_sparse(:ok)
  send(self(), different)
  c = receive_different()
  dbg({a, b, c})
  assert(case_plain(%{"key" => 7}) == 7)
  send(self(), %{"key" => 7})
  send(self(), %{"key" => 8})
  send(self(), value)
  before = Process.heap_alloc_stats().bitstring_allocs
  assert(receive_only_wanted() == 42)
  count_after = Process.heap_alloc_stats().bitstring_allocs
  assert(count_after - before == 1)
  send(self(), <<8, 42>>)
  assert(receive_sized() == 42)
  send(self(), %{"alt" => 42})
  assert(receive_either() == 42)
  assert(case <<8, 42>> do
    value when sized(value) -> true
    _ -> false
  end)
end
