#---
# purpose: "two processes waiting on 2ms and 1ms timers both wake from their own timers; the parent asks for :fast and then :slow, so the output is the same whichever wakes first"
# oracle: self
# oracle.stamp: 340e503579635f0d
#---
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () ->
      receive do
        :never -> :ok
      after
        2 -> send(parent, :slow)
      end
    end)
    spawn(fn () ->
      receive do
        :never -> :ok
      after
        1 -> send(parent, :fast)
      end
    end)
    receive do
      :fast -> IO.inspect(:fast)
    end
    receive do
      :slow -> IO.inspect(:slow)
    end
  end
end

Main.main()
