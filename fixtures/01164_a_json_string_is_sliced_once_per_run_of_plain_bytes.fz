#---
# purpose: decoding a JSON string takes each run of plain bytes with one slice, so a long string without escapes allocates a handful of objects, not one per byte
# kind: run
#---
#
# The long string is 1,000 plain ASCII bytes. The decoder walks it once, and at
# the closing quote the run is one slice of the input, which is the decoded
# value: a string with no escape is a view of the input. The program prints the
# decoded length, then the allocations and the off-heap bytes the decode made.
# The allocations exclude what one `Process.heap_alloc_stats` call itself
# allocates, which a second snapshot measures: the stats map lands in the window
# after its snapshot. The native paths count the continuation frames the decode
# builds and the interpreter builds none: the native number is 6 above the
# interpreter's. No byte is copied, so the off-heap count is 0.
#
# The remaining cases pin what the decoder does at each kind of stop: an
# escape between runs, an escape first and last, an empty string, multi-byte
# UTF-8 between runs, a control character after a run, a string cut off after
# a run, and an invalid UTF-8 byte after a run. The decoded values are what
# Elixir's JSON decoder returns.
defmodule P do
  def decode_cost(doc) do
    a = Process.heap_alloc_stats()
    a2 = Process.heap_alloc_stats()
    {:ok, v} = JSON.decode(doc)
    b = Process.heap_alloc_stats()
    stats_call_allocs = a2[:allocs] - a[:allocs]
    decode_allocs = (b[:allocs] - a2[:allocs]) - stats_call_allocs
    {String.length(v), decode_allocs, b[:shared_bin_bytes] - a2[:shared_bin_bytes]}
  end
end

long = "\"" <> String.duplicate("a", 1000) <> "\""
dbg(P.decode_cost(long))

dbg(JSON.decode("\"plain\""))
dbg(JSON.decode("\"\""))
dbg(JSON.decode("\"ab\\ncd\\\"ef\\\\gh\""))
dbg(JSON.decode("\"\\tab\\u0041\""))
dbg(JSON.decode("\"abc\\u00e9def\\ud83d\\ude00ghi\""))
dbg(JSON.decode("\"café 世界 ok \u{1F600}!\""))
dbg(JSON.decode("\"abc\ndef\""))
dbg(JSON.decode("\"abc"))
dbg(JSON.decode(<<34, 97, 98, 99, 255, 100, 34>>))
dbg(JSON.decode("[\"ab\", \"cd\\n\", \"é\"]"))
