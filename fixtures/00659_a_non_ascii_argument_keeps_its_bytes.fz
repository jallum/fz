#---
# purpose: "a non-ASCII argument arrives byte for byte, spaces inside a single argument preserved, as in Elixir"
# args: "é ü" ü
# oracle: self
# oracle.stamp: 5b3295d48e414190
#---
defmodule Main do
  def main() do
    IO.inspect(System.argv())
    IO.inspect(Enum.map(System.argv(), fn arg -> byte_size(arg) end))
  end
end

Main.main()
