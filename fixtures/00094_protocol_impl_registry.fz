#---
# purpose: defprotocol and defimpl register the protocol, its implementation, and the domain type facts they declare.
#---
defprotocol Enumerable do
  @spec reduce(t(a), acc, (a, acc) -> acc) :: acc
  def reduce(enumerable, acc, reducer)
end

defimpl Enumerable, for: List do
  def reduce(list, acc, reducer), do: acc
end

defmodule Consumer do
  @spec use(Enumerable.t(integer)) :: integer
  def use(xs), do: 1
end

def main(), do: dbg(Consumer.use([1, 2, 3]))
