#---
# purpose: "Enum.sort materializes and sorts a Range without leaving an untyped resume payload"
#---
def main() do
  Enum.sort(1..3) == [1, 2, 3] || raise("Enum.sort/1 should accept every Enumerable, including Range")
  Enum.sort(1..3, fn (left, right) -> left >= right end) == [3, 2, 1] || raise("Enum.sort/2 should materialize its Enumerable before applying the custom order")
end
