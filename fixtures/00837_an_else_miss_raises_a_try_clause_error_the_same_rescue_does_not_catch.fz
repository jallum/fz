#---
# purpose: "a value no else clause matches raises TryClauseError carrying the value; the try's own rescue does not take it, the enclosing one does"
# oracle: self
# oracle.stamp: e8817142cfab4d8b
#---
defmodule Main do
  def main() do
    result = try do
      try do
        :unexpected
      rescue
        _ -> :inner_rescue
      else
        :expected -> :ok
      end
    rescue
      e in TryClauseError -> {:outer, e.term}
    end
    IO.inspect(result)
  end
end

Main.main()
