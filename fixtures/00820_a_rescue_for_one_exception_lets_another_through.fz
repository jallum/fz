#---
# purpose: "a rescue naming ArgumentError catches raise ArgumentError and does not catch a RuntimeError, which the outer try takes"
# oracle: self
# oracle.stamp: 832fac1b6e4122af
#---
defmodule Main do
  def attempt(f) do
    try do
      try do
        f.()
      rescue
        ArgumentError -> :argument
      end
    rescue
      RuntimeError -> :runtime_from_outer
    end
  end

  def main() do
    IO.inspect(attempt(fn () -> raise ArgumentError, "x" end))
    IO.inspect(attempt(fn () -> raise "x" end))
  end
end

Main.main()
