#---
# purpose: "an after block is lowered once per way out, so a closure inside it is built and called on the raising path and on the completing path"
# oracle: self
# oracle.stamp: ebcaf2f958d7165a
#---
defmodule Main do
  def main() do
    result = try do
      try do
        raise "x"
      after
        f = fn (v) -> IO.inspect({:raising, v}) end
        f.(1)
      end
    rescue
      e -> e.message
    end
    IO.inspect(result)
    try do
      :ok
    after
      g = fn (v) -> IO.inspect({:completing, v}) end
      g.(2)
    end
    IO.inspect(:done)
  end
end

Main.main()
