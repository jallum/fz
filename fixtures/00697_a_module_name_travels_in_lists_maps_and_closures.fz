#---
# purpose: "a module name is an ordinary value inside a list, as a map key and value, and captured by a closure"
# oracle: self
# oracle.stamp: 895662c02ba2bd7a
#---
defmodule Main do
  def main() do
    IO.inspect([RuntimeError, Foo.Bar])
    IO.inspect(%{"m" => Foo, Foo.Bar => 1})
    f = fn () -> Foo.Bar end
    IO.inspect(f.())
    g = fn (m) -> m == Foo.Bar end
    IO.inspect(g.(Foo.Bar))
  end
end

Main.main()
