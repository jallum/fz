#---
# purpose: "a module name is an ordinary value inside a list, as a map key and value, and captured by a closure"
# oracle: 00697_a_module_name_travels_in_lists_maps_and_closures.oracle.exs
#---
def main() do
  dbg([RuntimeError, Foo.Bar])
  dbg(%{"m" => Foo, Foo.Bar => 1})
  f = fn () -> Foo.Bar end
  dbg(f.())
  g = fn (m) -> m == Foo.Bar end
  dbg(g.(Foo.Bar))
end
