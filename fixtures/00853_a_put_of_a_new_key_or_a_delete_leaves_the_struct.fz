#---
# purpose: "Map.put of a new key and Map.delete answer plain maps that keep __struct__ as an ordinary key; deleting __struct__ leaves the fields"
# oracle: self
# oracle.stamp: ae1ad84472de14fe
#---
#
# Adding or removing a key changes the key set, so the answer is no longer
# the struct. `__struct__` stays an ordinary key of it until it is deleted.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Main do
  def main() do
    p = %Pt{x: 1, y: 2}
    grown = Map.put(p, :z, 0)
    IO.inspect(Enum.sort(Map.keys(grown)))
    IO.inspect(grown.__struct__)
    IO.inspect(grown.z)
    shrunk = Map.delete(p, :x)
    IO.inspect(Enum.sort(Map.keys(shrunk)))
    IO.inspect(shrunk.__struct__)
    IO.inspect(shrunk.y)
    IO.inspect(Map.delete(p, :__struct__))
    IO.inspect(Map.delete(p, :w))
    IO.inspect(Map.get(p, :x))
  end
end

Main.main()
