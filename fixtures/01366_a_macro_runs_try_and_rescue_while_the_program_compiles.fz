#---
# purpose: "A macro's own program raises and rescues while it runs, in the macro or in a function it calls, expanding to an expression or a definition, as in Elixir"
# oracle: self
# oracle.stamp: bc420e684a027e7a
#---

defmodule Helper do
  def escaped(value) do
    try do
      Macro.escape(value)
    rescue
      error in [ArgumentError] -> "refused: " <> Exception.message(error)
    end
  end

  defmacro seven() do
    try do
      7
    rescue
      error -> raise(error)
    end
  end

  defmacro recovered() do
    try do
      raise ArgumentError, "inside the macro"
    rescue
      error in [ArgumentError] -> Exception.message(error)
    end
  end

  defmacro table(), do: escaped({1, 2, 3})
  defmacro refused(), do: escaped(make_ref()) |> String.slice(0, 31)

  defmacro definition() do
    value =
      try do
        div(1, 0)
      rescue
        ArithmeticError -> :rescued
      end

    quote do
      def rescued_at_definition(), do: unquote(value)
    end
  end
end

defmodule Defined do
  import Helper
  definition()
end

defmodule Main do
  import Helper

  def main() do
    IO.inspect(seven())
    IO.inspect(recovered())
    IO.inspect(table())
    IO.inspect(refused())
    IO.inspect(Defined.rescued_at_definition())
  end
end

Main.main()
