#---
# purpose: "A @spec that names String.t() in a parameter and in a return position compiles, since String declares the type"
# oracle: 01380_a_spec_naming_string_t_compiles.oracle.exs
# oracle.stamp: d33e1e427e715dda
#---
defmodule Main do
  @spec name(atom()) :: String.t()
  def name(module), do: Atom.to_string(module)

  @spec shout(String.t()) :: String.t()
  def shout(text), do: text <> "!"

  def main() do
    IO.inspect(name(Foo.Bar))
    IO.inspect(shout("hello"))
    IO.inspect(shout(name(Baz)))
  end
end

Main.main()
