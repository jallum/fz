#---
# purpose: "Enum.count, Enum.member? and Enum.reduce work over a %Stream{} and over a %File.Stream{}: neither answers count or member? itself, so each reduces"
# oracle: 00774_enum_count_member_and_reduce_work_over_both_streams.oracle.exs
#---
def main() do
  mapped = Stream.map([1, 2, 3], fn x -> x * 2 end)
  dbg(Enum.count(mapped))
  dbg(Enum.member?(mapped, 4))
  dbg(Enum.member?(mapped, 3))
  dbg(Enum.reduce(mapped, 0, fn x, acc -> x + acc end))

  path = "00774_enum.tmp"
  File.write!(path, "a\nbb\nccc\n")
  file = File.stream!(path)
  dbg(Enum.count(file))
  dbg(Enum.member?(file, "bb\n"))
  dbg(Enum.member?(file, "bb"))
  dbg(Enum.reduce(file, 0, fn line, acc -> byte_size(line) + acc end))
  File.rm!(path)
end
