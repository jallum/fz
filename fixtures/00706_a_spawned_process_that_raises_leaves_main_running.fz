#---
# purpose: "a spawned process that raises prints its failure line and ends; main carries on and the program exits 0"
# oracle: self
# oracle.stamp: ae3a70729f728fe2
#---
# Elixir reports the same `** (RuntimeError) child boom` line through its
# logger, wrapped in a timestamped `[error] Process ... raised an exception`
# line and a stacktrace, on stderr. The fixture's stdout is the program's own
# output.
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () ->
      send(parent, :child_started)
      raise "child boom"
    end)
    receive do
      message -> IO.inspect(message)
    end
    IO.inspect(:main_carried_on)
  end
end

Main.main()
