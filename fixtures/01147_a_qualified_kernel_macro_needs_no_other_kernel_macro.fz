#---
# purpose: "qualified Kernel macros expand with no other Kernel macro in use"
# oracle: 01147_a_qualified_kernel_macro_needs_no_other_kernel_macro.oracle.exs
# oracle.stamp: 1518d5641f8d7495
#---
#
# The file names `Kernel.&&`, `Kernel.||`, `Kernel.!` and `Kernel.apply/3`
# only by their qualified names, so nothing else asks for a Kernel macro
# first. A qualified call to an imported module's macro expands the same way
# the unqualified call does, whatever else the file or its modules define.
def main() do
  IO.inspect(Kernel.&&(true, 3))
  IO.inspect(Kernel.&&(nil, 3))
  IO.inspect(Kernel.||(nil, 3))
  IO.inspect(Kernel.||(2, 3))
  IO.inspect(Kernel.!(nil))
  IO.inspect(Kernel.!(1))
  IO.inspect(Kernel.apply(Kernel, :abs, [-2]))
  IO.inspect(Kernel.apply(Kernel, :+, [1, 2]))
end
