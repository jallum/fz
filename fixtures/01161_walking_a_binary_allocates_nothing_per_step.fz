#---
# purpose: a `<<_c, r :: binary>>` match step allocates nothing: no struct, no view of the rest, and no frame; the clause dispatch only checks the field fits
# kind: run
#---
#
# The walk takes 10,000 steps over a 10,000-byte binary. A match keeps its
# position as an integer, the clause dispatch builds a field's value only when
# something consumes it, and the rest is the binary being read together with
# the position it starts at, so a step makes no heap object at all. The program
# prints the step count, then allocations and struct allocations per step.
#
# The allocation count is the total, which includes continuation frames. The
# `+ 1` is an extern the step calls itself, so it builds no frame either.
defmodule P do
  def go(b), do: walk(b, 0)
  defp walk(<<_c, r :: binary>>, n), do: walk(r, n + 1)
  defp walk(_b, n), do: n
end

line = String.duplicate("x", 10000)
a = Process.heap_alloc_stats()
n = P.go(line)
b = Process.heap_alloc_stats()
dbg(n)
dbg(div(b[:allocs] - a[:allocs], 10000))
dbg(div(b[:struct_allocs] - a[:struct_allocs], 10000))
