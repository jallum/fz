#---
# purpose: a `<<_c, r :: binary>>` match step allocates no struct and exactly one view of the rest; the clause dispatch only checks the field fits
# kind: run
#---
#
# The walk takes 10,000 steps over a 10,000-byte binary. A match keeps its
# position as an integer, and the clause dispatch builds a field's value only
# when something consumes it, so the only heap object a step makes is the view
# of the rest that the clause body's read hands out. The program prints the
# step count, then allocations and struct allocations per step.
defmodule P do
  def go(b), do: walk(b, 0)
  defp walk(<<_c, r :: binary>>, n), do: walk(r, n + 1)
  defp walk(_b, n), do: n
end

line = String.duplicate("x", 10000)
a = Process.heap_alloc_stats()
n = P.go(line)
b = Process.heap_alloc_stats()
dbg(n)
dbg(div(b[:allocs] - a[:allocs], 10000))
dbg(div(b[:struct_allocs] - a[:struct_allocs], 10000))
