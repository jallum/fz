#---
# purpose: a `<<_c, r :: binary>>` match step allocates no struct; each step builds only the views of the rest that the dispatch read and the body read hand out
# kind: run
#---
#
# The walk takes 10,000 steps over a 10,000-byte binary. A match keeps its
# position as an integer, so the only heap objects a step makes are the views
# of the rest: one from the clause dispatch's read, one from the clause body's
# read. The program prints the step count, then allocations and struct
# allocations per step.
defmodule P do
  def go(b), do: walk(b, 0)
  defp walk(<<_c, r :: binary>>, n), do: walk(r, n + 1)
  defp walk(_b, n), do: n
end

line = String.duplicate("x", 10000)
a = Process.heap_alloc_stats()
n = P.go(line)
b = Process.heap_alloc_stats()
dbg(n)
dbg(div(b[:allocs] - a[:allocs], 10000))
dbg(div(b[:struct_allocs] - a[:struct_allocs], 10000))
