#---
# purpose: an impl's @spec whose return type matches its protocol's declared return type is accepted, same as a mismatched one
#---
defprotocol P do
  @spec to_thing(t(a)) :: integer
  def to_thing(value)
end

defimpl P, for: List do
  @spec to_thing(list(integer)) :: integer
  def to_thing(value), do: 1
end

def main(), do: P.to_thing([1])
