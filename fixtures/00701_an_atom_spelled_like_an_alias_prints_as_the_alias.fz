#---
# purpose: "an atom whose name is Elixir. followed by capitalised segments prints as the alias however it was written"
# oracle: self
# oracle.stamp: 4ccf000381088a7e
#---
defmodule Main do
  def main() do
    IO.inspect(:"Elixir.Foo")
    IO.inspect(:"Elixir.Foo_9.Bar")
    IO.inspect(:"Elixir.F")
    IO.inspect(:Elixir)
    IO.inspect(:Foo)
    IO.inspect(String.to_atom("Elixir.Made.At.Runtime"))
  end
end

Main.main()
