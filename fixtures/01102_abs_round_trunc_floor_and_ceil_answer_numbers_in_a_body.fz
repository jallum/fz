#---
# purpose: "abs, round, trunc, floor and ceil answer an integer or a float in a body as Elixir does: round halves away from zero, floor and ceil go toward the signs, negative zero rounds to zero, and an operand that is not a number raises ArgumentError"
# oracle: self
# oracle.stamp: 28fa251885298bc6
#---
#
# abs keeps the type of its operand. round, trunc, floor and ceil answer an
# integer, and an integer operand answers itself. An operand that is not a
# number raises ArgumentError; the operand comes through JSON so no compile-time
# check sees it.

defmodule Main do
  def refused(f) do
    try do
      f.()
    rescue
      e in ArgumentError -> e.message
    end
  end

  def main() do
    IO.inspect([abs(-3), abs(3), abs(-2.5), abs(-0.0), abs(0.0), abs(-9223372036854775807)])
    IO.inspect([round(2.5), round(-2.5), round(0.5), round(-0.5), round(2.4), round(-2.6), round(-0.0), round(7)])
    IO.inspect([trunc(2.7), trunc(-2.7), trunc(-0.5), trunc(0.9), trunc(-0.0), trunc(7)])
    IO.inspect([floor(2.5), floor(-2.5), floor(-0.0), floor(2.0), floor(-3), floor(7)])
    IO.inspect([ceil(2.5), ceil(-2.5), ceil(-0.5), ceil(2.0), ceil(-3), ceil(7)])
    IO.inspect([trunc(-9223372036854775808.0), floor(-9223372036854775808.0)])
    IO.inspect([ceil(9223372036854774784.0), round(9223372036854774784.0)])
    IO.inspect(refused(fn -> abs(JSON.decode!("\"s\"")) end))
    IO.inspect(refused(fn -> round(JSON.decode!("\"s\"")) end))
    IO.inspect(refused(fn -> trunc(JSON.decode!("[1]")) end))
    IO.inspect(refused(fn -> floor(JSON.decode!("\"s\"")) end))
    IO.inspect(refused(fn -> ceil(JSON.decode!("\"t\"")) end))
  end
end

Main.main()
