#---
# purpose: "abs, round, trunc, floor and ceil answer an integer or a float in a body as Elixir does: round halves away from zero, floor and ceil go toward the signs, negative zero rounds to zero, and an operand that is not a number raises ArgumentError"
# oracle: oracle.exs
# oracle.stamp: 4467d04eb1145089
#---
#
# abs keeps the type of its operand. round, trunc, floor and ceil answer an
# integer, and an integer operand answers itself. An operand that is not a
# number raises ArgumentError; the operand comes through JSON so no compile-time
# check sees it.

def refused(f) do
  try do
    f.()
  rescue
    e in ArgumentError -> e.message
  end
end

def main() do
  dbg([abs(-3), abs(3), abs(-2.5), abs(-0.0), abs(0.0), abs(-9223372036854775807)])
  dbg([round(2.5), round(-2.5), round(0.5), round(-0.5), round(2.4), round(-2.6), round(-0.0), round(7)])
  dbg([trunc(2.7), trunc(-2.7), trunc(-0.5), trunc(0.9), trunc(-0.0), trunc(7)])
  dbg([floor(2.5), floor(-2.5), floor(-0.0), floor(2.0), floor(-3), floor(7)])
  dbg([ceil(2.5), ceil(-2.5), ceil(-0.5), ceil(2.0), ceil(-3), ceil(7)])
  dbg([trunc(-9223372036854775808.0), floor(-9223372036854775808.0)])
  dbg([ceil(9223372036854774784.0), round(9223372036854774784.0)])
  dbg(refused(fn -> abs(JSON.decode!("\"s\"")) end))
  dbg(refused(fn -> round(JSON.decode!("\"s\"")) end))
  dbg(refused(fn -> trunc(JSON.decode!("[1]")) end))
  dbg(refused(fn -> floor(JSON.decode!("\"s\"")) end))
  dbg(refused(fn -> ceil(JSON.decode!("\"t\"")) end))
end
