#---
# purpose: "Inline arms receive ordered plan bindings across nested constructors, shadowing, aliases, and dependent bitstrings"
#---
defmodule InlineBox do
  defstruct [:unused, :value]
end

def unpack(value) do
  captured = 100
  case value do
    {:nested, [%{box: %InlineBox{value: captured}} | tail]} -> {captured, tail}
    {:pair, left, right} -> {left, right}
    %{key: nil} -> :present_nil
    %{key: bound} -> {:present, bound}
    _ -> captured
  end
end

def framed(bytes) do
  case bytes do
    <<len, payload :: binary-size(len), rest :: binary>> -> {len, payload, rest}
    _ -> :bad_frame
  end
end

def recipes(bytes) do
  case bytes do
    <<x :: integer-size(8), 0>> -> x
    <<x :: binary-size(1), 1>> -> x
    _ -> :bad_recipe
  end
end

def aliased(value) do
  case value do
    whole = {:same, x, x} -> {whole, x}
    _ -> :different
  end
end

def accepted(value) do
  with {:ok, %{key: [head | tail]}} <- value,
       <<len, payload :: binary-size(len)>> <- head do
    {len, payload, tail}
  else
    {:error, %{reason: reason}} -> {:rejected, reason}
    %{key: nil} -> :present_nil
    other -> {:other, other}
  end
end

def main() do
  unpack({:nested, [%{box: %InlineBox{unused: 9, value: 7}}, 8]}) == {7, [8]} || raise("nested plan subjects bind the field and tail, shadowing the enclosing capture")
  unpack({:pair, 4, 5}) == {4, 5} || raise("outcome bindings preserve source order")
  unpack(%{key: nil}) == :present_nil || raise("a literal arm wins before a binding arm")
  unpack(%{key: 42}) == {:present, 42} || raise("a required present map value is bound")
  unpack(%{}) == 100 || raise("an absent key reaches the enclosing capture")
  framed(<<2, 65, 66, 67>>) == {2, "AB", "C"} || raise("dependent field sizes reuse the dispatch extraction")
  framed(:no) == :bad_frame || raise("a nonbinary reaches the arm with no bindings")
  recipes(<<65, 1>>) == "A" || raise("incompatible extraction recipes at the same ordinal cannot share a value")
  aliased({:same, 7, 7}) == {{:same, 7, 7}, 7} || raise("aliases and repeated bindings retain their values")
  accepted({:ok, %{key: [<<2, 65, 66>>, 9]}}) == {2, "AB", [9]} || raise("successive with outcomes supply bindings to the remaining match and body")
  accepted({:error, %{reason: :bad}}) == {:rejected, :bad} || raise("with else binds a nested map field from its winning outcome")
  accepted(%{key: nil}) == :present_nil || raise("with else preserves a present nil")
  accepted(%{}) == {:other, %{}} || raise("with else preserves an absent-key fallback")
end
