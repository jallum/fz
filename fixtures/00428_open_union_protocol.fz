#---
# purpose: a protocol call on an open-union receiver dispatches its known implementations inline and retains a stub fallthrough for the uncovered remainder.
#---
defprotocol Sizer do
  def size(value)
end

defimpl Sizer, for: Integer do
  def size(value), do: 1
end

defimpl Sizer, for: List do
  def size(value), do: 2
end

def describe(value), do: Sizer.size(value)

def main() do
  case [7, [1, 2, 3], :other] do
    [a, b, c] -> describe(a) + describe(b)
    _ -> 0
  end
end
