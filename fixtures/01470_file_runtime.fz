#---
# purpose: "The built-in File library interprets direct libc status values in fz source and claims an opaque stream exactly once on close."
#---
def main() do
  root = "fz-file-runtime-direct"
  path = root <> "/entry"
  renamed = root <> "/renamed"
  copied = root <> "/copied"
  copied_again = root <> "/copied-again"
  linked = root <> "/linked"
  symlinked = root <> "/symlinked"

  File.rm(path)
  File.rm(renamed)
  File.rm(copied)
  File.rm(copied_again)
  File.rm(linked)
  File.rm(symlinked)
  File.rmdir(root)

  File.mkdir(root) == :ok || raise("mkdir creates one directory")
  File.write(path, "hello") == :ok || raise("write stores binary contents")
  File.read(path) == {:ok, "hello"} || raise("read returns the stored binary")
  File.write(path, "!", [:append]) == :ok || raise("append preserves prior bytes")
  File.read(path) == {:ok, "hello!"} || raise("append extends the file")
  File.exists?(path) || raise("exists? recognizes the file")

  {:ok, handle} = File.open(path, [:read])
  File.close(handle) == :ok || raise("a proven success field retains the open resource")
  File.close(handle) == {:error, :closed} || raise("close only claims a handle once")

  File.rename(path, renamed) == :ok || raise("rename moves a file")
  File.copy(renamed, copied) == {:ok, 6} || raise("copy reports copied bytes")
  File.cp(copied, copied_again) == :ok || raise("cp hides the byte count")
  File.ln(copied, linked) == :ok || raise("ln creates a hard link")
  File.ln_s(copied, symlinked) == :ok || raise("ln_s creates a symbolic link")
  File.chmod(copied, 0o600) == :ok || raise("chmod changes file permissions")
  File.read("fz-file-runtime-direct-missing") == {:error, :io} || raise("read normalizes a C failure")

  File.rm(renamed) == :ok || raise("rm removes the renamed source")
  File.rm(copied) == :ok || raise("rm removes the copied file")
  File.rm(copied_again) == :ok || raise("rm removes the second copy")
  File.rm(linked) == :ok || raise("rm removes the hard link")
  File.rm(symlinked) == :ok || raise("rm removes the symbolic link")
  File.rmdir(root) == :ok || raise("rmdir removes an empty directory")
  dbg(:file_runtime_ok)
end
