#---
# purpose: "a binary construction whose segment value or size breaks its type's contract raises Elixir's ArgumentError naming the segment, which try can rescue; with several bad segments the one reported is the BEAM's: sizes, unsized binaries and code points are checked across all segments before values and lengths. <> reports as the two segments of <<left::binary, right::binary>>"
# oracle: self
# oracle.stamp: c620d7e6cc56ba67
# args: 0
#---
defmodule Main do
  # A value read from a list at a position known only at run time, so the
  # compiler cannot prove its type and every contract is checked.
  def v(k) do
    base = String.to_integer(hd(System.argv()))
    Enum.at([:a, 1.5, "a", <<1::3>>, 5, 0xDC00, 0x110000, -1, "abc", 65, :b, 2], base + k)
  end

  def build(:integer_atom), do: <<v(0)::8>>
  def build(:integer_float), do: <<v(1)::8>>
  def build(:float_atom), do: <<v(0)::float>>
  def build(:float_integer), do: <<v(4)::float>>
  def build(:binary_atom), do: <<v(0)::binary>>
  def build(:binary_integer), do: <<v(4)::binary>>
  def build(:binary_short), do: <<v(2)::binary-size(2)>>
  def build(:binary_prefix), do: <<v(8)::binary-size(2)>>
  def build(:binary_not_bytes), do: <<v(3)::binary>>
  def build(:bits_atom), do: <<v(0)::bits>>
  def build(:bits_of_bits), do: <<v(3)::bits, 1::5>>
  def build(:utf8_atom), do: <<v(0)::utf8>>
  def build(:utf8_surrogate), do: <<v(5)::utf8>>
  def build(:utf16_past_max), do: <<v(6)::utf16>>
  def build(:utf32_surrogate), do: <<v(5)::utf32>>
  def build(:utf8_negative), do: <<v(7)::utf8>>
  def build(:utf8_valid), do: <<v(9)::utf8>>
  def build(:size_negative) do
    n = v(7)
    <<5::size(n)>>
  end

  def build(:size_atom) do
    n = v(0)
    <<5::size(n)>>
  end

  def build(:binary_size_negative) do
    n = v(7)
    <<v(8)::binary-size(n)>>
  end

  def build(:float_size_two) do
    n = v(11)
    <<1.5::float-size(n)>>
  end

  def build(:second_segment), do: <<1, v(0)::8, 2>>
  def build(:sizing_before_writing), do: <<v(0)::16, v(10)::binary>>
  def build(:writing_in_order), do: <<v(0)::16, v(2)::binary-size(2)>>
  def build(:unit_is_a_write_check), do: <<v(0)::16, v(3)::binary>>
  def build(:code_point_is_a_sizing_check), do: <<v(0)::16, v(5)::utf8>>
  def build(:size_before_value) do
    n = v(10)
    <<v(0)::16, 5::size(n)>>
  end

  def build(:concat_left), do: v(0) <> "a"
  def build(:concat_right_not_bytes), do: "a" <> v(3)
  def build(:concat_valid), do: v(2) <> v(8)

  def attempt(row) do
    try do
      {row, :ok, build(row)}
    rescue
      e -> {row, e.__struct__, Exception.message(e)}
    end
  end

  # An append of a code point a utf8 segment cannot encode is caught by a bare
  # catch, as json.erl's encoder catches it.
  def append_code_point(acc, cp) do
    try do
      <<acc::binary, cp::utf8>>
    else
      s -> {:ok, s}
    catch
      _, _ -> :bad
    end
  end

  def main() do
    rows = [
      :integer_atom, :integer_float, :float_atom, :float_integer,
      :binary_atom, :binary_integer, :binary_short, :binary_prefix, :binary_not_bytes,
      :bits_atom, :bits_of_bits,
      :utf8_atom, :utf8_surrogate, :utf16_past_max, :utf32_surrogate, :utf8_negative, :utf8_valid,
      :size_negative, :size_atom, :binary_size_negative, :float_size_two,
      :second_segment, :sizing_before_writing, :writing_in_order,
      :unit_is_a_write_check, :code_point_is_a_sizing_check, :size_before_value,
      :concat_left, :concat_right_not_bytes, :concat_valid
    ]
    Enum.each(rows, fn row -> IO.puts(inspect(attempt(row))) end)
    IO.inspect({append_code_point("a", v(5)), append_code_point("a", v(6)), append_code_point("a", v(9))})
  end
end

Main.main()
