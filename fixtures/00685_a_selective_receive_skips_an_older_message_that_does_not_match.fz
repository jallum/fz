#---
# purpose: "a receive for a later message leaves the older one in the mailbox for the next receive"
# oracle: self
# oracle.stamp: f4e6ce652f0b27d5
#---
defmodule Main do
  def main() do
    me = self()
    spawn(fn () -> send(me, :child) end)
    send(me, :x)
    send(me, :y)
    a = receive do
      :y -> :y
    end
    b = receive do
      :x -> :x
    end
    c = receive do
      :child -> :child
    end
    IO.inspect({a, b, c})
  end
end

Main.main()
