#---
# purpose: "Enum.to_list/1 of a range allocates one list cell per element, whatever the step, and nothing for an empty range"
#---
#
# # enum_to_list_builds_a_ranges_list_once
#
# A range knows its last element, so its list is built from that end and no
# cell is allocated twice. `Process.heap_alloc_stats/0` counts the cells the
# process has allocated so far: 100 for `1..100`, then 5 more, 4 more, and
# none for the empty range.
def main() do
  up = Enum.to_list(1..100)
  dbg(Map.get(Process.heap_alloc_stats(), :list_cons_allocs))
  dbg(length(up))
  dbg(hd(up))

  dbg(Enum.to_list(1..10//2))
  dbg(Map.get(Process.heap_alloc_stats(), :list_cons_allocs))

  dbg(Enum.to_list(10..1//-3))
  dbg(Map.get(Process.heap_alloc_stats(), :list_cons_allocs))

  dbg(Enum.to_list(1..0//1))
  dbg(Enum.to_list(5..5))
  dbg(Map.get(Process.heap_alloc_stats(), :list_cons_allocs))
end
