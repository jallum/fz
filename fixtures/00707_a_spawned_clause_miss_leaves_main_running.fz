#---
# purpose: "a spawned process whose call matches no clause raises FunctionClauseError and ends; main carries on"
# oracle: self
# oracle.stamp: 4e0c87a25febfc7b
#---
# The failure line names the function that missed, qualified by its module
# as Elixir names it. Only the program's own output is compared with Elixir.
defmodule Main do
  def zero(0), do: :zero

  def main() do
    parent = self()
    spawn(fn () ->
      send(parent, :child_started)
      zero(7)
    end)
    receive do
      message -> IO.inspect(message)
    end
    IO.inspect(:main_carried_on)
  end
end

Main.main()
