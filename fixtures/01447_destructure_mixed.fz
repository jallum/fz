#---
# purpose: "nested destructure mixing tuple arity and list cons — `{[h | t], y} = make()` across all four legs"
#---
def make(), do: {[1, 2, 3], 99}

def main() do
  {[h | t], y} = make()
  h == 1 || raise("nested cons head binds through the tuple")
  t == [2, 3] || raise("nested cons tail binds through the tuple")
  y == 99 || raise("second tuple leg binds")
end
