#---
# purpose: "else sees only the body's value: a value produced by a rescue arm is the try's value as it stands"
# oracle: self
# oracle.stamp: a1120183b5dfe90c
#---
defmodule Main do
  def main() do
    result = try do
      raise ArgumentError, "x"
    rescue
      _ -> :from_rescue
    else
      :from_rescue -> :wrongly_matched
      other -> {:else, other}
    end
    IO.inspect(result)
  end
end

Main.main()
