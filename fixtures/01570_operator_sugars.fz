#---
# purpose: "operator desugaring rewrites ++, --, <>, .., and ..// to runtime-library calls"
# oracle: self
# oracle.stamp: 825e2283a0a8d9b1
#---
#
# Exercises the user-facing operator spellings after compiler2 source-sugar
# normalization. List operators become source `List` helper calls, binary
# concatenation becomes the public Kernel operator wrapper call, and range literals
# construct the source `Range` struct.
defmodule Main do
  def main() do
    IO.inspect([1, 2] ++ [3, 4])
    IO.inspect([1, 2, 1, 3] -- [1, 3])
    IO.inspect("foo" <> "bar")
    IO.inspect(1..5)
    IO.inspect(1..5//2)
  end
end

Main.main()
