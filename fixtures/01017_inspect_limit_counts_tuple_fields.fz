#---
# purpose: "inspect/2 limit: shows that many tuple fields and then ..., nested tuples sharing one budget"
# oracle: 01017_inspect_limit_counts_tuple_fields.oracle.exs
#---
def main() do
  dbg(inspect({1, 2, 3}, limit: 2))
  dbg(inspect({1, {2, 3}, 4}, limit: 2))
  dbg(inspect({1, {2, 3}, 4}, limit: 3))
  dbg(inspect({1, 2}, limit: 2))
  dbg(inspect({}, limit: 0))
  dbg(inspect({1}, limit: 0))
end
