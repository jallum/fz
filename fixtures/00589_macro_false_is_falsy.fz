#---
# purpose: a macro given false or nil sees it as falsy: if and case inside the macro body take the false branch
#---
defmacro pick(flag) do
  if flag do
    quote do: 1 + 0
  else
    quote do: 2 + 0
  end
end

defmacro classify(flag) do
  case flag do
    false -> quote do: 2 + 0
    _ -> quote do: 1 + 0
  end
end

def main() do
  pick(true) == 1 || raise("pick(true) takes the if branch")
  pick(false) == 2 || raise("pick(false) takes the else branch, not the if branch")
  pick(nil) == 2 || raise("pick(nil) takes the else branch, same as false")
  classify(false) == 2 || raise("a case on false inside a macro takes the false arm")
end
