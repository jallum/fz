#---
# purpose: "else clauses are a case over the body's value; the first clause that matches gives the try's value"
# oracle: self
# oracle.stamp: f3810fe53f725dd1
#---
defmodule Main do
  def main() do
    a = try do
      {:ok, 1}
    rescue
      _ -> :rescued
    else
      {:ok, n} -> n
      other -> other
    end
    b = try do
      :plain
    rescue
      _ -> :rescued
    else
      {:ok, n} -> n
      other -> other
    end
    IO.inspect(a)
    IO.inspect(b)
  end
end

Main.main()
