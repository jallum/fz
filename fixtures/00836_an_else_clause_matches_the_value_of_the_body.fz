#---
# purpose: "else clauses are a case over the body's value; the first clause that matches gives the try's value"
# oracle: self
# oracle.stamp: 296fc968bcd4aef7
#---
defmodule Main do
  def main() do
    a = try do
      {:ok, 1}
    rescue
      _ -> :rescued
    else
      {:ok, n} -> {:got, n}
      other -> other
    end
    b = try do
      :plain
    rescue
      _ -> :rescued
    else
      {:ok, n} -> {:got, n}
      other -> {:other, other}
    end
    IO.inspect(a)
    IO.inspect(b)
  end
end

Main.main()
