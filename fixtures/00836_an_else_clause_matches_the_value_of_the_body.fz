#---
# purpose: "else clauses are a case over the body's value; the first clause that matches gives the try's value"
# oracle: 00836_an_else_clause_matches_the_value_of_the_body.oracle.exs
#---
def main() do
  a = try do
    {:ok, 1}
  rescue
    _ -> :rescued
  else
    {:ok, n} -> {:got, n}
    other -> other
  end
  b = try do
    :plain
  rescue
    _ -> :rescued
  else
    {:ok, n} -> {:got, n}
    other -> {:other, other}
  end
  dbg(a)
  dbg(b)
end
