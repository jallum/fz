#---
# purpose: "Float.parse/1 reads sign, digits, an optional fraction and an optional exponent, leaves a dangling '.' or 'e' in the rest, and rounds to the nearest float"
# oracle: 00757_float_parse_reads_a_prefix_with_exponent_and_rounds_correctly.oracle.exs
#---
def main() do
  dbg(Float.parse("1e3"))
  dbg(Float.parse("1."))
  dbg(Float.parse("1.e3"))
  dbg(Float.parse(".5"))
  dbg(Float.parse("1.5x"))
  dbg(Float.parse("+1.5"))
  dbg(Float.parse("-2.5e-3"))
  dbg(Float.parse("1e"))
  dbg(Float.parse("1e+"))
  dbg(Float.parse("1e+2x"))
  dbg(Float.parse("1E5"))
  dbg(Float.parse("1_000.5"))
  dbg(Float.parse("  1.5"))
  dbg(Float.parse(""))
  dbg(Float.parse("-"))
  dbg(Float.parse("007.50"))
  dbg(Float.parse("3"))
  dbg(Float.parse("-0.0"))
  dbg(Float.parse("0.1"))
  dbg(Float.parse("1.5.5"))
  dbg(Float.parse("1ee3"))
  dbg(Float.parse("1e400"))
  dbg(Float.parse("1e-400"))
  dbg(Float.parse("1.7976931348623157e308"))
  dbg(Float.parse("123456789012345678901234567890.5"))
  dbg(Float.parse("0.30000000000000004"))
  dbg(Float.parse("9007199254740993"))
  dbg(Float.parse("2.2250738585072014e-308x"))
end
