#---
# purpose: "m.f(a) on a value typed as any atom is refused at compile time: the call is resolved from the modules the receiver's type lists, and atom lists none"
# expect: diagnostic
# diagnostic.code: type/module-value-call
#---
defmodule Overdrawn do
  def exception(attrs), do: {:overdrawn, attrs}
end

def main() do
  m = String.to_atom("Elixir.Overdrawn")
  dbg(m.exception([]))
end
