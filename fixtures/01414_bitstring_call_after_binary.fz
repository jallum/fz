#---
# purpose: "unsuffixed binary literals stay binary fields in runtime-built bitstrings"
#---
@spec digit(integer) :: integer
defp digit(n), do: 48 + n

def main() do
  <<digit(1)>> == "1" || raise("a call result works as the first field")
  <<digit(1), digit(2)>> == "12" || raise("adjacent call results keep their fields")
  <<"x", digit(1)>> == "x1" || raise("one binary literal does not shift a following call result")
  <<"x", "y", digit(1)>> == "xy1" || raise("several binary literals still occupy one field each")
end
