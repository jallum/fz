#---
# purpose: "a call no clause of a module function matches raises FunctionClauseError naming the function"
# expect: abort
# oracle: self
# oracle.stamp: 4794840a25bbb3e0
#---
defmodule Shapes do
  def sides(:triangle), do: 3
  def sides(:square), do: 4
end

defmodule Main do
  def main() do
    IO.inspect(Shapes.sides(:square))
    IO.inspect(Shapes.sides(:circle))
    IO.inspect(:never_printed)
  end
end

Main.main()
