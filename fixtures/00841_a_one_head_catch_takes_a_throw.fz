#---
# purpose: "a catch clause with one head matches a throw, binds the thrown value, and the try takes the clause's value"
# oracle: self
# oracle.stamp: 5f120f7a6e60fc90
#---
defmodule Main do
  def main() do
    result = try do
      throw({:found, 42})
    catch
      {:found, n} -> n
    end
    IO.inspect(result)
  end
end

Main.main()
