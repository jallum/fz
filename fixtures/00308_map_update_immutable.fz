#---
# purpose: map update syntax creates a new map, leaving the original unchanged
#---
def main() do
  m = %{a: 1, b: 2}
  m2 = %{m | a: 99}
  m == %{a: 1, b: 2} || raise("the original map is unchanged after an update")
  m2 == %{a: 99, b: 2} || raise("update syntax produces a new map with the field replaced")
end
