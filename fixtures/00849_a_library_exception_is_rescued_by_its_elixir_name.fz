#---
# purpose: "an exception the library raises is rescued by the name Elixir gives it, and its message is Elixir's"
# oracle: self
# oracle.stamp: 8c7f65be9ebc9c3a
#---
defmodule Main do
  defp zero(), do: 0

  defp empty(), do: []

  def main() do
    try do
      Map.fetch!(%{}, :k)
    rescue
      e in KeyError -> IO.inspect(e.__struct__)
    end
    try do
      div(1, zero())
    rescue
      e in ArithmeticError ->
        IO.inspect(e.__struct__)
        IO.inspect(e.message)
    end
    try do
      tuple_size(:x)
    rescue
      e in ArgumentError -> IO.inspect(e.__struct__)
    end
    try do
      Enum.max(empty())
    rescue
      e in Enum.EmptyError ->
        IO.inspect(e.__struct__)
        IO.inspect(e.message)
    end
    IO.inspect(:done)
  end
end

Main.main()
