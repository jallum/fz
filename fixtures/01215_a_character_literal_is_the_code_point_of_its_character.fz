#---
# purpose: ?c is the code point of c, ?\e the code point of an escape, and a literal works in expressions, patterns and next to a name ending in a question mark
# oracle: self
# oracle.stamp: 96df63ada7f7f986
#---
defmodule Main do
  def kind(?a), do: :a

  def kind(?\n), do: :newline

  def kind(_), do: :other

  def ready?(), do: true

  def main() do
    IO.inspect({?a, ?A, ?0, ?é, ?😀, ??, ?", ?#, ?(, ?:, ?_})
    IO.inspect({?\n, ?\t, ?\r, ?\s, ?\0, ?\\, ?\', ?\", ?\#})
    IO.inspect({?\a, ?\b, ?\d, ?\e, ?\f, ?\v})
    IO.inspect({?a + 1, ?z - ?a, ?a == 97, ?é == 233})
    IO.inspect({kind(97), kind(10), kind(?b)})
    IO.inspect(if ready?(), do: ?y, else: ?n)
  end
end

Main.main()
