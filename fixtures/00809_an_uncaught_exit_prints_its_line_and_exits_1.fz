#---
# purpose: "an exit with a reason other than normal or shutdown fails the main process: it prints the exit line and exits 1"
# expect: abort
# oracle: self
# oracle.stamp: 03d7ea1781257766
#---
defmodule Main do
  def main() do
    IO.inspect(:before)
    exit({:bad, :reason})
  end
end

Main.main()
