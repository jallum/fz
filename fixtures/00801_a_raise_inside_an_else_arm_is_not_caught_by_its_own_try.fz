#---
# purpose: "an else arm runs outside the try's rescue: its raise reaches the enclosing rescue, and the try's after still runs"
# oracle: 00801_a_raise_inside_an_else_arm_is_not_caught_by_its_own_try.oracle.exs
#---
def main() do
  result = try do
    try do
      :value
    rescue
      _ -> :inner_rescue
    else
      :value -> raise ArgumentError, "from else"
    after
      dbg(:after)
    end
  rescue
    e in ArgumentError -> e.message
  end
  dbg(result)
end
