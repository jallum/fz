#---
# purpose: "a module name that no module defines is still the atom of that name, with no diagnostic"
# oracle: self
# oracle.stamp: a989a7a1e024f5dc
#---
defmodule Main do
  def never(), do: Nope.Never

  def main() do
    IO.inspect(never())
    IO.inspect(Atom.to_string(Nope.Never))
  end
end

Main.main()
