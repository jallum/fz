#---
# purpose: "an after block runs once when the body completes, and the try's value is the body's, not the after's"
# oracle: 00832_an_after_runs_on_success_and_its_value_is_discarded.oracle.exs
# oracle.stamp: fcd94f695d90ce18
#---
def main() do
  result = try do
    dbg(:body)
    :body_value
  after
    dbg(:after)
    :after_value
  end
  dbg(result)
end
