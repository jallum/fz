#---
# purpose: "an after block runs once when the body completes, and the try's value is the body's, not the after's"
# oracle: self
# oracle.stamp: bb7d503a6c033491
#---
defmodule Main do
  def main() do
    result = try do
      IO.inspect(:body)
      :body_value
    after
      IO.inspect(:after)
      :after_value
    end
    IO.inspect(result)
  end
end

Main.main()
