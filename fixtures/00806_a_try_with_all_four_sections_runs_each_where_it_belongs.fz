#---
# purpose: "do, rescue, else and after together: the body's value goes to else, a raise goes to rescue, and after runs last on both"
# oracle: self
# oracle.stamp: dd802d462fc20989
#---
defmodule Main do
  def attempt(f) do
    try do
      f.()
    rescue
      _ -> :rescued
    else
      {:ok, n} -> n
      other -> {:else, other}
    after
      IO.inspect(:after)
    end
  end

  def main() do
    IO.inspect(attempt(fn () -> {:ok, 5} end))
    IO.inspect(attempt(fn () -> :other end))
    IO.inspect(attempt(fn () -> raise "x" end))
  end
end

Main.main()
