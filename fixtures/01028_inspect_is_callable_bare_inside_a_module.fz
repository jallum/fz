#---
# purpose: "inspect/1 and inspect/2 are imported into every module: a module's functions call them bare"
# oracle: self
# oracle.stamp: 779ab9af88be6d4e
#---
defmodule Shape do
  def show(value), do: inspect(value)
  def show(value, limit), do: inspect(value, limit: limit)
end
defmodule Main do
  def main() do
    IO.inspect(Shape.show(%{"a" => [1, 2]}))
    IO.inspect(Shape.show([1, 2, 3], 2))
    IO.inspect(Shape.show({:ok, "v"}, :infinity))
  end
end

Main.main()
