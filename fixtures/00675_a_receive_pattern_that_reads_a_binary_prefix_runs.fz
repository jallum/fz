#---
# purpose: "a receive whose only bitstring is its own pattern, written as <<45, 45, r::binary>>, <<"--", r::binary>> or "--" <> r, binds the rest on every path"
# oracle: self
# oracle.stamp: 6b5c08dd519693a8
#---
defmodule Main do
  def main() do
    send(self(), "--hi")
    receive do
      <<45, 45, r::binary>> -> IO.inspect(r)
    end
    send(self(), "--hi")
    receive do
      <<"--", r::binary>> -> IO.inspect(r)
    end
    send(self(), "--hi")
    receive do
      "--" <> r -> IO.inspect(r)
    end
  end
end

Main.main()
