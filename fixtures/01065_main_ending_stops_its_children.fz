#---
# purpose: "A program ends when its main process ends: a child still waiting then never runs again"
# oracle: self
# oracle.stamp: 55b45381e98ac370
#---
defmodule Main do
  def main() do
    spawn(fn ->
      receive do
        :never -> :ok
      after
        60000 -> IO.puts("late")
      end
    end)
    IO.puts("main done")
  end
end

Main.main()
