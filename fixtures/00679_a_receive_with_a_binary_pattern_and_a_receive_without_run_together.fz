#---
# purpose: "one program holds a receive that reads a binary prefix and a receive that matches a plain tuple"
# oracle: self
# oracle.stamp: 7cacfa971e187e39
#---
defmodule Main do
  def main() do
    send(self(), {:plain, 7})
    receive do
      {:plain, n} -> IO.inspect(n)
    end
    send(self(), "--hi")
    receive do
      "--" <> r -> IO.inspect(r)
    end
  end
end

Main.main()
