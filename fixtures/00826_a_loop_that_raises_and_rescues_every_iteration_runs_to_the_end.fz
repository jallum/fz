#---
# purpose: "a tail loop that raises and rescues on every one of 10_000 iterations completes with the count"
# oracle: self
# oracle.stamp: 3f0eda51dd05e29f
#---
defmodule Main do
  def loop(0, acc), do: acc

  def loop(n, acc) do
    one = try do
      raise ArgumentError, "x"
    rescue
      ArgumentError -> 1
    end
    loop(n - 1, acc + one)
  end

  def main() do
    IO.inspect(loop(10_000, 0))
  end
end

Main.main()
