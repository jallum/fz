#---
# purpose: "Enumerable over a Map.put result followed by a stream over the same map reaches every Enumerable impl in either order; both lines print what Elixir prints"
# oracle: self
# oracle.stamp: 0e1734f773d8b2db
#---
defmodule Main do
  def main() do
    IO.inspect(Enum.to_list(Map.put(%{}, 1, 1)))
    IO.inspect(Enum.to_list(Stream.map(Map.put(%{}, 1, 1), &(&1))))
  end
end

Main.main()
