#---
# purpose: "inspect(meta, limit: 6) over an eight-key string-keyed map prints the first six entries in key order and then ..."
# oracle: 01026_inspect_limit_six_over_an_eight_key_string_map.oracle.exs
#---
def main() do
  dbg(inspect(%{"name" => 1, "fz.compiler2.job" => 2, "kind" => 3, "span_id" => 4, "parent" => 5, "duration" => 6, "ts" => 7, "x" => 8}, limit: 6))
  dbg(inspect(%{"name" => "x", "kind" => "job"}, limit: 6))
end
