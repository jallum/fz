#---
# purpose: "inspect(meta, limit: 6) over an eight-key string-keyed map prints the first six entries in key order and then ..."
# oracle: self
# oracle.stamp: 65022e2149b243f5
#---
defmodule Main do
  def main() do
    IO.inspect(inspect(%{"name" => 1, "fz.compiler2.job" => 2, "kind" => 3, "span_id" => 4, "parent" => 5, "duration" => 6, "ts" => 7, "x" => 8}, limit: 6))
    IO.inspect(inspect(%{"name" => "x", "kind" => "job"}, limit: 6))
  end
end

Main.main()
