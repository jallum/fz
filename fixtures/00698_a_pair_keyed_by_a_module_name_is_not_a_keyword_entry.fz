#---
# purpose: "a list of pairs keyed by a module name prints as tuples, because an Elixir.-prefixed atom is never a keyword key"
# oracle: self
# oracle.stamp: 7cdeff7ea23959db
#---
defmodule Main do
  def main() do
    IO.inspect([{Foo, 1}])
    IO.inspect([{:a, 1}, {Foo.Bar, 2}])
    IO.inspect([a: 1])
  end
end

Main.main()
