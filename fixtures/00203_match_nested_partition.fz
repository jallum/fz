#---
# purpose: empty-payload, cons-payload, and atom-fallback clauses are distinct activations; a total catch-all doesn't contribute to the observed return
#---
def pick({:ok, []}), do: :empty
def pick({:ok, [h | _t]}), do: h
def pick(:error), do: :error
def pick(_), do: :unreachable

def main() do
  {pick({:ok, []}), pick({:ok, [1]}), pick(:error)}
end
