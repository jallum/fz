#---
# purpose: "three-level currying — nested lambdas each capturing outer scope; exercises multi-depth closure allocation"
#---
def add3(x), do: fn(y) -> fn(z) -> x + y + z end end
def apply(f, x), do: f.(x)

def main() do
  apply(apply(add3(10), 20), 12) == 42 || raise("three nested closures preserve their captured outer values")
  apply(apply(add3(1), 2), 3) == 6 || raise("a second curried call chain still computes through the same nested shape")
end
