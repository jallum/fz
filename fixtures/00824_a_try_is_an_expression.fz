#---
# purpose: "try is an expression: its value is passed straight to a call"
# oracle: self
# oracle.stamp: ee9d292769c9aaba
#---
defmodule Main do
  def main() do
    IO.inspect(try do
      raise ArgumentError, "x"
    rescue
      ArgumentError -> :rescued
    end)
    IO.inspect(try do
      :completed
    rescue
      ArgumentError -> :rescued
    end)
  end
end

Main.main()
