#---
# purpose: "try is an expression: its value is passed straight to a call"
# oracle: 00824_a_try_is_an_expression.oracle.exs
# oracle.stamp: c0100cea9cc98bd5
#---
def main() do
  dbg(try do
    raise ArgumentError, "x"
  rescue
    ArgumentError -> :rescued
  end)
  dbg(try do
    :completed
  rescue
    ArgumentError -> :rescued
  end)
end
