#---
# purpose: "A process spawned with a closure that captures a ten-thousand-element list and a three-hundred-element tuple reads every element of both, as in Elixir"
# kind: run
# oracle: self
# oracle.stamp: 96c7e8f1a065444f
#---
#
# The closure is far larger than a new process's first block, so the runtime
# sizes the child's heap to hold it instead of growing one while copying. The
# child's checksum shows nothing was lost in the copy.
defmodule Main do
  def main() do
    parent = self()
    list = Enum.to_list(1..10_000)
    tuple = List.to_tuple(Enum.to_list(1..300))

    spawn(fn ->
      send(parent, {:checksum, Enum.sum(list), length(list), tuple_size(tuple), elem(tuple, 299)})
    end)

    receive do
      {:checksum, sum, len, size, last} -> IO.inspect({sum, len, size, last})
    end
  end
end

Main.main()
