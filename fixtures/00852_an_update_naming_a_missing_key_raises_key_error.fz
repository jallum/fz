#---
# purpose: "%{m | k: v} with no k in m raises KeyError with Elixir's message, for a map and a struct, even when the result is unused"
# oracle: self
# oracle.stamp: a948a0f8a3a9881e
#---
#
# An update may only replace keys the map already has. The update itself
# reports the miss, and the raise names the key.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Main do
  def grow(v), do: %{v | z: 0}

  def main() do
    m = %{a: 1}
    try do
      %{m | b: 2}
    rescue
      e in KeyError -> IO.inspect(Exception.message(e))
    end
    try do
      %{m | a: 3, c: 4}
    rescue
      e in KeyError -> IO.inspect(Exception.message(e))
    end
    try do
      _ = %{m | d: 4}
      IO.inspect(:unreachable)
    rescue
      e in KeyError -> IO.inspect(Exception.message(e))
    end
    p = %Pt{x: 1, y: 2}
    try do
      grow(p)
    rescue
      e in KeyError -> IO.inspect(Exception.message(e))
    end
    try do
      %{p | __struct__: Pt, x: 3}
      |> IO.inspect()
    rescue
      e in KeyError -> IO.inspect(Exception.message(e))
    end
  end
end

Main.main()
