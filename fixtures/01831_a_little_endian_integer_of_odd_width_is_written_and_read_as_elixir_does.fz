  def build63(x), do: <<x::63-little>>
  def clause63(<<x::63-little, rest::bits>>), do: {x, rest}
  def clause63(_), do: :nomatch
  def clause_signed63(<<x::signed-63-little, rest::bits>>), do: {x, rest}
  def clause_signed63(_), do: :nomatch

  def case63(bin) do
    case bin do
      <<x::63-little, rest::bits>> -> {x, rest}
      _ -> :nomatch
    end
  end

