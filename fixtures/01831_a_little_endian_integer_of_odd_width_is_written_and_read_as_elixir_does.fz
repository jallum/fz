    IO.inspect({:case, case63(bin)})
    IO.inspect({:case_signed, case_signed63(bin)})
    IO.inspect({:receive, receive63(bin)})
    IO.inspect({:receive_signed, receive_signed63(bin)})
  end

  def literal_clause(<<0x1ABC::13-little, _rest::bits>>), do: :hit13
  def literal_clause(<<0x1A5::9-little, _rest::bits>>), do: :hit9
  def literal_clause(<<5::3-little, _rest::bits>>), do: :hit3
  def literal_clause(_), do: :miss

  def literal_receive(bin) do
    send(self(), bin)
    receive do
      <<0x1ABC::13-little, _rest::bits>> -> :hit13
      <<0x1A5::9-little, _rest::bits>> -> :hit9
      _other -> :miss
    end
  end

  def runtime_width(bits, x) do
    bin = <<x::size(bits)-little, 5::3>>
    <<y::size(bits)-little, rest::bits>> = bin
    <<z::signed-size(bits)-little, _::bits>> = bin
    IO.inspect({bits, bin})
    IO.inspect({y, rest, z})
  end

  def main() do
    xs = [1, 0x5A5A5A5A5A5A5A5A, -1, -2, 0x1ABC, 0x1A5, 5, 0x0123456789ABCDEF]
    Enum.each(0..7, fn k -> row1(v(xs, k)) end)
    Enum.each(0..7, fn k -> row3(v(xs, k)) end)
    Enum.each(0..7, fn k -> row9(v(xs, k)) end)
    Enum.each(0..7, fn k -> row13(v(xs, k)) end)
    Enum.each(0..7, fn k -> row17(v(xs, k)) end)
    Enum.each(0..7, fn k -> row33(v(xs, k)) end)
    Enum.each(0..7, fn k -> row63(v(xs, k)) end)

    bins = [<<0xBC, 0x1A::5>>, <<0xBC, 0x1A::5, 1::1>>, <<0xA5, 0x1::1>>, <<5::3>>, <<0xBC, 0x1B::5>>, <<>>]
    Enum.each(bins, fn b -> IO.inspect({b, literal_clause(b), literal_receive(b)}) end)

    ns = [5, 9, 13, 17, 33, 63]
    Enum.each(0..5, fn k -> runtime_width(v(ns, k), v(xs, 1)) end)
  end
end
Main.main()
