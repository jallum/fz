  def clause33(<<x::33-little, rest::bits>>), do: {x, rest}
  def clause33(_), do: :nomatch
  def clause_signed33(<<x::signed-33-little, rest::bits>>), do: {x, rest}
  def clause_signed33(_), do: :nomatch

