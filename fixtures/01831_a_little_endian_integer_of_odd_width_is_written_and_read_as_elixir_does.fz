#---
# purpose: "a little-endian integer whose width is not a multiple of 8 is written and read as Elixir does: the whole low bytes first, then the remaining high bits as the final partial byte -- by construction, function-clause match, case match and receive match, unsigned and signed, at widths 1, 3, 9, 13, 17, 33 and 63, with values wider than the field truncated, a literal little-endian pattern, and a width read at run time"
# oracle: self
# oracle.stamp: c6a4e66e9b731084
# args: 0
#---
defmodule Main do
  # Values the compiler cannot see through: each is read from a list at a
  # position that is known only at run time.
  def v(list, k), do: Enum.at(list, String.to_integer(hd(System.argv())) + k)

  def build1(x), do: <<x::1-little>>
  def clause1(<<x::1-little, rest::bits>>), do: {x, rest}
  def clause1(_), do: :nomatch
  def clause_signed1(<<x::signed-1-little, rest::bits>>), do: {x, rest}
  def clause_signed1(_), do: :nomatch

  def case1(bin) do
    case bin do
      <<x::1-little, rest::bits>> -> {x, rest}
      _ -> :nomatch
    end
  end

  def case_signed1(bin) do
    case bin do
      <<x::signed-1-little, rest::bits>> -> {x, rest}
      _ -> :nomatch
    end
  end

  def receive1(bin) do
    send(self(), bin)
    receive do
      <<x::1-little, rest::bits>> -> {x, rest}
      _other -> :nomatch
    end
  end

  def receive_signed1(bin) do
    send(self(), bin)
    receive do
      <<x::signed-1-little, rest::bits>> -> {x, rest}
      _other -> :nomatch
    end
  end

  def row1(x) do
    # three trailing bits keep the rest of every match off a byte boundary
    bin = <<build1(x)::bits, 5::3>>
    IO.inspect({1, x, build1(x)})
    IO.inspect({:clause, clause1(bin)})
    IO.inspect({:clause_signed, clause_signed1(bin)})
    IO.inspect({:case, case1(bin)})
    IO.inspect({:case_signed, case_signed1(bin)})
    IO.inspect({:receive, receive1(bin)})
    IO.inspect({:receive_signed, receive_signed1(bin)})
  end

