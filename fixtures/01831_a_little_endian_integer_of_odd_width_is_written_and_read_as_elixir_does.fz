    bin = <<build3(x)::bits, 5::3>>
    IO.inspect({3, x, build3(x)})
    IO.inspect({:clause, clause3(bin)})
    IO.inspect({:clause_signed, clause_signed3(bin)})
    IO.inspect({:case, case3(bin)})
    IO.inspect({:case_signed, case_signed3(bin)})
    IO.inspect({:receive, receive3(bin)})
    IO.inspect({:receive_signed, receive_signed3(bin)})
  end

