  def build17(x), do: <<x::17-little>>
  def clause17(<<x::17-little, rest::bits>>), do: {x, rest}
  def clause17(_), do: :nomatch
  def clause_signed17(<<x::signed-17-little, rest::bits>>), do: {x, rest}
