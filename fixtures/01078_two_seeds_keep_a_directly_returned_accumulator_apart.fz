#---
# purpose: "Two callers seeding a directly returned accumulator with different element types each get back a list of their own element type"
# oracle: 01078_two_seeds_keep_a_directly_returned_accumulator_apart.oracle.exs
#---
def go([], a), do: a
def go([x | rest], a), do: go(rest, [x | a])

def tell(:a), do: "atom"
def tell(x), do: x

def main() do
  [h1 | _] = go([1, 2], [:a])
  [h2 | _] = go([1, 2], ["x"])
  dbg(tell(h1))
  dbg(tell(h2))
  dbg(go([3], [:a]))
  dbg(go([3], ["x"]))
end
