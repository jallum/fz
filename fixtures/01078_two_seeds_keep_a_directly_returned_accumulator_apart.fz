#---
# purpose: "Two callers seeding a directly returned accumulator with different element types each get back a list of their own element type"
# oracle: self
# oracle.stamp: 061290927c724846
#---
defmodule Main do
  def go([], a), do: a

  def go([x | rest], a), do: go(rest, [x | a])

  def tell(:a), do: "atom"

  def tell(x), do: x

  def main() do
    [h1 | _] = go([1, 2], [:a])
    [h2 | _] = go([1, 2], ["x"])
    IO.inspect(tell(h1))
    IO.inspect(tell(h2))
    IO.inspect(go([3], [:a]))
    IO.inspect(go([3], ["x"]))
  end
end

Main.main()
