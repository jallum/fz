#---
# purpose: "Two identical shape questions on one subject compile and answer once"
# oracle: self
# oracle.stamp: 91a9958f6cce2083
#---
defmodule Main do
  def same({_, _} = {_, _} = t), do: t

  def twice(t) do
    case t do
      {_, _} = {_, _} -> :pair
      _ -> :other
    end
  end

  def main() do
    IO.inspect(same({1, 2}))
    IO.inspect(twice({1, 2}))
    IO.inspect(twice(3))
  end
end

Main.main()
