#---
# purpose: "Two identical shape questions on one subject compile and answer once"
# oracle: 00794_the_same_question_asked_twice_of_one_subject_compiles.oracle.exs
#---
def same({_, _} = {_, _} = t), do: t

def twice(t) do
  case t do
    {_, _} = {_, _} -> :pair
    _ -> :other
  end
end

def main() do
  dbg(same({1, 2}))
  dbg(twice({1, 2}))
  dbg(twice(3))
end
