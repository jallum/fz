#---
# purpose: "an atom handed into a try body that dispatches on it keeps its own activation key, and one only compared there shares a key"
# oracle: self
# oracle.stamp: edd55f313ad89501
#---
defmodule Main do
  defp kind(:int), do: 1

  defp kind(:text), do: "one"

  defp kind(_other), do: raise(ArgumentError, "unknown kind")

  defp guarded(tag) do
    try do
      kind(tag)
    rescue
      e in ArgumentError -> {:rescued, e.message}
    end
  end

  defp same(a, b) do
    try do
      a === b
    rescue
      _ -> :never
    end
  end

  def main() do
    IO.inspect(guarded(:int))
    IO.inspect(guarded(:text))
    IO.inspect(guarded(:other))
    IO.inspect(same(:a, :a))
    IO.inspect(same(:a, :b))
  end
end

Main.main()
