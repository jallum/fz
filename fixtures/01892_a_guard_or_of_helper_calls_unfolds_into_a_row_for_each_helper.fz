#---
# purpose: "A guard that `or`s helper calls, and a helper whose body is an `or`, answer as Elixir's guards do and unfold into one row for each side: a callable argument is never constructed first-class"
# kind: run
# root: main/0
# assert.metric.semantic.executables: 12
# assert.metric.semantic.callsites: 21
# oracle: 01892_a_guard_or_of_helper_calls_unfolds_into_a_row_for_each_helper.oracle.exs
# oracle.stamp: 70ade77c9a2c1776
#---
defmodule Main do
  def number?(x), do: is_integer(x) or is_float(x)
  def text?(x), do: is_binary(x) or is_atom(x)
  def callable?(f) when is_function(f), do: true
  def callable?(_), do: false

  def pick(x) when number?(x) or text?(x), do: {:scalar, x}
  def pick(x) when callable?(x) or is_list(x), do: :later
  def pick(_), do: :other

  def either(x, y) when number?(x) or number?(y), do: :one_number
  def either(_, _), do: :none

  def main() do
    IO.inspect(pick(1))
    IO.inspect(pick(2.5))
    IO.inspect(pick("s"))
    IO.inspect(pick(:a))
    IO.inspect(pick(fn -> :ok end))
    IO.inspect(pick([1]))
    IO.inspect(pick({1}))
    IO.inspect(either(1, :a))
    IO.inspect(either(:a, 2.5))
    IO.inspect(either(:a, :b))
  end
end

Main.main()
