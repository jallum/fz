#---
# purpose: "a raise inside nested tries is caught by the innermost rescue that matches; the outer one never runs"
# oracle: 00821_a_nested_try_rescues_at_the_innermost_handler.oracle.exs
#---
def main() do
  result = try do
    try do
      raise ArgumentError, "inner"
    rescue
      e in ArgumentError -> "inner caught " <> e.message
    end
  rescue
    e in ArgumentError -> "outer caught " <> e.message
  end
  dbg(result)
end
