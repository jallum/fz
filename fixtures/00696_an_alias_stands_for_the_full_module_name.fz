#---
# purpose: "an alias in value position is the atom of the module it names, both for `alias X, as: Y` and for a plain `alias X.Y`"
# oracle: self
# oracle.stamp: 7de5651fbf3d0492
#---
alias Foo.Bar, as: B
alias Foo.Baz

defmodule Main do
  def aliased(), do: B

  def main() do
    IO.inspect(aliased())
    IO.inspect(B == Foo.Bar)
    IO.inspect(Atom.to_string(B))
    IO.inspect(Baz)
    IO.inspect(B.Inner)
  end
end

Main.main()
