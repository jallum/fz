#---
# purpose: "IO.puts, IO.write, IO.inspect and dbg write to one sink: alternating them prints their bytes in program order, and a write without a newline is continued by the next print"
# oracle: self
# oracle.stamp: 5dc5018884a394fe
#---
defmodule Main do
  def main() do
    IO.puts("one")
    IO.write("two ")
    IO.inspect(:three)
    IO.inspect("four")
    IO.write("five")
    IO.puts("")
    IO.inspect({:six, 6})
    IO.puts("seven")
    IO.inspect([8, 9.5])
  end
end

Main.main()
