#---
# purpose: "case guards call pure user fns — locks X1A β-reduction three-path parity"
#---
def is_pos(n) do n > 0 end
def double(x) do x * 2 end

def classify(n) do
  case n do
    x when is_pos(x) -> :pos
    x when is_pos(double(x)) -> :zero_or_neg_doubled_pos
    _ -> :other
  end
end

def main() do
  classify(5) == :pos || raise("guard calling a pure user fn fires")
  classify(0) == :other || raise("0 falls through both guards")
  classify(-3) == :other || raise("negative falls through both guards")
end
