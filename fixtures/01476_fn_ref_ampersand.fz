#---
# purpose: "&name/arity parses as an explicit function reference, disambiguating overloaded names by arity"
#---
def double(x), do: x * 2
def neg(x), do: 0 - x
def add(x, y), do: x + y

def apply1(f, x), do: f.(x)
def apply2(f, x, y), do: f.(x, y)

def main() do
  # Explicit &name/arity passes the disambiguated function reference
  # through apply1/apply2 and back into a call site.
  apply1(&double/1, 21) == 42 || raise("&double/1 reference applied")
  apply1(&neg/1, 7) == -7 || raise("&neg/1 reference applied")
  apply2(&add/2, 30, 12) == 42 || raise("&add/2 disambiguated by arity")
end
