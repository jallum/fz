#---
# purpose: "__info__/1 reflection — a synthesized module function reports functions, macros, and the module name on all four paths"
#---
defmodule Shapes do
  def area(r), do: r * r
  def perimeter(r), do: 4 * r

  defmacro twice(x) do
    quote do: unquote(x) + unquote(x)
  end
end

def main() do
  Shapes.__info__(:functions) == [{:area, 1}, {:perimeter, 1}] || raise("exported fns with arities")
  Shapes.__info__(:macros) == [{:twice, 1}] || raise("macros listed separately")
  Shapes.__info__(:module) == :Shapes || raise("module name as an atom")
  Shapes.__info__(:nonsense) == nil || raise("unknown kind yields nil")
end
