#---
# purpose: a reducer whose accumulator is added to its own {:cont, _} result is a compile error when the reduced list is computed, not only when it is a literal.
# expect: diagnostic
# diagnostic.code: spec/violation
#---
defmodule Main do
  def broken_reducer(entry, acc) do
    {:cont, acc + entry}
  end
end

def main() do
  l = Enum.filter([1, 2, 3], fn x -> x > 0 end)
  Enum.reduce(l, 0, &Main.broken_reducer/2)
  |> dbg()
end
