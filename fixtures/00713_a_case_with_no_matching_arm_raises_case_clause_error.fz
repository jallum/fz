#---
# purpose: "a case no arm matches raises CaseClauseError showing the value"
# expect: abort
# oracle: self
# oracle.stamp: e797ba01c449c99c
#---
defmodule Main do
  defp fetch(), do: {:error, 2}

  def main() do
    result = case fetch() do
      {:ok, n} -> n
    end
    IO.inspect(result)
  end
end

Main.main()
