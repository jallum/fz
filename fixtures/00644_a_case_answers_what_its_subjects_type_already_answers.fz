#---
# purpose: "a case over a boolean answers from its arms alone, a case whose subject's type leaves a value unnamed still takes its arms for the values that arrive, and both agree with Elixir"
# oracle: self
# oracle.stamp: fc89b877f4a178c1
#---
defmodule Main do
  def flip(a) do
    case a == 1 do
      true -> :was_one
      false -> :was_other
    end
  end

  def word(v) do
    case v do
      :a -> "first"
      :b -> "second"
    end
  end

  def main() do
    IO.inspect(Enum.map([1, 2, 1], fn a -> flip(a) end))
    IO.inspect(Enum.map([1, 2], fn a -> not (a == 1) end))
    IO.inspect(Enum.map(Enum.take([:a, :b, :c], 2), fn v -> word(v) end))
  end
end

Main.main()
