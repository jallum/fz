#---
# purpose: "a rescue-only try does not take a throw or an exit, even with a bare variable head; both reach the outer catch"
# oracle: self
# oracle.stamp: bc091b5dafca55da
#---
defmodule Main do
  def attempt(f) do
    try do
      f.()
    rescue
      e -> {:rescued, e}
    end
  catch
    kind, value -> {kind, value}
  end

  def main() do
    IO.inspect(attempt(fn () -> throw(:ball) end))
    IO.inspect(attempt(fn () -> exit(:leaving) end))
    IO.inspect(attempt(fn () -> raise "oops" end) |> elem(0))
  end
end

Main.main()
