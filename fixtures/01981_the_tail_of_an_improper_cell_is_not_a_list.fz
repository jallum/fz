#---
# purpose: the tail of a cell built as [1 | x] is whatever x is, so a tail that is an integer takes arithmetic.
# oracle: self
# oracle.stamp: 47357529282213d8
#---
defmodule Main do
  def t(x), do: [1 | x]

  def tail_plus_one(x) do
    [_ | y] = t(x)
    y + 1
  end

  def main() do
    if System.argv() == ["improper"] do
      IO.inspect(tail_plus_one(2))
    else
      IO.puts("not run")
    end
  end
end
Main.main()
