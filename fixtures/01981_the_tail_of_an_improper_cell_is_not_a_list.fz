#---
# purpose: the tail of a cell built as [1 | x] is whatever x is, so a tail that is an integer takes arithmetic.
# oracle: self
# oracle.stamp: 6fb27b6c7792b2b4
#---
defmodule Main do
  def t(x), do: [1 | x]

  def tail_plus_one(x) do
    [_ | y] = t(x)
    y + 1
  end

  def main() do
    IO.inspect(tail_plus_one(2))
  end
end
Main.main()
