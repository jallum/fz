#---
# purpose: "A recursion that wraps its argument in a struct on every call compiles: the repeated struct folds where it grew, and the budget never fires"
# root: main/0
# assert.metric.return_type.widened: 0
# assert.metric.type.clash_folded: 1
# oracle: self
# oracle.stamp: 63a5ebd80854e2fa
#---
defmodule W do
  defexception [:original]
end

defmodule Wrapper do
  def wrap(x) when is_exception(x), do: x
  def wrap(x), do: wrap(%W{original: x})
end

defmodule Main do
  def main() do
    IO.inspect(Wrapper.wrap(:a))
  end
end

Main.main()
