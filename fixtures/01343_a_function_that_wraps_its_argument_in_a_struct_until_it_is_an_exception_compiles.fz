#---
# purpose: "A recursion that wraps its argument in a struct until a guard accepts it compiles: type decides the guard, so the struct never grows"
# root: main/0
# assert.metric.type.clash_folded: 0
# oracle: self
# oracle.stamp: 791d616c4fdd0493
#---
defmodule W do
  defexception [:original]
end

defmodule Wrapper do
  def wrap(x) when is_exception(x), do: x
  def wrap(x), do: wrap(%W{original: x})
end

defmodule Main do
  def main() do
    IO.inspect(Wrapper.wrap(:a))
  end
end

Main.main()
