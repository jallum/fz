#---
# purpose: "sequential calls returning tuple-pattern results (fz-i82 regression)"
#---
def f(v) do
  case v do
    {:ok, x} -> x
    :err -> 0
  end
end

def g(v) do
  with {:ok, x} <- v do x else :err -> 0 end
end

def main() do
  f({:ok, 7}) == 7 || raise("case tuple-pattern arm returns the bound value")
  f(:err) == 0 || raise("case atom fallback returns 0")
  f(:err) == 0 || raise("sequential call: atom fallback again")
  f({:ok, 7}) == 7 || raise("sequential call: tuple arm again")
  g({:ok, 7}) == 7 || raise("with tuple-pattern returns the bound value")
  g(:err) == 0 || raise("with else atom fallback returns 0")
end
