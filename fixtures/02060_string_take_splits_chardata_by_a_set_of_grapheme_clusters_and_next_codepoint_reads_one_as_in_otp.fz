#---
# purpose: ":string.take/2,3,4 split chardata at the run of grapheme clusters that are, or are not, members of a set, from either end, over lists, binaries, nested chardata and multi-codepoint clusters, and :string.next_codepoint/1 reads one codepoint of ASCII, multibyte, invalid and empty input, with the same results as OTP on all three paths"
# oracle: self
# oracle.stamp: 2f3eb0acf07a3c33
#---
defmodule Main do
  def main() do
    sp = [?\s, ?\n]
    letters = Enum.to_list(?a..?z)
    digits = Enum.to_list(?0..?9)
    ring = [?e, 769]

    IO.inspect(:string.take([32, 32, 123, 120], sp), label: "list")
    IO.inspect(:string.take("  ab c", sp), label: "binary")
    IO.inspect(:string.take("", sp), label: "empty binary")
    IO.inspect(:string.take([], sp), label: "empty list")
    IO.inspect(:string.take("abc", []), label: "no set, leading")
    IO.inspect(:string.take([?a], [], true), label: "no set, complement")
    IO.inspect(:string.take("abc", [], false, :trailing), label: "no set, trailing")
    IO.inspect(:string.take("abc", [], true, :trailing), label: "no set, both")
    IO.inspect(:string.take("abc0z123", letters), label: "doc 1")
    IO.inspect(:string.take(<<"abc0z123">>, digits, true, :leading), label: "doc 2")
    IO.inspect(:string.take("abc0z123", digits, false, :trailing), label: "doc 3")
    IO.inspect(:string.take(<<"abc0z123">>, letters, true, :trailing), label: "doc 4")
    IO.inspect(:string.take(~c"abc0z123", digits, false, :trailing), label: "doc 3 list")
    IO.inspect(:string.take(~c"abc0z123", digits, true), label: "complement list")
    IO.inspect(:string.take("abc", letters), label: "all taken")
    IO.inspect(:string.take("abc", digits), label: "none taken")
    IO.inspect(:string.take("abc", digits, true), label: "all taken, complement")
    IO.inspect(:string.take("abc", letters, false, :trailing), label: "all, trailing")
    IO.inspect(:string.take("abc", digits, false, :trailing), label: "none, trailing")
    IO.inspect(:string.take("abc", letters, true, :trailing), label: "none, c trailing")
    IO.inspect(:string.take("aéb", [?a, ?é]), label: "multibyte")
    IO.inspect(:string.take("éé1", [?é], false, :leading), label: "multibyte run")
    IO.inspect(:string.take("1éé", [?é], false, :trailing), label: "multibyte tail")
    IO.inspect(:string.take("1éé", [?1], true, :trailing), label: "multibyte comp")
    IO.inspect(:string.take("ab\r\ncd", [?a, ?b, [?\r, ?\n]]), label: "crlf cluster")
    IO.inspect(:string.take("ab\r\ncd", [?a, ?b, ?\r]), label: "crlf split set")
    IO.inspect(:string.take([?a, ?b, ?\r, ?\n, ?c], [?a, ?b, [?\r, ?\n]]), label: "crlf list")
    IO.inspect(:string.take(["a" <> <<101, 204, 129>>, "x"], [?a, ring]), label: "ring bin")
    IO.inspect(:string.take([?a | ring] ++ [?x], [?a, ring]), label: "ring list")
    IO.inspect(:string.take([?a | ring] ++ [?x], [?a, ?e]), label: "ring not in set")
    IO.inspect(:string.take([?a | ring] ++ [?x], [?a, ?e], true), label: "ring comp")
    IO.inspect(:string.take("xa" <> <<101, 204, 129>>, [?a, ring], false, :trailing), label: "ring trailing")
    IO.inspect(:string.take("xae", [?a, ?e], false, :trailing), label: "trailing ae")
    IO.inspect(:string.take("xa" <> <<101, 204, 129>>, [?x], true, :trailing), label: "ring comp trailing")
    IO.inspect(:string.take("  ab", ["  "], false), label: "string element")
    IO.inspect(:string.take("a b", [" ", "a"]), label: "binary elements")
    IO.inspect(:string.take(["ab", ?c, "de"], letters), label: "nested leading")
    IO.inspect(:string.take(["ab", ?c, "1de"], letters), label: "nested stops")
    IO.inspect(:string.take(["ab", [?c, "1"], "de"], digits, true), label: "nested comp")
    IO.inspect(:string.take(["ab", ?c, "de1"], digits, false, :trailing), label: "nested trailing")
    IO.inspect(:string.take(["1ab", ?c, "de1"], digits, true, :trailing), label: "nested comp trailing")
    IO.inspect(:string.take(["", "  ", [], " x"], sp), label: "nested empties")
    IO.inspect(:string.take(["a" | "b"], letters), label: "improper tail")
    IO.inspect(:string.take(["aé", "é1"], [?é, ?a]), label: "nested multibyte")
    IO.inspect(:string.take(["x", "aaa", "b"], [?a], true, :leading), label: "nested comp leading")
    IO.inspect(:string.take(["xaa", "aa", "b"], [?a], false, :trailing), label: "nested a trailing")
    IO.inspect(:string.take(["ab", "aab"], [?a, ?b], false, :trailing), label: "nested all trailing")
    IO.inspect(:string.take(["ab", "aab"], [?c], true, :trailing), label: "nested all comp trailing")
    IO.inspect(:string.take("aaa", [?a], true, :trailing), label: "comp trailing none")
    IO.inspect(:string.take("a b c", [?a, ?b, ?c, ?\s], true), label: "comp leading end")

    IO.inspect(:string.next_codepoint("abc"), label: "cp ascii")
    IO.inspect(:string.next_codepoint(~c"abc"), label: "cp ascii list")
    IO.inspect(:string.next_codepoint("é!"), label: "cp multibyte")
    IO.inspect(:string.next_codepoint("€"), label: "cp three bytes")
    IO.inspect(:string.next_codepoint("😀x"), label: "cp four bytes")
    IO.inspect(:string.next_codepoint([[?a, ?b], ?c]), label: "cp nested")
    IO.inspect(:string.next_codepoint(["", "z"]), label: "cp after empty")
    IO.inspect(:string.next_codepoint(<<255, 1>>), label: "cp invalid")
    IO.inspect(:string.next_codepoint([<<255>>, "a"]), label: "cp invalid in list")
    IO.inspect(:string.next_codepoint(<<>>), label: "cp empty binary")
    IO.inspect(:string.next_codepoint([]), label: "cp empty list")
    IO.inspect(:string.next_codepoint([[], <<>>]), label: "cp empties")
    IO.inspect(:string.next_codepoint(<<?e, 204, 129>>), label: "cp ring")
  end
end

Main.main()
