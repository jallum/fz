#---
# purpose: "In a body match, p1 = p2 = expr binds the names of every side from the one value"
# oracle: self
# oracle.stamp: 79fb8bf4f31879fa
#---
defmodule Main do
  def main() do
    %{} = m = %{a: 1}
    m2 = %{} = %{b: 2}
    {a, _} = {_, b} = {10, 20}
    [h | _] = [_, x | _] = l = [1, 2, 3]
    IO.inspect({Map.get(m, :a), Map.get(m2, :b), a, b, h, x, l})
  end
end

Main.main()
