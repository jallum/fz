#---
# purpose: "a dotted module path is one atom named for its whole path, equal to the same atom written out"
# oracle: self
# oracle.stamp: d99d281f5b9a2b09
#---
defmodule Main do
  def main() do
    IO.inspect(Foo.Bar)
    IO.inspect(Atom.to_string(Foo.Bar.Baz))
    IO.inspect(Foo.Bar == :"Elixir.Foo.Bar")
    IO.inspect(Foo.Bar == Foo)
  end
end

Main.main()
