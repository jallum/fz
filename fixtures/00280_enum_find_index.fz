#---
# purpose: Enum.find_index returns the index of the first match or nil when nothing matches
#---
def main() do
  xs = [1, 2, 3, 4]
  Enum.find_index(xs, fn (x) -> (x % 2) == 0 end) == 1 || raise("find_index returns the first matching index")
  Enum.find_index(xs, fn (x) -> x > 9 end) == nil || raise("find_index returns nil when nothing matches")
end
