#---
# purpose: "a closure that arrives already boxed can be called for its effect, its result discarded, and called again"
# oracle: self
# oracle.stamp: cffa1abf078756b0
#---
defmodule Main do
  def make(map) do
    {map, fn acc, cmd ->
      case cmd do
        :done -> acc
        :halt -> :ok
      end
    end}
  end

  def run(map) do
    {initial, collector} = make(map)
    collector.(initial, :halt)
    collector.(initial, :done)
  end

  def main() do
    IO.inspect(run(%{}))
    IO.inspect(run(%{a: 1}))
  end
end

Main.main()
