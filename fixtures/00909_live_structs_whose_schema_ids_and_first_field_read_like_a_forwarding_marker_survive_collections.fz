def churn(0, acc), do: acc
def churn(n, acc), do: churn(n - 1, [Integer.to_string(n) | acc])
def make(x) do
  {%R0{a: x, b: 0}, %R1{a: x, b: 1}, %R2{a: x, b: 2}, %R3{a: x, b: 3}, %R4{a: x, b: 4}, %R5{a: x, b: 5}, %R6{a: x, b: 6}, %R7{a: x, b: 7}, %R8{a: x, b: 8}, %R9{a: x, b: 9}, %R10{a: x, b: 10}, %R11{a: x, b: 11}, %R12{a: x, b: 12}, %R13{a: x, b: 13}, %R14{a: x, b: 14}, %R15{a: x, b: 15}, %R16{a: x, b: 16}, %R17{a: x, b: 17}, %R18{a: x, b: 18}, %R19{a: x, b: 19}, %R20{a: x, b: 20}, %R21{a: x, b: 21}, %R22{a: x, b: 22}, %R23{a: x, b: 23}, %R24{a: x, b: 24}, %R25{a: x, b: 25}, %R26{a: x, b: 26}, %R27{a: x, b: 27}, %R28{a: x, b: 28}, %R29{a: x, b: 29}, %R30{a: x, b: 30}, %R31{a: x, b: 31}, %R32{a: x, b: 32}, %R33{a: x, b: 33}, %R34{a: x, b: 34}, %R35{a: x, b: 35}, %R36{a: x, b: 36}, %R37{a: x, b: 37}, %R38{a: x, b: 38}, %R39{a: x, b: 39}}
end
def main() do
  all = make(8)
  20000 = length(churn(20000, []))
  dbg(all)
  :ok
end
