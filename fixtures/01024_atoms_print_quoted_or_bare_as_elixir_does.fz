#---
# purpose: "An atom prints bare when it is an identifier or an unquoted operator, as an alias when it names a module, and quoted otherwise"
# oracle: self
# oracle.stamp: 7a5018e371a2d040
#---
defmodule Main do
  def main() do
    IO.inspect(:ok)
    IO.inspect(:ok?)
    IO.inspect(:save!)
    IO.inspect(:_hidden)
    IO.inspect(:Foo)
    IO.inspect(:nil)
    IO.inspect(:"foo bar")
    IO.inspect(:"1abc")
    IO.inspect(:"a-b")
    IO.inspect(:"a?b")
    IO.inspect(:"a\"b")
    IO.inspect(String.to_atom("a@b"))
    IO.inspect(String.to_atom("+"))
    IO.inspect(String.to_atom("-"))
    IO.inspect(String.to_atom("<>"))
    IO.inspect(String.to_atom("|>"))
    IO.inspect(String.to_atom("++"))
    IO.inspect(String.to_atom("in"))
    IO.inspect(String.to_atom("when"))
    IO.inspect(String.to_atom("and"))
    IO.inspect(String.to_atom("&&"))
    IO.inspect(String.to_atom("&&&"))
    IO.inspect(String.to_atom("|||"))
    IO.inspect(String.to_atom("**"))
    IO.inspect(String.to_atom("=="))
    IO.inspect(String.to_atom("->"))
    IO.inspect(String.to_atom("<-"))
    IO.inspect(String.to_atom("%{}"))
    IO.inspect(String.to_atom("{}"))
    IO.inspect(String.to_atom("<<>>"))
    IO.inspect(String.to_atom("..."))
    IO.inspect(String.to_atom(".."))
    IO.inspect(String.to_atom("..//"))
    IO.inspect(String.to_atom("\\"))
    IO.inspect(String.to_atom("\\\\"))
    IO.inspect(String.to_atom("::"))
    IO.inspect(String.to_atom("=>"))
    IO.inspect(String.to_atom("//"))
    IO.inspect(String.to_atom("<|>"))
    IO.inspect(String.to_atom("^^^"))
    IO.inspect(String.to_atom("?"))
    IO.inspect(String.to_atom("!!"))
    IO.inspect(String.to_atom("///"))
    IO.inspect(Foo.Bar)
    IO.inspect(Foo)
    IO.inspect(:"Elixir.foo")
    IO.inspect(:"Elixir.Foo bar")
    IO.inspect(:true)
    IO.inspect(:false)
  end
end

Main.main()
