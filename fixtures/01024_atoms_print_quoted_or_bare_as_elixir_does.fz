#---
# purpose: "An atom prints bare when it is an identifier or an unquoted operator, as an alias when it names a module, and quoted otherwise"
# oracle: 01024_atoms_print_quoted_or_bare_as_elixir_does.oracle.exs
#---
def main() do
  dbg(:ok)
  dbg(:ok?)
  dbg(:save!)
  dbg(:_hidden)
  dbg(:Foo)
  dbg(:nil)
  dbg(:"foo bar")
  dbg(:"1abc")
  dbg(:"a-b")
  dbg(:"a?b")
  dbg(:"a\"b")
  dbg(String.to_atom("a@b"))
  dbg(String.to_atom("+"))
  dbg(String.to_atom("-"))
  dbg(String.to_atom("<>"))
  dbg(String.to_atom("|>"))
  dbg(String.to_atom("++"))
  dbg(String.to_atom("in"))
  dbg(String.to_atom("when"))
  dbg(String.to_atom("and"))
  dbg(String.to_atom("&&"))
  dbg(String.to_atom("&&&"))
  dbg(String.to_atom("|||"))
  dbg(String.to_atom("**"))
  dbg(String.to_atom("=="))
  dbg(String.to_atom("->"))
  dbg(String.to_atom("<-"))
  dbg(String.to_atom("%{}"))
  dbg(String.to_atom("{}"))
  dbg(String.to_atom("<<>>"))
  dbg(String.to_atom("..."))
  dbg(String.to_atom(".."))
  dbg(String.to_atom("..//"))
  dbg(String.to_atom("\\"))
  dbg(String.to_atom("\\\\"))
  dbg(String.to_atom("::"))
  dbg(String.to_atom("=>"))
  dbg(String.to_atom("//"))
  dbg(String.to_atom("<|>"))
  dbg(String.to_atom("^^^"))
  dbg(String.to_atom("?"))
  dbg(String.to_atom("!!"))
  dbg(String.to_atom("///"))
  dbg(Foo.Bar)
  dbg(Foo)
  dbg(:"Elixir.foo")
  dbg(:"Elixir.Foo bar")
  dbg(:true)
  dbg(:false)
end
