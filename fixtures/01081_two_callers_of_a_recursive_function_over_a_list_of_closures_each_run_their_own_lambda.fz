#---
# purpose: "Two callers of one recursive function over a list of closures each call a different lambda on the closure element"
# kind: run
# oracle: self
# oracle.stamp: e19a029cba179de5
#---
defmodule M do
  def ml([], _), do: 0
  def ml([h | t], f), do: f.(h) + ml(t, f)
end
defmodule Main do
  def main() do
    l = [fn x -> x end]
    IO.inspect(M.ml(l, fn h -> h.(3) end))
    IO.inspect(M.ml(l, fn h -> h.(4) end))
  end
end

Main.main()
