#---
# purpose: "Two callers of one recursive function over a list of closures each call a different lambda on the closure element"
# kind: run
# oracle: 01081_two_callers_of_a_recursive_function_over_a_list_of_closures_each_run_their_own_lambda.oracle.exs
#---
defmodule M do
  def ml([], _), do: 0
  def ml([h | t], f), do: f.(h) + ml(t, f)
end
def main() do
  l = [fn x -> x end]
  dbg(M.ml(l, fn h -> h.(3) end))
  dbg(M.ml(l, fn h -> h.(4) end))
end
