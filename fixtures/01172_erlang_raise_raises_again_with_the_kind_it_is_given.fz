#---
# purpose: ":erlang.raise/3 raises a reason again as an error, a throw or an exit, whichever kind it is given"
# oracle: 01172_erlang_raise_raises_again_with_the_kind_it_is_given.oracle.exs
# oracle.stamp: 6d708f44288612b6
#---
def main() do
  again = fn kind, reason ->
    try do
      try do
        :erlang.raise(kind, reason, [])
      catch
        caught_kind, caught -> :erlang.raise(caught_kind, caught, __STACKTRACE__)
      end
    catch
      outer_kind, outer -> {outer_kind, outer}
    end
  end

  dbg(again.(:throw, :ball))
  dbg(again.(:exit, :stop))
  dbg(again.(:error, :reason))

  rescued = try do
    try do
      raise ArgumentError, "worse"
    rescue
      e in ArgumentError -> :erlang.raise(:error, e, __STACKTRACE__)
    end
  rescue
    e in ArgumentError -> {:rescued, e.message}
  end
  dbg(rescued)
end
