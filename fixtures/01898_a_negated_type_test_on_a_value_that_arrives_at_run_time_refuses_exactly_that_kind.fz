#---
# purpose: "A guard `not is_integer(a)` decides at run time from the value it is handed: a value whose type is unknown until a message delivers it is refused when it is an integer, as in Elixir, and taken when it is anything else"
# kind: run
# root: main/0
# oracle: self
# oracle.stamp: ac9d85ff14e13e36
#---
defmodule Main do
  def kind(a) when not is_integer(a), do: :not_an_integer
  def kind(_), do: :an_integer

  def main() do
    me = self()
    send(me, -1)
    send(me, :b)
    send(me, 3)
    send(me, 2.5)
    send(me, [1])
    receive do a -> IO.inspect(kind(a)) end
    receive do a -> IO.inspect(kind(a)) end
    receive do a -> IO.inspect(kind(a)) end
    receive do a -> IO.inspect(kind(a)) end
    receive do a -> IO.inspect(kind(a)) end
  end
end

Main.main()
