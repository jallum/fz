#---
# purpose: "cross-module qualified calls — `M.double`, `M.quad`, `N.helper`"
#---
defmodule M do
  def double(x), do: x * 2
  def quad(x), do: double(double(x))
end

defmodule N do
  def helper(x), do: x + 100
end

def main() do
  M.double(21) == 42 || raise("qualified call M.double")
  M.quad(5) == 20 || raise("M.quad calls sibling M.double")
  N.helper(7) == 107 || raise("qualified call N.helper")
  M.__info__(:functions) == [{:double, 1}, {:quad, 1}] || raise("M exports double/1 and quad/1")
  N.__info__(:functions) == [{:helper, 1}] || raise("N exports helper/1")
end
