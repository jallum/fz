#---
# purpose: "a receive pattern {:m, <<a, r::binary>>} binds the first byte and the rest of a binary held in a tuple message"
# oracle: self
# oracle.stamp: 932635a79b24c5b1
#---
defmodule Main do
  def main() do
    send(self(), {:m, "xyz"})
    receive do
      {:m, <<a, r::binary>>} -> IO.inspect({a, r})
    end
  end
end

Main.main()
