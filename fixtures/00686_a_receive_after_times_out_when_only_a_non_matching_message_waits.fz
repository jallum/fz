#---
# purpose: "a receive whose only mail does not match times out after 1ms and the program continues"
# oracle: self
# oracle.stamp: 63d021cc182f9469
#---
defmodule Main do
  def main() do
    send(self(), :other)
    receive do
      :never -> IO.inspect(:got)
    after
      1 -> IO.inspect(:timeout)
    end
    IO.inspect(:end)
  end
end

Main.main()
