#---
# purpose: "a receive whose only mail does not match times out after 1ms and the program continues"
# oracle: 00686_a_receive_after_times_out_when_only_a_non_matching_message_waits.oracle.exs
# oracle.stamp: 6c31c1b7ae0b4156
#---
def main() do
  send(self(), :other)
  receive do
    :never -> dbg(:got)
  after
    1 -> dbg(:timeout)
  end
  dbg(:end)
end
