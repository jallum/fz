#---
# purpose: a variadic C extern call passes integer arguments and returns a valid fd
#---
extern "C" defp libc::open(path :: c_string, flags :: c_int, ...) :: c_int
extern "C" defp libc::close(fd :: c_int) :: c_int
def main() do
  fd = libc::open("/tmp/fz-variadic-open-test.tmp", 578, 500 :: integer)
  assert(fd >= 0, "libc::open returns a valid fd")
  libc::close(fd)
end
