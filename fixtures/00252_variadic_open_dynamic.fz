#---
# purpose: a variadic C extern call passes integer arguments and returns a valid fd
#---
extern "C" defp libc::open(c_string, c_int, ...) :: c_int
extern "C" defp libc::close(c_int) :: c_int
def main() do
  fd = libc::open("fz-variadic-open-test.tmp", 578, 500 :: integer)
  assert(fd >= 0, "libc::open returns a valid fd")
  libc::close(fd)
end
