#---
# purpose: "a try with rescue and after: the rescue handles the raise, the after runs exactly once, on both the raising and the completing path"
# oracle: self
# oracle.stamp: dde564f2530eea88
#---
defmodule Main do
  def attempt(f) do
    try do
      f.()
    rescue
      e in ArgumentError -> {:rescued, e.message}
    after
      IO.inspect(:after)
    end
  end

  def main() do
    IO.inspect(attempt(fn () -> raise ArgumentError, "bad" end))
    IO.inspect(attempt(fn () -> :fine end))
  end
end

Main.main()
