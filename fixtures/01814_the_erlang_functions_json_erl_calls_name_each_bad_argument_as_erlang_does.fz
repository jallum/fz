#---
# purpose: "The :erlang functions json.erl calls raise ArgumentError naming every faulty argument, and BadMapError for a non-map, as Erlang does"
# oracle: self
# oracle.stamp: 295e61233cc533e0
#---
defmodule Main do
  # A value that has been through the mailbox has no type the compiler can
  # prove, so a call with the wrong kind of argument reaches its runtime check.
  def unknown(term) do
    send(self(), term)

    receive do
      received -> received
    end
  end

  def message(thunk) do
    try do
      thunk.()
    rescue
      e -> {e.__struct__, Exception.message(e)}
    end
  end

  def show(thunk) do
    {module, message} = message(thunk)
    IO.puts(inspect(module) <> ": " <> String.replace(message, "\n", "|"))
  end

  def main() do
    tuple = unknown({1, 2, 3})
    atom = unknown(:a)
    text = unknown("abcd")
    bits = unknown(<<1::3>>)
    show(fn -> :erlang.element(4, tuple) end)
    show(fn -> :erlang.element(0, tuple) end)
    show(fn -> :erlang.element(atom, tuple) end)
    show(fn -> :erlang.element(1, atom) end)
    show(fn -> :erlang.element(0, atom) end)
    show(fn -> :erlang.element(atom, atom) end)

    show(fn -> :erlang.binary_part(text, 1, 5) end)
    show(fn -> :erlang.binary_part(text, 1, -2) end)
    show(fn -> :erlang.binary_part(text, -1, 2) end)
    show(fn -> :erlang.binary_part(text, 5, 0) end)
    show(fn -> :erlang.binary_part(text, 5, -1) end)
    show(fn -> :erlang.binary_part(text, 5, atom) end)
    show(fn -> :erlang.binary_part(text, -1, atom) end)
    show(fn -> :erlang.binary_part(atom, 1, 2) end)
    show(fn -> :erlang.binary_part(atom, atom, atom) end)
    show(fn -> :erlang.binary_part(bits, 0, 0) end)

    show(fn -> :erlang.iolist_to_binary([1, atom]) end)
    show(fn -> :erlang.iolist_to_binary(atom) end)
    show(fn -> :erlang.iolist_to_binary([256]) end)
    show(fn -> :erlang.iolist_to_binary([bits]) end)
    show(fn -> :erlang.iolist_size(["ab", atom]) end)
    show(fn -> IO.iodata_to_binary(atom) end)

    show(fn -> :erlang.integer_to_binary(255, 1) end)
    show(fn -> :erlang.integer_to_binary(255, 37) end)
    show(fn -> :erlang.integer_to_binary(atom, 16) end)
    show(fn -> :erlang.integer_to_binary(5, atom) end)
    show(fn -> :erlang.integer_to_binary(atom, atom) end)

    show(fn -> :erlang.atom_to_binary(:foo, atom) end)
    show(fn -> :erlang.atom_to_binary(:"€", :latin1) end)
    show(fn -> :erlang.atom_to_binary(tuple, :utf8) end)
    show(fn -> :erlang.atom_to_binary(tuple, atom) end)
    show(fn -> :erlang.atom_to_binary(tuple, :latin1) end)

    show(fn -> :erlang.is_map_key(atom, 1) end)
    show(fn -> :erlang.is_map_key(atom, [1]) end)

    show(fn -> :erlang.binary_to_float("1") end)
    show(fn -> :erlang.binary_to_float("1e3") end)
    show(fn -> :erlang.binary_to_float(".5") end)
    show(fn -> :erlang.binary_to_float("5.") end)
    show(fn -> :erlang.binary_to_float(atom) end)
    show(fn -> :erlang.binary_to_integer("1.5") end)
    show(fn -> :erlang.binary_to_integer("5 ") end)
    show(fn -> :erlang.binary_to_integer("") end)
    show(fn -> :erlang.binary_to_integer(atom) end)

    show(fn -> :erlang.error(atom, :none, []) end)
    show(fn -> :erlang.error(atom, [1], error_info: %{cause: 1}) end)
    show(fn -> :erlang.error(%RuntimeError{message: "x"}, :none, error_info: %{}) end)
  end
end

Main.main()
