#---
# purpose: "a receive timeout computed at runtime waits and then yields the after value"
# oracle: self
# oracle.stamp: 25488ca5245ff934
#---
defmodule Main do
  def wait_for(ms) do
    receive do
      :never -> :got
    after
      ms -> :timeout
    end
  end

  def main() do
    IO.inspect(wait_for(2 - 1))
    IO.inspect(:end)
  end
end

Main.main()
