#---
# purpose: "a receive waits out a 1500ms timeout when nothing else can run, then continues"
# oracle: 00688_a_receive_after_waits_out_a_long_timeout.oracle.exs
# oracle.stamp: f0f40775bb458f33
#---
def main() do
  receive do
    :never -> dbg(:got)
  after
    1500 -> dbg(:timeout)
  end
  dbg(:end)
end
