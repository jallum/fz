#---
# purpose: "a struct update stores into its base when nothing else can hold it, and copies a base a caller, a tuple, a closure, another process or a collection could still reach"
# oracle: self
# oracle.stamp: 5f7c064ece53eed5
#---
#
# `count/2` threads one struct through its own updates, so each update after
# the first stores into the struct it was handed. The first base is a literal
# in `main`: run and build keep it in read-only program data, so that update
# copies; interp builds it on the heap, so it rewrites that one too.
#
# Every other update is handed a base something else may still reach, so it
# copies, and an old struct read again still reads its old fields:
#   `bump(held)`         the caller reads `held` again afterwards
#   `bump_first(boxed)`  the base was stored into a tuple
#   `bump(f.())`         the base was captured by a closure
#   the spawned process  the base arrived as a message
#   `bump(kept)`         the base was kept by a collection
#
# The last case holds on run and build, which collect while `Enum.to_list`
# fills the heap. interp collects only between quanta, and this program runs
# in one, so on interp nothing kept `kept` and its update rewrites it.
#
# Across the run: thirteen struct updates. Run and build rewrite two, the
# second and third steps of the threaded loop. interp rewrites nine: the
# three threaded steps, the first step of each of the five one-step loops,
# and `bump(kept)`.
defmodule Counter do
  defstruct [:n, :tag]
end

defmodule Main do
  def count(c, 0), do: c

  def count(c, k), do: count(%{c | n: c.n + 1}, k - 1)

  def bump(c), do: %{c | n: c.n + 1}

  def bump_first({c}), do: bump(c)

  def main() do
    threaded = count(%Counter{n: 0, tag: :threaded}, 3)
    IO.inspect(threaded.n)

    held = count(%Counter{n: 10, tag: :held}, 1)
    IO.inspect(bump(held).n)
    IO.inspect(held.n)

    boxed = {count(%Counter{n: 20, tag: :boxed}, 1)}
    IO.inspect(bump_first(boxed).n)
    IO.inspect(elem(boxed, 0).n)

    captured = count(%Counter{n: 30, tag: :captured}, 1)
    f = fn -> captured end
    IO.inspect(bump(f.()).n)
    IO.inspect(f.().n)

    sent = count(%Counter{n: 40, tag: :sent}, 1)
    me = self()
    pid = spawn(fn -> receive do %Counter{} = c -> send(me, bump(c)) end end)
    send(pid, sent)
    receive do c -> IO.inspect(c.n) end
    IO.inspect(sent.n)

    kept = count(%Counter{n: 50, tag: :kept}, 1)
    garbage = Enum.to_list(1..200000)
    IO.inspect(length(garbage))
    IO.inspect(bump(kept).n)
  end
end

Main.main()
