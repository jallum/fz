#---
# purpose: "A recursive call that returns a closure delivers it to its caller in the carrier the callee sent it in, so the caller can call it"
# kind: run
# oracle: 01126_a_closure_returned_through_recursion_is_called.oracle.exs
#---
defmodule M do
  def h(0), do: fn x -> x end
  def h(n), do: h(n - 1).(1)
end
def main() do
  dbg(M.h(1))
end
