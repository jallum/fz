#---
# purpose: "a with whose else matches nothing raises WithClauseError showing the value"
# expect: abort
# oracle: self
# oracle.stamp: ee26ad148e9ad6ba
#---
defmodule Main do
  defp fetch(), do: {:bad, 1}

  def main() do
    result = with {:ok, v} <- fetch() do
      v
    else
      :error -> :e
    end
    IO.inspect(result)
  end
end

Main.main()
