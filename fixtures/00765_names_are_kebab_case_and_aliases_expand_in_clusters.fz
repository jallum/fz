#---
# purpose: "OptionParser.parse/2 reads --max-top as :max_top, refuses --max_top, and expands one-letter aliases as -t 5, -t5, -t=5 and clusters such as -abc and -at 5"
# oracle: 00765_names_are_kebab_case_and_aliases_expand_in_clusters.oracle.exs
# args: --max-top 3
#---
def main() do
  dbg(OptionParser.parse(System.argv(), strict: [max_top: :integer]))
  dbg(OptionParser.parse(["--max_top", "3"], strict: [max_top: :integer]))
  dbg(OptionParser.parse(["-t", "5"], strict: [top: :integer], aliases: [t: :top]))
  dbg(OptionParser.parse(["-t5"], strict: [top: :integer], aliases: [t: :top]))
  dbg(OptionParser.parse(["-t=5"], strict: [top: :integer], aliases: [t: :top]))
  dbg(OptionParser.parse(["-t"], strict: [top: :integer], aliases: [t: :top]))
  dbg(OptionParser.parse(["-t", "x"], strict: [top: :integer], aliases: [t: :top]))
  dbg(OptionParser.parse(["-abc", "f"], strict: [alpha: :boolean, beta: :boolean, gamma: :boolean], aliases: [a: :alpha, b: :beta, c: :gamma]))
  dbg(OptionParser.parse(["-ac"], strict: [alpha: :boolean, gamma: :boolean], aliases: [a: :alpha, b: :beta, c: :gamma]))
  dbg(OptionParser.parse(["-at", "5"], strict: [alpha: :boolean, top: :integer], aliases: [a: :alpha, t: :top]))
  dbg(OptionParser.parse(["-at5"], strict: [alpha: :boolean, top: :integer], aliases: [a: :alpha, t: :top]))
  dbg(OptionParser.parse(["-ta", "5"], strict: [alpha: :boolean, top: :integer], aliases: [a: :alpha, t: :top]))
  dbg(OptionParser.parse(["-t", "1", "-t", "2"], strict: [top: [:integer, :keep]], aliases: [t: :top]))
  dbg(OptionParser.parse(["-x", "5"], strict: [top: :integer], aliases: [x: :missing]))
  dbg(OptionParser.parse(["--top", "5"], strict: [top: :integer], aliases: [t: :top]))
end
