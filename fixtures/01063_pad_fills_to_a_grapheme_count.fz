#---
# purpose: "String.pad_leading and pad_trailing fill to a grapheme count with a cycled binary or list, never truncate, and raise FunctionClauseError for a negative count or empty padding"
# oracle: self
# oracle.stamp: d3cfa651e192d711
#---
defmodule Main do
  def main() do
    IO.inspect(String.pad_leading("abc", 6))
    IO.inspect(String.pad_trailing("abc", 6))
    IO.inspect(String.pad_leading("abc", 6, "12"))
    IO.inspect(String.pad_trailing("abc", 6, "12"))
    IO.inspect(String.pad_trailing("abc", 6, ["x", "yz"]))
    IO.inspect(String.pad_leading("abc", 6, ["x", "yz"]))
    IO.inspect(String.pad_trailing("héllo", 3))
    IO.inspect(String.pad_leading("abc", 3))
    IO.inspect(String.pad_leading("a longer string than the count", 4))
    IO.inspect(String.pad_trailing("a longer string than the count", 4, ["x"]))
    IO.inspect(String.pad_leading("abc", 0))
    IO.inspect(String.pad_trailing("", 2, "ab"))
    IO.inspect(String.pad_trailing("é", 3, "ë"))
    IO.inspect(String.pad_leading(<<101, 204, 129>>, 3, "-"))
    IO.inspect(String.pad_leading("x", 4, <<101, 204, 129>>))
    try do
      String.pad_leading("abc", -1)
    rescue
      e -> IO.inspect({e.__struct__, Exception.message(e)})
    end
    try do
      String.pad_trailing("abc", -1, "x")
    rescue
      e -> IO.inspect({e.__struct__, Exception.message(e)})
    end
    try do
      String.pad_leading("abc", 5, "")
    rescue
      e -> IO.inspect({e.__struct__, Exception.message(e)})
    end
    try do
      String.pad_trailing("abc", 5, [])
    rescue
      e -> IO.inspect({e.__struct__, Exception.message(e)})
    end
    try do
      String.pad_leading("a", 3, ["x", 1])
    rescue
      e -> IO.inspect({e.__struct__, Exception.message(e)})
    end
    IO.inspect(String.pad_leading("a", 2, ["x", 1]))
  end
end

Main.main()
