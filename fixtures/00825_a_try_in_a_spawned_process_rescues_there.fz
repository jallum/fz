#---
# purpose: "a spawned process rescues its own raise and reports the value; main receives it and carries on"
# oracle: self
# oracle.stamp: 31811f7981a37e5d
#---
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () ->
      result = try do
        raise ArgumentError, "in child"
      rescue
        e in ArgumentError -> e.message
      end
      send(parent, {:done, result})
    end)
    receive do
      {:done, result} -> IO.inspect(result)
    end
    IO.inspect(:main_carried_on)
  end
end

Main.main()
