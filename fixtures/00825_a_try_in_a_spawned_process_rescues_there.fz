#---
# purpose: "a spawned process rescues its own raise and reports the value; main receives it and carries on"
# oracle: 00825_a_try_in_a_spawned_process_rescues_there.oracle.exs
# oracle.stamp: a8c7631e0a8439e0
#---
def main() do
  parent = self()
  spawn(fn () ->
    result = try do
      raise ArgumentError, "in child"
    rescue
      e in ArgumentError -> e.message
    end
    send(parent, {:done, result})
  end)
  receive do
    {:done, result} -> dbg(result)
  end
  dbg(:main_carried_on)
end
