#---
# purpose: "a catch clause's guard sees the kind and the value; a clause whose guard fails falls to the next clause"
# oracle: 00843_a_catch_guard_can_test_the_kind.oracle.exs
#---
def attempt(f) do
  try do
    f.()
  catch
    kind, value when kind == :throw and value > 100 -> {:big_throw, value}
    kind, value when kind == :throw -> {:throw, value}
    kind, value -> {:other, kind, value}
  end
end

def main() do
  dbg(attempt(fn () -> throw(500) end))
  dbg(attempt(fn () -> throw(5) end))
  dbg(attempt(fn () -> exit(:gone) end))
end
