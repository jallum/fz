#---
# purpose: a multi-clause fn literal desugars to a case expression with pattern dispatch
#---
def main() do
  f = fn
0 -> :zero
n when n > 0 -> :pos
_ -> :other
  end
  f.(0) == :zero || raise("clause 0 matches the literal")
  f.(2) == :pos || raise("clause n when n > 0 matches")
  f.(-1) == :other || raise("the wildcard clause matches everything else")
end
