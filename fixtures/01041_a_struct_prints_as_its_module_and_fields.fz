#---
# purpose: "a struct prints as %Name{field: value} in defstruct order, whether flat, nil-valued, nested, in a list, in a tuple or in a nested module"
# oracle: self
# oracle.stamp: 0b59f03d43b54ef9
#---
#
# dbg renders a struct the way Elixir's inspect does: the module alias, then
# every field in defstruct order. A nested module spells as a dotted alias.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Seg do
  defstruct [:a, :b]
end

defmodule Geo.Pt do
  defstruct [:lat, :lon]
end

defmodule Main do
  def main() do
    IO.inspect(%Pt{x: 1, y: 2})
    IO.inspect(%Pt{y: 3})
    IO.inspect(%Seg{a: %Pt{x: 1, y: 2}, b: %Pt{y: 3}})
    IO.inspect([%Pt{x: 1, y: 2}, %Pt{x: 3, y: 4}])
    IO.inspect({%Pt{x: 1, y: 2}, :tag})
    IO.inspect(%Geo.Pt{lat: 1, lon: 2})
  end
end

Main.main()
