#---
# purpose: an @spec with nothing after `::` reads on to the module's `end`, so it attaches to no function and is a parse-time error.
# expect: diagnostic
# diagnostic.code: parse/dangling-function-attr
#---
defmodule M do
  def add1(n), do: n + 1
  @spec add1(integer) ::
end

def main(), do: dbg(M.add1(1))
