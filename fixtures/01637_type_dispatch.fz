#---
# purpose: multi-clause function dispatches on parameter type at runtime (fz-ty1.8/1.9)
#---
def check(x) when is_integer(x) do :is_int end
def check(_x) do :other end

def main() do
  check(42) == :is_int || raise("integer arg dispatches to the TypeTest clause")
  check(:foo) == :other || raise("atom arg falls through to the fallback clause")
end
