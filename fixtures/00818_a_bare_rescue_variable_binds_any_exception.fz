#---
# purpose: "a rescue head that is a bare variable catches every exception and binds it"
# oracle: self
# oracle.stamp: b51c68656d809ed9
#---
defmodule Main do
  def main() do
    result = try do
      raise ArgumentError, "bare"
    rescue
      e -> e.message
    end
    IO.inspect(result)
  end
end

Main.main()
