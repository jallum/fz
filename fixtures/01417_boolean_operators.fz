#---
# purpose: "boolean operators are Elixir's `and` / `or` / `not` (no C-style `&&` / `||` / `!`) — truth table, precedence, and guard use"
#---
#
# `and` binds tighter than `or`; `not` is the tightest unary prefix. The same
# operators are valid in `when` guards. The C-style spellings `&&` / `||` / `!`
# are not operators in fz and are rejected at lex time.
def classify(n) when n > 0 and n < 10, do: :small
def classify(n) when n >= 10 or n < 0, do: :big_or_negative
def classify(_), do: :zero

def main() do
  # Truth table for `and` / `or` / `not`.
  (true and true) || raise("and: both true")
  (true and false) && raise("and: one false")
  (true or false) || raise("or: one true")
  (false or false) && raise("or: both false")
  not false || raise("not: negates false")
  not true && raise("not: negates true")

  # Precedence mirrors Elixir: `and` binds tighter than `or`, and unary
  # `not` binds tightest. `true or false and false` parses as
  # `true or (false and false)`.
  (true or false and false) || raise("and binds tighter than or")
  (not false or false) || raise("not binds tighter than or")

  # `and` / `or` compose in guards.
  classify(5) == :small || raise("guard: 0 < n < 10")
  classify(42) == :big_or_negative || raise("guard: n >= 10")
  classify(-1) == :big_or_negative || raise("guard: n < 0")
  classify(0) == :zero || raise("guard: fall-through")
end
