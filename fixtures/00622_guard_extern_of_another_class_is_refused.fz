#---
# purpose: a guard may call an extern only when its parameters and return are numbers or reference words, and one that takes a binary is refused at compile time
# expect: diagnostic
# diagnostic.code: lower/unsupported
#---
extern "C" defp measure(binary) :: integer

def big(x) when measure(x) > 1, do: :big
def big(_), do: :small

def main(), do: dbg(big("four"))
