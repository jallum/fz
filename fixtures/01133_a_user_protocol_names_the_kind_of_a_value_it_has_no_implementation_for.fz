#---
# purpose: "A user protocol with one implementation, called with a receiver that may be any of several kinds, raises Protocol.UndefinedError for each kind it does not take; the message names the kind, a struct by its module, and shows the value"
# oracle: 01133_a_user_protocol_names_the_kind_of_a_value_it_has_no_implementation_for.oracle.exs
# oracle.stamp: 5acbb206e4ddb504
#---
defprotocol Sizer do
  def size(value)
end

defimpl Sizer, for: Integer do
  def size(value), do: "an integer, #{value}"
end

defmodule Foo do
  defstruct [:a]
end

def describe(value) do
  try do
    Sizer.size(value)
  rescue
    e -> e.message
  end
end

def first_line(value) do
  [line | _] = String.split(describe(value), "\n")
  line
end

def main() do
  values = [7, 1.5, %Foo{a: 1}, :ok, [1, 2], {1, 2}, %{a: 1}, "text"]
  Enum.each(values, fn value -> IO.puts(describe(value)) end)
  Enum.each([7, fn -> 1 end], fn value -> IO.puts(first_line(value)) end)
end
