#---
# purpose: "A guard `A or B` takes its clause when either side holds, as in Elixir, and each side narrows the value the clause reads: a clause no argument can satisfy is never specialized"
# kind: run
# root: main/0
# assert.metric.semantic.activations: 18
# assert.metric.semantic.executables: 18
# assert.metric.semantic.callsites: 25
# oracle: self
# oracle.stamp: 3d1b8045ea57187e
#---
defmodule Main do
  def number(x), do: {:number, x}
  def text(x), do: {:text, x}
  def tagged(x), do: {:tagged, x}

  def kind(x) when is_integer(x) or is_float(x), do: number(x)
  def kind(x) when is_binary(x) or is_atom(x), do: text(x)
  def kind(x) when is_tuple(x) and tuple_size(x) == 2 or is_list(x), do: tagged(x)
  def kind(_), do: :other

  def main() do
    IO.inspect(kind(1))
    IO.inspect(kind(2.5))
    IO.inspect(kind("s"))
    IO.inspect(kind(:a))
    IO.inspect(kind({1, 2}))
    IO.inspect(kind([1]))
    IO.inspect(kind({1, 2, 3}))
    IO.inspect(kind(%{}))
  end
end

Main.main()
