#---
# purpose: "a rescued FunctionClauseError, CondClauseError and BadBooleanError each carry Elixir's fields and word Elixir's message from them"
# oracle: self
# oracle.stamp: 5e9d1029f0badf28
#---
defmodule Shapes do
  def only_one(1), do: :one
end

defmodule Main do
  defp two(), do: 2

  defp word(), do: :maybe

  def main() do
    try do
      Shapes.only_one(two())
    rescue
      e in FunctionClauseError ->
        IO.inspect({e.module, e.function, e.arity})
        IO.inspect(Exception.message(e))
    end
    try do
      cond do
        two() == 1 -> :one
      end
    rescue
      e in CondClauseError -> IO.inspect(Exception.message(e))
    end
    try do
      word() and true
    rescue
      e in BadBooleanError ->
        IO.inspect({e.term, e.operator})
        IO.inspect(Exception.message(e))
    end
  end
end

Main.main()
