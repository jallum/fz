#---
# purpose: "A recursion that wraps its argument in a one-key map on every call compiles: the repeated map folds where it grew"
# root: main/0
# assert.metric.type.clash_folded: 1
# oracle: self
# oracle.stamp: 91cd88fe7be3a1cb
#---
defmodule Wrap do
  def m(acc, 0), do: acc
  def m(acc, n), do: m(%{k: acc}, n - 1)
end

defmodule Main do
  def main() do
    IO.inspect(Wrap.m(1, 3))
  end
end

Main.main()
