#---
# purpose: "Elixir-style keyword lists lower to ordinary lists of atom/value tuples"
#---
def echo(opts), do: opts
def echo(opts, more), do: opts ++ more

def main() do
  [a: 1, b: 2] == [{:a, 1}, {:b, 2}] || raise("keyword list lowers to a list of atom/value tuples")
  echo(timeout: 10, retry: true) == [{:timeout, 10}, {:retry, true}] || raise("trailing keyword args collect into a keyword list")
  with_do = echo(label: :work) do
    42
  end
  with_do == [{:label, :work}, {:do, 42}] || raise("a trailing do-block after a paren call with keyword args appends a second keyword-list argument (Elixir never merges do: into a preceding keyword-list arg)")
end
