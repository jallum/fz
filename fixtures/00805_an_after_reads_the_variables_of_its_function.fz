#---
# purpose: "an after block uses what is in scope at the try, on the completing path and on the raising path"
# oracle: self
# oracle.stamp: 3901c22caf97cd9e
#---
defmodule Main do
  def attempt(label, f) do
    try do
      f.()
    rescue
      _ -> :rescued
    after
      IO.inspect({:after, label})
    end
  end

  def main() do
    IO.inspect(attempt(:one, fn () -> :fine end))
    IO.inspect(attempt(:two, fn () -> raise "x" end))
  end
end

Main.main()
