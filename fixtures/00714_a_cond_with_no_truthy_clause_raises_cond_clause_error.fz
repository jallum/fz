#---
# purpose: "a cond none of whose conditions is truthy raises CondClauseError"
# expect: abort
# oracle: self
# oracle.stamp: 7b9c998aab15eefd
#---
defmodule Main do
  defp two(), do: 2

  def main() do
    x = two()
    result = cond do
      x == 1 -> :one
      x > 5 -> :many
    end
    IO.inspect(result)
  end
end

Main.main()
