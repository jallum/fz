#---
# purpose: "List.to_tuple/1 builds a tuple as wide as its list, and Enum.zip/1 zips any number of enumerables into tuples of that width, as in Elixir"
# oracle: self
# oracle.stamp: d9b169ab68450148
#---
defmodule Main do
  # A value that has been through the mailbox has no type the compiler can
  # prove, so a bad argument reaches the runtime check.
  def unknown(term) do
    send(self(), term)

    receive do
      received -> received
    end
  end

  def rescued(thunk) do
    try do
      thunk.()
    rescue
      e -> e.__struct__
    end
  end

  def sum3(list) do
    case List.to_tuple(list) do
      {a, b, c} -> a + b + c
    end
  end

  def main() do
    IO.inspect(List.to_tuple([]))
    IO.inspect(List.to_tuple([1, 2]))
    IO.inspect(List.to_tuple([1, 2, 3, 4, 5]))
    IO.inspect(List.to_tuple([1, :a, "b", 2.5, [1, 2], {3}, nil]))

    wide = List.to_tuple(Enum.to_list(1..40))
    IO.inspect({tuple_size(wide), elem(wide, 0), elem(wide, 39)})
    IO.inspect(elem(put_elem(wide, 0, :z), 0))
    IO.inspect(tuple_size(put_elem(wide, 39, :z)))

    IO.inspect(List.to_tuple([1, 2]) == {1, 2})
    IO.inspect(List.to_tuple([1, 2]) == {1, 3})
    IO.inspect(sum3([10, 20, 30]))
    IO.inspect(Tuple.to_list(List.to_tuple([7, 8, 9])))
    IO.inspect(Enum.map(1..4, fn n -> tuple_size(List.to_tuple(Enum.to_list(1..n))) end))

    IO.inspect(rescued(fn -> :erlang.list_to_tuple(unknown([1 | 2])) end))
    IO.inspect(rescued(fn -> :erlang.list_to_tuple(unknown(:a)) end))

    IO.inspect(Enum.zip([1..3, [4, 5, 6], [7, 8, 9]]))
    IO.inspect(Enum.zip([[1, 2, 3], [4]]))
    IO.inspect(Enum.zip([]))
    IO.inspect(Enum.zip([[1, 2]]))
    IO.inspect(Enum.zip([[1, 2], [], [3]]))
    IO.inspect(Enum.zip([[1, 2], [3, 4], [5, 6], [7, 8], [9, 0]]))
  end
end

Main.main()
