#---
# purpose: "source-level tuple-tree traversal allocation baseline"
#---
#
# # tree
#
# Pins a tuple-shaped tree traversal using ordinary source functions and tuple
# patterns:
#
# ```fz
# def inc_tree(:empty), do: :empty
# def inc_tree({:node, left, value, right}), do: {:node, inc_tree(left), value + 1, inc_tree(right)}
# ```
#
# The input tree has three `{:node, left, value, right}` tuples. Native JIT/AOT
# currently fold the literal input tree into the traversal and allocate only the
# three rebuilt output nodes. The interpreter/REPL direct IR path now follows the
# same scalar-box-free shape for this literal input. No list or map allocations
# are needed in either path, and no closures are built beyond
# the two closures the scheduler builds to start the program (`closure_allocs = 2`,
# `closure_bytes = 64` on the native paths, 0 on the interpreter).
def inc_tree(:empty), do: :empty
def inc_tree({:node, left, value, right}), do: {:node, inc_tree(left), value + 1, inc_tree(right)}

def main() do
  tree = {:node, {:node, :empty, 1, :empty}, 2, {:node, :empty, 3, :empty}}
  out = inc_tree(tree)
  dbg(out)

  stats = System.alloc_stats()
  dbg(%{list_cons_allocs: stats[:list_cons_allocs], list_cons_bytes: stats[:list_cons_bytes], struct_allocs: stats[:struct_allocs], struct_bytes: stats[:struct_bytes], closure_allocs: stats[:closure_allocs], closure_bytes: stats[:closure_bytes], map_allocs: stats[:map_allocs], map_bytes: stats[:map_bytes]})
  heap_bytes = stats[:list_cons_bytes] + stats[:struct_bytes] + stats[:map_bytes]
  dbg(heap_bytes)
end
