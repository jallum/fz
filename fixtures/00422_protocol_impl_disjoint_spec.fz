#---
# purpose: an impl's @spec is not checked against its protocol's @spec; a returned atom against the protocol's declared integer return is accepted
#---
defprotocol P do
  @spec to_thing(t(a)) :: integer
  def to_thing(value)
end

defimpl P, for: List do
  @spec to_thing(list(integer)) :: atom
  def to_thing(value), do: :ok
end

def main(), do: P.to_thing([1])
