#---
# purpose: "@moduledoc / @doc attributes parse and the module still executes"
#---
defmodule Greeter do
  @moduledoc "Hand-rolled greeter for the v1 demo."

  @doc "Returns a friendly greeting for the given name atom."
  def hi(name), do: name

  @doc "Echoes its argument back."
  def echo(x), do: x
end

def main() do
  Greeter.hi(:alice) == :alice || raise("module with @moduledoc/@doc still executes")
  Greeter.echo(42) == 42 || raise("second documented function executes")
  Greeter.__info__(:functions) == [{:hi, 1}, {:echo, 1}] || raise("@doc/@moduledoc do not disturb the exports")
end
