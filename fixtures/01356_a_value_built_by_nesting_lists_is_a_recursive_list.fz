#---
# purpose: "A value built by wrapping an accumulator in a list is the recursive type μA. int | [A]"
# root: main/0
# oracle: self
# oracle.stamp: 466e573a56cd293b
#---
defmodule Nest do
  def wrap(0, acc), do: acc
  def wrap(n, acc), do: wrap(n - 1, [acc])
end

defmodule Main do
  def main() do
    IO.inspect(Nest.wrap(3, 1))
  end
end

Main.main()
