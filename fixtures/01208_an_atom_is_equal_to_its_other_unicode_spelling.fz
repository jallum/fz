#---
# purpose: an unquoted atom spelled with a combining accent equals the atom spelled with the composed letter, while the quoted atoms stay distinct
# oracle: self
# oracle.stamp: a16bd9fe55e8933c
#---
defmodule Main do
  def main() do
    IO.inspect({:café == :café, :"café" == :"café"})
  end
end

Main.main()
