#---
# purpose: "==, !=, ===, !==, <, <=, > and >= over binaries answer what Elixir answers, in a function body and in a guard, in a receive guard, for equal binaries, same-length and different-length ones, a prefix against what it begins in both directions, the same object, an empty binary, a long binary against a copy built at run time, a view against a literal, bitstrings that are not whole bytes, and a binary against an integer, an atom and a list; the rows run once over values of unknown type and once over values the compiler knows are binaries or bitstrings"
# oracle: self
# oracle.stamp: 57fd9ff7e7d7461d
# args: 0
#---
defmodule Main do
  # Values read from a list at a position known only at run time, so the
  # compiler cannot prove their types. The list mixes kinds on purpose.
  def v(k) do
    base = String.to_integer(hd(System.argv()))
    Enum.at(values(), base + k)
  end

  # The same, over lists whose elements are all binaries, or all bitstrings.
  def b(k) do
    base = String.to_integer(hd(System.argv()))
    Enum.at(binaries(), base + k)
  end

  def s(k) do
    base = String.to_integer(hd(System.argv()))
    Enum.at(bitstrings(), base + k)
  end

  def long_built(), do: String.duplicate("0123456789", 10)

  def long_copy() do
    Enum.reduce(1..10, "", fn _, acc -> acc <> "0123456789" end)
  end

  def view_of_long(start), do: :erlang.binary_part(long_built(), start, 10)

  def values() do
    [
      "hello",
      "hello",
      "hellp",
      "hell",
      "",
      "",
      long_built(),
      long_copy(),
      <<1::3>>,
      <<1::3>>,
      <<2::3>>,
      <<1::4>>,
      42,
      :hello,
      [104, 101, 108, 108, 111],
      "0123456789",
      view_of_long(10),
      view_of_long(30),
      <<0, 1::3>>,
      "ab",
      "abc"
    ]
  end

  def binaries() do
    [
      "hello",
      "hello",
      "hellp",
      "hell",
      "",
      "",
      long_built(),
      long_copy(),
      "0123456789",
      view_of_long(10),
      view_of_long(30),
      "ab",
      "abc"
    ]
  end

  def bitstrings() do
    [<<1::3>>, <<1::3>>, <<2::3>>, <<1::4>>, <<0, 1::3>>, <<0, 1::3>>, <<1::5>>, <<1::4, 1::1>>]
  end

  # One clause per operator, each asking it in a guard; the last clause takes
  # the pair when the guard fails.
  def guarded(:eq, x, y) when x == y, do: true
  def guarded(:neq, x, y) when x != y, do: true
  def guarded(:identical, x, y) when x === y, do: true
  def guarded(:not_identical, x, y) when x !== y, do: true
  def guarded(:lt, x, y) when x < y, do: true
  def guarded(:lte, x, y) when x <= y, do: true
  def guarded(:gt, x, y) when x > y, do: true
  def guarded(:gte, x, y) when x >= y, do: true
  def guarded(_, _, _), do: false

  # The pair is delivered to the process itself and tested in the receive
  # guard; the last clause takes the message when the guard fails.
  def received(op, x, y) do
    send(self(), {op, x, y})

    receive do
      {:eq, p, q} when p == q -> true
      {:neq, p, q} when p != q -> true
      {:identical, p, q} when p === q -> true
      {:not_identical, p, q} when p !== q -> true
      {:lt, p, q} when p < q -> true
      {:lte, p, q} when p <= q -> true
      {:gt, p, q} when p > q -> true
      {:gte, p, q} when p >= q -> true
      _other -> false
    end
  end

  # The eight answers as a word, one letter each, in the order
  # == != === !== < <= > >=.
  def flags(answers), do: Enum.map_join(Tuple.to_list(answers), fn a -> if a, do: "T", else: "F" end)

  def in_body(x, y), do: flags({x == y, x != y, x === y, x !== y, x < y, x <= y, x > y, x >= y})
  def in_guards(x, y), do: flags({guarded(:eq, x, y), guarded(:neq, x, y), guarded(:identical, x, y), guarded(:not_identical, x, y), guarded(:lt, x, y), guarded(:lte, x, y), guarded(:gt, x, y), guarded(:gte, x, y)})
  def in_receive(x, y), do: flags({received(:eq, x, y), received(:neq, x, y), received(:identical, x, y), received(:not_identical, x, y), received(:lt, x, y), received(:lte, x, y), received(:gt, x, y), received(:gte, x, y)})

  def report(group, label, x, y) do
    IO.inspect({group, label, :body, in_body(x, y)})
    IO.inspect({group, label, :guards, in_guards(x, y)})
    IO.inspect({group, label, :receive, in_receive(x, y)})
  end

  def mixed_rows() do
    [
      {:equal_literals, 0, 1},
      {:same_length_different, 0, 2},
      {:shorter, 0, 3},
      {:same_object, 0, 0},
      {:empty_equal, 4, 5},
      {:empty_and_text, 4, 0},
      {:long_and_copy, 6, 7},
      {:long_and_text, 6, 0},
      {:bits_equal, 8, 9},
      {:bits_different, 8, 10},
      {:bits_length, 8, 11},
      {:bits_and_binary, 8, 0},
      {:binary_and_integer, 0, 12},
      {:binary_and_atom, 0, 13},
      {:binary_and_list, 0, 14},
      {:view_and_literal, 16, 15},
      {:two_views, 16, 17},
      {:view_and_long, 16, 6},
      {:bits_with_a_byte, 18, 18},
      {:text_and_empty, 0, 4},
      {:later_byte_greater, 2, 0},
      {:later_byte_smaller, 0, 2},
      {:shorter_after, 3, 0},
      {:prefix, 19, 20},
      {:prefix_reversed, 20, 19},
      {:bits_prefix, 8, 11},
      {:bits_prefix_reversed, 11, 8},
      {:bits_and_whole_byte, 8, 18},
      {:whole_byte_and_bits, 18, 8},
      {:integer_and_binary, 12, 0},
      {:binary_and_integer_first, 0, 12},
      {:atom_and_binary, 13, 0},
      {:list_and_binary, 14, 0},
      {:binary_and_list_first, 0, 14}
    ]
  end

  def binary_rows() do
    [
      {:equal_literals, 0, 1},
      {:same_length_different, 0, 2},
      {:shorter, 0, 3},
      {:same_object, 0, 0},
      {:empty_equal, 4, 5},
      {:empty_and_text, 4, 0},
      {:long_and_copy, 6, 7},
      {:long_and_text, 6, 0},
      {:view_and_literal, 9, 8},
      {:two_views, 9, 10},
      {:view_and_long, 9, 6},
      {:text_and_empty, 0, 4},
      {:later_byte_greater, 2, 0},
      {:later_byte_smaller, 0, 2},
      {:shorter_after, 3, 0},
      {:long_after_view, 6, 9},
      {:prefix, 11, 12},
      {:prefix_reversed, 12, 11}
    ]
  end

  def bitstring_rows() do
    [
      {:bits_equal, 0, 1},
      {:bits_different, 0, 2},
      {:bits_length, 0, 3},
      {:bits_with_a_byte, 4, 5},
      {:bits_and_shorter, 0, 4},
      {:bits_and_longer, 4, 0},
      {:bits_prefix, 0, 3},
      {:bits_prefix_reversed, 3, 0},
      {:bits_five_and_three, 6, 0},
      {:bits_four_and_five, 3, 6},
      {:bits_split, 3, 7},
      {:bits_split_reversed, 7, 3}
    ]
  end

  def main() do
    Enum.each(mixed_rows(), fn {label, i, j} -> report(:mixed, label, v(i), v(j)) end)
    Enum.each(binary_rows(), fn {label, i, j} -> report(:binary, label, b(i), b(j)) end)
    Enum.each(bitstring_rows(), fn {label, i, j} -> report(:bitstring, label, s(i), s(j)) end)
  end
end

Main.main()
