#---
# purpose: "=== and !== in a function-head guard and in a receive guard answer as Elixir does over an integer, a float, an atom and a list, and a negative zero is not the same value as zero"
# oracle: oracle.exs
#---
#
# `===` is identity: `1 === 1.0` is false where `1 == 1.0` is true. `:a` means
# the guard held and `:b` means it did not.
def same_as_one(n) when n === 1, do: :a
def same_as_one(_), do: :b

def differs_from_one(n) when n !== 1, do: :a
def differs_from_one(_), do: :b

def same_as_float(n) when n === 1.0, do: :a
def same_as_float(_), do: :b

def same_as_zero(n) when n === 0.0, do: :a
def same_as_zero(_), do: :b

def same_as_atom(n) when n === :x, do: :a
def same_as_atom(_), do: :b

def pair_same(a, b) when a === b, do: :a
def pair_same(_, _), do: :b

def pair_differs(a, b) when a !== b, do: :a
def pair_differs(_, _), do: :b

def receive_same(m) do
  send(self(), m)
  receive do
    n when n === 1 -> :a
    _ -> :b
  end
end

def receive_differs(m) do
  send(self(), m)
  receive do
    n when n !== 1 -> :a
    _ -> :b
  end
end

def receive_pair(m, k) do
  send(self(), m)
  receive do
    n when n === k -> :a
    _ -> :b
  end
end

def receive_float(m) do
  send(self(), m)
  receive do
    n when n === 1.0 -> :a
    _ -> :b
  end
end

def main() do
  dbg([same_as_one(1), same_as_one(1.0), same_as_one(:x), same_as_one([1])])
  dbg([differs_from_one(1), differs_from_one(1.0), differs_from_one(:x), differs_from_one([1])])
  dbg([same_as_float(1), same_as_float(1.0), same_as_float(:x)])
  dbg([same_as_zero(0.0), same_as_zero(-0.0), same_as_zero(0)])
  dbg([same_as_atom(:x), same_as_atom(:y), same_as_atom(1)])
  dbg([pair_same(1, 1), pair_same(1, 1.0), pair_same(:x, :x), pair_same([1, 2], [1, 2]), pair_same([1, 2], [1.0, 2])])
  dbg([pair_differs(1, 1), pair_differs(1, 1.0), pair_differs([1, 2], [1, 2]), pair_differs([1, 2], [1.0, 2])])
  dbg([receive_same(1), receive_same(1.0), receive_same(:x)])
  dbg([receive_differs(1), receive_differs(1.0), receive_differs(:x)])
  dbg([receive_pair([1, 2], [1, 2]), receive_pair([1, 2], [1.0, 2]), receive_pair(1, 1.0), receive_pair(:x, :x)])
  dbg([receive_float(1.0), receive_float(1), receive_float(:x)])
end
