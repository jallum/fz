#---
# purpose: "inner module addressed both fully-qualified (`Outer.Inner.f`) and via outer-local reference"
#---
defmodule Outer do
  def f(x), do: x

  defmodule Inner do
    def f(x), do: x + 1000
  end

  def use_inner(x), do: Inner.f(x)
end

def main() do
  Outer.f(7) == 7 || raise("outer-local f")
  Outer.Inner.f(7) == 1007 || raise("fully-qualified inner f")
  Outer.use_inner(7) == 1007 || raise("outer reaches inner via local reference")
  Outer.Inner.__info__(:functions) == [{:f, 1}] || raise("inner module exports f/1")
  Outer.__info__(:functions) == [{:f, 1}, {:use_inner, 1}] || raise("outer exports its own fns, not the nested module")
end
