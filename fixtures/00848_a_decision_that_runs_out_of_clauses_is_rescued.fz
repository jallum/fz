#---
# purpose: "a decision that runs out of clauses raises its Elixir exception, and a rescue around it catches it like any raise and lets the program continue"
# oracle: self
# oracle.stamp: 72c6fff504758320
#---
defmodule Shapes do
  def sides(:triangle), do: 3
  def sides(:square), do: 4
end

defmodule Main do
  defp two(), do: 2

  defp pair(), do: {1, 2}

  defp bad(), do: {:bad, 1}

  def main() do
    try do
      case two() do
        1 -> :one
        3 -> :three
      end
    rescue
      e in [CaseClauseError, MatchError, FunctionClauseError, CondClauseError, WithClauseError] -> IO.inspect(e.__struct__)
    end
    IO.inspect(:after_case)
    try do
      {a} = pair()
      IO.inspect(a)
    rescue
      e in [CaseClauseError, MatchError, FunctionClauseError, CondClauseError, WithClauseError] -> IO.inspect(e.__struct__)
    end
    IO.inspect(:after_match)
    try do
      IO.inspect(Shapes.sides(:circle))
    rescue
      e in [CaseClauseError, MatchError, FunctionClauseError, CondClauseError, WithClauseError] -> IO.inspect(e.__struct__)
    end
    IO.inspect(:after_function)
    try do
      x = two()
      cond do
        x == 1 -> :one
        x > 5 -> :many
      end
    rescue
      e in [CaseClauseError, MatchError, FunctionClauseError, CondClauseError, WithClauseError] -> IO.inspect(e.__struct__)
    end
    IO.inspect(:after_cond)
    try do
      with {:ok, v} <- bad() do
        v
      else
        :error -> :e
      end
    rescue
      e in [CaseClauseError, MatchError, FunctionClauseError, CondClauseError, WithClauseError] -> IO.inspect(e.__struct__)
    end
    IO.inspect(:after_with)
  end
end

Main.main()
