#---
# purpose: "A union argument that overlaps a function's @spec domain is accepted, and the call answers when the member inside the domain arrives"
# kind: run
# oracle: self
# oracle.stamp: 41c7fff27a2a1b74
#---
defmodule M do
  @spec f(integer) :: integer
  def f(x) when is_integer(x), do: x + 1
end

defmodule Main do
  def main() do
    [v | _] = [1, "x"]
    IO.inspect(M.f(v))
  end
end

Main.main()
