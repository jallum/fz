#---
# purpose: "a child's 1ms timeout and its parent's 2ms timeout are pending together; messages order what each prints, so the parent outlives the child however the machine is loaded"
# oracle: 00691_a_child_and_its_parent_both_time_out_in_order.oracle.exs
# oracle.stamp: 82fa4037407825e0
#---
def main() do
  parent = self()
  spawn(fn () ->
    receive do
      :never -> :ok
    after
      1 ->
        dbg(:child_timeout)
        send(parent, :child_done)
    end
  end)
  timed_out = receive do
    :never -> false
  after
    2 -> true
  end
  receive do
    :child_done -> dbg(:joined)
  end
  dbg({:main_timeout, timed_out})
end
