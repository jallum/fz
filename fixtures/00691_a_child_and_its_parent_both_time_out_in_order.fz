#---
# purpose: "a child's 1ms timeout and its parent's 2ms timeout are pending together; messages order what each prints, so the parent outlives the child however the machine is loaded"
# oracle: self
# oracle.stamp: 461d4bcd19db6239
#---
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () ->
      receive do
        :never -> :ok
      after
        1 ->
          IO.inspect(:child_timeout)
          send(parent, :child_done)
      end
    end)
    timed_out = receive do
      :never -> false
    after
      2 -> true
    end
    receive do
      :child_done -> IO.inspect(:joined)
    end
    IO.inspect({:main_timeout, timed_out})
  end
end

Main.main()
