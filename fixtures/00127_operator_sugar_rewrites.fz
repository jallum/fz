#---
# purpose: ++, --, and <> desugar to stdlib calls that compute the expected value; .. and .../2 parse and lower as ranges
#---
def main() do
  [1] ++ [2] == [1, 2] || raise("++ desugars to a list concat call")
  [1, 2, 1] -- [1] == [2, 1] || raise("-- desugars to a list subtract call")
  "a" <> "b" == "ab" || raise("<> desugars to a string concat call")
  _ = 1..3
  _ = 1..3//2
end
