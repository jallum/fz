#---
# purpose: ++, --, and <> desugar to stdlib calls that compute the expected value; .. and .../2 parse and lower as ranges
#---
def main() do
  assert([1] ++ [2] == [1, 2], "++ desugars to a list concat call")
  assert([1, 2, 1] -- [1] == [2, 1], "-- desugars to a list subtract call")
  assert("a" <> "b" == "ab", "<> desugars to a string concat call")
  _ = 1..3
  _ = 1..3//2
end
