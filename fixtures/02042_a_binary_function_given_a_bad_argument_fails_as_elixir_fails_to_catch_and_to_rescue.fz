#---
# purpose: "A function of :binary or a binary_part that checks its arguments fails with `:badarg` for `catch` and an `ArgumentError` worded for each bad argument for `rescue`, as Elixir does on all three paths"
# oracle: self
# oracle.stamp: f06abac6d89bf70b
#---
defmodule Main do
  # `x`, typed as one of the kinds of value a call may be given, so the call
  # is made and fails at run time rather than being refused when compiled.
  def v(x), do: Enum.at([x, 1, 1.5, "s", <<1::3>>, [1], {1}, %{}, self()], 0)

  def caught(fun) do
    try do
      fun.()
    catch
      kind, reason -> {kind, reason}
    end
  end

  def rescued(fun) do
    try do
      fun.()
    rescue
      e -> inspect(e.__struct__) <> ": " <> Exception.message(e)
    end
  end

  def show(label, fun) do
    IO.puts(label)
    IO.inspect(caught(fun))
    IO.puts(rescued(fun))
  end

  def main() do
    show("binary_part of a non-binary", fn -> :erlang.binary_part(v(1), 2, 3) end)
    show("binary_part past the end", fn -> :erlang.binary_part("abc", v(4), 1) end)
    show("binary_part too long", fn -> :erlang.binary_part("abc", v(1), 5) end)
    show("binary_part before the start", fn -> :erlang.binary_part("abc", v(-1), 5) end)
    show("binary_part of non-integers", fn -> :erlang.binary_part("abc", v(:a), v(:b)) end)
    show("binary_part of a non-binary and a negative start", fn -> :erlang.binary_part(v(1), v(-1), 5) end)
    show("at past the end", fn -> :binary.at("abc", v(5)) end)
    show("at a non-binary", fn -> :binary.at(v(1), 1) end)
    show("at a negative position", fn -> :binary.at("abc", v(-1)) end)
    show("copy of a non-binary", fn -> :binary.copy(v(1), 1) end)
    show("copy a negative count", fn -> :binary.copy("a", v(-1)) end)
    show("copy of a non-binary a non-integer count", fn -> :binary.copy(v(1), v(:a)) end)
    show("copy of a bitstring", fn -> :binary.copy(v(<<1::3>>), 1) end)
    show("referenced_byte_size of a non-bitstring", fn -> :binary.referenced_byte_size(v(1)) end)
    show("match with an empty pattern", fn -> :binary.match("abc", v([])) end)
    show("compile_pattern of an empty pattern", fn -> :binary.compile_pattern(v([])) end)
  end
end

Main.main()
