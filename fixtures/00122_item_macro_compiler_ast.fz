#---
# purpose: an item-level macro that returns a compiler-shaped fn AST splices a callable function definition
#---
defmacro make_const(name, value) do
  {:def, %{}, [{name, %{}, []}, [{:do, value}]]}
end

make_const(:answer, 42)

def main() do
  assert(answer() == 42, "make_const spliced a callable answer/0")
end
