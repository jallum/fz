#---
# purpose: "A guard `not (is_integer(x) and x > 0)` has a comparison no region can state the complement of, so it stays one guard; a value that raises in the comparison fails the whole guard, as in Elixir"
# kind: run
# root: main/0
# assert.metric.semantic.activations: 6
# assert.metric.semantic.executables: 6
# assert.metric.semantic.callsites: 13
# assert.metric.call_edges.count: 13
# oracle: self
# oracle.stamp: 748f064fc1b6f186
#---
defmodule Main do
  def check(x) when not (is_integer(x) and x > 0), do: {:not_positive, x}
  def check(x), do: {:positive, x}

  def main() do
    IO.inspect(check(1))
    IO.inspect(check(0))
    IO.inspect(check(-5))
    IO.inspect(check(:a))
    IO.inspect(check("s"))
    IO.inspect(check(2.5))
  end
end

Main.main()
