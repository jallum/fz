#---
# purpose: "a program selects on the shape of System.argv() with a case, taking its one path argument or falling through, as in Elixir"
# args: trace.jsonl
# oracle: self
# oracle.stamp: 30edb7a6bd2138c7
#---
defmodule Main do
  def describe(argv) do
    case argv do
      [path] -> {:path, path}
      [] -> :none
      _ -> :too_many
    end
  end

  def main() do
    IO.inspect(describe(System.argv()))
    IO.inspect(describe([]))
    IO.inspect(describe(["a", "b"]))
  end
end

Main.main()
