#---
# purpose: "A receive guard that calls a defguardp whose body is hd/1 takes a list with a matching head and leaves any other message unmatched, as Elixir's hd/1 does in a guard"
# oracle: self
# oracle.stamp: 84efbb28086fdde2
#---
#
# The atom `:no` and the empty list have no head, so the guard fails for them
# and the next clause takes them.
defmodule Main do
  defguardp first(l) when hd(l)

  def main() do
    send(self(), [3])
    send(self(), :no)
    send(self(), [])
    send(self(), [4])
    receive do
      l when first(l) == 3 -> IO.inspect(:a)
    end
    receive do
      l when first(l) == 3 -> IO.inspect(:a)
      _ -> IO.inspect(:b)
    end
    receive do
      l when first(l) == 3 -> IO.inspect(:a)
      _ -> IO.inspect(:b)
    end
    receive do
      l when first(l) == 3 -> IO.inspect(:a)
      _ -> IO.inspect(:b)
    end
  end
end

Main.main()
