#---
# purpose: a macro's quoted call inside its home module resolves against that module, not the module that requires it
#---
defmodule M do
  def helper(x), do: x + 100
  defmacro bump(x) do
quote do: helper(unquote(x))
  end
end
defmodule User do
  require M
  def run(), do: M.bump(7)
end
def main() do
  result = User.run()
  assert(result == 107, "M.bump(7) expands to M's own helper(7), 7 + 100 == 107")
  result
end
