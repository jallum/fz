#---
# purpose: "a child that sends after its own timer wakes a parent waiting on a much longer timeout, so :timeout never prints"
# oracle: self
# oracle.stamp: a868e567ccdab16d
#---
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () ->
      receive do
        :never -> :ok
      after
        1 -> send(parent, :late)
      end
    end)
    receive do
      :late -> IO.inspect(:late)
    after
      60000 -> IO.inspect(:timeout)
    end
    IO.inspect(:end)
  end
end

Main.main()
