#---
# purpose: "a guard that takes a remainder by zero does not match its clause, in an entry guard and in a receive guard, and a remainder by a nonzero divisor still decides"
# oracle: oracle.exs
#---
#
# `rem(n, 0)` fails in a body by raising. In a guard a failure is the clause
# not matching, so the next clause answers. `:a` means the guard held and `:b`
# means it did not.
def entry_by_zero(n) when rem(n, 0) == 1, do: :a
def entry_by_zero(_), do: :b

def entry_by_two(n) when rem(n, 2) == 1, do: :a
def entry_by_two(_), do: :b

def receive_by_zero(m) do
  send(self(), m)
  receive do
    n when rem(n, 0) == 1 -> :a
    _ -> :b
  end
end

def receive_by_two(m) do
  send(self(), m)
  receive do
    n when rem(n, 2) == 1 -> :a
    _ -> :b
  end
end

def main() do
  dbg([entry_by_zero(5), entry_by_two(5), receive_by_zero(5), receive_by_two(5)])
end
