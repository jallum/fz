#---
# purpose: "Three Enum.reduce calls that share one named reducer, each seeded with a deeper tuple, compile: each entry into the reduce cycle keeps its own chain of activations"
# root: main/0
# oracle: self
# oracle.stamp: f5d09386694dd956
#---
defmodule Pair do
  def push(x, acc), do: {x, acc}
end

defmodule Main do
  def main() do
    IO.inspect(Enum.reduce([1, 2, 3], :s, &Pair.push/2))
    IO.inspect(Enum.reduce([1, 2, 3], {9, :s}, &Pair.push/2))
    IO.inspect(Enum.reduce([4, 5], {9, {8, :s}}, &Pair.push/2))
  end
end

Main.main()
