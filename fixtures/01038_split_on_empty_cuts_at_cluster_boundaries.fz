#---
# purpose: "String.split(s, "") cuts at grapheme boundaries and keeps an empty binary at each end"
# oracle: self
# oracle.stamp: 5a018dd9aa8ad7a3
#---
defmodule Main do
  def main() do
    strings = ["abc", "é", "\r\n", "éx", "👨‍👩‍👧x", "🇫🇷🇫", "각x", "क्षx", "x́̂y"]
    Enum.each(strings, fn s -> IO.inspect(String.split(s, "")) end)
  end
end

Main.main()
