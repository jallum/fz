#---
# purpose: "A macro whose private helper builds a struct compiles when its module is first reached from inside a closure: the helper asks for the struct's schema while the program's own products are still being worked out, and waits its turn"
#---
#
# `mk` chooses its expansion by walking its argument with the recursive private
# `flag?`, which builds a `Tag` on its way. `Probe` is first reached from the closure `Lazy.a/1` passes to
# `Enum.map`, and the program then asks `Map.fetch!` for a key the map lacks,
# which loads `KeyError`'s library code in the same compile.
defmodule Tag do
  defstruct [:v]
end

defmodule M do
  defmacro mk(fields) do
    if flag?(fields) do
      quote do: defstruct([])
    else
      quote do: defstruct(unquote(fields))
    end
  end

  defp flag?([]), do: %Tag{v: false}.v
  defp flag?([:a | _]), do: true
  defp flag?([_ | rest]), do: flag?(rest)
end

defmodule Probe do
  import M
  mk [:a]
  def make(x), do: x
end

defmodule Lazy do
  def a(x), do: Enum.map(x, fn v -> Probe.make(v) end)
end

def main() do
  IO.inspect(Lazy.a([3, 1, 2]))

  try do
    Map.fetch!(%{a: 1}, :b)
  rescue
    _ in KeyError -> IO.puts("no :b")
  end
end
