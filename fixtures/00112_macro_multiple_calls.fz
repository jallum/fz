#---
# purpose: a macro called more than once inside one function body expands independently at each call site
#---
defmacro double(x) do
  quote do: unquote(x) * 2
end
def run() do
  a = double(10)
  b = double(20)
  a + b
end
def main() do
  assert(run() == 60, "double(10) + double(20) == 60")
end
