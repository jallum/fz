#---
# purpose: "a matching message that arrives before the timer cancels it, so :timeout never prints"
# oracle: self
# oracle.stamp: 034a3905a15ab156
#---
defmodule Main do
  def main() do
    parent = self()
    spawn(fn () -> send(parent, :hello) end)
    receive do
      :hello -> IO.inspect(:hello)
    after
      60000 -> IO.inspect(:timeout)
    end
    IO.inspect(:end)
  end
end

Main.main()
