  def wide_values() do
    [
      <<-1::64>>,
      <<-1::signed-64>>,
      <<255::8>>,
      <<256::8>>,
      <<-129::signed-8>>,
      <<0::64>>,
      <<9223372036854775807::64>>,
      <<-9223372036854775807::signed-64>>,
      <<1::size(2)-unit(4)>>,
      <<1::size(1)-unit(16)>>,
      <<65>>,
      <<65, 66, 67>>,
      <<>>
    ]
  end

  def floats() do
    [
      <<1.0::float-16, -2.5::float-16, 0.1::float-16, 65504.0::float-16>>,
      <<65520.0::float-16, 1.0e10::float-16, 6.0e-8::float-16, 6.1e-5::float-16, 1.0e-8::float-16>>,
      <<1.0::float-16-little, -2.5::float-16-native>>,
      <<1.0::float-32, -2.5::float-32, 0.1::float-32, 3.0e38::float-32, 1.0e300::float-32>>,
