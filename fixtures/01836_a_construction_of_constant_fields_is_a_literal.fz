#---
# purpose: "a construction whose fields are all constants is the literal binary Elixir spells, and a run of constant fields inside a construction is written as one literal: every field kind (integers of every width from 1 to 64 in each byte order, signed, floats of 16, 32 and 64 bits, utf8, utf16 and utf32, binary and bits literals), totals that end mid-byte, constant runs that start or end mid-byte, runs beside runtime sizes and binaries, chains of <> over literals, and constants Elixir refuses, which still raise when the construction runs"
# oracle: self
# oracle.stamp: e1474964def9b498
# args: 0
#---
defmodule Main do
  # Values the compiler cannot see through: each is read from a list at a
  # position that is known only at run time.
  def v(list, k), do: Enum.at(list, String.to_integer(hd(System.argv())) + k)

  def show(value), do: IO.puts(inspect(value, limit: :infinity))

  def failure(thunk) do
    try do
      {:ok, thunk.()}
    rescue
      e -> {e.__struct__, Exception.message(e)}
    end
  end

