  end

  def utfs() do
    [
      <<0::utf8, 0x41::utf8, 0x7F::utf8, 0x80::utf8, 0xE9::utf8, 0x7FF::utf8, 0x800::utf8>>,
      <<0x20AC::utf8, 0xD7FF::utf8, 0xE000::utf8, 0xFFFF::utf8, 0x10000::utf8, 0x1F600::utf8, 0x10FFFF::utf8>>,
      <<0::utf16, 0x41::utf16, 0xD7FF::utf16, 0xE000::utf16, 0xFFFF::utf16, 0x10000::utf16, 0x10FFFF::utf16>>,
