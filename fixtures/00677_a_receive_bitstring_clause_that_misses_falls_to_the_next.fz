#---
# purpose: "a receive clause whose binary prefix does not match leaves the message for the next clause"
# oracle: self
# oracle.stamp: 7c962c696d96e578
#---
defmodule Main do
  def main() do
    send(self(), "xyz")
    receive do
      <<45, 45, r::binary>> -> IO.inspect({:dashes, r})
      other -> IO.inspect({:other, other})
    end
  end
end

Main.main()
