#---
# purpose: "a receive clause whose binary prefix does not match leaves the message for the next clause"
# oracle: 00677_a_receive_bitstring_clause_that_misses_falls_to_the_next.oracle.exs
#---
def main() do
  send(self(), "xyz")
  receive do
    <<45, 45, r::binary>> -> dbg({:dashes, r})
    other -> dbg({:other, other})
  end
end
