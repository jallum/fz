#---
# purpose: "when a matching message is already in the mailbox a receive with after 0 runs the clause and not the after body"
# oracle: 00684_a_receive_after_zero_takes_a_matching_message_already_waiting.oracle.exs
#---
def main() do
  send(self(), :here)
  v = receive do
    :here -> :got
  after 0 -> :after
  end
  dbg(v)
end
