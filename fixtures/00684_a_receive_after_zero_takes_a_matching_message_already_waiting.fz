#---
# purpose: "when a matching message is already in the mailbox a receive with after 0 runs the clause and not the after body"
# oracle: self
# oracle.stamp: 986cc507e24b94e8
#---
defmodule Main do
  def main() do
    send(self(), :here)
    v = receive do
      :here -> :got
    after 0 -> :after
    end
    IO.inspect(v)
  end
end

Main.main()
