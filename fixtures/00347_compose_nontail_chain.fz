#---
# purpose: chained non-tail closure calls compose correctly and return the right values
#---
def double(x), do: x * 2
def neg(x), do: 0 - x
def apply2(f, x), do: f.(x)
def compose(f, g, x), do: f.(g.(x))
def main() do
  apply2(double, 21) == 42 || raise("apply2 calls a passed fn")
  apply2(neg, 7) == -7 || raise("apply2 with neg")
  compose(double, neg, 5) == -10 || raise("compose chains two fns")
end
