#---
# purpose: a call that passes an inline closure is still checked against the @spec domain of its other argument, so a range where a list is declared is refused
# expect: diagnostic
# diagnostic.code: spec/violation
#---
defmodule Spec do
  @spec first_count([a], (a -> any)) :: integer when a: var
  def first_count(_items, _fun), do: 1
  @spec identity(integer) :: integer
  def identity(n), do: n
end
def main(), do: dbg(Spec.first_count(1..3, fn x -> x end))
