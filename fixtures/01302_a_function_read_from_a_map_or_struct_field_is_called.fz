#---
# purpose: "A function stored in a map or struct field is called when read back, directly or through a local"
# oracle: oracle.exs
# oracle.stamp: f7b6cb61a3300c97
#---
defmodule Sample do
  defstruct [:step]
end

def in_map(n), do: %{step: fn x -> x + n end}

def in_struct(n), do: %Sample{step: fn x -> x + n end}

def main() do
  m = in_map(1)
  dbg(m.step.(1000))
  s = in_struct(2)
  dbg(s.step.(1000))
  f = s.step
  dbg(f.(1000))
end
