#---
# purpose: "A function stored in a map or struct field is called when read back, directly or through a local"
# oracle: self
# oracle.stamp: a8fec6440340f150
#---
defmodule Sample do
  defstruct [:step]
end

defmodule Main do
  def in_map(n), do: %{step: fn x -> x + n end}

  def in_struct(n), do: %Sample{step: fn x -> x + n end}

  def main() do
    m = in_map(1)
    IO.inspect(m.step.(1000))
    s = in_struct(2)
    IO.inspect(s.step.(1000))
    f = s.step
    IO.inspect(f.(1000))
  end
end

Main.main()
