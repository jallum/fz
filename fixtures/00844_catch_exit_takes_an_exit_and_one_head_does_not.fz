#---
# purpose: "catch :exit, reason takes exit/1 and binds its reason; a one-head catch is for throws only, so an exit passes through it to the outer catch"
# oracle: self
# oracle.stamp: b1be1f9058c01e2b
#---
defmodule Main do
  def main() do
    IO.inspect(try do
      exit({:stopped, 3})
    catch
      :exit, reason -> reason
    end)
    IO.inspect(try do
      try do
        exit(:inner)
      catch
        thrown -> {:wrong, thrown}
      end
    catch
      :exit, reason -> {:outer, reason}
    end)
  end
end

Main.main()
