#---
# purpose: a string, a heredoc and a quoted atom accept \uHHHH and \u{H...} escapes, which stand for the code point's UTF-8 bytes
# oracle: self
# oracle.stamp: 09e4418ce561d4e0
#---
defmodule Main do
  def main() do
    four = "caf\u00e9"
    braced = "caf\u{e9}"
    IO.inspect({four, braced, four == braced, byte_size(four), String.length(four)})
    emoji = "\u{1F600}"
    IO.inspect({emoji, byte_size(emoji), String.length(emoji)})
    IO.inspect({"\u{0041}\u0042\u{43}", "a\u{10FFFF}b" == "a" <> <<244, 143, 191, 191>> <> "b"})
    IO.inspect(:"caf\u00e9" == :café)
    IO.inspect("""
    \u00e9 and \u{1F600}
    """)
    IO.inspect("e\u0301" == <<101, 204, 129>>)
  end
end

Main.main()
