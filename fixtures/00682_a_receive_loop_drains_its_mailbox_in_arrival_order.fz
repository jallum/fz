#---
# purpose: "a recursive loop of bare receives collects two self-sends and two children's messages in the order they arrived"
# oracle: self
# oracle.stamp: 6d6d23df2d268acf
#---
defmodule Main do
  def drain(0, acc) do
    acc
  end

  def drain(n, acc) do
    m = receive do
      x -> x
    end
    drain(n - 1, [m | acc])
  end

  def main() do
    me = self()
    spawn(fn () -> send(me, :c1) end)
    spawn(fn () -> send(me, :c2) end)
    send(me, :p1)
    send(me, :p2)
    IO.inspect(drain(4, []))
  end
end

Main.main()
