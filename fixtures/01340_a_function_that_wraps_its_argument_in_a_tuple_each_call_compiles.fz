#---
# purpose: "A recursion that wraps its argument in a tuple on every call compiles: the repeated tuple folds where it grew, and the budget never fires"
# root: main/0
# assert.metric.return_type.widened: 0
# assert.metric.type.clash_folded: 1
# oracle: self
# oracle.stamp: 6fb535d5ce71c771
#---
defmodule Wrap do
  def f(x, 0), do: x
  def f(x, n), do: f({x}, n - 1)
end

defmodule Main do
  def main() do
    IO.inspect(Wrap.f(1, 3))
  end
end

Main.main()
