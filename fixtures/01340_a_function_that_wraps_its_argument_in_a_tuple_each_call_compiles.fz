#---
# purpose: "A recursion that wraps its argument in a tuple on every call compiles: the repeated tuple folds where it grew"
# root: main/0
# assert.metric.type.clash_folded: 1
# oracle: self
# oracle.stamp: b68c4af4e9850863
#---
defmodule Wrap do
  def f(x, 0), do: x
  def f(x, n), do: f({x}, n - 1)
end

defmodule Main do
  def main() do
    IO.inspect(Wrap.f(1, 3))
  end
end

Main.main()
