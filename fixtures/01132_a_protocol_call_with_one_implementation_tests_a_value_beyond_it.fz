#---
# purpose: "Enum.join over integers and a tuple, and over a binary and a tuple, tests each element against the one implementation that overlaps its type, so the tuple raises Protocol.UndefinedError naming Tuple instead of entering code compiled for integers or binaries"
# oracle: 01132_a_protocol_call_with_one_implementation_tests_a_value_beyond_it.oracle.exs
# oracle.stamp: 71c0c3b427227092
#---
def join_ints_and_a_tuple() do
  try do
    Enum.join([1, {2, 3}], " ")
  rescue
    e -> e.message
  end
end

def join_binaries_and_a_tuple() do
  try do
    Enum.join(["x", {1, 2}], " ")
  rescue
    e -> e.message
  end
end

def main() do
  IO.puts(Enum.join([1, 2, 3], " "))
  IO.puts(Enum.join(["x", "y"], " "))
  IO.puts(join_ints_and_a_tuple())
  IO.puts(join_binaries_and_a_tuple())
end
