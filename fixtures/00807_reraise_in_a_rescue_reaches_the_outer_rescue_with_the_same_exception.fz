#---
# purpose: "reraise/2 inside a rescue raises the exception again, and the enclosing rescue receives the same exception"
# oracle: self
# oracle.stamp: 88cf34669a8b0ae5
#---
defmodule Main do
  def main() do
    result = try do
      try do
        raise ArgumentError, "original"
      rescue
        e in ArgumentError ->
          IO.inspect(:inner_saw)
          reraise e, []
      end
    rescue
      e in ArgumentError -> {:outer_saw, e.message}
    end
    IO.inspect(result)
  end
end

Main.main()
