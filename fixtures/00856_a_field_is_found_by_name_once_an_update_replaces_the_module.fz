#---
# purpose: "After %{s | __struct__: m} a field read answers the field's value and __struct__ answers the new module, with the base a known struct or behind any"
# oracle: self
# oracle.stamp: abc7e025782f41ed
#---
#
# A struct's module is what places its fields. Once an update replaces the
# module, the fields are found by name again, wherever the new module would
# have put them.
defmodule Near do
  defstruct [:x, :y]
end

defmodule Far do
  defstruct [:y, :x]
end

defmodule Main do
  def rename(v, m), do: %{v | __struct__: m}

  def main() do
    p = %Near{x: 1, y: 2}
    q = %{p | __struct__: Far}
    IO.inspect(q.x)
    IO.inspect(q.y)
    IO.inspect(q.__struct__)
    r = rename(p, Far)
    IO.inspect(r.x)
    IO.inspect(r.__struct__)
    s = %{p | __struct__: Near, y: 5}
    IO.inspect(s.x)
    IO.inspect(s.y)
    IO.inspect(s.__struct__)
    IO.inspect(p.x)
    IO.inspect(p.__struct__)
  end
end

Main.main()
