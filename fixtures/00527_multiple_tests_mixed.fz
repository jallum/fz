#---
# purpose: multiple test blocks run independently; one whose check raises aborts the fixture
# expect: abort
#---
# Source-surface coverage:
# This fixture declares the macro head as `[do: body]` specifically to prove
# compiler2 accepts the bracketed keyword-list head form, not just
# `do: body` sugar in macro parameters.
defmacro test(name_atom, [do: body]) do
  {:def, [], [{name_atom, [], []}, [{:do, body}]]}
end

test(:test_a) do
  true || raise("expected true")
end
test(:test_b) do
  :x == :x || raise("expected :x == :x")
end
test(:test_c) do
  1 == 2 || raise("expected 1 == 2")
end
