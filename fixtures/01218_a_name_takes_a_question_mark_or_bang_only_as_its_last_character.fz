#---
# purpose: a name, atom or keyword key may end in ? or !, a capitalised atom or key may too, and the name ends at that mark so a name written after it is a separate word
# oracle: self
# oracle.stamp: d14135c0f3f981d0
#---
defmodule Main do
  def big?(n), do: n > 10

  def save!(n), do: n + 1

  def second?(a, b), do: {a, b}

  def main() do
    IO.inspect({big?(11), save!(1)})
    value = 4
    IO.inspect(save! value)
    IO.inspect(second?(1, value))
    IO.inspect([ready?: 1, done!: 2, Loud?: 3, Hot!: 4])
    IO.inspect({:big?, :save!, :Loud?, :Hot!, :_?})
    IO.inspect(Atom.to_string(:a?))
    IO.inspect(big?(1) == false)
  end
end

Main.main()
