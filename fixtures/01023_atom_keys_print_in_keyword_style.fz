#---
# purpose: "A map whose keys are all non-alias atoms, and a list of such pairs, print as key: value, quoting the keys that need it"
# oracle: self
# oracle.stamp: 62a63381172a8e1c
#---
defmodule Main do
  def main() do
    IO.inspect(%{a: 1})
    IO.inspect(%{"foo bar": 1})
    IO.inspect(%{Foo => 1})
    IO.inspect(%{nil: 1})
    IO.inspect([a: 1])
    IO.inspect([a: 1, b: 2])
    IO.inspect(["foo bar": 1, b: 2])
    IO.inspect([{Foo, 1}])
    IO.inspect([{:a, 1}, {:b, 2}])
    IO.inspect([{:a, 1}, {1, 2}])
    IO.inspect([ok?: 1])
  end
end

Main.main()
