#---
# purpose: "a call no clause of an anonymous function matches raises FunctionClauseError naming the function it was defined in"
# expect: abort
# oracle: self
# oracle.stamp: 4dc5ac59222446fe
#---
defmodule Words do
  def name(n) do
    to_word = fn 1 -> :one end
    to_word.(n)
  end
end

defmodule Main do
  def main() do
    IO.inspect(Words.name(1))
    IO.inspect(Words.name(2))
  end
end

Main.main()
