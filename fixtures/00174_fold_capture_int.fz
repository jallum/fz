#---
# purpose: a threaded closure that captures a plain int still settles the fold to number
#---
def go(list, acc, f) do
  case list do
    [] -> acc
    [h | t] -> go(t, f.(h, acc), f)
    _ -> acc
  end
end

def myreduce(list, acc, n) do
  go(list, acc, fn (entry, inner) -> entry + inner + n end)
end

def main() do
  dbg(myreduce([1, 2, 3], 0, 5))
end
