#---
# purpose: "A body frame is not given back while later steps of its body still read it"
#---
#
# Twenty sequential calls hold every result in one body frame. Each callee
# builds a two-thousand-element list by non-tail recursion, so each step
# resumes with newer objects above the frame, and each step's resume must leave
# the frame whole: a step that gave it back would let the next allocation
# overwrite the results the later steps read. The sum reads them all.
def build(0), do: []
def build(n), do: [n | build(n - 1)]

def g(x), do: length(build(2000)) + x

def main() do
  a1 = g(1)
  a2 = g(2)
  a3 = g(3)
  a4 = g(4)
  a5 = g(5)
  a6 = g(6)
  a7 = g(7)
  a8 = g(8)
  a9 = g(9)
  a10 = g(10)
  a11 = g(11)
  a12 = g(12)
  a13 = g(13)
  a14 = g(14)
  a15 = g(15)
  a16 = g(16)
  a17 = g(17)
  a18 = g(18)
  a19 = g(19)
  a20 = g(20)
  IO.inspect(a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20)
end
