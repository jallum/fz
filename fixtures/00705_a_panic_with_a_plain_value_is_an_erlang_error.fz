#---
# purpose: "a raise of a value that is not an exception, `:erlang.error/1` (fz's `panic/1`), prints the way Elixir prints a raw Erlang error"
# expect: abort
# oracle: self
# oracle.stamp: 7d2f38bd1b67872e
#---
defmodule Main do
  def main() do
    :erlang.error({:stop, [1, 2]})
  end
end

Main.main()
