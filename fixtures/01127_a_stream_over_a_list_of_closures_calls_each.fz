#---
# purpose: "A stream mapped over a list of closures calls each closure element, so a closure crossing the stream's recursion keeps one carrier"
# kind: run
# oracle: self
# oracle.stamp: a74908ca9fa2afc8
#---
defmodule Main do
  def main() do
    IO.inspect(Enum.to_list(Stream.map([fn x -> x end], fn f -> f.(1) end)))
  end
end

Main.main()
