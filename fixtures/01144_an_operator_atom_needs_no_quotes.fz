#---
# purpose: "every operator Elixir lets follow a colon with no quotes is one atom, as a list element, a map key, an equality operand and a printed value"
# oracle: 01144_an_operator_atom_needs_no_quotes.oracle.exs
# oracle.stamp: cc6498ec425fade7
#---
#
# Elixir reads `:+` as the atom `+`, the same atom `:"+"` names. A colon is
# an atom's colon only where no identifier precedes it, so `a: -1` stays a
# keyword pair and `x :: integer` stays a type annotation.
def main() do
  IO.inspect(:+)
  IO.inspect(:+ == :"+")
  IO.inspect(:+ == :-)
  IO.inspect([:+, :-, :*, :/, :=, :!, :<, :>, :&, :|, :^, :@, :%, :.])
  IO.inspect([:++, :--, :->, :**, :==, :=~, :!=, :<-, :<=])
  IO.inspect([:<>, :<~, :>=, :&&, :|>, :||, :~>, :.., :\\])
  IO.inspect([:+++, :---, :===, :!==, :<<<, :<<~, :<|>, :<~>, :>>>])
  IO.inspect([:&&&, :|||, :^^^, :~>>, :~~~, :...])
  IO.inspect([:%{}, :{}, :<<>>, :..//])
  IO.inspect(%{:+ => :plus})
  IO.inspect(%{:+ => :plus, :- => :minus}[:-])
  IO.inspect({:+, 1})
  IO.inspect(a: -1)
  IO.inspect(Enum.map([:+, :-], fn op -> op == :+ end))
end
