#---
# purpose: "Keyword.update/4 and update!/3 change the first entry for a key where it stands and drop its duplicates, and update/4 adds an absent key at the end, as in Elixir"
# oracle: 00770_keyword_update_changes_the_entry_where_it_stands.oracle.exs
#---
def main() do
  dbg(Keyword.update([a: 1, b: 2], :a, 0, fn x -> x + 1 end))
  dbg(Keyword.update([a: 1, b: 2], :b, 0, fn x -> x + 1 end))
  dbg(Keyword.update([a: 1, b: 2], :z, 0, fn x -> x + 1 end))
  dbg(Keyword.update([], :z, 0, fn x -> x + 1 end))
  dbg(Keyword.update([a: 1, b: 2, a: 3], :a, 0, fn x -> x + 10 end))
  dbg(Keyword.update!([a: 1, b: 2], :a, fn x -> x + 1 end))
  dbg(Keyword.update!([b: 2, a: 1, c: 3, a: 4], :a, fn x -> x + 1 end))
  dbg(Keyword.update!([a: 1, b: 2], :b, fn x -> x * 5 end))
end
