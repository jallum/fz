#---
# purpose: an opaque resource's inner type is preserved by minting, so a value made inside its own module flows through a parameter typed by the opaque tag, and its .value accessor recovers the wrapped payload
#---
defmodule A do
  @type t :: opaque resource(integer)

  def make(), do: make_resource(7, &dbg/1)
  def get(h :: t), do: h.value
end

def main() do
  h = A.make()
  assert(A.get(h) == 7)
end
