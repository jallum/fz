#---
# purpose: "%{s | k: v} and Map.put of an existing field answer the same struct with that field replaced, with the base type known or through an any-typed parameter"
# oracle: self
# oracle.stamp: db54d9d4599a7aff
#---
#
# A struct is a map whose keys are its fields and `__struct__`. Replacing a
# field keeps every key, so the answer is still the struct.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Main do
  def bump(v), do: %{v | x: 10}

  def main() do
    p = %Pt{x: 1, y: 2}
    IO.inspect(%{p | x: 9})
    IO.inspect(%{p | x: 9, y: 8})
    IO.inspect(bump(p))
    IO.inspect(Map.put(p, :y, 7))
    IO.inspect(%{p | x: 9}.__struct__)
    IO.inspect(p)
    m = %{b: 2}
    IO.inspect(%{m | b: 3})
  end
end

Main.main()
