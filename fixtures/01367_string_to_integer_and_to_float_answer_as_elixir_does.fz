#---
# purpose: "String.to_integer/1 and String.to_float/1 give Elixir's answers: the whole 64-bit range, a leading sign, exponents, correct rounding, and ArgumentError on text Elixir refuses"
# oracle: self
# oracle.stamp: 6602bbf4087c9742
#---
defmodule Main do
  def to_integer(s) do
    try do
      String.to_integer(s)
    rescue
      e in ArgumentError -> refused(e)
    end
  end

  def to_float(s) do
    try do
      String.to_float(s)
    rescue
      e in ArgumentError -> refused(e)
    end
  end

  def refused(e) do
    IO.puts("ArgumentError: " <> e.message)
    :argument_error
  end

  def main() do
    IO.inspect(to_integer("9223372036854775807"))
    IO.inspect(to_integer("-9223372036854775808"))
    IO.inspect(to_integer("-0"))
    IO.inspect(to_integer("+5"))
    IO.inspect(to_integer(""))
    IO.inspect(to_integer("12x"))
    IO.inspect(to_integer("-"))

    IO.inspect(to_float("1.14"))
    IO.inspect(to_float("1.57"))
    IO.inspect(to_float("99999999999999999999.5"))
    IO.inspect(to_float("1.0e3"))
    IO.inspect(to_float("1.0E3"))
    IO.inspect(to_float("1.0e-3"))
    IO.inspect(to_float("1.0e+3"))
    IO.inspect(to_float("+1.0"))
    IO.inspect(to_float("-0.0"))
    IO.inspect(to_float("-0.25"))
    IO.inspect(to_float("1"))
    IO.inspect(to_float("1e3"))
    IO.inspect(to_float("1."))
    IO.inspect(to_float(".5"))
    IO.inspect(to_float("1.e3"))
    IO.inspect(to_float("1.0x"))
  end
end

Main.main()
