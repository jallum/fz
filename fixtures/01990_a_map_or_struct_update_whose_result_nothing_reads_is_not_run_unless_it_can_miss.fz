#---
# purpose: "A map or struct update whose result is discarded compiles and runs: one that cannot miss is not emitted, and one that can miss still raises KeyError; the effects inside a discarded update still happen; a returned update is the control"
# kind: run
# oracle: self
# oracle.stamp: 7568a79c9f435c50
#---
defmodule P do
  def upd(v), do: %{v | a: 1}

  def upd_sending(v, pid), do: %{v | a: send(pid, :inside_update)}
end

defmodule S do
  defstruct a: 0

  def upd(%S{} = s), do: %{s | a: 1}
end

defmodule Main do
  def discard_map do
    P.upd(%{a: 0})
    :map_done
  end

  def discard_struct do
    S.upd(%S{a: 0})
    :struct_done
  end

  def discard_miss do
    try do
      P.upd(%{b: 0})
      :no_raise
    rescue
      KeyError -> :key_error
    end
  end

  def discard_sending_update do
    P.upd_sending(%{a: 0}, self())
    receive do
      m -> m
    end
  end

  def discard_inline_sending_update do
    %{%{a: 0} | a: send(self(), :inline_update)}
    receive do
      m -> m
    end
  end

  def returned, do: P.upd(%{a: 0, b: 2})
end

IO.inspect(Main.discard_map())
IO.inspect(Main.discard_struct())
IO.inspect(Main.discard_miss())
IO.inspect(Main.returned())
IO.inspect(Main.discard_sending_update())
IO.inspect(Main.discard_inline_sending_update())
