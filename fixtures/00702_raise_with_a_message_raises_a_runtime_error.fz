#---
# purpose: "raise with a message fails the process with a RuntimeError, which prints its one line on stderr and exits 1"
# expect: abort
# oracle: self
# oracle.stamp: 0925a376975cf16e
#---
defmodule Main do
  def main() do
    IO.inspect(:before)
    raise "boom"
    IO.inspect(:never_printed)
  end
end

Main.main()
