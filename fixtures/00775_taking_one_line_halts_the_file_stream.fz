#---
# purpose: "Enum.take(1) over a File.stream! of three lines reads the first line and halts, and a mapped stream over it sees one line only"
# oracle: self
# oracle.stamp: c484f9384a3b9209
#---
defmodule Main do
  def main() do
    path = "00775_take.tmp"
    File.write!(path, "one\ntwo\nthree\n")
    IO.inspect(Enum.take(File.stream!(path), 1))
    IO.inspect(Enum.take(File.stream!(path), 2))
    IO.inspect(Enum.take(Stream.map(File.stream!(path), fn line -> IO.inspect(line) end), 1))
    File.rm!(path)
  end
end

Main.main()
