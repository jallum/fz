#---
# purpose: "an if both of whose branches raise never reaches its join: the raise prints its line and the process exits 1"
# expect: abort
# oracle: 00828_a_join_every_branch_of_which_raises_is_never_reached.oracle.exs
#---
def pick(x) do
  v = if x > 0 do
    raise ArgumentError, "positive"
  else
    raise ArgumentError, "not positive"
  end
  dbg(v)
end

def main() do
  pick(0)
end
