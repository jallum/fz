#---
# purpose: "`&` captures any expression: the operand is an ordinary expression, and a name/arity operand is a function reference"
# oracle: self
# oracle.stamp: c8a17d5e7173f74f
#---
#
# `&` takes one operand expression. When the operand is `name/arity` or
# `Mod.name/arity` it names a function; otherwise the operand is the body of an
# anonymous function over its highest `&N`.
defmodule Twice do
  def double(x), do: x * 2
end

defmodule Capture do
  def inc(x), do: x + 1

  def run() do
    maps = [%{inclusive: 1}, %{inclusive: 2}]

    IO.inspect(Enum.map(maps, & &1.inclusive))
    IO.inspect(Enum.map([1, 2, 3], & &1 + 1))
    IO.inspect(Enum.map([1, 2], &{&1, 10}))
    IO.inspect(Enum.map([1, 2], &[&1]))
    IO.inspect(Enum.map([1, 2], &"n=#{&1}"))
    IO.inspect(Enum.map([1, 2], &Twice.double/1))
    IO.inspect(Enum.map([1, 2], &inc/1))
    IO.inspect(Enum.reduce([1, 2, 3], 0, &+/2))
    IO.inspect(Enum.map([1, 2, 3], &(&1 * 2)))
    IO.inspect((&{&1, &2}).(:a, :b))
  end
end

defmodule Main do
  def main() do
    Capture.run()
  end
end

Main.main()
