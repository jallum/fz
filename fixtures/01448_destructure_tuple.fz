#---
# purpose: "irrefutable tuple destructure in a let-style bind — first fixture to exercise `{a, b} = expr` across all four legs"
#---
def pair(), do: {1, 2}

def main() do
  {a, b} = pair()
  a == 1 || raise("first tuple element binds")
  b == 2 || raise("second tuple element binds")
  a + b == 3 || raise("bound values are usable in arithmetic")
end
