#---
# purpose: "a rescue head listing several aliases catches a raise of any one of them"
# oracle: self
# oracle.stamp: e5a377aac956fa85
#---
defmodule Main do
  def attempt(f) do
    f.()
  rescue
    [ArgumentError, RuntimeError] -> :listed
  end

  def main() do
    IO.inspect(attempt(fn () -> raise ArgumentError, "a" end))
    IO.inspect(attempt(fn () -> raise "r" end))
    IO.inspect(attempt(fn () -> :no_raise end))
  end
end

Main.main()
