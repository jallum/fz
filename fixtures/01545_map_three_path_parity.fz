#---
# purpose: "map layout three-path parity for lookup, update, floats, nil miss, and pointer values"
#---
def main() do
  xs = [1, 2]
  m = %{b: 2, a: 1, pi: 1.5, xs: xs}
  n = Map.put(%{m | b: 20}, :c, 3)

  m[:a] == 1 || raise("map lookup by atom key")
  m[:pi] == 1.5 || raise("float value lookup")
  n[:b] == 20 || raise("map update overrides an existing key")
  n[:missing] == nil || raise("missing key lookup yields nil")
  n[:xs] == [1, 2] || raise("pointer value lookup returns the bound list")
end
