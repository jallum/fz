#---
# purpose: "Enum count, member, reduce, and Enumerable.reduce over lists match Elixir"
# oracle: oracle.exs
#---
def main() do
  dbg({
    Enum.count([1, 2, 3]),
    Enum.member?([1, 2, 3], 2),
    Enum.reduce([1, 2, 3], 0, fn (x, acc) -> acc + x end),
    Enumerable.reduce([1, 2, 3], {:cont, 0}, fn (x, acc) -> {:cont, acc + x} end)
  })
end
