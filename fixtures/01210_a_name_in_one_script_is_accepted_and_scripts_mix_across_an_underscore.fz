#---
# purpose: a name drawn from a single script, with digits and underscores, is accepted, and an underscore lets scripts mix
# oracle: self
# oracle.stamp: a459123da2289910
#---
defmodule Main do
  def main() do
    привет_1 = 40
    日本あア = 1
    hello_мир = 1
    IO.inspect({привет_1 + 日本あア + hello_мир, :привет, :日本, [ключ: 1]})
  end
end

Main.main()
