#---
# purpose: "A value that one case arm reads as an integer and another reads as an atom, a float or itself keeps one form for each arm"
# oracle: self
# oracle.stamp: 43c1e4c64ee4e8e5
#---
defmodule Main do
  def main() do
    IO.inspect(Enum.map([4, :five], fn x ->
      case x do
        i when is_integer(i) -> :int
        f -> {:other, f}
      end
    end))
    IO.inspect(Enum.map([4, :five], fn x ->
      case x do
        i when is_integer(i) -> {:int, i}
        f when is_atom(f) -> {:atom, f}
      end
    end))
    IO.inspect(Enum.map([4, 2.5], fn x ->
      case x do
        i when is_integer(i) -> {:int, i}
        f -> {:float, f}
      end
    end))
    IO.inspect(Enum.map([4, :five], fn x ->
      case x do
        i when is_integer(i) -> {:int, i}
        _ -> {:other, x}
      end
    end))
    IO.inspect(Enum.map([4, :five], fn x ->
      y = case x do
        i when is_integer(i) -> i
        _ -> 0
      end
      {y, x}
    end))
  end
end

Main.main()
