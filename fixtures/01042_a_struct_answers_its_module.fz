#---
# purpose: "p.__struct__ answers the struct's module atom, with the base type known or through an any-typed parameter, and equals the alias"
# oracle: self
# oracle.stamp: acd6264b3ce537ef
#---
#
# A struct's module is a value: the same atom the alias spells in value
# position, so comparing the two is true.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Geo.Pt do
  defstruct [:lat]
end

defmodule Main do
  def module_of(v), do: v.__struct__

  def main() do
    p = %Pt{x: 1, y: 2}
    IO.inspect(p.__struct__)
    IO.inspect(module_of(p))
    IO.inspect(p.__struct__ == Pt)
    IO.inspect(module_of(p) == Pt)
    IO.inspect(module_of(p) == Geo.Pt)
    g = %Geo.Pt{lat: 1}
    IO.inspect(g.__struct__)
    IO.inspect(module_of(g))
  end
end

Main.main()
