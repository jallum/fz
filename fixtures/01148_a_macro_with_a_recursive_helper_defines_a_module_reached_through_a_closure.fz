#---
# purpose: "A module whose body calls a macro with a recursive private helper is defined when it is first reached from inside a closure, while another lazily loaded library function is also waiting"
# oracle: 01148_a_macro_with_a_recursive_helper_defines_a_module_reached_through_a_closure.oracle.exs
# oracle.stamp: 536648f30a981aa2
#---
#
# `mk` chooses its expansion by walking its argument with the recursive private
# `flag?`. `Probe` is first reached from the closure `Lazy.a/1` passes to
# `Enum.map`, and the program then asks `Map.fetch!` for a key the map lacks,
# which loads `KeyError`'s library code in the same compile.
defmodule M do
  defmacro mk(fields) do
    if flag?(fields) do
      quote do: defstruct([])
    else
      quote do: defstruct(unquote(fields))
    end
  end

  defp flag?([]), do: false
  defp flag?([:a | _]), do: true
  defp flag?([_ | rest]), do: flag?(rest)
end

defmodule Probe do
  import M
  mk [:a]
  def make(x), do: x
end

defmodule Lazy do
  def a(x), do: Enum.map(x, fn v -> Probe.make(v) end)
end

def main() do
  IO.inspect(Lazy.a([3, 1, 2]))

  try do
    Map.fetch!(%{a: 1}, :b)
  rescue
    _ in KeyError -> IO.puts("no :b")
  end
end
