#---
# purpose: "a raise inside a rescue arm is outside that try's protection: the enclosing try catches it"
# oracle: 00823_a_raise_inside_a_rescue_arm_is_not_caught_by_its_own_try.oracle.exs
#---
def main() do
  result = try do
    try do
      raise ArgumentError, "first"
    rescue
      e in ArgumentError -> raise RuntimeError, "from rescue of " <> e.message
    end
  rescue
    e in RuntimeError -> e.message
  end
  dbg(result)
end
