#---
# purpose: "A recursion that wraps its argument in a list on every call compiles: the repeated list folds where it grew"
# root: main/0
# assert.metric.type.clash_folded: 1
# oracle: self
# oracle.stamp: d0883ca4035edda1
#---
defmodule Wrap do
  def g(acc, 0), do: acc
  def g(acc, n), do: g([acc], n - 1)
end

defmodule Main do
  def main() do
    IO.inspect(Wrap.g([], 3))
  end
end

Main.main()
