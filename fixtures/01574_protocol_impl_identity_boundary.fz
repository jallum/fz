#---
# purpose: A module's atom is its identity: an impl is called through its own atom, and a lexical alias never retargets an unquoted atom
#---
defmacro self_val(x) do
  quote do: unquote(__CALLER__.module).val(unquote(x))
end

defmacro same_module() do
  quote do: unquote(__CALLER__.module) == __MODULE__
end

defmacro self_struct(x) do
  {:"%", [], [__CALLER__.module, {:"%{}", [], [{:x, x}]}]}
end

defmodule Decoy do
  defstruct [:x]
end

defmodule Original do
  defstruct [:x]
  alias Decoy, as: Original
  def make(x), do: self_struct(x)
  def matches(value) do
    case value do
      self_struct(_) -> true
      _ -> false
    end
  end
end

defprotocol Solo do
  @spec val(t) :: integer
  def val(x)
  @spec relay(t) :: integer
  def relay(x)
  @spec same(t) :: boolean
  def same(x)
end

defimpl Solo, for: List do
  def val(_x), do: 4
  def relay(x), do: self_val(x)
  def same(_x), do: same_module()
end

defimpl Solo, for: Map do
  def val(_x), do: 5
  def relay(x), do: self_val(x)
  def same(_x), do: same_module()
end

def main() do
  dbg({Solo.val([]), Solo.val(%{}), Solo.List.val(0), Solo.Map.val(0)})
  dbg({Solo.relay([]), Solo.relay(%{})})
  dbg({Solo.same([]), Solo.same(%{})})
  dbg({Original.make(5) == %Original{x: 5}, Original.matches(%Original{x: 5})})
end
