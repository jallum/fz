#---
# purpose: "an if whose one branch raises and whose other branch yields a value carries that value past the join"
# oracle: self
# oracle.stamp: 0d64781595664fc1
#---
defmodule Main do
  def pick(x) do
    v = if x > 0 do
      raise ArgumentError, "positive"
    else
      7
    end
    v + 1
  end

  def main() do
    IO.inspect(pick(0))
  end
end

Main.main()
