#---
# purpose: "list literal decodes the same regardless of which element is a call: trailing call, trailing literal, call in the middle, and every element a call"
#---
def main() do
  [Enum.reverse([1, 2, 3])] == [[3, 2, 1]] || raise("single-element list whose only element is a call")
  [1, Enum.reverse([1, 2, 3])] == [1, [3, 2, 1]] || raise("trailing element is a call")
  [Enum.reverse([1, 2, 3]), 9] == [[3, 2, 1], 9] || raise("leading element is a call, trailing element is a literal")
  [Enum.reverse([1]), 2, Enum.reverse([3, 4])] == [[1], 2, [4, 3]] || raise("call in the middle, call trailing")
  [Enum.reverse([1, 2, 3]), Enum.reverse([4, 5])] == [[3, 2, 1], [5, 4]] || raise("every element is a call")
end
