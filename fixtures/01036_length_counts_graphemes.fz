#---
# purpose: "String.length counts extended grapheme clusters, not codepoints or bytes"
# oracle: self
# oracle.stamp: 10159f2d269e77bd
#---
defmodule Main do
  def main() do
    strings = ["abc", "é", "\r\n", "éx", "👨‍👩‍👧x", "🇫🇷🇫", "각x", "क्षx", "x́̂y"]
    Enum.each(strings, fn s -> IO.inspect(String.length(s)) end)
    IO.inspect(String.length(""))
  end
end

Main.main()
