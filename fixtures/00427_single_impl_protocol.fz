#---
# purpose: a protocol with exactly one implementation dispatches directly rather than being rewritten into a multi-arm cascade.
#---
defprotocol Sizer do
  def size(value)
end

defimpl Sizer, for: List do
  def size(value), do: 2
end

def describe(value), do: Sizer.size(value)

def main(), do: describe([1, 2, 3])
