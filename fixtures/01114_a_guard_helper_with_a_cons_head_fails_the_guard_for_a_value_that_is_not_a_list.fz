#---
# purpose: "A function-head guard that calls a defguardp whose body is hd/1 holds for a list with a positive head and fails for every value that is not a list, as Elixir's hd/1 does in a guard"
# oracle: self
# oracle.stamp: 8cf78b2a92c76363
#---
#
# `:a` means the guard held and `:b` means it did not. The guard's body is
# hd/1, which raises for an empty list, an integer, an atom, a float, a tuple,
# a binary or a map, and a body that raises fails the guard that called it.
defmodule Main do
  defguardp first(l) when hd(l)

  def f(l) when first(l) > 0, do: :a
  def f(_), do: :b

  def main() do
    IO.inspect([f([1]), f([]), f(7), f(:x)])
    IO.inspect([f([-1]), f(1.5), f({1, 2}), f("abc"), f(%{k: 1})])
  end
end

Main.main()
