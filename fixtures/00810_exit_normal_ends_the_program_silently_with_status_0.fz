#---
# purpose: "exit(:normal) from main ends the program at once, prints nothing, and exits 0: the code after it never runs"
# oracle: self
# oracle.stamp: 1167ec57078d86f1
#---
defmodule Main do
  def main() do
    IO.inspect(:before)
    exit(:normal)
    IO.inspect(:after)
  end
end

Main.main()
