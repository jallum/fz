#---
# purpose: "a raise of a value that is not an exception, `:erlang.error/1` (fz's `panic/1`), rescues as an ErlangError carrying the value as original, by alias and by bare variable"
# oracle: self
# oracle.stamp: 6f6b8bcde10f21e8
#---
# Elixir normalizes a few reason atoms into named exceptions (`:badarg`
# becomes ArgumentError); fz does not, so the value here is one Elixir leaves
# alone.
defmodule Main do
  def main() do
    by_alias = try do
      :erlang.error(:boom)
    rescue
      e in ErlangError -> e.original
    end
    IO.inspect(by_alias)
    bare = try do
      :erlang.error({:stop, 3})
    rescue
      e -> {e.__struct__, e.original}
    end
    IO.inspect(bare)
  end
end

Main.main()
