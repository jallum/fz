#---
# purpose: "Enum.slice/2 with a stepped range takes every stride-th element of a stepped or descending range, advancing by step * stride"
#---
# Not an oracle fixture: the golden below is written by hand from the
# ../elixir main source of Enumerable.Range.slice/1
# (lib/elixir/lib/enum.ex:5269-5271), which advances by `step * stride`.
# Elixir 1.19.4 advances by `step + stride - 1`, so on a range whose step is
# not 1 it returns other elements (`Enum.slice(1..9//2, 0..4//2)` is
# `[1, 4, 7]` there, `[1, 5, 9]` here).
defmodule Main do
  def strided(label, enumerable) do
    IO.inspect(label)
    IO.inspect(Enum.slice(enumerable, 0..-1//2))
    IO.inspect(Enum.slice(enumerable, 1..-1//3))
    IO.inspect(Enum.slice(enumerable, 0..4//2))
    IO.inspect(Enum.slice(enumerable, -4..3//2))
  end

  def main() do
    strided("stepped range", 1..9//2)
    strided("descending range", 5..1//-1)
    strided("descending stepped range", 9..1//-2)

    {:ok, count, slicer} = Enumerable.slice(1..10//2)
    IO.inspect(count)
    IO.inspect(slicer.(1, 2, 2))
  end
end

Main.main()
