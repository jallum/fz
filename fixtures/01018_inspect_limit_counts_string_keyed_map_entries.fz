#---
# purpose: "inspect/2 limit: shows that many map entries, a key and its value both spending from the budget"
# oracle: 01018_inspect_limit_counts_string_keyed_map_entries.oracle.exs
#---
def main() do
  dbg(inspect(%{"a" => 1, "b" => 2, "c" => 3}, limit: 2))
  dbg(inspect(%{"a" => 1, "b" => 2, "c" => 3}, limit: 1))
  dbg(inspect(%{"a" => 1, "b" => 2, "c" => 3}, limit: 3))
  dbg(inspect(%{[1, 2, 3] => [4, 5, 6]}, limit: 4))
  dbg(inspect(%{[1, 2, 3] => [4, 5, 6]}, limit: 3))
  dbg(inspect(%{"a" => [1, 2, 3], "b" => 2}, limit: 3))
end
