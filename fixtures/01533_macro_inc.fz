#---
# purpose: "defmacro + quote/unquote round-trip — two macros, one nested in the other"
#---
defmacro inc(x) do
  quote do: unquote(x) + 1
end

defmacro double(x) do
  quote do: unquote(x) * 2
end

def main() do
  inc(41) == 42 || raise("inc macro expands to +1")
  double(21) == 42 || raise("double macro expands to *2")
  inc(double(20)) == 41 || raise("nested macro expansion: double(20) then inc")
end
