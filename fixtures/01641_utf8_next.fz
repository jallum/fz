#---
# purpose: "Utf8.next/1 returns a branded codepoint or the suffix at the first impossible byte"
#---
def main() do
  Utf8.next("") == nil || raise("expected Utf8.next(\"\") == nil")
  Utf8.next(<<195, 169, 120>>) == {:ok, Utf8.from_bytes!(<<195, 169>>), "x"} || raise("expected Utf8.next(<<195, 169, 120>>) == {:ok, Utf8.from_bytes!(<<195, 169>>), \"x\"}")
  Utf8.next(<<225, 128, 65>>) == {:error, "A"} || raise("expected Utf8.next(<<225, 128, 65>>) == {:error, \"A\"}")
  Utf8.next(<<225, 128>>) == {:error, ""} || raise("expected Utf8.next(<<225, 128>>) == {:error, \"\"}")
end
