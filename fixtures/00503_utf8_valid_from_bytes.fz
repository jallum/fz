#---
# purpose: Utf8.valid? and Utf8.from_bytes report validity for good and bad binaries
#---
def main() do
  good = <<104, 105>>
  bad = <<0xff, 0xff>>
  Utf8.valid?(good) || raise("expected Utf8.valid?(good)")
  Utf8.valid?(bad) == true && raise("expected not Utf8.valid?(bad) == true")
  Utf8.from_bytes(good) == {:ok, "hi"} || raise("expected Utf8.from_bytes(good) == {:ok, \"hi\"}")
  Utf8.from_bytes(bad) == {:error, :invalid_utf8} || raise("expected Utf8.from_bytes(bad) == {:error, :invalid_utf8}")
end
