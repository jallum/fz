#---
# purpose: "fz-axu.17 (P2) — pattern matching on utf8 string literals"
#---
def greet("hi"), do: :hello
def greet("bye"), do: :goodbye
def greet(_), do: :unknown

def main() do
  greet("hi") == :hello || raise("utf8 literal clause matches")
  greet("bye") == :goodbye || raise("second utf8 literal clause matches")
  greet("other") == :unknown || raise("wildcard clause for non-matching strings")
end
