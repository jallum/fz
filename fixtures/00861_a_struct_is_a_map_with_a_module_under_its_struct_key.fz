#---
# purpose: "a struct is a map: is_map, map_size, a map pattern and the Map functions answer for a struct what they answer for the map holding its fields and its module under __struct__"
# oracle: self
# oracle.stamp: a54318d7228df752
#---
#
# A struct's keys are its fields and `__struct__`, whose value is the module.
# Nothing that asks for a map tells a struct from any other map, and a tuple
# is no map although it shares the struct's layout.
defmodule Pt do
  defstruct [:x, :y]
end

defmodule Main do
  def kind(v) when is_map(v), do: :map

  def kind(_), do: :other

  def x_of(v) do
    case v do
      %{x: x} -> x
      _ -> :none
    end
  end

  def main() do
    p = %Pt{x: 1, y: 2}
    IO.inspect(is_map(p))
    IO.inspect(kind(p))
    IO.inspect(kind({1, 2}))
    IO.inspect(map_size(p))
    IO.inspect(x_of(p))
    IO.inspect(x_of(%{x: 7}))
    IO.inspect(x_of(%{y: 7}))
    IO.inspect(x_of({1, 2}))
    IO.inspect(Map.get(p, :__struct__))
    IO.inspect(p.__struct__)
    IO.inspect(Map.get(p, :x))
    IO.inspect(Map.get(p, :x, :none))
    IO.inspect(Map.get(p, :z, :none))
    IO.inspect(Map.get(%Pt{x: :left, y: 2}, :x))
    IO.inspect(Map.get(%{x: :left}, :x))
    IO.inspect(Map.has_key?(p, :x))
    IO.inspect(Map.has_key?(p, :z))
    IO.inspect(Map.has_key?(p, :__struct__))
    IO.inspect(Map.merge(p, %{x: 9}).x)
    IO.inspect(Map.put(p, :y, 5))
    IO.inspect(Map.fetch(p, :y))
    send(self(), p)
    receive do
      %{y: y} -> IO.inspect({:map, y})
    end
  end
end

Main.main()
