#---
# purpose: "a rescued decision exception carries the value that missed in term and Elixir's multi-line message"
# oracle: self
# oracle.stamp: 9792c0a496fe3f90
#---
defmodule Main do
  defp three(), do: 3

  defp pair(), do: {1, 2}

  defp bad(), do: {:bad, 1}

  defp unexpected(), do: :unexpected

  def main() do
    try do
      case three() do
        1 -> :one
      end
    rescue
      e in CaseClauseError ->
        IO.inspect(e.term)
        IO.inspect(Exception.message(e))
    end
    try do
      {a} = pair()
      IO.inspect(a)
    rescue
      e in MatchError ->
        IO.inspect(e.term)
        IO.inspect(Exception.message(e))
    end
    try do
      with {:ok, v} <- bad() do
        IO.inspect(v)
      else
        :nothing -> :none
      end
    rescue
      e in WithClauseError ->
        IO.inspect(e.term)
        IO.inspect(Exception.message(e))
    end
    try do
      try do
        unexpected()
      rescue
        _ -> :inner_rescue
      else
        :expected -> :ok
      end
    rescue
      e in TryClauseError ->
        IO.inspect(e.term)
        IO.inspect(Exception.message(e))
    end
  end
end

Main.main()
