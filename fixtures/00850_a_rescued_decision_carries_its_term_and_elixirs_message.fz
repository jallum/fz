#---
# purpose: "a rescued decision exception carries the value that missed in term and Elixir's multi-line message"
# oracle: 00850_a_rescued_decision_carries_its_term_and_elixirs_message.oracle.exs
#---
defp three(), do: 3
defp pair(), do: {1, 2}
defp bad(), do: {:bad, 1}
defp unexpected(), do: :unexpected

def main() do
  try do
    case three() do
      1 -> :one
    end
  rescue
    e in CaseClauseError ->
      dbg(e.term)
      dbg(e.message)
  end
  try do
    {a} = pair()
    dbg(a)
  rescue
    e in MatchError ->
      dbg(e.term)
      dbg(e.message)
  end
  try do
    with {:ok, v} <- bad() do
      dbg(v)
    else
      :nothing -> :none
    end
  rescue
    e in WithClauseError ->
      dbg(e.term)
      dbg(e.message)
  end
  try do
    try do
      unexpected()
    rescue
      _ -> :inner_rescue
    else
      :expected -> :ok
    end
  rescue
    e in TryClauseError ->
      dbg(e.term)
      dbg(e.message)
  end
end
