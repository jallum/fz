#---
# purpose: nil, true, and false are atoms whose names round-trip through Atom.to_string
#---
def main() do
  Atom.to_string(nil) == "nil" || raise("nil renders as its name")
  Atom.to_string(true) == "true" || raise("true renders as its name")
  Atom.to_string(false) == "false" || raise("false renders as its name")
end
