#---
# purpose: a root `defmodule Geo.Pt` binds no name in scope, and a call, a capture and a type written `Geo.Pt.…` still reach it, because a dotted name nothing binds means the root module of that name; inside it, `Pt` alone is the root `Pt`
# oracle: self
# oracle.stamp: 8b9300f871f3eea8
#---
defmodule Geo.Pt do
  @type t :: integer

  def name(), do: :dotted
  def twice(x), do: x * 2
  def short(), do: Pt
end

defmodule Use do
  @spec stretch(Geo.Pt.t) :: integer
  def stretch(x), do: Geo.Pt.twice(x)
end

defmodule Main do
  def main() do
    IO.inspect(Geo.Pt.name())
    twice = &Geo.Pt.twice/1
    IO.inspect(twice.(4))
    IO.inspect(Use.stretch(5))
    IO.inspect(Geo.Pt.short())
  end
end

Main.main()
