#---
# purpose: "a catch clause that reads the reason binds the struct a program raised and the Erlang reason a failure carries, and :erlang.error(:badarg) binds :badarg"
# oracle: self
# oracle.stamp: 6d91360f7a5cf81a
#---
defmodule Main do
  def one(1), do: :one

  def reason(fun) do
    try do
      fun.()
    catch
      :error, reason -> reason
    end
  end

  def rescued(fun) do
    try do
      fun.()
    rescue
      e -> e
    end
  end

  def main() do
    IO.inspect(reason(fn -> one(2) end))
    IO.inspect(reason(fn -> raise %MatchError{term: 1} end))
    IO.inspect(reason(fn -> raise ArgumentError, "text" end))
    IO.inspect(rescued(fn -> raise %MatchError{term: 1} end))
    IO.inspect(rescued(fn -> match(1) end))
    IO.inspect(reason(fn -> :erlang.error(:badarg) end))
  end

  def match(a), do: {:ok, _} = a
end

Main.main()
