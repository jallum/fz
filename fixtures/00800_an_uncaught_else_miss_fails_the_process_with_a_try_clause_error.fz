#---
# purpose: "an else miss with no handler left prints the TryClauseError line and exits 1"
# expect: abort
# oracle: self
# oracle.stamp: 19b7d68df4838614
#---
defmodule Main do
  def main() do
    try do
      :unexpected
    rescue
      _ -> :inner_rescue
    else
      :expected -> :ok
    end
  end
end

Main.main()
