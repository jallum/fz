#---
# purpose: "A @type that names itself, t :: :start | {integer, t}, is the recursive type μt. :start | {int, t}, and a function spec'd to return it runs"
# root: main/0
# oracle: self
# oracle.stamp: 2004caadd912845f
#---
defmodule Main do
  @type t :: :start | {integer, t}

  @spec build(integer) :: t
  def build(0), do: :start
  def build(n), do: {n, build(n - 1)}

  def main() do
    IO.inspect(build(3))
  end
end

Main.main()
