#---
# purpose: "a module name in value position is the atom Elixir.<Name>; it prints as the alias and its name carries the Elixir. prefix"
# oracle: self
# oracle.stamp: 43086f45de68f6ca
#---
defmodule Main do
  def main() do
    IO.inspect(RuntimeError)
    IO.inspect(Atom.to_string(RuntimeError))
    IO.inspect(RuntimeError == :"Elixir.RuntimeError")
    IO.inspect(is_atom(RuntimeError))
  end
end

Main.main()
