#---
# purpose: "JSON.decode/1 decodes multi-byte characters inside and beside escapes, escapes written with u and surrogate pairs, and reports invalid or truncated UTF-8 inside a string, as Elixir does"
# oracle: oracle.exs
# oracle.stamp: 304d13ac626fbc62
#---
defmodule Decode do
  def show(doc), do: IO.inspect(JSON.decode(doc))

  # A decoded string of `n` copies of `char` is reported by size and by equality.
  def sized(char, n), do: check(JSON.decode("\"" <> String.duplicate(char, n) <> "\""), String.duplicate(char, n))

  # The same string spelled with `n` copies of `escape`, with a plain character between copies.
  def escaped(char, escape, n) do
    doc = "\"" <> String.duplicate("x" <> escape, n) <> "\""
    check(JSON.decode(doc), String.duplicate("x" <> char, n))
  end

  defp check({:ok, value}, expected), do: IO.inspect({byte_size(value), value == expected})
  defp check(other, _expected), do: IO.inspect(other)
end

def main() do
  # Multi-byte characters inside a run, at its start, middle and end.
  Decode.show("\"世界\"")
  Decode.show("\"ab世cd\"")
  Decode.show("\"é\"")
  Decode.show("\"aé\"")
  Decode.show("\"éa\"")
  Decode.show("\"😀😀😀\"")
  Decode.show("\"a€b😀c世d\"")

  # Multi-byte characters beside escapes.
  Decode.show("\"é\\n世\"")
  Decode.show("\"\\n世\\n\"")
  Decode.show("\"世\\u0041世\"")
  Decode.show("\"世\\\"世\\\\世\"")
  Decode.show("\"\\t世é\\t\"")

  # \u escapes: BMP characters, both ends of each width, and surrogate pairs.
  Decode.show("\"\\u4e16\\u754c\"")
  Decode.show("\"\\u00e9x\"")
  Decode.show("\"\\u0000\\u007f\\u0080\\u07ff\\u0800\\uffff\"")
  Decode.show("\"\\ud83d\\ude00\"")
  Decode.show("\"a\\ud83d\\ude00b世\"")
  Decode.show("\"\\uD800\\uDC00\\uDBFF\\uDFFF\"")
  Decode.show("\"世\\u4e16世\\ud83d\\ude00é\"")

  # Lone and misordered surrogates.
  Decode.show("\"\\ud83d\"")
  Decode.show("\"\\ude00\"")
  Decode.show("\"x世\\ude00\"")
  Decode.show("\"世\\ud83dx\"")
  Decode.show("\"\\ud83d\\u0041\"")
  Decode.show("\"\\ud83d\\ud83d\"")

  # Invalid, overlong, surrogate and truncated UTF-8 inside a string.
  Decode.show("\"")
  Decode.show("\"abc")
  Decode.show("\"ab世")
  Decode.show("\"ab\\")
  Decode.show(<<34, 226, 130, 34>>)
  Decode.show(<<34, 226, 130>>)
  Decode.show(<<34, 226>>)
  Decode.show(<<34, 237, 160, 128, 34>>)
  Decode.show(<<34, 192, 128, 34>>)
  Decode.show(<<34, 128, 34>>)
  Decode.show(<<34, 244, 144, 128, 128, 34>>)
  Decode.show(<<34, 228, 184, 150, 255, 34>>)
  Decode.show("\"ab世" <> <<240, 159, 152>>)
  Decode.show("\"ab" <> <<195, 34>>)
  Decode.show("\"é\\n" <> <<226, 130, 65>>)
  Decode.show("{\"k世\":\"é\"," <> <<34, 255, 34, 58, 49, 125>>)

  # Objects and arrays carry the same strings.
  Decode.show("{\"世\":\"é\",\"a\\u00e9\":[\"\\ud83d\\ude00\",\"😀\"]}")

  # Strings over and under the 64-byte copy threshold, with and without escapes.
  Decode.sized("a", 63)
  Decode.sized("a", 64)
  Decode.sized("a", 65)
  Decode.sized("世", 21)
  Decode.sized("世", 22)
  Decode.sized("世", 333)
  Decode.sized("é", 40)
  Decode.escaped("世", "\\u4e16", 21)
  Decode.escaped("世", "\\u4e16", 22)
  Decode.escaped("世", "\\u4e16", 333)
  Decode.escaped("😀", "\\ud83d\\ude00", 40)
end
