#---
# purpose: mixed numeric expressions and guards compare exact values without losing integer precision
#---
def greater?(left, right) when left > right, do: true
def greater?(_, _), do: false

def check(integer, float) when is_integer(integer) and is_float(float) do
  integer != float || raise("a rounded float is not the adjacent integer")
  integer > float || raise("mixed expression order retains the integer's low bit")
  float < integer || raise("reverse mixed expression order agrees")
  greater?(integer, float) || raise("a mixed guard shares exact expression order")
  not greater?(float, integer) || raise("reverse mixed guard order agrees")
end

def main() do
  check(9007199254740993, 9007199254740992.0)
  check(-9007199254740993, -9007199254740994.0)
  check(0, -0.5)
  0.0 == -0.0 || raise("widening comparison equates signed zeros")
  0.0 !== -0.0 || raise("strict identity distinguishes signed zeros")
  map_size(%{0.0 => 1, -0.0 => 2}) == 2 || raise("signed zeros remain distinct strict map keys")
  0
end
