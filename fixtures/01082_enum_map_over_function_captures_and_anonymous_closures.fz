#---
# purpose: "Enum.map over a list of captures, a list of one capture repeated and a list of anonymous closures returns one result per element"
# kind: run
# oracle: 01082_enum_map_over_function_captures_and_anonymous_closures.oracle.exs
#---
defmodule M do
  def id(x), do: x
  def inc(x), do: x + 1
  def go([]), do: []
  def go([h | t]), do: [h.(3) | go(t)]
end

def main() do
  dbg(Enum.map([&M.id/1, &M.inc/1], fn h -> h.(3) end))
  dbg(Enum.map([&M.id/1, &M.id/1, &M.id/1], fn h -> h.(3) end))
  dbg(M.go([&M.id/1, &M.id/1]))
  fs = [fn x -> x end, fn x -> x end]
  dbg(Enum.map(fs, fn h -> h.(3) end))
  dbg(Enum.count([&M.id/1, &M.id/1]))
end
