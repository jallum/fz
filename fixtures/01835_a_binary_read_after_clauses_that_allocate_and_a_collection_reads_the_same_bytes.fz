#---
# purpose: "a function whose first clause reads the bytes of a binary that lives on the process heap, whose middle clauses allocate (a binary field built as a view, float arithmetic) and whose last clause reads the bytes again, answers the same on every call of a loop that allocates enough to collect the heap many times between calls"
# oracle: self
# oracle.stamp: 9a081e24020b1d70
# args: 0
#---
defmodule Main do
  def pick(<<255, _r::binary>>, _f), do: 0
  def pick(<<_c, _r::binary>>, f) when f * 1.5 > 500.0, do: 1
  def pick(<<x::binary-size(2), _r::binary>>, _f) when byte_size(x) > 5, do: 2
  def pick(<<a, b, c, _r::binary>>, _f), do: a * 10_000 + b * 100 + c
  def pick(_, _f), do: -1

  # A binary of 3 bytes made at run time, so it lives on the heap.
  def subject(i), do: :binary.copy(<<rem(i, 200) + 1>>, 1) <> <<rem(i, 7) + 1, rem(i, 11) + 1>>

  # Garbage of about a kilobyte per call.
  def churn(i), do: length(Enum.to_list(1..(100 + rem(i, 3))))

  def run(i, n, acc) when i == n, do: acc

  def run(i, n, acc) do
    s = subject(i)
    junk = churn(i)
    run(i + 1, n, acc + pick(s, 1.0 + junk) - pick(s, 1.0))
  end

  def main() do
    n = 1_000 + String.to_integer(hd(System.argv()))
    IO.inspect(run(0, n, 0))
    IO.inspect(pick(subject(5), 1.0))
  end
end

Main.main()
