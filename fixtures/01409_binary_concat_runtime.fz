#---
# purpose: "public <> joins byte-aligned binaries across inline and BinView storage"
# oracle: self
# oracle.stamp: dc42f70276a72d56
#---
#
# Exercises the public `<>` wrapper over the runtime binary-concat export. The small
# case stays inline; the long case crosses the shared-binary threshold and
# therefore returns through the BinView path.
defmodule Main do
  def main() do
    small = "foo" <> "bar"
    long_left = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    long = long_left <> "bbbb"

    IO.inspect(small)
    IO.inspect(long)
    IO.inspect(String.valid?(long))
  end
end

Main.main()
