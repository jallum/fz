#---
# purpose: "two workers both block on receive simultaneously; exercises scheduler managing multiple Blocked processes"
#---
def worker(parent), do: send(parent, receive do x -> x * 2 end)

def main() do
  parent = self()
  first = spawn(fn () -> worker(parent) end)
  second = spawn(fn () -> worker(parent) end)
  send(first, 10)
  send(second, 11)
  a = receive do x -> x end
  b = receive do x -> x end
  a == 20 || raise("first worker doubled 10")
  b == 22 || raise("second worker doubled 11")
end
