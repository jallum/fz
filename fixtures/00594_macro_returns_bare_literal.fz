#---
# purpose: a macro whose body is a bare literal returns that literal, the same as Elixir -- quote do: 1, a bare 2, an atom, nil, a string, and a 2-tuple
#---
defmacro quoted_one() do
  quote do: 1
end

defmacro bare_two() do
  2
end

defmacro bare_atom() do
  :ok
end

defmacro bare_nil() do
  nil
end

defmacro bare_string() do
  "s"
end

defmacro bare_tuple() do
  {1, 2}
end

def main() do
  quoted_one() == 1 || raise("quote do: 1 returns the literal 1")
  bare_two() == 2 || raise("a macro body that is a bare 2 returns 2")
  bare_atom() == :ok || raise("a macro body that is a bare atom returns that atom")
  bare_nil() == nil || raise("a macro body that is bare nil returns nil")
  bare_string() == "s" || raise("a macro body that is a bare string returns that string")
  bare_tuple() == {1, 2} || raise("a macro body that is a bare 2-tuple returns that tuple")
end
