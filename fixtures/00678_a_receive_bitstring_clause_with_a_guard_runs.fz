#---
# purpose: "a receive clause that reads a binary and carries a guard takes its body only when the guard holds"
# oracle: self
# oracle.stamp: 9bbe48634d9e26e3
#---
defmodule Main do
  def main() do
    send(self(), "ahi")
    receive do
      <<a, r::binary>> when a == 98 -> IO.inspect({:b, r})
      <<a, r::binary>> when a == 97 -> IO.inspect({:a, r})
    end
  end
end

Main.main()
