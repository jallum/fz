#---
# purpose: "A top-level call to a module defined above it runs: the module is defined once, and the call is a statement of main/0"
# kind: run
# oracle: 00645_a_top_level_call_reaches_a_module_defined_above_it.oracle.exs
#---
defmodule M do
  def go(a), do: dbg(a)
end

M.go(1)
dbg(:between)
M.go(2)
