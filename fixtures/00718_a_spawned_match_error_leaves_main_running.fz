#---
# purpose: "a spawned process whose = matches nothing raises MatchError and ends; main carries on and the program exits 0"
# oracle: self
# oracle.stamp: d0a388a64c78cbd5
#---
# Elixir's logger writes to stderr, so only the program's own output is
# compared; the failure line is pinned as this program's diagnostics.
defmodule Main do
  defp fetch(), do: {:error, :closed}

  def main() do
    parent = self()
    spawn(fn () ->
      send(parent, :child_started)
      {:ok, value} = fetch()
      send(parent, value)
    end)
    receive do
      message -> IO.inspect(message)
    end
    IO.inspect(:main_carried_on)
  end
end

Main.main()
