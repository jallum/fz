#---
# purpose: "Stream.map over a list runs nothing until an Enum function pulls: Enum.take(1) runs the function once, and Stream.map alone runs it never"
# oracle: self
# oracle.stamp: e0fd78b2d4cac8a1
#---
defmodule Main do
  def main() do
    stream = Stream.map([1, 2, 3], fn x -> IO.inspect(x) end)
    IO.inspect(:built)
    IO.inspect(Enum.take(stream, 1))
  end
end

Main.main()
