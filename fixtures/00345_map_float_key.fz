#---
# purpose: a map with a float key allocates no box for the float on any path, and the map itself only where it is built at run time: the interpreter builds it, compiled code reads it as program data
#---
def main() do
  m = %{3.14 => :ok}
  dbg(m)
  stats = System.alloc_stats()
  dbg(stats[:map_allocs])
  dbg(stats[:scalar_box_allocs])
end
