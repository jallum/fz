#---
# purpose: a function defined in one module is imported and called from another module, resolving and executing across that module boundary.
#---
defmodule Math do
  def add(x, y), do: x + y
end
defmodule User do
  import Math, only: [add: 2]
  def run(), do: add(20, 22) + 1
end
def main(), do: User.run()
