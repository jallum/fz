#---
# purpose: "a macro that computes the name of the module that invokes it and calls a function through that name runs while that module is being defined, so the function is not available yet: the one diagnostic names the function at the call"
# expect: diagnostic
#---
defmodule Helper do
  defmacro make() do
    mod = String.to_atom("Elixir.M")
    n = mod.seven()
    quote do
      def f(), do: unquote(n)
    end
  end
end

defmodule M do
  import Helper
  def seven(), do: 7
  make()
end

def main() do
  dbg(M.f())
end
