#---
# purpose: receive in main returns the value sent by a spawned child
#---
def child() do
  parent = receive do x -> x end
  send(parent, 42)
end
def main() do
  child = spawn(child)
  send(child, self())
  assert((receive do x -> x end) == 42, "receive in main returns the value sent by the spawned child")
end
