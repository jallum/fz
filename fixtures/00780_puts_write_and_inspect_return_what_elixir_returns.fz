#---
# purpose: "IO.puts and IO.write return :ok, IO.inspect and dbg return their argument unchanged, so each can be printed again by the next call"
# oracle: 00780_puts_write_and_inspect_return_what_elixir_returns.oracle.exs
#---
def main() do
  IO.inspect(IO.puts("x"))
  IO.inspect(IO.write("y\n"))
  IO.inspect(IO.inspect([1, "s"]))
  dbg(dbg(1))
  IO.inspect(dbg({:a, 2.5}))
end
