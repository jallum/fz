#---
# purpose: "catch :error, value binds the raised value as raised: an exception stays the exception, a plain reason stays the reason and is not wrapped in ErlangError"
# oracle: self
# oracle.stamp: 7a44db99b231c78c
#---
defmodule Main do
  def attempt(f) do
    f.()
  catch
    :error, value -> value
  end

  def main() do
    IO.inspect(attempt(fn () -> :erlang.error(:bare_reason) end))
    IO.inspect(attempt(fn () -> raise ArgumentError, "bad" end).message)
    IO.inspect(attempt(fn () -> raise ArgumentError, "bad" end).__struct__)
  end
end

Main.main()
