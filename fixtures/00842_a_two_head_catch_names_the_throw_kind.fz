#---
# purpose: "catch :throw, value is the two-head spelling of the one-head catch, and a throw from a called function reaches it"
# oracle: self
# oracle.stamp: 6188ab6fc28d0bd1
#---
defmodule Main do
  def find(items) do
    case items do
      [] -> :none
      [first | _] -> throw({:first, first})
    end
  end

  def main() do
    result = try do
      find([7, 8])
    catch
      :throw, {:first, value} -> value
    end
    IO.inspect(result)
  end
end

Main.main()
