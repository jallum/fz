#---
# purpose: "a protocol call on a receiver type with no implementation compiles and raises Protocol.UndefinedError naming the protocol and the kind of the value, and the process exits 1"
# expect: abort
#---
defprotocol P do
  def each(value)
end

defimpl P, for: List do
  def each(value), do: value
end

def main(), do: P.each(42)
