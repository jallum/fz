#---
# purpose: double negation round-trips an integer literal, including zero and large magnitudes
#---
def main() do
  -(-(42)) == 42 || raise("double negation round-trips 42")
  -(-(0)) == 0 || raise("double negation round-trips 0")
  -(-(1)) == 1 || raise("double negation round-trips 1")
  -(-(-1)) == -1 || raise("double negation round-trips -1")
  -(-(-42)) == -42 || raise("double negation round-trips -42")
  -(-(1000000000)) == 1000000000 || raise("double negation round-trips a large literal")
end
