#---
# purpose: "a receive with an empty mailbox and nothing else able to run times out after 1ms and the program continues"
# oracle: self
# oracle.stamp: b8844d8c9d70b34a
#---
defmodule Main do
  def main() do
    receive do
      :never -> IO.inspect(:got)
    after
      1 -> IO.inspect(:timeout)
    end
    IO.inspect(:end)
  end
end

Main.main()
