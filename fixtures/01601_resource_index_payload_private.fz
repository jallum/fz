#---
# purpose: resource payloads do not leak through non-atom map indexing outside the owning module: indexing a resource is refused as Access.get/3 refuses any value it has no clause for
#---
defmodule R do
  @type t :: opaque resource(integer)

  def make(), do: make_resource(42, &drop/1)
  def drop(_), do: nil
end

def main() do
  h = R.make()

  refused =
    try do
      h[0]
    rescue
      FunctionClauseError -> :refused
    end

  dbg(refused)
end
