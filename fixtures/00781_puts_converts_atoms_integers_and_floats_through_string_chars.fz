#---
# purpose: "IO.puts and IO.write convert any String.Chars value as Elixir does: an atom prints its name, an integer its digits, a float its shortest round-trip text, nil prints nothing"
# oracle: self
# oracle.stamp: df647523761bea8a
#---
defmodule Main do
  def main() do
    IO.puts(:atom)
    IO.puts(1)
    IO.puts(1.5)
    IO.puts(-0.25)
    IO.puts(nil)
    IO.puts(true)
    IO.write(:w)
    IO.write(42)
    IO.write("\n")
  end
end

Main.main()
