#---
# purpose: "a receive finds the message sent to itself before a runnable child gets to send, even when the child's clause is listed first"
# oracle: self
# oracle.stamp: 444802dd211cdbc6
#---
defmodule Main do
  def main() do
    me = self()
    spawn(fn () -> send(me, :child) end)
    send(me, :parent)
    v = receive do
      :child -> :got_child
      :parent -> :got_parent
    end
    IO.inspect(v)
  end
end

Main.main()
