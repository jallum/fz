#---
# purpose: "String.slice/3 counts graphemes, reads a negative start from the end, clamps it, and raises FunctionClauseError for a negative length"
# oracle: 01061_slice_counts_graphemes_from_either_end.oracle.exs
#---
def main() do
  s = "héllo"
  dbg(String.slice(s, 1, 3))
  dbg(String.slice(s, 0, 5))
  dbg(String.slice(s, 3, 100))
  dbg(String.slice(s, -3, 2))
  dbg(String.slice(s, -10, 2))
  dbg(String.slice(s, 10, 2))
  dbg(String.slice(s, 5, 2))
  dbg(String.slice(s, 2, 0))
  dbg(String.slice("", 0, 3))
  dbg(String.slice("", -1, 3))
  accent = <<101, 204, 129, 120, 121>>
  dbg(String.slice(accent, 0, 1))
  dbg(String.slice(accent, 1, 1))
  dbg(String.slice(accent, -2, 2))
  try do
    String.slice(s, 0, -1)
  rescue
    e -> dbg({e.__struct__, e.message})
  end
end
