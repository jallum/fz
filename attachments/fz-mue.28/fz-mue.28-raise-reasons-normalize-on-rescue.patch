diff --git a/fixtures/01913_a_catch_clause_sees_the_erlang_reason_of_a_failed_clause_match_or_arithmetic.fz b/fixtures/01913_a_catch_clause_sees_the_erlang_reason_of_a_failed_clause_match_or_arithmetic.fz
