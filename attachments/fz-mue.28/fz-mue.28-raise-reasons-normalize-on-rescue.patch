 /// Builds `term` on the current process's heap.
+/// The Erlang reason `reason` writes, with `given` as the plan's leading
+/// inputs: the first is the subject.
+fn reason_value(runtime: &mut IrInterpRuntime, reason: &ReasonTerm, given: &[AnyValue]) -> Result<AnyValue, String> {
+    let proc = runtime.cur_proc();
+    match reason {
+        ReasonTerm::Ground(value) => literal_value(runtime, value),
+        ReasonTerm::Subject => given
+            .first()
+            .copied()
+            .ok_or_else(|| "internal error: a reason reads a subject its plan lacks".to_string()),
+        ReasonTerm::Tuple(items) => {
+            let items = items
+                .iter()
+                .map(|item| reason_value(runtime, item, given))
+                .collect::<Result<_, _>>()?;
+            make_tuple_on_proc(proc, items)
+        }
+    }
