@@ -0,0 +1,72 @@
+#---
+# purpose: "catch :error, reason binds the Erlang term (:function_clause, {:badmatch, v}, {:case_clause, v}, ...) of an error the compiler raises, and the struct of one a program raises"
+# oracle: self
+# oracle.stamp: e4762cf646622321
+#---
+defmodule Main do
+  def one(1), do: :one
+
+  def quotient(a, b), do: div(a, b)
+
+  def match(a), do: {:ok, _} = a
+
+  def pick(a) do
+    case a do
+      :yes -> 1
+    end
+  end
+
+  def conditions(a) do
+    cond do
+      a == 1 -> :one
+    end
+  end
+
+  def withed(a) do
+    with :ok <- a do
+      :done
+    else
+      :fine -> :unreachable
+    end
+  end
+
+  def elsed(a) do
+    try do
+      a
+    catch
+      _, _ -> :unreachable
+    else
+      :expected -> :unreachable
+    end
+  end
+
+  def both(a, b), do: a and b
+
+  def caught(fun) do
+    try do
+      fun.()
+    catch
+      kind, reason -> {kind, reason}
+    end
+  end
+
+  def main() do
+    IO.inspect(caught(fn -> one(2) end))
+    IO.inspect(caught(fn -> quotient(1, 0) end))
+    IO.inspect(caught(fn -> match(:b) end))
+    IO.inspect(caught(fn -> pick(:no) end))
+    IO.inspect(caught(fn -> conditions(2) end))
+    IO.inspect(caught(fn -> withed(:other) end))
+    IO.inspect(caught(fn -> elsed(:unexpected) end))
+    IO.inspect(caught(fn -> both(1, true) end))
+    IO.inspect(caught(fn -> throw(:ball) end))
+    IO.inspect(caught(fn -> exit(:gone) end))
+    IO.inspect(caught(fn -> raise "text" end))
+    IO.inspect(caught(fn -> :erlang.error(:boom) end))
+    IO.inspect(caught(fn -> :erlang.error({:badmatch, 1}) end))
+    IO.inspect(caught(fn -> raise %MatchError{term: 1} end))
+    IO.inspect(caught(fn -> raise ArgumentError, "text" end))
+  end
+end
+
+Main.main()
