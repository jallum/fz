index 000000000..2da6c24d0
--- /dev/null
+++ b/fixtures/01914_a_rescue_clause_sees_the_exception_of_an_erlang_reason_raised_again.fz
@@ -0,0 +1,42 @@
+#---
+# purpose: "rescue normalises an Erlang reason to its exception, and an uncaught function clause names the function"
+# expect: abort
+# oracle: self
+# oracle.stamp: 093b668f6949807f
+#---
+defmodule Main do
+  def one(1), do: :one
+
+  def match(a), do: {:ok, _} = a
+
+  def again(fun) do
+    try do
+      fun.()
+    catch
+      kind, reason -> :erlang.raise(kind, reason, __STACKTRACE__)
+    end
+  end
+
+  def rescued(fun) do
+    try do
+      fun.()
+    rescue
+      e in FunctionClauseError -> {:function_clause, e.__struct__}
+      e in MatchError -> {:match, e.term}
+      e in ErlangError -> {:erlang, e.original}
+    end
+  end
+
+  def main() do
+    IO.inspect(rescued(fn -> again(fn -> one(2) end) end))
+    IO.inspect(rescued(fn -> again(fn -> match(:b) end) end))
+    IO.inspect(rescued(fn -> :erlang.error(:function_clause) end))
+    IO.inspect(rescued(fn -> :erlang.error({:badmatch, 3}) end))
+    IO.inspect(rescued(fn -> :erlang.error(:boom) end))
+    IO.inspect(rescued(fn -> one(2) end))
+    IO.inspect(rescued(fn -> raise %MatchError{term: 4} end))
+    one(2)
+  end
+end
+
+Main.main()
