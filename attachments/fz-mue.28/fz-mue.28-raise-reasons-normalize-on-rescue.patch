diff --git a/lib/exception.fz b/lib/exception.fz
index 77d0d5fff..79cfda57c 100644
--- a/lib/exception.fz
+++ b/lib/exception.fz
@@ -13,14 +13,75 @@ defmodule Exception do
   @spec message(any) :: any
   def message(exception), do: exception.__struct__.message(exception)
 
+  @doc """
+  Returns the exception a `rescue` sees of a raised value, as Elixir's
+  `Exception.normalize/3` does for `:error`. An exception is itself. An Erlang
+  reason that is the normal form of an exception (`:function_clause`,
+  `{:badmatch, term}`, ...) is that exception. Any other value is an
+  `ErlangError` holding it. The two reasons fz tags itself carry what Elixir
+  keeps in the stacktrace: the module, function and arity of a function clause
+  and of an undefined call.
+
+  ## Examples
+
+      Exception.__normalize__({:badmatch, :b})
+      #=> %MatchError{term: :b}
+
+      Exception.__normalize__(:boom)
+      #=> %ErlangError{original: :boom}
+
+  """
+  # An exception is built by its own module, chosen by the reason's shape, so a
+  # program defines only the exceptions its reasons are of, and the call's
+  # result is the struct of exactly those modules.
+  @spec __normalize__(any) :: any
+  def __normalize__(%{__exception__: true} = exception), do: exception
+  def __normalize__(reason), do: exception_module(reason).__from_reason__(reason)
+
+  @spec exception_module(any) :: atom
+  defp exception_module({:__fz_function_clause__, _module, _function, _arity}), do: FunctionClauseError
+  defp exception_module({:__fz_undefined_function__, _module, _function, _arity, _message}), do: UndefinedFunctionError
+  defp exception_module({:case_clause, _term}), do: CaseClauseError
+  defp exception_module({:badmatch, _term}), do: MatchError
+  defp exception_module(:cond_clause), do: CondClauseError
+  defp exception_module({:else_clause, _term}), do: WithClauseError
+  defp exception_module({:try_clause, _term}), do: TryClauseError
+  defp exception_module({:badbool, _operator, _term}), do: BadBooleanError
+  defp exception_module({:badmap, _term}), do: BadMapError
+  defp exception_module(:badarith), do: ArithmeticError
+  defp exception_module(:badarg), do: ArgumentError
+  defp exception_module(:function_clause), do: FunctionClauseError
+  defp exception_module(:undef), do: UndefinedFunctionError
+  defp exception_module(_reason), do: ErlangError
+
+  @doc """
+  Returns the reason a `catch :error, reason` clause binds for a raised
+  `value`: the Erlang reason Elixir raises. The reasons fz tags itself are
+  trimmed to the atoms Elixir shows, `:function_clause` and `:undef`; every
+  other value, exception structs included, is its own reason.
+
