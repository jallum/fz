defmodule Map do
  @moduledoc """
  A map of up to 32 entries is a flat sorted array; a map of more is a hash
  trie.

  In a flat map keys stay in sorted order, so `get/2` and `has_key?/2` are
  binary searches; in a trie they follow the key's hash. `put/3` and
  `delete/2` copy the whole array of a flat map, and the nodes on one path of
  a trie, so a loop of them over `n` keys is `O(n)` copies of at most 32
  entries once the map is a trie. `new/1`, `merge/2`, `take/2`, `drop/2`,
  `filter/2`, and `split/2` each do one pass and one allocation instead --
  reach for one of those when a call site touches several keys.

  Keys use strict structural identity: independently built equal tuples,
  lists, maps, and binaries are the same key, and the last input value wins.
  Integer and float keys stay distinct, including inside composite keys.
  Closures use their source function and complete captured values; resources
  keep their identity across copying and garbage collection.

  Iteration of a map of up to 32 entries follows fz key order; above 32 it
  follows the trie, an order fixed by the keys' hashes. `Enum.sort/1` on the
  entries orders any map. Binary keys sort by content, as in Elixir.
  Atom keys sort by name, using the same order as `Kernel.compare/2` and
  `Enum.sort/1`; Elixir orders atoms by VM identity instead, so atom-keyed map
  iteration can differ between the two runtimes.
  """

  # One pass, one allocation each. Reach for these when working with several keys.

  @doc """
  Builds a map from a list of `{key, value}` pairs. When a key repeats,
  the last pair wins.

  ## Examples

      Map.new([{:a, 1}, {:b, 2}])
      #=> %{:a => 1, :b => 2}

      Map.new([{:a, 1}, {:a, 2}])
      #=> %{:a => 2}

  """
  @spec new([{any, any}]) :: any
  def new(pairs), do: build(pairs, [], [])

  @doc """
  Builds a map from the `{key, value}` pairs that `fun` returns for each
  element of `enumerable`. When a key repeats, the last pair wins.

  ## Examples

      Map.new([1, 2, 3], fn (n) -> {n, n * n} end)
      #=> %{1 => 1, 2 => 4, 3 => 9}

  """
  @spec new(any, (any -> {any, any})) :: any
  def new(enumerable, fun), do: new(Enum.map(enumerable, fun))

  @doc """
  Merges `a` and `b` into one map. Where both have a key, `b`'s value wins.

  One pass, one allocation.

  ## Examples

      Map.merge(%{a: 1, b: 2}, %{b: 3, c: 4})
      #=> %{:a => 1, :b => 3, :c => 4}

  """
  @spec merge(any, any) :: any
  def merge(a, b), do: build(to_list(a) ++ to_list(b), [], [])

  @doc """
  Returns a new map with only the given `keys`.

  Keys with no entry in `map` are ignored. One pass, one allocation.

  ## Examples

      Map.take(%{a: 1, b: 2, c: 3}, [:a, :c])
      #=> %{:a => 1, :c => 3}

      Map.take(%{a: 1, b: 2, c: 3}, [:a, :zzz])
      #=> %{:a => 1}

  """
  @spec take(any, [any]) :: any
  def take(map, keys), do: build(taken(map, keys, []), [], [])

  @doc """
  Returns a new map without the given `keys`.

  Keys with no entry in `map` are ignored. One pass, one allocation.

  ## Examples

      Map.drop(%{a: 1, b: 2, c: 3}, [:b])
      #=> %{:a => 1, :c => 3}

  """
  @spec drop(any, [any]) :: any
  def drop(map, keys), do: build(dropped(to_list(map), keys, []), [], [])

  @doc """
  Returns a new map keeping only the `{key, value}` pairs for which `fun`
  returns true.

  One pass, one allocation.

  ## Examples

      Map.filter(%{a: 1, b: 2, c: 3}, fn ({_k, v}) -> rem(v, 2) == 1 end)
      #=> %{:a => 1, :c => 3}

  """
  @spec filter(any, ({any, any} -> boolean)) :: any
  def filter(map, fun), do: build(kept(to_list(map), fun, []), [], [])

  @doc """
  Returns `{taken, dropped}`: the given `keys` and everything else, as two
  maps.

  Equivalent to `{take(map, keys), drop(map, keys)}`, one pass each.

  ## Examples

      Map.split(%{a: 1, b: 2, c: 3}, [:a, :c])
      #=> {%{:a => 1, :c => 3}, %{:b => 2}}

  """
  @spec split(any, [any]) :: {any, any}
  def split(map, keys), do: {take(map, keys), drop(map, keys)}

  # Splits the pair list into parallel key and value lists, which is what the
  # one-allocation builder takes.
  @spec build([{a, b}], [a], [b]) :: any when a: var, b: var
  defp build([], ks, vs), do: fz_map_from_kv(reverse(ks, []), reverse(vs, []))
  defp build([{k, v} | t], ks, vs), do: build(t, [k | ks], [v | vs])

  extern "fz" defp fz_map_from_kv(any, any) :: any

  @spec taken(any, [any], [{any, any}]) :: [{any, any}]
  defp taken(_map, [], acc), do: reverse(acc, [])
  defp taken(map, [k | t], acc) do
    case map do
      %{^k => v} -> taken(map, t, [{k, v} | acc])
      %{} -> taken(map, t, acc)
      other -> raise(%BadMapError{term: other})
    end
  end

  @spec dropped([{a, b}], [any], [{a, b}]) :: [{a, b}] when a: var, b: var
  defp dropped([], _keys, acc), do: reverse(acc, [])
  defp dropped([{k, v} | t], keys, acc), do: dropped(t, keys, drop_one({k, v}, keys, acc, key_listed?(keys, k)))
  @spec drop_one({a, b}, [any], [{a, b}], boolean) :: [{a, b}] when a: var, b: var
  defp drop_one(_pair, _keys, acc, true), do: acc
  defp drop_one(pair, _keys, acc, false), do: [pair | acc]

  @spec kept([{a, b}], ({a, b} -> boolean), [{a, b}]) :: [{a, b}] when a: var, b: var
  defp kept([], _fun, acc), do: reverse(acc, [])
  defp kept([pair | t], fun, acc), do: kept(t, fun, keep_one(pair, acc, fun.(pair)))
  @spec keep_one({a, b}, [{a, b}], boolean) :: [{a, b}] when a: var, b: var
  defp keep_one(pair, acc, true), do: [pair | acc]
  defp keep_one(_pair, acc, false), do: acc

  @spec key_listed?([any], any) :: boolean
  defp key_listed?([], _v), do: false
  defp key_listed?([h | t], v), do: key_listed_or?(h === v, t, v)
  @spec key_listed_or?(boolean, [any], any) :: boolean
  defp key_listed_or?(true, _t, _v), do: true
  defp key_listed_or?(false, t, v), do: key_listed?(t, v)

  # Each of these copies the whole array of a flat map and one path of a trie.

  @doc """
  Returns the map with `value` set for `key`, overwriting any existing
  entry.

  Copies the whole array of a flat map and one path of a trie; prefer `new/1`
  or `merge/2` for several keys.

  ## Examples

      Map.put(%{a: 1}, :b, 2)
      #=> %{:a => 1, :b => 2}

      Map.put(%{a: 1}, :a, 99)
      #=> %{:a => 99}

  """
  @spec put(any, any, any) :: any
  def put(map, key, value), do: fz_map_put(map, key, value)

  extern "fz" defp fz_map_put(any, stored_value, stored_value) :: any

  @doc """
  Returns the value for `key`, or `nil` when the key is absent.

  ## Examples

      Map.get(%{a: 1}, :a)
      #=> 1

      Map.get(%{a: 1}, :b)
      #=> nil

  """
  @spec get(any, any) :: any
  def get(map, key), do: map[key]

  @doc """
  Returns the value for `key`, or `default` when the key is absent.

  ## Examples

      Map.get(%{a: 1}, :a, 0)
      #=> 1

      Map.get(%{a: 1}, :b, 0)
      #=> 0

  """
  @spec get(any, any, any) :: any
  def get(map, key, default) do
    case map do
      %{^key => value} -> value
      %{} -> default
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Returns `{:ok, value}` for `key`, or `:error` when the key is absent.

  Unlike `get/2`, a stored `nil` is told apart from a missing key.

  ## Examples

      Map.fetch(%{a: 1}, :a)
      #=> {:ok, 1}

      Map.fetch(%{a: nil}, :a)
      #=> {:ok, nil}

      Map.fetch(%{a: 1}, :b)
      #=> :error

  """
  @spec fetch(any, any) :: {:ok, any} | :error
  def fetch(map, key) do
    case map do
      %{^key => value} -> {:ok, value}
      %{} -> :error
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Returns the value for `key`, and aborts with `KeyError` when the key is
  absent.

  ## Examples

      Map.fetch!(%{a: 1}, :a)
      #=> 1

  """
  @spec fetch!(any, any) :: any
  def fetch!(map, key) do
    case map do
      %{^key => value} -> value
      %{} -> key_error(map, key)
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Aborts with the `KeyError` for a `key` absent from `container`. `Map` and
  `Keyword` both fail a missing key through it, so the message is built once.

  ## Examples

      Map.key_error([], :b)
      # ** (KeyError) key :b not found in:
      #
      #     []
  """
  @spec key_error(any, any) :: no_return()
  def key_error(container, key),
    do: raise(%KeyError{key: key, term: container})

  @doc """
  Aborts with the `KeyError` for `%{map | ...}` naming a key `map` lacks:
  the first of `keys` absent from `map`. The update has already found one
  missing, so it raises without making a map.

  ## Examples

      Map.update_key_error(%{a: 1}, [:a, :b])
      # ** (KeyError) key :b not found
  """
  @spec update_key_error(any, [any]) :: no_return()
  def update_key_error(map, keys),
    do: raise(%KeyError{key: first_missing_key(map, keys)})

  @spec first_missing_key(any, [any]) :: any
  defp first_missing_key(map, [key | keys]), do: first_missing_key(map, key, keys, fz_map_has_key(map, key))

  @spec first_missing_key(any, any, [any], boolean) :: any
  defp first_missing_key(map, _key, keys, true), do: first_missing_key(map, keys)
  defp first_missing_key(_map, key, _keys, false), do: key

  @doc """
  Returns the map with `fun` applied to the value at `key`, and aborts with
  `KeyError` when the key is absent.

  Copies as `put/3` does.

  ## Examples

      Map.update!(%{a: 1}, :a, fn (v) -> v + 1 end)
      #=> %{:a => 2}

  """
  @spec update!(any, any, (any -> any)) :: any
  def update!(map, key, fun) do
    case map do
      %{^key => value} -> put(map, key, fun.(value))
      %{} -> key_error(map, key)
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Puts `value` under `key` when `map` already has `key`, and returns `map`
  unchanged when it does not.

  ## Examples

      Map.replace(%{a: 1}, :a, 2)
      #=> %{a: 2}

      Map.replace(%{a: 1}, :b, 2)
      #=> %{a: 1}

  """
  @spec replace(any, any, any) :: any
  def replace(map, key, value) do
    case map do
      %{^key => _} -> put(map, key, value)
      %{} -> map
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Puts `value` under `key` when `map` already has `key`, and raises `KeyError`
  when it does not.

  ## Examples

      Map.replace!(%{a: 1}, :a, 2)
      #=> %{a: 2}

      Map.replace!(%{a: 1}, :b, 2)
      # ** (KeyError) key :b not found in:
      #
      #     %{a: 1}

  """
  @spec replace!(any, any, any) :: any
  def replace!(map, key, value) do
    case map do
      %{^key => _} -> put(map, key, value)
      %{} -> key_error(map, key)
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Returns the map with `fun` applied to the value at `key`, or with `key`
  put to `default` when it is absent. `fun` is not called for an absent key.

  Copies as `put/3` does.

  ## Examples

      Map.update(%{a: 1}, :a, 0, fn (v) -> v + 1 end)
      #=> %{:a => 2}

      Map.update(%{a: 1}, :b, 0, fn (v) -> v + 1 end)
      #=> %{:a => 1, :b => 0}

  """
  @spec update(map, any, any, (any -> any)) :: map
  def update(map, key, default, fun) do
    case map do
      %{^key => value} -> put(map, key, fun.(value))
      %{} -> put(map, key, default)
      other -> raise(%BadMapError{term: other})
    end
  end

  @doc """
  Returns the map without `key`, or `map` unchanged if `key` is absent.

  Copies as `put/3` does; prefer `drop/2` for removing several keys.

  ## Examples

      Map.delete(%{a: 1, b: 2}, :a)
      #=> %{:b => 2}

      Map.delete(%{a: 1}, :zzz)
      #=> %{:a => 1}

  """
  @spec delete(any, any) :: any
  def delete(map, key), do: fz_map_delete(map, key)

  extern "fz" defp fz_map_delete(any, any) :: any

  @doc """
  Returns the entries as a `{key, value}` list, in the map's iteration order.

  ## Examples

      Map.to_list(%{"b" => 2, "a" => 1, "c" => 3})
      #=> [{"a", 1}, {"b", 2}, {"c", 3}]

  """
  @spec to_list(any) :: [{any, any}]
  def to_list(map), do: to_list(map, map_size(map), 0, [])

  @doc """
  Returns just the keys, in the map's iteration order.

  ## Examples

      Map.keys(%{"b" => 2, "a" => 1, "c" => 3})
      #=> ["a", "b", "c"]

  """
  @spec keys(any) :: [any]
  def keys(map), do: keys(map, map_size(map), 0, [])

  @doc """
  Returns just the values, in the map's iteration order.

  ## Examples

      Map.values(%{"b" => 2, "a" => 1, "c" => 3})
      #=> [1, 2, 3]

  """
  @spec values(any) :: [any]
  def values(map), do: values(map, map_size(map), 0, [])

  @doc """
  Returns true when `key` is present in `map`.

  A binary search, like `get/2` and `get/3`.

  ## Examples

      Map.has_key?(%{a: 1}, :a)
      #=> true

      Map.has_key?(%{a: 1}, :b)
      #=> false

  """
  @spec has_key?(any, any) :: boolean
  def has_key?(map, key) when is_map(map), do: fz_map_has_key(map, key)
  def has_key?(map, _key), do: raise(%BadMapError{term: map})

  extern "fz" defp fz_map_has_key(any, any) :: boolean

  extern "fz" defp fz_map_entry_key(any, integer) :: any

  @spec keys(any, integer, integer, [any]) :: [any]
  defp keys(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      keys(map, count, index + 1, [fz_map_entry_key(map, index) | acc])
    end
  end

  @spec values(any, integer, integer, [any]) :: [any]
  defp values(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      values(map, count, index + 1, [fz_map_entry_value(map, index) | acc])
    end
  end

  extern "fz" defp fz_map_entry_value(any, integer) :: any

  @doc """
  The `Enumerable.reduce/3` callback body for maps.

  Called by `Enumerable`, not usually by hand; reach for `Enum.reduce/3`
  and friends instead.

  ## Examples

      Map.reduce(%{a: 1, b: 2}, {:cont, 0}, fn ({_k, v}, acc) -> {:cont, acc + v} end)
      #=> {:done, 3}

  """
  @spec reduce(any, {:cont, b} | {:halt, b} | {:suspend, b}, (any, b -> {:cont, b} | {:halt, b} | {:suspend, b})) :: {:done, b} | {:halted, b} | {:suspended, b, (-> any)} when b: var
  def reduce(map, acc, reducer), do: reduce(map, map_size(map), acc, reducer)

  @doc """
  The `Enumerable.reduce_while/3` callback body for maps.

  Called by `Enumerable`, not usually by hand; reach for
  `Enum.reduce_while/3` instead.

  ## Examples

      Map.reduce_while(%{a: 1, b: 2, c: 3}, 0, fn ({_k, v}, acc) ->
        if v == 2 do
          {:halt, acc}
        else
          {:cont, acc + v}
        end
      end)
      #=> 1

  """
  @spec reduce_while(any, b, (any, b -> {:cont, b} | {:halt, c})) :: b | c when b: var, c: var
  def reduce_while(map, acc, reducer), do: reduce_while_cont(map, map_size(map), 0, acc, reducer)

  @doc """
  Returns true when the `{key, value}` pair appears in `map`, the
  `Enumerable.member?/2` callback.

  Anything other than a `{key, value}` tuple is never a member.

  ## Examples

      Map.member?(%{a: 1}, {:a, 1})
      #=> true

      Map.member?(%{a: 1}, {:a, 2})
      #=> false

      Map.member?(%{a: 1}, :not_a_pair)
      #=> false

  """
  @spec member?(any, any) :: boolean
  def member?(map, {key, value}), do: member_pair?(map, map_size(map), 0, key, value)
  def member?(_map, _value), do: false

  @doc """
  Returns the `Enumerable.slice/1` contract for `map`: `{:ok, size,
  to_list}`, where `to_list` ignores its argument and returns the map's
  entries.

  ## Examples

      {:ok, n, to_list} = Map.slice(%{a: 1, b: 2})
      n
      #=> 2

      to_list.(nil)
      #=> [a: 1, b: 2]

  """
  @spec slice(any) :: {:ok, integer, any}
  def slice(map) do
    {:ok, map_size(map), (fn (_map) -> to_list(map) end)}
  end

  @spec reduce(any, integer, {:cont, b} | {:halt, b} | {:suspend, b}, (any, b -> {:cont, b} | {:halt, b} | {:suspend, b})) :: {:done, b} | {:halted, b} | {:suspended, b, (-> any)} when b: var
  defp reduce(map, count, {:cont, acc}, reducer), do: reduce_cont(map, count, 0, acc, reducer)
  defp reduce(_map, _count, {:halt, acc}, _reducer), do: {:halted, acc}
  defp reduce(map, count, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(map, count, 0, acc, reducer) end)}
  end

  @spec reduce_cont(any, integer, integer, b, (any, b -> {:cont, b} | {:halt, b} | {:suspend, b})) :: {:done, b} | {:halted, b} | {:suspended, b, (-> any)} when b: var
  defp reduce_cont(map, count, index, acc, reducer) do
    if index >= count do
      {:done, acc}
    else
      reduce_step(map, count, index, reducer.(entry(map, index), acc), reducer)
    end
  end

  @spec reduce_step(any, integer, integer, {:cont, b} | {:halt, b} | {:suspend, b}, (any, b -> {:cont, b} | {:halt, b} | {:suspend, b})) :: {:done, b} | {:halted, b} | {:suspended, b, (-> any)} when b: var
  defp reduce_step(map, count, index, {:cont, acc}, reducer), do: reduce_cont(map, count, index + 1, acc, reducer)
  defp reduce_step(_map, _count, _index, {:halt, acc}, _reducer), do: {:halted, acc}
  defp reduce_step(map, count, index, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(map, count, index + 1, acc, reducer) end)}
  end

  @spec reduce_while_cont(any, integer, integer, b, (any, b -> {:cont, b} | {:halt, c})) :: b | c when b: var, c: var
  defp reduce_while_cont(map, count, index, acc, reducer) do
    if index >= count do
      acc
    else
      reduce_while_step(map, count, index, reducer.(entry(map, index), acc), reducer)
    end
  end

  @spec reduce_while_step(any, integer, integer, {:cont, b} | {:halt, c}, (any, b -> {:cont, b} | {:halt, c})) :: b | c when b: var, c: var
  defp reduce_while_step(map, count, index, {:cont, acc}, reducer), do: reduce_while_cont(map, count, index + 1, acc, reducer)
  defp reduce_while_step(_map, _count, _index, {:halt, acc}, _reducer), do: acc

  @spec member_pair?(any, integer, integer, any, any) :: boolean
  defp member_pair?(map, count, index, key, value) do
    if index >= count do
      false
    else
      if fz_map_entry_key(map, index) === key and fz_map_entry_value(map, index) === value do
        true
      else
        member_pair?(map, count, index + 1, key, value)
      end
    end
  end

  @spec entry(any, integer) :: {any, any}
  defp entry(map, index) do
    {fz_map_entry_key(map, index), fz_map_entry_value(map, index)}
  end

  @spec to_list(any, integer, integer, [{any, any}]) :: [{any, any}]
  defp to_list(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      to_list(map, count, index + 1, [entry(map, index) | acc])
    end
  end

  @spec reverse([a], [b]) :: [a | b] when a: var, b: var
  defp reverse([], acc), do: acc
  defp reverse([head | tail], acc), do: reverse(tail, [head | acc])
end
