defmodule Macro do
  @moduledoc """
  Works with quoted code, as Elixir's `Macro` does.

  `escape/1`, `unescape_string/1`, `var/2`, `unique_var/2`,
  `quoted_literal?/1`, `expand_once/2`, `expand/2` and `to_string/1` are the
  only functions defined, and `to_string/1` only raises. The rest of Elixir's
  `Macro` (`prewalk/2` and the others), the options of `escape/2` and the escape map of `unescape_string/2`
  are not defined.
  """

  @doc """
  Returns the quoted variable `name` in `context`, as a `quote` in module
  `context` writes it. A context of `nil` is the variable the caller writes
  by that name.

  ## Examples

      Macro.var(:foo, nil)
      #=> {:foo, [], nil}

      Macro.var(:foo, Other)
      #=> {:foo, [], Other}

  """
  @spec var(atom, atom) :: {atom, list, atom}
  def var(name, context) when is_atom(name) and is_atom(context), do: {name, [], context}

  @doc """
  Returns a quoted variable `name` in `context` that no other variable is:
  its `counter` is one no expansion and no other call hands out.

  ## Examples

      Macro.unique_var(:x, __MODULE__) == Macro.unique_var(:x, __MODULE__)
      #=> false

  """
  @spec unique_var(atom, atom) :: {atom, list, atom}
  def unique_var(name, context) when is_atom(name) and is_atom(context) do
    {name, [counter: :erlang.unique_integer()], context}
  end

  @doc """
  Returns whether the given quoted expression is a literal.

  Atoms and numbers are always literals. Binaries, lists, tuples,
  maps, and structs are only literals if all of their terms are also literals.

  ## Examples

      Macro.quoted_literal?(quote(do: "foo"))
      #=> true

      Macro.quoted_literal?(quote(do: {"foo", 1}))
      #=> true

      Macro.quoted_literal?(quote(do: %{foo: "bar"}))
      #=> true

      Macro.quoted_literal?(quote(do: URI.parse("/")))
      #=> false

      Macro.quoted_literal?(quote(do: {foo, var}))
      #=> false

  """
  @spec quoted_literal?(any) :: boolean
  def quoted_literal?({:__aliases__, _, args}),
    do: quoted_literal?(args)

  def quoted_literal?({:__block__, _, [wrapped]}),
    do: quoted_literal?(wrapped)

  def quoted_literal?({:%, _, [left, right]}),
    do: quoted_literal?(left) and quoted_literal?(right)

  def quoted_literal?({:%{}, _, args}), do: quoted_literal?(args)
  def quoted_literal?({:{}, _, args}), do: quoted_literal?(args)
  def quoted_literal?({:__MODULE__, _, ctx}) when is_atom(ctx), do: true
  def quoted_literal?({:<<>>, _, segments}), do: Enum.all?(segments, &quoted_bitstring_segment?/1)
  def quoted_literal?({left, right}), do: quoted_literal?(left) and quoted_literal?(right)
  def quoted_literal?(list) when is_list(list), do: Enum.all?(list, &quoted_literal?/1)
  def quoted_literal?(term), do: is_atom(term) or is_number(term) or is_binary(term)

  @spec quoted_bitstring_segment?(term) :: boolean
  defp quoted_bitstring_segment?(term) when is_integer(term) or is_binary(term), do: true

  defp quoted_bitstring_segment?({:"::", _, [term, modifier]})
       when is_integer(term) or is_binary(term),
       do: quoted_bitstring_modifier?(modifier)

  defp quoted_bitstring_segment?(_other), do: false

  @spec quoted_bitstring_modifier?(term) :: boolean
  defp quoted_bitstring_modifier?({:-, _, [left, right]}),
    do: quoted_bitstring_modifier?(left) and quoted_bitstring_modifier?(right)

  defp quoted_bitstring_modifier?({atom, _, [size]})
       when atom in [:size, :unit] and is_integer(size),
       do: true

  defp quoted_bitstring_modifier?({:*, _, [left, right]})
       when is_integer(left) and is_integer(right),
       do: true

  defp quoted_bitstring_modifier?({modifier, _, ctx}) when is_atom(ctx) or ctx == [],
    do: modifier in [:big, :little, :native, :integer, :float, :binary, :bytes, :bitstring, :bits, :utf8, :utf16, :utf32, :signed, :unsigned]

  defp quoted_bitstring_modifier?(_other), do: false

  @doc """
  Renders quoted code as text. Elixir does so through `Code.quoted_to_algebra/2`
  and `Inspect.Algebra`, which are not defined here, so every call raises
  `RuntimeError`.

  ## Examples

      Macro.to_string(quote(do: 1 + 2))
      #=> ** (RuntimeError) Macro.to_string of quoted code is not supported yet

  """
  @spec to_string(any) :: no_return()
  def to_string(_tree), do: raise(RuntimeError, "Macro.to_string of quoted code is not supported yet")

  @doc """
  Expands the root node of `ast` once in `env`, without traversing it.

  Aliases become module atoms through `env.aliases`, `__MODULE__` becomes
  `env.module`, `__DIR__` the directory of `env.file`, `__ENV__` the env as
  quoted code (except in a match), and `__ENV__.field` that field's value.
  Unary `+` and `-` on an integer literal are computed. A function call, a
  variable, a literal and a `quote` come back unchanged, and so does a remote
  call of a module the env does not require.

  A call to a macro is expanded by the compiler, in the scope of the macro
  that is running, standing in `env.context`: `nil`, `:match` or `:guard`. The
  result is what the macro answers, with nothing in it expanded. A call the env
  proves is no macro (a special form, an imported function, a call on a module
  the env does not require) comes back unchanged without asking. Any other
  call is asked about, and comes back unchanged when the scope binds it to no
  macro.

  Only a macro that is running can ask the compiler. Expanding a call that may
  be a macro anywhere else raises `RuntimeError`.

  Everything but a macro call depends only on `ast` and `env`: a `%Macro.Env{}`
  built by hand expands as `__CALLER__` does. A macro call expands in the scope
  the running macro was called from, whatever its names are in `env`; `env`
  decides only which calls are asked about and the context they stand in.

  ## Examples

      env = %{__ENV__ | aliases: [{B, Foo.Bar}]}
      Macro.expand_once({:__aliases__, [], [:B, :Baz]}, env)
      #=> Foo.Bar.Baz

  """
  @spec expand_once(any, map) :: any
  def expand_once(ast, env), do: elem(do_expand_once(ast, env), 0)

  @doc """
  Expands the root node of `ast` in `env` until it no longer changes.

  Only the root node is expanded; see `expand_once/2` for what each root
  becomes.
  """
  @spec expand(any, map) :: any
  def expand(ast, env), do: expand_until(do_expand_once(ast, env), env)

  @spec expand_until({any, boolean}, map) :: any
  defp expand_until({ast, true}, env), do: expand_until(do_expand_once(ast, env), env)
  defp expand_until({ast, false}, _env), do: ast

  @spec do_expand_once(any, map) :: {any, boolean}
  defp do_expand_once({:__aliases__, _, list} = original, env) do
    case alias_receiver(list, env) do
      receiver when is_atom(receiver) ->
        {receiver, true}

      [head | tail] ->
        {expanded, _} = do_expand_once(head, env)

        if is_atom(expanded), do: {concat([expanded | tail]), true}, else: {original, false}
    end
  end

  defp do_expand_once({:__MODULE__, _, atom}, env) when is_atom(atom), do: {env.module, true}
  defp do_expand_once({:__DIR__, _, atom}, env) when is_atom(atom), do: {dirname(env.file), true}

  defp do_expand_once({:__ENV__, _, atom}, %{context: context} = env)
       when is_atom(atom) and context != :match do
    {escape_map(%{env | versioned_vars: escape_map(env.versioned_vars)}), true}
  end

  defp do_expand_once({{:., _, [{:__ENV__, _, atom}, field]}, _, []} = original, %{context: context} = env)
       when is_atom(atom) and is_atom(field) and context != :match do
    case Map.fetch(env, field) do
      {:ok, value} -> {escape_map(value), true}
      :error -> {original, false}
    end
  end

  defp do_expand_once({name, meta, context} = original, _env)
       when is_atom(name) and is_list(meta) and is_atom(context) do
    {original, false}
  end

  defp do_expand_once({name, meta, args} = original, env)
       when is_atom(name) and is_list(args) and is_list(meta) do
    arity = length(args)

    function_module = imported_from(env.functions, name, arity)

    cond do
      special_form?(name) -> {original, false}
      imported_from(env.macros, name, arity) != nil -> expand_call_once(original, env)
      name in [:+, :-] and arity == 1 and function_module == Kernel -> expand_unary(original, env, name)
      function_module != nil -> {original, false}
      true -> expand_call_once(original, env)
    end
  end

  defp do_expand_once({{:., _, [left, name]}, _, _args} = original, env) when is_atom(name) do
    {receiver, _} = do_expand_once(left, env)

    if is_atom(receiver) and receiver in env.requires, do: expand_call_once(original, env), else: {original, false}
  end

  defp do_expand_once(other, _env), do: {other, false}

  @spec expand_unary(tuple, map, atom) :: {any, boolean}
  defp expand_unary({_, _, [arg]} = original, env, name) do
    case expand_once(arg, env) do
      integer when is_integer(integer) -> {if(name == :-, do: -integer, else: integer), true}
      _other -> {original, false}
    end
  end

  @spec special_form?(atom) :: boolean
  defp special_form?(name) do
    name in [:%, :%{}, :&, :., :"::", :<<>>, :=, :^, :__CALLER__, :__STACKTRACE__, :__aliases__, :__block__,
             :__cursor__, :alias, :case, :cond, :fn, :for, :import, :quote, :receive, :require, :super, :try,
             :unquote, :unquote_splicing, :with, :{}]
  end

  @spec imported_from([{atom, [{atom, integer}]}], atom, integer) :: atom
  defp imported_from(imports, name, arity) do
    Enum.find_value(imports, fn {module, callables} ->
      if {name, arity} in callables, do: module
    end)
  end

  @spec expand_call_once(tuple, map) :: {any, boolean}
  defp expand_call_once(call, env), do: answered(call, fz_macro_expand(call, context_code(env.context)))

  @spec context_code(nil | :match | :guard) :: integer
  defp context_code(nil), do: 0
  defp context_code(:match), do: 1
  defp context_code(:guard), do: 2

  @spec answered(tuple, [integer | any]) :: {any, boolean}
  defp answered(call, [0]), do: {call, false}
  defp answered(_call, [1, expanded]), do: {expanded, true}

  defp answered(_call, [2]),
    do: raise(RuntimeError, "Macro.expand is waiting for the compiler to answer; this run of the macro is discarded")

  defp answered(_call, [3]),
    do: raise(RuntimeError, "Macro.expand of a macro call needs the compiler, which only a running macro can ask")

  extern "fz" defp fz_macro_expand(any, integer) :: any

  @spec alias_receiver([any], map) :: atom | [any]
  defp alias_receiver([:Elixir | rest], _env), do: concat(rest)

  defp alias_receiver([head | tail] = list, env) when is_atom(head) do
    short = short_atom(head)

    case Enum.find(env.aliases, fn {name, _full} -> name == short end) do
      {_short, full} -> concat([full | tail])
      nil -> concat(list)
    end
  end

  defp alias_receiver(list, _env), do: list

  @spec short_atom(atom) :: atom
  defp short_atom(name), do: String.to_atom("Elixir." <> Kernel.to_string(name))

  @spec concat([any]) :: atom
  defp concat(parts) do
    String.to_atom("Elixir." <> Enum.map_join(Enum.reject(parts, &is_nil/1), ".", &segment/1))
  end

  @spec segment(any) :: binary
  defp segment(part) when is_atom(part), do: String.replace_prefix(Kernel.to_string(part), "Elixir.", "")
  defp segment(part), do: raise(ArgumentError, "expected an alias segment to be an atom, got: #{inspect(part)}")

  @spec dirname(binary) :: binary
  defp dirname(file) do
    case String.split(file, "/") do
      [_only] -> "."
      ["", _only] -> "/"
      parts -> parts |> Enum.drop(-1) |> Enum.join("/")
    end
  end

  @spec escape_map(any) :: any
  defp escape_map(map) when is_map(map), do: {:%{}, [], Map.to_list(map)}
  defp escape_map(other), do: other

  @doc """
  Returns the quoted code that rebuilds `value`.

  A macro computes values while it runs; to put one into the code it returns,
  it escapes it. Atoms, numbers and binaries are their own code, and so are
  2-tuples and lists, with each element escaped. Any other tuple is
  `{:{}, [], elements}`. A map is `{:%{}, [], pairs}`, its pairs in
  `Map.to_list/1` order with each key and value escaped, and a struct is
  escaped as the map it is. A bitstring that is not a binary is its leading
  `rem(bit_size(value), 8)` bits as an integer, then the rest as a binary.

  A function a module defines by name is the capture that names it,
  `&Mod.fun/arity`.

  A PID, a reference and an anonymous function name nothing in the compiled
  program, so each raises `ArgumentError`, wherever it is inside `value`.

  ## Examples

      Macro.escape({1, 2, 3})
      #=> {:{}, [], [1, 2, 3]}

      Macro.escape(%{a: [1]})
      #=> {:%{}, [], [a: [1]]}

      Macro.escape([ok: {1, 2}])
      #=> [ok: {1, 2}]

      Macro.escape([1, 2 | 3])
      #=> [1, {:|, [], [2, 3]}]

      Macro.escape(&String.length/1)
      #=> {:&, [], [{:/, [], [{{:., [], [String, :length]}, [no_parens: true], []}, 1]}]}

  """
  @spec escape(any) :: any
  def escape(value) when is_atom(value) or is_number(value) or is_binary(value), do: value
  def escape(value) when is_bitstring(value), do: escape_bits(value, rem(bit_size(value), 8))
  def escape({first, second}), do: {escape(first), escape(second)}
  def escape(value) when is_tuple(value), do: {:{}, [], escape_each(Tuple.to_list(value))}
  def escape(value) when is_list(value), do: escape_list(value)
  def escape(value) when is_map(value), do: {:%{}, [], escape_each(Map.to_list(value))}

  def escape(value) when is_function(value), do: escape_function(value, fz_function_name(value))
  def escape(value), do: refuse(value)

  @doc """
  Returns `string` with each escape sequence replaced by the character it
  names, as a string literal would read it.

  The escapes are `\\n \\t \\r \\s \\0 \\a \\b \\d \\e \\f \\v`, `\\\\`, `\\"`, `\\'`, `\\#`,
  `\\xHH` (a byte), and `\\uHHHH` or `\\u{H...}` (a code point). A backslash before a
  newline is removed, and a backslash before any other character leaves the
  character. A `\\x` or `\\u` of the wrong form raises `ArgumentError`.

  ## Examples

      Macro.unescape_string("a\\\\nb")
      #=> "a\\nb"

      Macro.unescape_string("\\\\u00e9")
      #=> "é"

  """
  @spec unescape_string(binary) :: binary
  def unescape_string(string) when is_binary(string), do: unescaped(fz_unescape_string(string))

  @spec unescaped([integer | binary]) :: binary
  defp unescaped([1, text]), do: text
  defp unescaped([0, message]), do: raise(ArgumentError, message)

  extern "fz" defp fz_unescape_string(binary) :: any

  @spec escape_function(fun, list) :: tuple
  defp escape_function(_function, [module, name, arity]) do
    {:&, [], [{:/, [], [{{:., [], [module, name]}, [no_parens: true], []}, arity]}]}
  end

  defp escape_function(function, _unnamed), do: refuse(function)

  @spec refuse(any) :: no_return()
  defp refuse(value) do
    raise(ArgumentError, "cannot escape #{inspect(value)}. The supported values are: lists, tuples, maps, atoms, numbers, bitstrings and remote functions in the format &Mod.fun/arity")
  end

  extern "fz" defp fz_function_name(fun) :: any

  @spec escape_list(maybe_improper_list(any, any)) :: [any]
  defp escape_list([]), do: []
  defp escape_list([head | tail]) when is_list(tail), do: [escape(head) | escape_list(tail)]
  defp escape_list([head | tail]), do: [{:|, [], [escape(head), escape(tail)]}]

  @spec escape_each([any]) :: [any]
  defp escape_each(values), do: Enum.map(values, fn value -> escape(value) end)

  @spec escape_bits(bitstring, integer) :: tuple
  defp escape_bits(bits, lead) do
    <<head::size(lead), rest::binary>> = bits
    {:<<>>, [], [{:"::", [], [head, {:size, [], [lead]}]}, {:"::", [], [rest, {:binary, [], nil}]}]}
  end
end
