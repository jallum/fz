defmodule Macro do
  @moduledoc """
  Works with quoted code, as Elixir's `Macro` does.

  `escape/1`, `unescape_string/1`, `var/2`, `unique_var/2` and
  `quoted_literal?/1` are the only functions defined. The rest of Elixir's `Macro` (`to_string/1`, `expand/2`,
  `prewalk/2` and the others),
  the options of `escape/2` and the escape map of `unescape_string/2` are not
  defined.
  """

  @doc """
  Returns the quoted variable `name` in `context`, as a `quote` in module
  `context` writes it. A context of `nil` is the variable the caller writes
  by that name.

  ## Examples

      Macro.var(:foo, nil)
      #=> {:foo, [], nil}

      Macro.var(:foo, Other)
      #=> {:foo, [], Other}

  """
  @spec var(atom, atom) :: {atom, list, atom}
  def var(name, context) when is_atom(name) and is_atom(context), do: {name, [], context}

  @doc """
  Returns a quoted variable `name` in `context` that no other variable is:
  its `counter` is one no expansion and no other call hands out.

  ## Examples

      Macro.unique_var(:x, __MODULE__) == Macro.unique_var(:x, __MODULE__)
      #=> false

  """
  @spec unique_var(atom, atom) :: {atom, list, atom}
  def unique_var(name, context) when is_atom(name) and is_atom(context) do
    {name, [counter: :erlang.unique_integer()], context}
  end

  @doc """
  Returns whether the given quoted expression is a literal.

  Atoms and numbers are always literals. Binaries, lists, tuples,
  maps, and structs are only literals if all of their terms are also literals.

  ## Examples

      Macro.quoted_literal?(quote(do: "foo"))
      #=> true

      Macro.quoted_literal?(quote(do: {"foo", 1}))
      #=> true

      Macro.quoted_literal?(quote(do: %{foo: "bar"}))
      #=> true

      Macro.quoted_literal?(quote(do: URI.parse("/")))
      #=> false

      Macro.quoted_literal?(quote(do: {foo, var}))
      #=> false

  """
  @spec quoted_literal?(any) :: boolean
  def quoted_literal?({:__aliases__, _, args}),
    do: quoted_literal?(args)

  def quoted_literal?({:__block__, _, [wrapped]}),
    do: quoted_literal?(wrapped)

  def quoted_literal?({:%, _, [left, right]}),
    do: quoted_literal?(left) and quoted_literal?(right)

  def quoted_literal?({:%{}, _, args}), do: quoted_literal?(args)
  def quoted_literal?({:{}, _, args}), do: quoted_literal?(args)
  def quoted_literal?({:__MODULE__, _, ctx}) when is_atom(ctx), do: true
  def quoted_literal?({:<<>>, _, segments}), do: Enum.all?(segments, &quoted_bitstring_segment?/1)
  def quoted_literal?({left, right}), do: quoted_literal?(left) and quoted_literal?(right)
  def quoted_literal?(list) when is_list(list), do: Enum.all?(list, &quoted_literal?/1)
  def quoted_literal?(term), do: is_atom(term) or is_number(term) or is_binary(term)

  @spec quoted_bitstring_segment?(term) :: boolean
  defp quoted_bitstring_segment?(term) when is_integer(term) or is_binary(term), do: true

  defp quoted_bitstring_segment?({:"::", _, [term, modifier]})
       when is_integer(term) or is_binary(term),
       do: quoted_bitstring_modifier?(modifier)

  defp quoted_bitstring_segment?(_other), do: false

  @spec quoted_bitstring_modifier?(term) :: boolean
  defp quoted_bitstring_modifier?({:-, _, [left, right]}),
    do: quoted_bitstring_modifier?(left) and quoted_bitstring_modifier?(right)

  defp quoted_bitstring_modifier?({atom, _, [size]})
       when atom in [:size, :unit] and is_integer(size),
       do: true

  defp quoted_bitstring_modifier?({:*, _, [left, right]})
       when is_integer(left) and is_integer(right),
       do: true

  defp quoted_bitstring_modifier?({modifier, _, ctx}) when is_atom(ctx) or ctx == [],
    do: modifier in [:big, :little, :native, :integer, :float, :binary, :bytes, :bitstring, :bits, :utf8, :utf16, :utf32, :signed, :unsigned]

  defp quoted_bitstring_modifier?(_other), do: false

  @doc """
  Returns the quoted code that rebuilds `value`.

  A macro computes values while it runs; to put one into the code it returns,
  it escapes it. Atoms, numbers and binaries are their own code, and so are
  2-tuples and lists, with each element escaped. Any other tuple is
  `{:{}, [], elements}`. A map is `{:%{}, [], pairs}`, its pairs in
  `Map.to_list/1` order with each key and value escaped, and a struct is
  escaped as the map it is. A bitstring that is not a binary is its leading
  `rem(bit_size(value), 8)` bits as an integer, then the rest as a binary.

  A function a module defines by name is the capture that names it,
  `&Mod.fun/arity`.

  A PID, a reference and an anonymous function name nothing in the compiled
  program, so each raises `ArgumentError`, wherever it is inside `value`.

  ## Examples

      Macro.escape({1, 2, 3})
      #=> {:{}, [], [1, 2, 3]}

      Macro.escape(%{a: [1]})
      #=> {:%{}, [], [a: [1]]}

      Macro.escape([ok: {1, 2}])
      #=> [ok: {1, 2}]

      Macro.escape(&String.length/1)
      #=> {:&, [], [{:/, [], [{{:., [], [String, :length]}, [no_parens: true], []}, 1]}]}

  """
  @spec escape(any) :: any
  def escape(value) when is_atom(value) or is_number(value) or is_binary(value), do: value
  def escape(value) when is_bitstring(value), do: escape_bits(value, rem(bit_size(value), 8))
  def escape({first, second}), do: {escape(first), escape(second)}
  def escape(value) when is_tuple(value), do: {:{}, [], escape_each(Tuple.to_list(value))}
  def escape(value) when is_list(value), do: escape_each(value)
  def escape(value) when is_map(value), do: {:%{}, [], escape_each(Map.to_list(value))}

  def escape(value) when is_function(value), do: escape_function(value, fz_function_name(value))
  def escape(value), do: refuse(value)

  @doc """
  Returns `string` with each escape sequence replaced by the character it
  names, as a string literal would read it.

  The escapes are `\\n \\t \\r \\s \\0 \\a \\b \\d \\e \\f \\v`, `\\\\`, `\\"`, `\\'`, `\\#`,
  `\\xHH` (a byte), and `\\uHHHH` or `\\u{H...}` (a code point). A backslash before a
  newline is removed, and a backslash before any other character leaves the
  character. A `\\x` or `\\u` of the wrong form raises `ArgumentError`.

  ## Examples

      Macro.unescape_string("a\\\\nb")
      #=> "a\\nb"

      Macro.unescape_string("\\\\u00e9")
      #=> "é"

  """
  @spec unescape_string(binary) :: binary
  def unescape_string(string) when is_binary(string), do: unescaped(fz_unescape_string(string))

  @spec unescaped([integer | binary]) :: binary
  defp unescaped([1, text]), do: text
  defp unescaped([0, message]), do: raise(ArgumentError, message)

  extern "fz" defp fz_unescape_string(binary) :: any

  @spec escape_function(fun, list) :: tuple
  defp escape_function(_function, [module, name, arity]) do
    {:&, [], [{:/, [], [{{:., [], [module, name]}, [no_parens: true], []}, arity]}]}
  end

  defp escape_function(function, _unnamed), do: refuse(function)

  @spec refuse(any) :: no_return()
  defp refuse(value) do
    raise(ArgumentError, "cannot escape #{inspect(value)}. The supported values are: lists, tuples, maps, atoms, numbers, bitstrings and remote functions in the format &Mod.fun/arity")
  end

  extern "fz" defp fz_function_name(fun) :: any

  @spec escape_each([any]) :: [any]
  defp escape_each(values), do: Enum.map(values, fn value -> escape(value) end)

  @spec escape_bits(bitstring, integer) :: tuple
  defp escape_bits(bits, lead) do
    <<head::size(lead), rest::binary>> = bits
    {:<<>>, [], [{:"::", [], [head, {:size, [], [lead]}]}, {:"::", [], [rest, {:binary, [], nil}]}]}
  end
end
