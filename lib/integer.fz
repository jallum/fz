defmodule Integer do
  @moduledoc "Functions for working with integers."

  extern "fz" def fz_integer_to_binary(integer) :: binary

  @doc """
  Returns the integer's textual representation as a binary.

  ## Examples

      Integer.to_string(42)
      #=> "42"

      Integer.to_string(-7)
      #=> "-7"

  """
  @spec to_string(integer) :: binary
  def to_string(i), do: fz_integer_to_binary(i)
end
