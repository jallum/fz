defmodule Kernel do
  @moduledoc """
  The functions and operators available everywhere, without a `Kernel.` prefix.

  `Kernel` supplies:

    * the arithmetic operators `+`, `-`, `*`, `/`, `%`, unary plus and unary minus
    * the boolean operators `and`, `or` and `not`, which take booleans, and
      `&&`, `||` and `!`, which take any value and count `nil` and `false` as
      false; the three are macros, so a guard refuses them
    * the comparison operators `<`, `<=`, `>`, `>=`, plus `==`, `!=`, `===`,
      `!==` and the total term order `compare/2`
    * process primitives: `self/0`, `send/2`, `spawn/1`,
      `make_ref/0` and `make_resource/2`
    * `panic/1`, `raise/1`, `raise/2`, `reraise/2`, `throw/1` and `exit/1`,
      for failing the current process
    * `dbg/1`, `inspect/1`, `to_string/1`, `div/2`, `rem/2` and `range/3`
    * the sizes and accessors `bit_size/1`, `byte_size/1`, `map_size/1`,
      `tuple_size/1`, `length/1`, `elem/2`, `hd/1` and `tl/1`, the numeric functions `abs/1`,
      `round/1`, `trunc/1`, `floor/1` and `ceil/1`, the comparisons `max/2` and `min/2`,
      and the type tests `is_integer/1`,
      `is_float/1`, `is_number/1`, `is_binary/1`, `is_bitstring/1`, `is_list/1`, `is_map/1`, `is_tuple/1`,
      `is_atom/1`, `is_boolean/1`, `is_pid/1`, `is_reference/1`, `is_function/1`, `is_function/2`, `is_nil/1`,
      `is_struct/1` and `is_struct/2`, all of which a guard may call
    * `match?/2`, a macro answering whether a value matches a pattern

  Every arithmetic and comparison operator is a typed clause family: one
  clause per pair of operand types it supports. The `@spec` of an arithmetic
  operator lists only the number pairs, so a call whose operands are proven
  not to be numbers is refused at compile time. Operands known only at runtime
  reach a final default clause, which raises `ArithmeticError`. Ordering,
  equality and identity are total, and add an `any`/`any` clause for every
  other pair of values.
  """

  @doc """
  Fails the current process with `reason`.

  The process prints one line on stderr and ends; this call never returns.
  An exception, a map of the shape `raise/2` builds, prints as
  `** (Name) message`. Any other reason prints the way Elixir prints a raw
  Erlang error, `** (ErlangError) Erlang error: :reason`. Other processes
  carry on, and a failed main process exits the program with status 1.
  """
  @spec panic(any) :: no_return()
  def panic(reason), do: fz_panic(reason)

  extern "fz" defp fz_panic(stored_value) :: none, delivers: :error

  @doc """
  Returns `value` as the text Elixir's `inspect/1` gives it: `dbg/1`,
  `IO.inspect/1` and exception messages print the same text.

  A container shows at most 100 elements and then `...`.
  """
  @spec inspect(any) :: binary
  # Calls the one-argument extern rather than `inspect/2`: guard helpers such
  # as `map_size/1` show a value in their failure message and must stay
  # dispatch-pure, which the option walk of `inspect/2` is not.
  def inspect(value), do: fz_inspect(value)

  extern "fz" defp fz_inspect(stored_value) :: binary

  @doc """
  Returns `value` as the text Elixir's `inspect/2` gives it.

  Two options are built:

    * `limit:` how many elements of a list, tuple, map or bitstring show
      before `...`. Each element costs one and whatever it prints inside
      spends from the same budget. It defaults to 100, as in Elixir.
    * `printable_limit:` how many characters of a string or charlist show. A
      longer one ends `" <> ..."` after a string and `" ++ ..."` after a
      charlist. It does not spend from `limit:`, and defaults to 4096, as
      in Elixir.

  Both take a non-negative integer or `:infinity`.

      inspect([1, 2, 3], limit: 2)
      #=> "[1, 2, ...]"

      inspect("abcdef", printable_limit: 3)
      #=> "\"abc\" <> ..."

  Any other key, and a limit that is neither a count nor `:infinity`, raises
  `ArgumentError`, where Elixir ignores the key and fails only later on a bad
  limit.
  """
  @spec inspect(any, keyword) :: binary
  def inspect(value, opts), do: fz_inspect_with(value, checked_inspect_options(opts, opts))

  @spec checked_inspect_options(any, any) :: any
  defp checked_inspect_options([], opts), do: opts

  defp checked_inspect_options([{:limit, :infinity} | rest], opts), do: checked_inspect_options(rest, opts)
  defp checked_inspect_options([{:printable_limit, :infinity} | rest], opts), do: checked_inspect_options(rest, opts)

  defp checked_inspect_options([{:limit, limit} | rest], opts) when is_integer(limit) and limit >= 0,
    do: checked_inspect_options(rest, opts)

  defp checked_inspect_options([{:printable_limit, limit} | rest], opts) when is_integer(limit) and limit >= 0,
    do: checked_inspect_options(rest, opts)

  defp checked_inspect_options([{:limit, _} | _], _),
    do: raise(%ArgumentError{message: "inspect/2 limit: must be a non-negative integer or :infinity"})

  defp checked_inspect_options([{:printable_limit, _} | _], _),
    do: raise(%ArgumentError{message: "inspect/2 printable_limit: must be a non-negative integer or :infinity"})

  defp checked_inspect_options([{key, _} | _], _),
    do: raise(%ArgumentError{message: "inspect/2 does not support option " <> inspect(key)})

  defp checked_inspect_options(_, _), do: raise(%ArgumentError{message: "inspect/2 options must be a keyword list"})

  extern "fz" defp fz_inspect_with(stored_value, any) :: binary

  @doc """
  Raises `value` as a throw: the nearest `catch` clause that takes a throw
  receives it.

      try do
        throw(:found)
      catch
        value -> value
      end
      # :found

  A throw no `catch` takes fails the process like any other raise: the line
  is `** (throw) :found`, and a failed main process exits with status 1.
  """
  @spec throw(any) :: no_return()
  def throw(value), do: fz_throw(value)

  extern "fz" defp fz_throw(stored_value) :: none, delivers: :throw

  @doc """
  Ends the current process with `reason`: the nearest `catch :exit, reason`
  clause receives it.

      try do
        exit(:stopped)
      catch
        :exit, reason -> reason
      end
      # :stopped

  With no `catch` to take it the process ends. The reasons `:normal`,
  `:shutdown` and `{:shutdown, status}` end it silently, and a main process
  that ends this way exits the program with status 0, 0, and `status`. Any
  other reason prints `** (exit) reason` and exits the program with status 1.
  """
  @spec exit(any) :: no_return()
  def exit(reason), do: fz_exit(reason)

  extern "fz" defp fz_exit(stored_value) :: none, delivers: :exit

  @doc """
  Raises the exception `exception` again. The stacktrace is accepted for
  Elixir's sake and ignored: fz carries no stacktraces.

      try do
        raise ArgumentError, "bad"
      rescue
        e -> reraise e, []
      end
  """
  @spec reraise(any, any) :: no_return()
  def reraise(exception, _stacktrace), do: panic(exception)

  @doc """
  Raises an exception.

  A text raises a `RuntimeError` with that message. A module raises what
  its `exception/1` builds from no fields. An exception is raised as it is.
  Any other value raises an `ArgumentError`.

  ## Examples

      raise "boom"
      # ** (RuntimeError) boom

      raise ArgumentError
      # ** (ArgumentError) argument error

  """
  defmacro raise(message) when is_binary(message) do
    quote do: panic(%RuntimeError{message: unquote(message)})
  end

  defmacro raise({:__aliases__, _, _} = module) do
    quote do: panic(unquote(module).exception([]))
  end

  defmacro raise({:"%", _, _} = exception) do
    quote do: panic(unquote(exception))
  end

  defmacro raise(value) do
    quote do: panic(Kernel.to_exception(unquote(value)))
  end

  @doc """
  Raises what `exception.exception(attributes)` builds: `exception` is a
  module declared with `defexception`, and `attributes` is a message or a
  keyword list of its fields.

  ## Examples

      raise ArgumentError, "bad"
      # ** (ArgumentError) bad

      raise KeyError, key: :a, term: %{}
      # ** (KeyError) key :a not found in:
      #
      #     %{}

  """
  defmacro raise(exception, attributes) do
    quote do: panic(unquote(exception).exception(unquote(attributes)))
  end

  @doc """
  Returns the exception `raise/1` raises for `value`, when `value` is known
  only as the program runs.

  ## Examples

      Kernel.to_exception("boom")
      #=> %RuntimeError{message: "boom"}

      Kernel.to_exception(42).message
      #=> "raise/1 and reraise/2 expect a module name, string or exception as the first argument, got: 42"

  """
  @spec to_exception(any) :: any
  def to_exception(message) when is_binary(message), do: %RuntimeError{message: message}
  def to_exception(%{__struct__: module, __exception__: true} = exception) when is_atom(module), do: exception
  def to_exception(module) when is_atom(module), do: module.exception([])

  def to_exception(value),
    do: %ArgumentError{message: "raise/1 and reraise/2 expect a module name, string or exception as the first argument, got: " <> inspect(value)}

  @doc """
  Answers `left` when it is truthy, and `right` otherwise.

  `nil` and `false` are false; every other value is true. `right` is
  evaluated only when `left` is false. A macro, so a guard refuses it.

  ## Examples

      nil || []
      #=> []

      "x" || []
      #=> "x"

  """
  defmacro left || right do
    quote do
      case unquote(left) do
        nil -> unquote(right)
        false -> unquote(right)
        value -> value
      end
    end
  end

  @doc """
  Answers `left` when it is false, and `right` otherwise.

  `nil` and `false` are false; every other value is true. `right` is
  evaluated only when `left` is true. A macro, so a guard refuses it.

  ## Examples

      nil && 1
      #=> nil

      1 && 2
      #=> 2

  """
  defmacro left && right do
    quote do
      case unquote(left) do
        nil -> nil
        false -> false
        _ -> unquote(right)
      end
    end
  end

  @doc """
  Calls `function` of `module` with the arguments in `args`.

  `apply(m, :f, [a, b])` is the call `m.f(a, b)`. The function is written as
  an atom and the arguments as a list, so the call is known when the program
  is compiled; `module` is any expression.

  ## Examples

      apply(String, :upcase, ["a"])
      #=> "A"

      apply(Enum, :at, [[1, 2, 3], 1])
      #=> 2

  """
  defmacro apply(module, function, args) when is_atom(function) and is_list(args) do
    {{:".", [], [module, function]}, [], args}
  end

  defmacro apply(_module, _function, _args) do
    raise ArgumentError, "apply/3 takes the function as an atom and the arguments as a list, both written out"
  end

  @doc """
  Declares the module an exception. `fields` is a `defstruct` field list; the
  struct also has `__exception__: true`.

  The module gets `exception/1`, which builds the exception from a keyword
  list of its fields. When `fields` has `:message`, `exception/1` also takes
  the message as a binary, and the module gets `message/1`, which answers
  that field. Both are overridable: a `def` of the same name and arity
  further down the module replaces them.

  ## Examples

      defmodule NotFound do
        defexception [:path]

        def message(e), do: "no file " <> e.path
      end

      Exception.message(NotFound.exception(path: "/a"))
      #=> "no file /a"

  """
  defmacro defexception(fields) do
    fields = [{:__exception__, true} | fields]

    if declares_message?(fields) do
      quote do
        defstruct unquote(fields)

        def message(exception), do: exception.message
        defoverridable message: 1

        def exception(message) when is_binary(message), do: %__MODULE__{message: message}
        def exception(fields) when is_list(fields), do: struct!(__MODULE__, fields)
        defoverridable exception: 1
      end
    else
      quote do
        defstruct unquote(fields)

        def exception(fields) when is_list(fields), do: struct!(__MODULE__, fields)
        defoverridable exception: 1
      end
    end
  end

  @spec declares_message?(any) :: boolean
  defp declares_message?([]), do: false
  defp declares_message?([:message | _]), do: true
  defp declares_message?([{:message, _} | _]), do: true
  defp declares_message?([_ | rest]), do: declares_message?(rest)
  defp declares_message?(_other), do: false

  @doc """
  Answers `true` when `value` is an exception: a struct whose
  `__exception__` field is `true`.

  ## Examples

      is_exception(%ArgumentError{message: "bad"})
      #=> true

      is_exception(%{__struct__: Point})
      #=> false

  """
  @spec is_exception(any) :: boolean
  def is_exception(%{__struct__: module, __exception__: true}) when is_atom(module), do: true
  def is_exception(_), do: false

  @doc """
  Answers `true` when `term` is a struct: a map whose `__struct__` field is an
  atom.

  ## Examples

      is_struct(%ArgumentError{message: "bad"})
      #=> true

      is_struct(%{a: 1})
      #=> false

  """
  @spec is_struct(any) :: boolean
  def is_struct(%{__struct__: module}) when is_atom(module), do: true
  def is_struct(_), do: false

  @doc """
  Answers `true` when `term` is a struct of the module `name`.

  ## Examples

      is_struct(%ArgumentError{message: "bad"}, ArgumentError)
      #=> true

      is_struct(%ArgumentError{message: "bad"}, RuntimeError)
      #=> false

  """
  @spec is_struct(any, atom) :: boolean
  def is_struct(%{__struct__: module}, name) when is_atom(module) and is_atom(name), do: module == name
  def is_struct(_, name) when is_atom(name), do: false

  @doc """
  Answers `true` when `expression` matches `pattern`, and `false` otherwise.
  The pattern may carry a `when` guard; the variables it binds stay inside the
  match. A macro, so a guard refuses it.

  ## Examples

      match?({:ok, _}, {:ok, 1})
      #=> true

      match?({:ok, n} when n > 1, {:ok, 1})
      #=> false

  """
  defmacro match?(pattern, expression) do
    quote do
      case unquote(expression) do
        unquote(pattern) -> true
        _ -> false
      end
    end
  end

  @doc """
  Answers the struct `base` names, each field at its default. `base` is a
  module that declares a struct, or a struct.

  ## Examples

      struct(Point)
      #=> %Point{x: 0, y: 0}

  """
  @spec struct(any) :: any
  def struct(base), do: struct(base, [])

  @doc """
  Answers the struct `base` names with the fields `fields` gives. `base` is
  a module that declares a struct, or a struct to start from. `fields` is
  a keyword list or a map. A key the struct does not declare is ignored, and
  so is `:__struct__`.

  ## Examples

      struct(Point, x: 1)
      #=> %Point{x: 1, y: 0}

      struct(%Point{x: 1}, y: 2, z: 3)
      #=> %Point{x: 1, y: 2}

  """
  @spec struct(any, any) :: any
  def struct(module, fields) when is_atom(module), do: struct(module.__struct__(), fields)
  def struct(base, fields), do: Enum.reduce(fields, base, &replace_field/2)

  @spec replace_field({any, any}, any) :: any
  defp replace_field({:__struct__, _}, base), do: base
  defp replace_field({key, value}, base), do: Map.replace(base, key, value)

  @doc """
  Like `struct/2`, and raises `KeyError` for a key the struct does not
  declare. Given a module, it raises `ArgumentError` when `fields` names
  another module as `:__struct__`.

  ## Examples

      struct!(Point, x: 1)
      #=> %Point{x: 1, y: 0}

      struct!(Point, z: 3)
      # ** (KeyError) key :z not found

      struct!(Point, __struct__: Other)
      # ** (ArgumentError) expected struct name returned by Point.__struct__/1 to be Point, got: Other

  """
  @spec struct!(any, any) :: any
  def struct!(module, fields) when is_atom(module) and is_list(fields),
    do: put_declared_fields!(fields, module.__struct__(), module, module)

  def struct!(module, fields) when is_atom(module), do: struct!(module, Enum.to_list(fields))
  def struct!(base, fields), do: Enum.reduce(fields, base, &replace_field!/2)

  @spec put_declared_fields!([{any, any}], any, atom, any) :: any
  defp put_declared_fields!([], base, module, name) when name == module, do: base

  defp put_declared_fields!([], _, module, name),
    do:
      raise(%ArgumentError{
        message: "expected struct name returned by " <> inspect(module) <> ".__struct__/1 to be " <> inspect(module) <> ", got: " <> inspect(name)
      })

  defp put_declared_fields!([{:__struct__, name} | rest], base, module, _), do: put_declared_fields!(rest, base, module, name)
  defp put_declared_fields!([{key, value} | rest], base, module, name), do: put_declared_fields!(rest, %{base | key => value}, module, name)

  @spec replace_field!({any, any}, any) :: any
  defp replace_field!({:__struct__, _}, base), do: base
  defp replace_field!({key, value}, base), do: Map.replace!(base, key, value)

  @doc """
  Answers `true` when `value` is `nil` or `false`, and `false` otherwise.

  ## Examples

      !nil
      #=> true

      !0
      #=> false

  """
  defmacro !value do
    quote do
      case unquote(value) do
        nil -> true
        false -> true
        _ -> false
      end
    end
  end

  @doc """
  Handles the sigil `~S`: a string, as written. Escapes and `\#{...}` stay as
  text.

  A sigil is the call `sigil_x(body, modifiers)` that the compiler reads from
  `~x"..."`: `body` is `{:<<>>, meta, pieces}`, the text with an interpolated
  `\#{...}` of a lowercase sigil as its own piece, and `modifiers` is the list of
  character codes after the closing delimiter. A module defines `~x` with
  `defmacro sigil_x(body, modifiers)`.

  ## Examples

      ~S(foo\\n\#{bar})
      #=> "foo\\\\n\\\#{bar}"

  """
  defmacro sigil_S({:<<>>, _, [binary]}, []) when is_binary(binary), do: binary

  @doc """
  Handles the sigil `~s`: a string, as a double-quoted one reads, with its
  escapes and its `\#{...}` interpolations.

  ## Examples

      ~s(foo)
      #=> "foo"

      ~s(f\#{:o}o)
      #=> "foo"

      ~s(f\\\#{:o}o)
      #=> "f\\\#{:o}o"

  """
  defmacro sigil_s({:<<>>, _, [piece]}, []) when is_binary(piece) do
    Macro.unescape_string(piece)
  end

  defmacro sigil_s({:<<>>, line, pieces}, []) do
    {:<<>>, line, unescape_tokens(pieces)}
  end

  @doc """
  Handles the sigil `~C`: a charlist, as written, with no escapes and no
  interpolation.

  ## Examples

      ~C(foo\\n)
      #=> ~c"foo\\\\n"

  """
  defmacro sigil_C({:<<>>, _meta, [string]}, []) when is_binary(string) do
    String.to_charlist(string)
  end

  @doc """
  Handles the sigil `~c`: a charlist, with its escapes and its `\#{...}`
  interpolations. A text with none is computed when the program is compiled.

  ## Examples

      ~c(foo)
      #=> ~c"foo"

      ~c(f\#{:o}o)
      #=> ~c"foo"

  """
  defmacro sigil_c({:<<>>, _meta, [string]}, []) when is_binary(string) do
    String.to_charlist(Macro.unescape_string(string))
  end

  defmacro sigil_c({:<<>>, _meta, pieces}, []) do
    quote(do: List.to_charlist(unquote(unescape_list_tokens(pieces))))
  end

  @doc """
  Handles the sigil `~w`: the list of words of a text split at whitespace,
  after the text's escapes and interpolations are read.

  ## Modifiers

    * `s`: the words are strings (the default)
    * `a`: the words are atoms
    * `c`: the words are charlists

  ## Examples

      ~w(foo \#{:bar} baz)
      #=> ["foo", "bar", "baz"]

      ~w(foo bar)a
      #=> [:foo, :bar]

  """
  defmacro sigil_w({:<<>>, _meta, [string]}, modifiers) when is_binary(string) do
    split_words(Macro.unescape_string(string), modifiers)
  end

  defmacro sigil_w({:<<>>, meta, pieces}, modifiers) do
    split_words({:<<>>, meta, unescape_tokens(pieces)}, modifiers)
  end

  @doc """
  Handles the sigil `~W`: the list of words of a text split at whitespace,
  with no escapes and no interpolation. It takes the modifiers `~w` takes.

  ## Examples

      ~W(foo \#{bar} baz)
      #=> ["foo", "\\\#{bar}", "baz"]

  """
  defmacro sigil_W({:<<>>, _meta, [string]}, modifiers) when is_binary(string) do
    split_words(string, modifiers)
  end

  @spec split_words(any, [integer]) :: any
  defp split_words(string, []), do: split_words(string, [?s])

  defp split_words(string, [modifier]) when modifier == ?s or modifier == ?a or modifier == ?c do
    if is_binary(string) do
      parts = String.split(string)

      case modifier do
        ?s -> parts
        ?a -> Enum.map(parts, &String.to_atom/1)
        ?c -> Enum.map(parts, &String.to_charlist/1)
      end
    else
      parts = quote(do: String.split(unquote(string)))

      case modifier do
        ?s -> parts
        ?a -> quote(do: Enum.map(unquote(parts), &String.to_atom/1))
        ?c -> quote(do: Enum.map(unquote(parts), &String.to_charlist/1))
      end
    end
  end

  defp split_words(_string, _modifiers) do
    raise ArgumentError, "modifier must be one of: s, a, c"
  end

  # The pieces of a sigil body: text pieces are binaries, an interpolation
  # is `{:"::", meta, [expression, type]}`.
  @spec unescape_tokens([any]) :: [any]
  defp unescape_tokens([]), do: []

  defp unescape_tokens([token | rest]) when is_binary(token),
    do: [Macro.unescape_string(token) | unescape_tokens(rest)]

  defp unescape_tokens([token | rest]), do: [token | unescape_tokens(rest)]

  @spec unescape_list_tokens([any]) :: [any]
  defp unescape_list_tokens([]), do: []
  defp unescape_list_tokens([{:"::", _, [expression, _]} | rest]), do: [expression | unescape_list_tokens(rest)]

  defp unescape_list_tokens([binary | rest]) when is_binary(binary),
    do: [Macro.unescape_string(binary) | unescape_list_tokens(rest)]

  # In Elixir, `to_string/1` is a macro expanding to `String.Chars.to_string/1`.
  # Here it is an ordinary function, since the macro's expansion has nothing
  # to do at compile time.
  @doc """
  Converts `term` to a binary via the `String.Chars` protocol.

  ## Examples

      Kernel.to_string(42)
      #=> "42"

      Kernel.to_string(:hello)
      #=> "hello"

  """
  @spec to_string(any) :: binary
  def to_string(term), do: String.Chars.to_string(term)

  @doc """
  Prints `x` to standard output and returns it unchanged. It is
  `IO.inspect/1`.

  ## Examples

      Kernel.dbg(1 + 2)
      #=> 3

  """
  @spec dbg(t) :: t when t: any
  def dbg(x), do: IO.inspect(x)

  @doc """
  Starts a process that applies the zero-argument function `fun`, and
  returns its pid.

  ## Examples

      me = Kernel.self()
      Kernel.spawn(fn () -> Kernel.send(me, 1 + 2) end)
      receive do
        x -> x
      end
      #=> 3

  """
  @spec spawn((-> any)) :: pid
  def spawn(fun) do
    fz_spawn(fn ->
      try do
        fun.()
      rescue
        exception -> Exception.__uncaught__(exception)
      end
    end)
  end

  extern "fz" defp fz_spawn((-> any)) :: pid

  @doc """
  Returns the pid of the calling process.
  """
  @spec self() :: pid
  def self(), do: fz_self()

  extern "fz" defp fz_self() :: pid

  @doc """
  Sends `msg` to `pid` and returns `msg`. Raises `ArgumentError` when `pid` is
  not a pid.

  ## Examples

      Kernel.send(self(), 42)
      #=> 42

      receive do
        x -> x
      end
      #=> 42

  """
  @spec send(pid, t) :: t when t: any
  def send(pid, msg) when is_destination(pid), raises: ArgumentError, reason: :badarg

  def send(pid, msg) when is_destination(pid) do
    fz_send(pid, msg)
    msg
  end

  extern "fz" defp fz_send(pid, stored_value) :: unit

  # What `send/2` accepts as a destination; its own test, so the failure's
  # wording names `send/2`'s argument and no other test's.
  @spec is_destination(any) :: boolean
  defp is_destination(_ :: pid), do: true
  defp is_destination(_), do: false

  @doc """
  Returns a fresh, opaque reference; no two calls in a process return the
  same one.

  ## Examples

      Kernel.make_ref()
      #=> 1

  """
  @spec make_ref() :: ref
  def make_ref(), do: fz_make_ref()

  extern "C" defp fz_make_ref() :: ref

  @doc """
  Wraps a host handle `value` and destructor `dtor` in a resource.

  `value` is an integer or a C pointer. `dtor` runs once, when the
  resource is garbage-collected, even if the handle has been bound to
  more than one name. A destructor captures nothing: it is a function
  reference such as `&close/1`, never a closure over local values, and
  `make_resource` raises `ArgumentError` when given one that captures.
  """
  @spec make_resource(t, (t -> nil)) :: resource(t) when t: integer | c_pointer
  def make_resource(value, dtor) do
    case fz_make_resource(value, dtor) do
      nil -> raise(%ArgumentError{message: "a resource destructor captures nothing"})
      resource -> resource
    end
  end

  # `fz_make_resource` answers `nil` for a destructor that captures.
  extern "fz" defp fz_make_resource(t, (t -> nil)) :: resource(t) | nil when t: integer | c_pointer

  @doc """
  Claims `resource` for deterministic cleanup.

  Exactly one alias can claim a resource, including an alias sent to another
  process. A successful claim disables its fallback destructor; the caller
  now owns cleanup of the returned raw payload.
  """
  @spec claim_resource(resource(t)) :: {:ok, t} | {:error, :closed} when t: integer | c_pointer
  def claim_resource(resource :: resource(integer | c_pointer)) do
    value = resource.value
    claim_resource_result(fz_resource_claim(resource), value)
  end

  extern "fz" defp fz_resource_claim(resource(t)) :: boolean when t: integer | c_pointer

  @spec claim_resource_result(boolean, t) :: {:ok, t} | {:error, :closed} when t: integer | c_pointer
  defp claim_resource_result(true, value), do: {:ok, value}
  defp claim_resource_result(false, _value), do: {:error, :closed}

  @doc """
  Constructs a `Range` from `first` to `last`, stepping by `step`.

  ## Examples

      Kernel.range(1, 5, 1)
      #=> 1..5

      Kernel.range(1, 10, 2)
      #=> 1..10//2

  """
  @spec range(integer, integer, integer) :: any
  def range(first, last, step), do: Range.new(first, last, step)

  # An arithmetic extern declares with `raises:` that its operation can fail.
  # The C function returns the pair `{result, failed}`, the declared result is
  # the plain number, and a failed call raises `ArithmeticError`.
  # Each arithmetic function ends in a default clause outside its `@spec` that
  # calls `arithmetic_error/0`, so an operand that is not a number, known only
  # at runtime, raises `ArithmeticError` where a typed clause would otherwise
  # be missed. The default clause returns `never`, so it adds nothing to the
  # result type.
  @spec arithmetic_error() :: no_return()
  defp arithmetic_error(), do: __raise__(%ArithmeticError{message: "bad argument in arithmetic expression"}, :badarith)

  @doc """
  Concatenates `left` and `right`; this is the `++` operator.

  `left` must be a proper list; `right` may be any term, and a `right` that is
  not a list gives an improper list. A `left` that is not a proper list raises
  `ArgumentError`.

  ## Examples

      Kernel.++([1, 2], [3])
      #=> [1, 2, 3]

      Kernel.++([1, 2], 3)
      #=> [1, 2 | 3]

  """
  def [] ++ right, do: right
  def [head | tail] ++ right, do: [head | tail ++ right]
  def _left ++ _right, do: raise(%ArgumentError{message: "argument error"})

  @doc """
  Removes from `left` the first occurrence of each element of `right`; this is
  the `--` operator. Elements of `right` that do not occur in `left` are
  ignored.

  ## Examples

      Kernel.--([1, 2, 3, 2], [2])
      #=> [1, 3, 2]

  """
  def left -- [], do: left
  def left -- [item | rest], do: delete_first(left, item) -- rest

  @spec delete_first([a], any) :: [a] when a: var
  defp delete_first([], _value), do: []

  defp delete_first([head | tail], value) do
    if head === value, do: tail, else: [head | delete_first(tail, value)]
  end

  @doc """
  Concatenates two binaries.

  ## Examples

      "hello" <> " world"
      #=> "hello world"

  """
  @spec binary <> binary :: binary
  def left <> right, do: <<left::binary, right::binary>>

  # A binary construction tests every segment's contract before it writes a
  # byte, and calls this when the test fails. Each segment is
  # `{type, value, size, unit}`: `type` is the number the runtime reads a
  # segment's type from (`2` is `binary`), and `size` is `nil` where the
  # segment names none. The runtime words the message for the segment Elixir
  # reports.
  @spec __construction_failed__(list) :: no_return()
  def __construction_failed__(segments),
    do: raise(%ArgumentError{message: fz_construction_failure_message(segments)})

  extern "fz" defp fz_construction_failure_message(list) :: binary

  # `unquote(value)` inside a quote evaluates to this call, as Elixir's
  # `quote` builds a call of `:elixir_quote.unquote/1`: `value` becomes part of
  # the quoted code, so it must be quoted code.
  @spec __unquoted__(t) :: t when t: any
  def __unquoted__(value) do
    if fz_shallow_valid_ast(value) do
      value
    else
      raise(%ArgumentError{message: fz_unquote_failure_message(value)})
    end
  end

  extern "fz" defp fz_shallow_valid_ast(any) :: boolean

  extern "fz" defp fz_unquote_failure_message(any) :: binary

  # Unary minus. Every binary operator is a typed clause family, so a
  # dynamically-typed operand dispatches; unary minus was lowered straight to
  # one machine instruction and read one lane, so `-x` aborted natively where
  # `0 - x` worked. The front door rewrites `-x` to this call, except for a
  # literal, which folds to a negative literal and never becomes a call at
  # all.
  #
  # Not `0 - x`: that answers `0.0` for `-0.0`, and the sign of zero is
  # observable.
  @doc """
  Returns the negation of `x`.

  Raises `ArithmeticError` when `x` is not a number.

  This is what `-x` compiles to when `x` is not a literal.

  ## Examples

      Kernel.-(5)
      #=> -5

      Kernel.-(0.0)
      #=> -0.0

  """
  @spec -(integer) :: integer
  @spec -(float) :: float
  def -(x) when is_integer(x), do: fz_op_neg_i(x)
  def -(x) when is_float(x), do: fz_op_neg_f(x)
  def -(_), do: arithmetic_error()

  extern "C" defp fz_op_neg_i(integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_neg_f(float) :: float

  @doc """
  Returns the absolute value of `x`.

  Raises `ArithmeticError` for the minimum 64-bit integer, whose absolute value
  does not fit one, and `ArgumentError` when `x` is not a number.

  ## Examples

      Kernel.abs(-3)
      #=> 3

      Kernel.abs(-2.5)
      #=> 2.5

  """
  @spec abs(integer) :: integer
  @spec abs(float) :: float
  def abs(x) when is_number(x), raises: ArgumentError, reason: :badarg
  def abs(x) when is_integer(x), do: fz_op_abs_i(x)
  def abs(x) when is_float(x), do: fz_op_abs_f(x)

  extern "C" defp fz_op_abs_i(integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_abs_f(float) :: float

  @doc """
  Returns the bigger of `first` and `second` by structural comparison, which
  orders any two terms: a number is less than an atom, then a reference, a
  function, a pid, a tuple, a map, a list and a bitstring. When the two compare
  equal, `first` is returned, so `max(1, 1.0)` is `1`.

  A guard may call it.

  ## Examples

      max(1, 2)
      #=> 2

      max("a", "b")
      #=> "b"

  """
  @spec max(any, any) :: any
  def max(first, second) when first < second, do: second
  def max(first, _second), do: first

  @doc """
  Returns the smaller of `first` and `second` by structural comparison, which
  orders any two terms as `max/2` does. When the two compare equal, `first` is
  returned, so `min(1, 1.0)` is `1`.

  A guard may call it.

  ## Examples

      min(1, 2)
      #=> 1

      min("foo", "bar")
      #=> "bar"

  """
  @spec min(any, any) :: any
  def min(first, second) when second < first, do: second
  def min(first, _second), do: first

  @doc """
  Returns `x` rounded to the nearest integer, halves away from zero.

  Raises `ArithmeticError` when the result is outside the 64-bit integer
  range, and `ArgumentError` when `x` is not a number.

  ## Examples

      Kernel.round(2.5)
      #=> 3

      Kernel.round(-2.5)
      #=> -3

  """
  @spec round(integer) :: integer
  @spec round(float) :: integer
  def round(x) when is_number(x), raises: ArgumentError, reason: :badarg
  def round(x) when is_integer(x), do: x
  def round(x) when is_float(x), do: fz_op_round_f(x)

  extern "C" defp fz_op_round_f(float) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns `x` with its fractional part removed.

  Raises `ArithmeticError` when the result is outside the 64-bit integer
  range, and `ArgumentError` when `x` is not a number.

  ## Examples

      Kernel.trunc(-2.7)
      #=> -2

  """
  @spec trunc(integer) :: integer
  @spec trunc(float) :: integer
  def trunc(x) when is_number(x), raises: ArgumentError, reason: :badarg
  def trunc(x) when is_integer(x), do: x
  def trunc(x) when is_float(x), do: fz_op_trunc_f(x)

  extern "C" defp fz_op_trunc_f(float) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the greatest integer not above `x`.

  Raises `ArithmeticError` when the result is outside the 64-bit integer
  range, and `ArgumentError` when `x` is not a number.

  ## Examples

      Kernel.floor(-2.5)
      #=> -3

  """
  @spec floor(integer) :: integer
  @spec floor(float) :: integer
  def floor(x) when is_number(x), raises: ArgumentError, reason: :badarg
  def floor(x) when is_integer(x), do: x
  def floor(x) when is_float(x), do: fz_op_floor_f(x)

  extern "C" defp fz_op_floor_f(float) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the least integer not below `x`.

  Raises `ArithmeticError` when the result is outside the 64-bit integer
  range, and `ArgumentError` when `x` is not a number.

  ## Examples

      Kernel.ceil(-2.5)
      #=> -2

  """
  @spec ceil(integer) :: integer
  @spec ceil(float) :: integer
  def ceil(x) when is_number(x), raises: ArgumentError, reason: :badarg
  def ceil(x) when is_integer(x), do: x
  def ceil(x) when is_float(x), do: fz_op_ceil_f(x)

  extern "C" defp fz_op_ceil_f(float) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the first element of `list`.

  Raises `ArgumentError` when `list` is not a non-empty list. In a guard that
  makes the guard false.

  ## Examples

      Kernel.hd([1, 2])
      #=> 1

  """
  @spec hd(any) :: any
  def hd(list) when fz_list_is_cons(list), raises: ArgumentError, reason: :badarg, do: fz_list_head_ref(list)

  @doc """
  Returns `list` without its first element.

  Raises `ArgumentError` when `list` is not a non-empty list. In a guard that
  makes the guard false.

  ## Examples

      Kernel.tl([1, 2])
      #=> [2]

  """
  @spec tl(any) :: any
  def tl(list) when fz_list_is_cons(list), raises: ArgumentError, reason: :badarg, do: fz_list_tail_ref(list)

  extern "C" defp fz_list_is_cons(any) :: boolean
  extern "C" defp fz_list_head_ref(any) :: any
  extern "C" defp fz_list_tail_ref(any) :: any

  @doc """
  Returns `x` unchanged.

  Raises `ArithmeticError` when `x` is not a number.

  This is what `+x` compiles to.

  ## Examples

      +5
      #=> 5

      +(-2.5)
      #=> -2.5

  """
  @spec +(integer) :: integer
  @spec +(float) :: float
  def +(x) when is_integer(x), do: x
  def +(x) when is_float(x), do: x
  def +(_), do: arithmetic_error()

  @doc """
  Returns the sum of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      1 + 2
      #=> 3

      1 + 2.0
      #=> 3.0

  """
  @spec integer + integer :: integer
  @spec float + float :: float
  @spec integer + float :: float
  @spec float + integer :: float
  def left + right when is_integer(left) and is_integer(right), do: fz_op_add_ii(left, right)
  def left + right when is_integer(left) and is_float(right), do: fz_op_add_if(left, right)
  def left + right when is_float(left) and is_integer(right), do: fz_op_add_if(right, left)
  def left + right when is_float(left) and is_float(right), do: fz_op_add_ff(left, right)
  def _left + _right, do: arithmetic_error()

  extern "C" defp fz_op_add_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_add_if(integer, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_add_ff(float, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the difference of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      5 - 3
      #=> 2

      5 - 3.0
      #=> 2.0

  """
  @spec integer - integer :: integer
  @spec float - float :: float
  @spec integer - float :: float
  @spec float - integer :: float
  def left - right when is_integer(left) and is_integer(right), do: fz_op_sub_ii(left, right)
  def left - right when is_integer(left) and is_float(right), do: fz_op_sub_if(left, right)
  def left - right when is_float(left) and is_integer(right), do: fz_op_sub_fi(left, right)
  def left - right when is_float(left) and is_float(right), do: fz_op_sub_ff(left, right)
  def _left - _right, do: arithmetic_error()

  extern "C" defp fz_op_sub_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_sub_if(integer, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_sub_fi(float, integer) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_sub_ff(float, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the product of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      3 * 4
      #=> 12

      3 * 4.0
      #=> 12.0

  """
  @spec integer * integer :: integer
  @spec float * float :: float
  @spec integer * float :: float
  @spec float * integer :: float
  def left * right when is_integer(left) and is_integer(right), do: fz_op_mul_ii(left, right)
  def left * right when is_integer(left) and is_float(right), do: fz_op_mul_if(left, right)
  def left * right when is_float(left) and is_integer(right), do: fz_op_mul_if(right, left)
  def left * right when is_float(left) and is_float(right), do: fz_op_mul_ff(left, right)
  def _left * _right, do: arithmetic_error()

  extern "C" defp fz_op_mul_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_mul_if(integer, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_mul_ff(float, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  # `/` always returns a float, as in Elixir: `1 / 2` is `0.5`, not `0`. The
  # truncating form is `div/2` below. Getting this wrong is silent -- integer
  # division simply loses the fraction -- and a JSON number parser building
  # `3 + 5 / 10` needs `3.5`.
  @doc """
  Returns the quotient of `left` and `right`, as a float.

  Raises `ArithmeticError` when an operand is not a number.

  For the truncating integer quotient, see `div/2`.

  ## Examples

      1 / 2
      #=> 0.5

      4 / 2
      #=> 2.0

  """
  @spec integer / integer :: float
  @spec float / float :: float
  @spec integer / float :: float
  @spec float / integer :: float
  def left / right when is_integer(left) and is_integer(right), do: fz_op_div_ii_to_float(left, right)
  def left / right when is_integer(left) and is_float(right), do: fz_op_div_if(left, right)
  def left / right when is_float(left) and is_integer(right), do: fz_op_div_fi(left, right)
  def left / right when is_float(left) and is_float(right), do: fz_op_div_ff(left, right)
  def _left / _right, do: arithmetic_error()

  extern "C" defp fz_op_div_ii_to_float(integer, integer) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_div_if(integer, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_div_fi(float, integer) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_div_ff(float, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the truncating integer quotient of `left` divided by `right`.

  Raises `ArithmeticError` when an operand is not an integer, or `right` is zero.

  Unlike `/`, which always returns a float, `div/2` discards the remainder.

  ## Examples

      Kernel.div(7, 2)
      #=> 3

  """
  @spec div(integer, integer) :: integer
  def div(left, right) when is_integer(left) and is_integer(right), do: fz_op_div_ii(left, right)
  def div(_, _), do: arithmetic_error()

  extern "C" defp fz_op_div_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns the remainder of `left` divided by `right`, with the sign of
  `left`.

  Raises `ArithmeticError` when an operand is not an integer, or `right` is zero.

  ## Examples

      Kernel.rem(7, 2)
      #=> 1

      Kernel.rem(-7, 2)
      #=> -1

  """
  @spec rem(integer, integer) :: integer
  def rem(left, right) when is_integer(left) and is_integer(right), do: fz_op_rem_ii(left, right)
  def rem(_, _), do: arithmetic_error()

  @doc """
  Returns the remainder of `left` divided by `right`; the operator form of
  `rem/2`.

  Raises `ArithmeticError` when an operand is not a number.

  ## Examples

      7 % 2
      #=> 1

      -7 % 2
      #=> -1

  """
  @spec integer % integer :: integer
  @spec float % float :: float
  @spec integer % float :: float
  @spec float % integer :: float
  def left % right when is_integer(left) and is_integer(right), do: fz_op_rem_ii(left, right)
  def left % right when is_integer(left) and is_float(right), do: fz_op_rem_if(left, right)
  def left % right when is_float(left) and is_integer(right), do: fz_op_rem_fi(left, right)
  def left % right when is_float(left) and is_float(right), do: fz_op_rem_ff(left, right)
  def _left % _right, do: arithmetic_error()

  extern "C" defp fz_op_rem_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_rem_if(integer, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_rem_fi(float, integer) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"
  extern "C" defp fz_op_rem_ff(float, float) :: float,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  # Comparing an integer against a float is a comparison of two floats, and
  # widening the integer is this module's job. Arithmetic already spells its
  # four numeric combinations out one clause at a time; comparison does the
  # same, so a mixed pair is answered by a typed clause on unboxed lanes
  # rather than by codegen boxing an operand and coercing it behind our back.
  # Every comparison operator is a typed clause family over those numeric
  # pairs, and every one of them is total, so each keeps an `any`/`any` clause
  # beside the typed ones: two numbers are answered on unboxed lanes, and
  # every other pair falls through to the structural comparator, which orders
  # by the total term order, widens numerics for `==` and stays strict for
  # `===`.

  @doc """
  Returns whether `left` is less than `right`.

  Every pair of values has an answer: two numbers are compared on a typed
  clause, and every other pair goes through `compare/2`, the total term
  order.

  ## Examples

      1 < 2
      #=> true

      1 < 1.5
      #=> true

      "abc" < "abd"
      #=> true

      1 < :atom
      #=> true

  """
  @spec integer < integer :: boolean
  @spec float < float :: boolean
  @spec integer < float :: boolean
  @spec float < integer :: boolean
  @spec binary < binary :: boolean
  @spec any < any :: boolean
  def left < right when is_integer(left) and is_integer(right), do: fz_op_lt_ii(left, right)
  def left < right when is_float(left) and is_float(right), do: fz_op_lt_ff(left, right)
  def left < right when is_integer(left) and is_float(right), do: fz_op_lt_if(left, right)
  def left < right when is_float(left) and is_integer(right), do: fz_op_lt_fi(left, right)
  def left < right when is_binary(left) and is_binary(right), do: fz_op_lt_bb(left, right)
  def left < right, do: compare(left, right) < 0

  extern "C" defp fz_op_lt_ii(integer, integer) :: boolean
  extern "C" defp fz_op_lt_ff(float, float) :: boolean
  extern "C" defp fz_op_lt_if(integer, float) :: boolean
  extern "C" defp fz_op_lt_fi(float, integer) :: boolean
  extern "fz" defp fz_op_lt_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is less than or equal to `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      1 <= 1
      #=> true

      :atom <= "bin"
      #=> true

  """
  @spec integer <= integer :: boolean
  @spec float <= float :: boolean
  @spec integer <= float :: boolean
  @spec float <= integer :: boolean
  @spec binary <= binary :: boolean
  @spec any <= any :: boolean
  def left <= right when is_integer(left) and is_integer(right), do: fz_op_lte_ii(left, right)
  def left <= right when is_float(left) and is_float(right), do: fz_op_lte_ff(left, right)
  def left <= right when is_integer(left) and is_float(right), do: fz_op_lte_if(left, right)
  def left <= right when is_float(left) and is_integer(right), do: fz_op_lte_fi(left, right)
  def left <= right when is_binary(left) and is_binary(right), do: fz_op_lte_bb(left, right)
  def left <= right, do: compare(left, right) <= 0

  extern "C" defp fz_op_lte_ii(integer, integer) :: boolean
  extern "C" defp fz_op_lte_ff(float, float) :: boolean
  extern "C" defp fz_op_lte_if(integer, float) :: boolean
  extern "C" defp fz_op_lte_fi(float, integer) :: boolean
  extern "fz" defp fz_op_lte_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is greater than `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      2 > 1
      #=> true

      "abc" > "abb"
      #=> true

      [1] > {1}
      #=> true

  """
  @spec integer > integer :: boolean
  @spec float > float :: boolean
  @spec integer > float :: boolean
  @spec float > integer :: boolean
  @spec binary > binary :: boolean
  @spec any > any :: boolean
  def left > right when is_integer(left) and is_integer(right), do: fz_op_gt_ii(left, right)
  def left > right when is_float(left) and is_float(right), do: fz_op_gt_ff(left, right)
  def left > right when is_integer(left) and is_float(right), do: fz_op_gt_if(left, right)
  def left > right when is_float(left) and is_integer(right), do: fz_op_gt_fi(left, right)
  def left > right when is_binary(left) and is_binary(right), do: fz_op_gt_bb(left, right)
  def left > right, do: compare(left, right) > 0

  extern "C" defp fz_op_gt_ii(integer, integer) :: boolean
  extern "C" defp fz_op_gt_ff(float, float) :: boolean
  extern "C" defp fz_op_gt_if(integer, float) :: boolean
  extern "C" defp fz_op_gt_fi(float, integer) :: boolean
  extern "fz" defp fz_op_gt_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is greater than or equal to `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      1 >= 1
      #=> true

      :atom >= 1
      #=> true

  """
  @spec integer >= integer :: boolean
  @spec float >= float :: boolean
  @spec integer >= float :: boolean
  @spec float >= integer :: boolean
  @spec binary >= binary :: boolean
  @spec any >= any :: boolean
  def left >= right when is_integer(left) and is_integer(right), do: fz_op_gte_ii(left, right)
  def left >= right when is_float(left) and is_float(right), do: fz_op_gte_ff(left, right)
  def left >= right when is_integer(left) and is_float(right), do: fz_op_gte_if(left, right)
  def left >= right when is_float(left) and is_integer(right), do: fz_op_gte_fi(left, right)
  def left >= right when is_binary(left) and is_binary(right), do: fz_op_gte_bb(left, right)
  def left >= right, do: compare(left, right) >= 0

  extern "C" defp fz_op_gte_ii(integer, integer) :: boolean
  extern "C" defp fz_op_gte_ff(float, float) :: boolean
  extern "C" defp fz_op_gte_if(integer, float) :: boolean
  extern "C" defp fz_op_gte_fi(float, integer) :: boolean
  extern "fz" defp fz_op_gte_bb(binary, binary) :: boolean

  @doc """
  Returns the number of bytes that hold `bits`: a partial last byte counts.

  For the number of codepoints, see `String.length/1`.

  ## Examples

      Kernel.byte_size("hello")
      #=> 5

      Kernel.byte_size("héllo")
      #=> 6

      Kernel.byte_size(<<1::3>>)
      #=> 1

  """
  @spec byte_size(bitstring) :: integer
  def byte_size(bits) when is_bitstring(bits), raises: ArgumentError, reason: :badarg, do: fz_bitstring_byte_extent(bits)

  extern "C" defp fz_bitstring_byte_extent(binary_cursor) :: integer, projects: :byte_size

  @doc """
  Returns the `length` bytes of `binary` that start at byte `start`. A
  negative `length` takes the bytes that end at `start`.

  Raises `ArgumentError` when the part is not inside `binary`.

  ## Examples

      Kernel.binary_part("abcd", 1, 2)
      #=> "bc"

      Kernel.binary_part("abcd", 3, -2)
      #=> "bc"

  """
  @spec binary_part(binary, integer, integer) :: binary
  def binary_part(binary, start, length), do: :erlang.binary_part(binary, start, length)

  @doc """
  Returns the number of bits in `bits`: a partial last byte counts only the
  bits it holds.

  ## Examples

      Kernel.bit_size("hello")
      #=> 40

      Kernel.bit_size(<<1::3>>)
      #=> 3

  """
  @spec bit_size(bitstring) :: integer
  def bit_size(bits) when is_bitstring(bits), raises: ArgumentError, reason: :badarg, do: fz_bitstring_bit_extent(bits)

  extern "C" defp fz_bitstring_bit_extent(binary_cursor) :: integer

  @doc """
  Returns the number of entries in `map`.

  Raises `BadMapError` when `map` is not a map. In a guard, a non-map makes
  the guard false.

  ## Examples

      Kernel.map_size(%{a: 1, b: 2})
      #=> 2

      Kernel.map_size(%{})
      #=> 0

  """
  @spec map_size(any) :: integer
  def map_size(map) when is_map(map), do: fz_map_count(map)
  def map_size(map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  extern "fz" defp fz_map_count(map) :: integer, projects: :map_size

  @doc """
  Returns the number of elements in `tuple`.

  Raises `ArgumentError` when `tuple` is not a tuple. In a guard, a non-tuple
  makes the guard false.

  ## Examples

      Kernel.tuple_size({:a, :b, :c})
      #=> 3

      Kernel.tuple_size({})
      #=> 0

  """
  @spec tuple_size(any) :: integer
  def tuple_size(tuple) when is_tuple(tuple), raises: ArgumentError, reason: :badarg, do: fz_tuple_size(tuple)

  extern "fz" defp fz_tuple_size(any) :: integer, projects: :tuple_size

  @doc """
  Returns the element of `tuple` at the zero-based `index`.

  Raises `ArgumentError` when `tuple` is not a tuple or `index` is outside it,
  and `ArithmeticError` when `index` is not an integer.
  In a guard, either makes the guard false.

  ## Examples

      Kernel.elem({:a, :b, :c}, 1)
      #=> :b

  """
  @spec elem(any, any) :: any
  def elem(tuple, index) when is_tuple(tuple) and is_integer(index) and index >= 0 and index < tuple_size(tuple),
    do: fz_tuple_elem(tuple, index)

  def elem(tuple, index) when is_tuple(tuple) and is_integer(index),
    do: __raise__(%ArgumentError{message: "errors were found at the given arguments:\n\n  * 1st argument: out of range\n"}, :badarg)

  def elem(_, index) when is_integer(index),
    do: __raise__(%ArgumentError{message: "errors were found at the given arguments:\n\n  * 2nd argument: not a tuple\n"}, :badarg)

  def elem(_, _), do: arithmetic_error()

  extern "fz" defp fz_tuple_elem(any, integer) :: any

  @doc """
  Puts `value` at the zero-based `index` in `tuple`, returning a new tuple;
  `tuple` itself is unchanged.

  Raises `ArgumentError` when `tuple` is not a tuple or `index` is outside it,
  and `ArithmeticError` when `index` is not an integer.

  ## Examples

      tuple = {:foo, :bar, 3}
      Kernel.put_elem(tuple, 0, :baz)
      #=> {:baz, :bar, 3}

  """
  @spec put_elem(any, any, any) :: tuple
  def put_elem(tuple, index, value), do: :erlang.setelement(index + 1, tuple, value)

  @doc """
  Returns the number of elements in `list`.

  Raises `ArgumentError` when `list` is not a proper list. In a guard, an
  improper list or a non-list makes the guard false.

  ## Examples

      Kernel.length([1, 2, 3])
      #=> 3

      Kernel.length([])
      #=> 0

  """
  @spec length(any) :: integer
  def length(list) when is_list(list), raises: ArgumentError, reason: :badarg, do: fz_list_length(list)

  @doc """
  Fails the way a built-in function fails for a first argument that no test of
  its head catches: `rescue` sees an `ArgumentError` whose message words the
  argument as `wording` says, and `catch` sees `:badarg`.

  ## Examples

      try do
        Kernel.__badarg__("not a textual representation of an integer")
      catch
        :error, reason -> reason
      end
      #=> :badarg

  """
  @spec __badarg__(binary) :: no_return()
  def __badarg__(wording),
    do:
      __raise__(
        %ArgumentError{message: "errors were found at the given arguments:\n\n  * 1st argument: " <> wording <> "\n"},
        :badarg
      )

  # An improper list is not a list to `length/1`: the count fails the call.
  extern "C" defp fz_list_length(any) :: integer,
    raises: ArgumentError,
    reason: :badarg,
    message: "errors were found at the given arguments:\n\n  * 1st argument: not a list\n"

  @doc """
  Returns `true` when `term` is a tuple of any arity.

  ## Examples

      Kernel.is_tuple({1, 2})
      #=> true

      Kernel.is_tuple([1, 2])
      #=> false

  """
  @spec is_tuple(any) :: boolean
  def is_tuple(_ :: tuple), do: true
  def is_tuple(_), do: false

  @doc """
  Returns `true` when `term` is an integer.

  ## Examples

      Kernel.is_integer(1)
      #=> true

      Kernel.is_integer(1.0)
      #=> false

  """
  @spec is_integer(any) :: boolean
  def is_integer(_ :: integer), do: true
  def is_integer(_), do: false

  @doc """
  Returns `true` when `term` is a float.

  ## Examples

      Kernel.is_float(1.0)
      #=> true

      Kernel.is_float(1)
      #=> false

  """
  @spec is_float(any) :: boolean
  def is_float(_ :: float), do: true
  def is_float(_), do: false

  @doc """
  Returns `true` when `term` is an integer or a float.

  ## Examples

      Kernel.is_number(1.0)
      #=> true

      Kernel.is_number("1")
      #=> false

  """
  @spec is_number(any) :: boolean
  def is_number(_ :: integer | float), do: true
  def is_number(_), do: false

  @doc """
  Returns `true` when `term` is a binary: a bitstring whose bit length is a
  whole number of bytes.

  ## Examples

      Kernel.is_binary("hello")
      #=> true

      Kernel.is_binary(<<1::3>>)
      #=> false

      Kernel.is_binary(:hello)
      #=> false

  """
  @spec is_binary(any) :: boolean
  def is_binary(_ :: binary), do: true
  def is_binary(_), do: false

  @doc """
  Returns `true` when `term` is a bitstring of any bit length, including a
  binary.

  ## Examples

      Kernel.is_bitstring(<<1::3>>)
      #=> true

      Kernel.is_bitstring("hello")
      #=> true

      Kernel.is_bitstring(:hello)
      #=> false

  """
  @spec is_bitstring(any) :: boolean
  def is_bitstring(_ :: bitstring), do: true
  def is_bitstring(_), do: false

  @doc """
  Returns `true` when `term` is a list, proper or not.

  ## Examples

      Kernel.is_list([1, 2])
      #=> true

      Kernel.is_list({1, 2})
      #=> false

  """
  @spec is_list(any) :: boolean
  def is_list(_ :: list), do: true
  def is_list(_), do: false

  @doc """
  Returns `true` when `term` is a map.

  ## Examples

      Kernel.is_map(%{a: 1})
      #=> true

      Kernel.is_map([a: 1])
      #=> false

  """
  @spec is_map(any) :: boolean
  def is_map(_ :: map), do: true
  def is_map(_), do: false

  @doc """
  Returns `true` when `term` is an atom, including `true`, `false` and `nil`.

  ## Examples

      Kernel.is_atom(:ok)
      #=> true

      Kernel.is_atom("ok")
      #=> false

  """
  @spec is_atom(any) :: boolean
  def is_atom(_ :: atom), do: true
  def is_atom(_), do: false

  @doc """
  Returns `true` when `term` is a process identifier.

  ## Examples

      Kernel.is_pid(self())
      #=> true

      Kernel.is_pid(1)
      #=> false

  """
  @spec is_pid(any) :: boolean
  def is_pid(_ :: pid), do: true
  def is_pid(_), do: false

  @doc """
  Returns `true` when `term` is a reference.

  ## Examples

      Kernel.is_reference(make_ref())
      #=> true

      Kernel.is_reference(1)
      #=> false

  """
  @spec is_reference(any) :: boolean
  def is_reference(_ :: ref), do: true
  def is_reference(_), do: false

  @doc """
  Returns `true` when `term` is a function.

  ## Examples

      Kernel.is_function(fn x -> x end)
      #=> true

      Kernel.is_function(1)
      #=> false

  """
  @spec is_function(any) :: boolean
  def is_function(_ :: fun), do: true
  def is_function(_), do: false

  @doc """
  Returns `true` when `term` is a function that takes `arity` arguments.
  Raises `ArgumentError` when `arity` is not a non-negative integer, whatever
  `term` is.

  ## Examples

      Kernel.is_function(fn x -> x end, 1)
      #=> true

      Kernel.is_function(fn x -> x end, 2)
      #=> false

  """
  @spec is_function(any, any) :: boolean
  def is_function(term :: fun, arity) when is_integer(arity) and arity >= 0, do: fz_function_arity(term) == arity
  def is_function(_, arity) when is_integer(arity) and arity >= 0, do: false
  def is_function(_, arity) when is_integer(arity) and arity >= 0, raises: ArgumentError, reason: :badarg

  extern "fz" defp fz_function_arity(fun) :: integer, projects: :arity

  @doc """
  Returns `true` when `term` is `true` or `false`.

  ## Examples

      Kernel.is_boolean(false)
      #=> true

      Kernel.is_boolean(nil)
      #=> false

  """
  @spec is_boolean(any) :: boolean
  def is_boolean(_ :: boolean), do: true
  def is_boolean(_), do: false

  @doc """
  Returns `true` when `term` is `nil`.

  ## Examples

      Kernel.is_nil(nil)
      #=> true

      Kernel.is_nil(false)
      #=> false

  """
  @spec is_nil(any) :: boolean
  def is_nil(_ :: nil), do: true
  def is_nil(_), do: false

  # `</2` and its siblings carry this order through `compare/2`.
  @doc """
  Compares `left` and `right` by the total term order, and returns a
  negative integer, `0`, or a positive integer.

  Unlike `===/2`, numbers compare by value across types: `1` and `1.0`
  compare equal. Every value has a place in this order, which is what
  `Enum.sort/1` uses to order a mixed list.

  ## Examples

      Kernel.compare(1, 2)
      #=> -1

      Kernel.compare(1, 1.0)
      #=> 0

      Kernel.compare(:a, 1)
      #=> 1

  """
  @spec compare(any, any) :: integer
  def compare(left, right), do: fz_value_cmp_ref(left, right)

  # The total term order over every value. Takes the process (the `fz` ABI)
  # because atoms order by name, not by the id they were interned with.
  extern "fz" defp fz_value_cmp_ref(stored_value, stored_value) :: integer

  @doc """
  Returns whether `left` and `right` are equal, comparing numbers by value.

  `1 == 1.0` is true; for identity instead, see `===/2`.

  ## Examples

      1 == 1.0
      #=> true

      [1, 2] == [1, 2]
      #=> true

  """
  @spec integer == integer :: boolean
  @spec float == float :: boolean
  @spec integer == float :: boolean
  @spec float == integer :: boolean
  @spec binary == binary :: boolean
  @spec any == any :: boolean
  def left == right when is_integer(left) and is_integer(right), do: fz_op_eq_ii(left, right)
  def left == right when is_float(left) and is_float(right), do: fz_op_eq_ff(left, right)
  def left == right when is_integer(left) and is_float(right), do: fz_op_eq_if(left, right)
  def left == right when is_float(left) and is_integer(right), do: fz_op_eq_fi(left, right)
  def left == right when is_binary(left) and is_binary(right), do: fz_op_eq_bb(left, right)
  def left == right, do: fz_op_eq(left, right)

  extern "C" defp fz_op_eq_ii(integer, integer) :: boolean
  extern "C" defp fz_op_eq_ff(float, float) :: boolean
  extern "C" defp fz_op_eq_if(integer, float) :: boolean
  extern "C" defp fz_op_eq_fi(float, integer) :: boolean
  extern "fz" defp fz_op_eq_bb(binary, binary) :: boolean
  extern "fz" defp fz_op_eq(stored_value, stored_value) :: boolean

  @doc """
  Returns whether `left` and `right` are not equal; the negation of `==/2`.

  ## Examples

      1 != 2
      #=> true

      1 != 1.0
      #=> false

  """
  @spec integer != integer :: boolean
  @spec float != float :: boolean
  @spec integer != float :: boolean
  @spec float != integer :: boolean
  @spec binary != binary :: boolean
  @spec any != any :: boolean
  def left != right when is_integer(left) and is_integer(right), do: fz_op_neq_ii(left, right)
  def left != right when is_float(left) and is_float(right), do: fz_op_neq_ff(left, right)
  def left != right when is_integer(left) and is_float(right), do: fz_op_neq_if(left, right)
  def left != right when is_float(left) and is_integer(right), do: fz_op_neq_fi(left, right)
  def left != right when is_binary(left) and is_binary(right), do: fz_op_neq_bb(left, right)
  def left != right, do: fz_op_neq(left, right)

  extern "C" defp fz_op_neq_ii(integer, integer) :: boolean
  extern "C" defp fz_op_neq_ff(float, float) :: boolean
  extern "C" defp fz_op_neq_if(integer, float) :: boolean
  extern "C" defp fz_op_neq_fi(float, integer) :: boolean
  extern "fz" defp fz_op_neq_bb(binary, binary) :: boolean
  extern "fz" defp fz_op_neq(stored_value, stored_value) :: boolean

  # `===` asks whether two values are the same value, where `==` compares
  # numbers by value: `1 == 1.0` is true and `1 === 1.0` is false. Membership,
  # `--` and a map key all mean identity.
  @doc """
  Returns whether `left` and `right` are the same value.

  Unlike `==/2`, `===` does not compare numbers across types: `1 === 1.0`
  is false. Membership, `--` and map keys all mean identity.

  ## Examples

      1 === 1.0
      #=> false

      [1, 2] === [1, 2]
      #=> true

  """
  @spec integer === integer :: boolean
  @spec float === float :: boolean
  @spec integer === float :: boolean
  @spec float === integer :: boolean
  @spec binary === binary :: boolean
  @spec any === any :: boolean
  def left === right when is_integer(left) and is_integer(right), do: fz_op_identical_ii(left, right)
  def left === right when is_float(left) and is_float(right), do: fz_op_identical_ff(left, right)
  def left === right when is_integer(left) and is_float(right), do: false
  def left === right when is_float(left) and is_integer(right), do: false
  def left === right when is_binary(left) and is_binary(right), do: fz_op_eq_bb(left, right)
  def left === right, do: fz_op_identical(left, right)

  extern "C" defp fz_op_identical_ii(integer, integer) :: boolean
  extern "C" defp fz_op_identical_ff(float, float) :: boolean
  extern "fz" defp fz_op_identical(stored_value, stored_value) :: boolean

  @doc """
  Returns whether `left` and `right` are not the same value; the negation
  of `===/2`.

  ## Examples

      1 !== 1.0
      #=> true

      1 !== 1
      #=> false

  """
  @spec integer !== integer :: boolean
  @spec float !== float :: boolean
  @spec integer !== float :: boolean
  @spec float !== integer :: boolean
  @spec binary !== binary :: boolean
  @spec any !== any :: boolean
  def left !== right when is_integer(left) and is_integer(right), do: fz_op_not_identical_ii(left, right)
  def left !== right when is_float(left) and is_float(right), do: fz_op_not_identical_ff(left, right)
  def left !== right when is_integer(left) and is_float(right), do: true
  def left !== right when is_float(left) and is_integer(right), do: true
  def left !== right when is_binary(left) and is_binary(right), do: fz_op_neq_bb(left, right)
  def left !== right, do: fz_op_not_identical(left, right)

  extern "C" defp fz_op_not_identical_ii(integer, integer) :: boolean
  extern "C" defp fz_op_not_identical_ff(float, float) :: boolean
  extern "fz" defp fz_op_not_identical(stored_value, stored_value) :: boolean
end
