defmodule Kernel do
  @moduledoc """
  The functions and operators available everywhere, without a `Kernel.` prefix.

  `Kernel` supplies:

    * the arithmetic operators `+`, `-`, `*`, `/`, `%` and unary minus
    * the boolean operators `and`, `or` and `not`, which take booleans, and
      `&&`, `||` and `!`, which take any value and count `nil` and `false` as
      false; the three are macros, so a guard refuses them
    * the comparison operators `<`, `<=`, `>`, `>=`, plus `==`, `!=`, `===`,
      `!==` and the total term order `compare/2`
    * process primitives: `self/0`, `send/2`, `spawn/1`,
      `make_ref/0` and `make_resource/2`
    * `panic/1`, `raise/1`, `raise/2`, `reraise/2`, `throw/1`, `exit/1`,
      `inspect/1`, `assert/1`, `assert/2`, `refute/1` and `refute/2`, for
      failing the current process
    * `dbg/1`, `to_string/1`, `div/2`, `rem/2` and `range/3`
    * the sizes and accessors `byte_size/1`, `map_size/1`, `tuple_size/1`,
      `length/1` and `elem/2`, and the type tests `is_integer/1`,
      `is_float/1`, `is_binary/1`, `is_list/1`, `is_map/1`, `is_tuple/1`,
      `is_atom/1`, `is_boolean/1` and `is_nil/1`, all of which a guard may call

  Every arithmetic and comparison operator is a typed clause family: one
  clause per pair of operand types it supports. The `@spec` of an arithmetic
  operator lists only the number pairs, so a call whose operands are proven
  not to be numbers is refused at compile time. Operands known only at runtime
  reach a final default clause, which raises `ArithmeticError`. Ordering,
  equality and identity are total, and add an `any`/`any` clause for every
  other pair of values.
  """

  @doc """
  Fails the current process with `reason`.

  The process prints one line on stderr and ends; this call never returns.
  An exception, a map of the shape `raise/2` builds, prints as
  `** (Name) message`. Any other reason prints the way Elixir prints a raw
  Erlang error, `** (ErlangError) Erlang error: :reason`. Other processes
  carry on, and a failed main process exits the program with status 1.
  """
  @spec panic(any) :: never
  def panic(reason), do: fz_panic(reason)

  extern "fz" defp fz_panic(any) :: never

  @doc """
  Returns `value` as the text Elixir's `inspect/1` gives it: `dbg/1`,
  `IO.inspect/1` and exception messages print the same text.

  A container shows at most 100 elements and then `...`.
  """
  @spec inspect(any) :: binary
  # Calls the one-argument extern rather than `inspect/2`: guard helpers such
  # as `map_size/1` show a value in their failure message and must stay
  # dispatch-pure, which the option walk of `inspect/2` is not.
  def inspect(value), do: fz_inspect(value)

  extern "fz" defp fz_inspect(any) :: binary

  @doc """
  Returns `value` as the text Elixir's `inspect/2` gives it.

  `limit:` is the only option: a non-negative integer, or `:infinity`, for
  how many elements of a list, tuple, map or bitstring show before `...`.
  Each element costs one and whatever it prints inside spends from the same
  budget. It defaults to 100, as in Elixir.

      inspect([1, 2, 3], limit: 2)
      #=> "[1, 2, ...]"

  Any other key, and a limit that is neither, raises `ArgumentError`, where
  Elixir ignores the key and fails only later on a bad limit.
  """
  @spec inspect(any, keyword) :: binary
  def inspect(value, opts), do: fz_inspect_with(value, checked_inspect_options(opts, opts))

  @spec checked_inspect_options(any, any) :: any
  defp checked_inspect_options([], opts), do: opts
  defp checked_inspect_options([{:limit, :infinity} | rest], opts), do: checked_inspect_options(rest, opts)

  defp checked_inspect_options([{:limit, limit} | rest], opts) when is_integer(limit) and limit >= 0,
    do: checked_inspect_options(rest, opts)

  defp checked_inspect_options([{:limit, _} | _], _),
    do: raise(ArgumentError, "inspect/2 limit: must be a non-negative integer or :infinity")

  defp checked_inspect_options([{key, _} | _], _),
    do: raise(ArgumentError, "inspect/2 does not support option " <> inspect(key))

  defp checked_inspect_options(_, _), do: raise(ArgumentError, "inspect/2 options must be a keyword list")

  extern "fz" defp fz_inspect_with(any, any) :: binary

  @doc """
  Raises `value` as a throw: the nearest `catch` clause that takes a throw
  receives it.

      try do
        throw(:found)
      catch
        value -> value
      end
      # :found

  A throw no `catch` takes fails the process like any other raise: the line
  is `** (throw) :found`, and a failed main process exits with status 1.
  """
  @spec throw(any) :: never
  def throw(value), do: fz_throw(value)

  extern "fz" defp fz_throw(any) :: never

  @doc """
  Ends the current process with `reason`: the nearest `catch :exit, reason`
  clause receives it.

      try do
        exit(:stopped)
      catch
        :exit, reason -> reason
      end
      # :stopped

  With no `catch` to take it the process ends. The reasons `:normal`,
  `:shutdown` and `{:shutdown, status}` end it silently, and a main process
  that ends this way exits the program with status 0, 0, and `status`. Any
  other reason prints `** (exit) reason` and exits the program with status 1.
  """
  @spec exit(any) :: never
  def exit(reason), do: fz_exit(reason)

  extern "fz" defp fz_exit(any) :: never

  @doc """
  Raises the exception `exception` again. The stacktrace is accepted for
  Elixir's sake and ignored: fz carries no stacktraces.

      try do
        raise ArgumentError, "bad"
      rescue
        e -> reraise e, []
      end
  """
  @spec reraise(any, any) :: never
  def reraise(exception, _stacktrace), do: panic(exception)

  @doc """
  Raises a `RuntimeError` with `message`.

      raise "boom"
      # ** (RuntimeError) boom
  """
  @spec raise(binary) :: never
  def raise(message), do: raise(RuntimeError, message)

  @doc """
  Raises the exception `name` with `message`: the raise is
  `%{__struct__: name, __exception__: true, message: message}`, and the
  nearest `rescue` that takes it receives it. With none the current process
  fails.

      raise ArgumentError, "bad"
      # ** (ArgumentError) bad
  """
  @spec raise(atom, binary) :: never
  def raise(name, message), do: fz_raise(name, message)

  extern "fz" defp fz_raise(any, any) :: never

  @doc """
  Answers `left` when it is truthy, and `right` otherwise.

  `nil` and `false` are false; every other value is true. `right` is
  evaluated only when `left` is false. A macro, so a guard refuses it.

  ## Examples

      nil || []
      #=> []

      "x" || []
      #=> "x"

  """
  defmacro left || right do
    quote do
      case unquote(left) do
        nil -> unquote(right)
        false -> unquote(right)
        value -> value
      end
    end
  end

  @doc """
  Answers `left` when it is false, and `right` otherwise.

  `nil` and `false` are false; every other value is true. `right` is
  evaluated only when `left` is true. A macro, so a guard refuses it.

  ## Examples

      nil && 1
      #=> nil

      1 && 2
      #=> 2

  """
  defmacro left && right do
    quote do
      case unquote(left) do
        nil -> nil
        false -> false
        _ -> unquote(right)
      end
    end
  end

  @doc """
  Answers `true` when `value` is `nil` or `false`, and `false` otherwise.

  ## Examples

      !nil
      #=> true

      !0
      #=> false

  """
  defmacro !value do
    quote do
      case unquote(value) do
        nil -> true
        false -> true
        _ -> false
      end
    end
  end

  # In Elixir, `to_string/1` is a macro expanding to `String.Chars.to_string/1`.
  # Here it is an ordinary function, since the macro's expansion has nothing
  # to do at compile time.
  @doc """
  Converts `term` to a binary via the `String.Chars` protocol.

  ## Examples

      Kernel.to_string(42)
      #=> "42"

      Kernel.to_string(:hello)
      #=> "hello"

  """
  @spec to_string(any) :: binary
  def to_string(term), do: String.Chars.to_string(term)

  @doc """
  Prints `x` to standard output and returns it unchanged. It is
  `IO.inspect/1`.

  ## Examples

      Kernel.dbg(1 + 2)
      #=> 3

  """
  @spec dbg(t) :: t when t: any
  def dbg(x), do: IO.inspect(x)

  @doc """
  Aborts the current process if `x` is `nil` or `false`.

  Returns `nil` when `x` is truthy.

  ## Examples

      Kernel.assert(1 == 1)
      #=> nil

  """
  @spec assert(any) :: nil
  def assert(x), do: if x, do: nil, else: panic("assertion failed")

  @doc """
  Aborts the current process with `msg` as the reason if `x` is `nil` or
  `false`.

  Like `assert/1`, but with a custom message.
  """
  @spec assert(any, any) :: nil
  def assert(x, msg), do: if x, do: nil, else: panic(msg)

  @doc """
  Aborts the current process if `x` is truthy.

  Returns `nil` when `x` is `nil` or `false`.

  ## Examples

      Kernel.refute(1 == 2)
      #=> nil

  """
  @spec refute(any) :: nil
  def refute(x), do: if x, do: panic("refutation failed"), else: nil

  @doc """
  Aborts the current process with `msg` as the reason if `x` is truthy.

  Like `refute/1`, but with a custom message.
  """
  @spec refute(any, any) :: nil
  def refute(x, msg), do: if x, do: panic(msg), else: nil

  @doc """
  Starts a process that applies the zero-argument function `fun`, and
  returns its pid.

  ## Examples

      me = Kernel.self()
      Kernel.spawn(fn () -> Kernel.send(me, 1 + 2) end)
      receive do
        x -> x
      end
      #=> 3

  """
  @spec spawn(() -> any) :: pid
  def spawn(fun), do: fz_spawn(fun)

  extern "fz" defp fz_spawn(() -> any) :: pid

  @doc """
  Returns the pid of the calling process.
  """
  @spec self() :: pid
  def self(), do: fz_self()

  extern "fz" defp fz_self() :: pid

  @doc """
  Sends `msg` to `pid` and returns `msg`.

  ## Examples

      Kernel.send(self(), 42)
      #=> 42

      receive do
        x -> x
      end
      #=> 42

  """
  @spec send(pid, t) :: t when t: any
  def send(pid, msg), do: fz_send(pid, msg)

  extern "fz" defp fz_send(pid, t) :: t when t: any

  @doc """
  Returns a fresh, opaque reference; no two calls in a process return the
  same one.

  ## Examples

      Kernel.make_ref()
      #=> 1

  """
  @spec make_ref() :: ref
  def make_ref(), do: fz_make_ref()

  extern "C" defp fz_make_ref() :: ref

  @doc """
  Wraps a host handle `value` and destructor `dtor` in a resource.

  `value` is an integer or a C pointer. `dtor` runs once, when the
  resource is garbage-collected, even if the handle has been bound to
  more than one name.
  """
  @spec make_resource(t, (t) -> nil) :: resource(t) when t: integer | c_pointer
  def make_resource(value, dtor), do: fz_make_resource(value, dtor)

  extern "fz" defp fz_make_resource(t, (t) -> nil) :: resource(t) when t: integer | c_pointer

  @doc """
  Claims `resource` for deterministic cleanup.

  Exactly one alias can claim a resource, including an alias sent to another
  process. A successful claim disables its fallback destructor; the caller
  now owns cleanup of the returned raw payload.
  """
  @spec claim_resource(resource(t)) :: {:ok, t} | {:error, :closed} when t: integer | c_pointer
  def claim_resource(resource) do
    value = resource.value
    claim_resource_result(fz_resource_claim(resource), value)
  end

  extern "fz" defp fz_resource_claim(resource(t)) :: boolean when t: integer | c_pointer

  @spec claim_resource_result(boolean, t) :: {:ok, t} | {:error, :closed} when t: integer | c_pointer
  defp claim_resource_result(true, value), do: {:ok, value}
  defp claim_resource_result(false, _value), do: {:error, :closed}

  @doc """
  Constructs a `Range` from `first` to `last`, stepping by `step`.

  ## Examples

      Kernel.range(1, 5, 1)
      #=> 1..5

      Kernel.range(1, 10, 2)
      #=> 1..10//2

  """
  @spec range(integer, integer, integer) :: any
  def range(first, last, step), do: Range.new(first, last, step)

  # Arithmetic exports are total and communicate domain failures as an
  # unboxed `{result, boolean}` pair. This is the sole source-level policy
  # point: every failed arithmetic operation raises through `arithmetic_error/0`.
  # Each arithmetic function ends in a default clause outside its `@spec` that
  # calls it, so an operand that is not a number, known only at runtime, raises
  # `ArithmeticError` where a typed clause would otherwise be missed. The
  # default clause returns `never`, so it adds nothing to the result type.
  @spec arithmetic_error() :: never
  defp arithmetic_error(), do: raise(ArithmeticError, "bad argument in arithmetic expression")

  @spec arithmetic_result({t, boolean}) :: t when t: any
  defp arithmetic_result({result, false}), do: result
  defp arithmetic_result({_, true}), do: arithmetic_error()

  @doc """
  Concatenates two binaries.

  ## Examples

      "hello" <> " world"
      #=> "hello world"

  """
  @spec binary <> binary :: binary
  def (left :: binary) <> (right :: binary), do: fz_binary_concat(left, right)

  extern "fz" defp fz_binary_concat(binary, binary) :: binary

  # Unary minus. Every binary operator is a typed clause family, so a
  # dynamically-typed operand dispatches; unary minus was lowered straight to
  # one machine instruction and read one lane, so `-x` aborted natively where
  # `0 - x` worked. The front door rewrites `-x` to this call, except for a
  # literal, which folds to a negative literal and never becomes a call at
  # all.
  #
  # Not `0 - x`: that answers `0.0` for `-0.0`, and the sign of zero is
  # observable.
  @doc """
  Returns the negation of `x`.

  Raises `ArithmeticError` when `x` is not a number.

  This is what `-x` compiles to when `x` is not a literal.

  ## Examples

      Kernel.negate(5)
      #=> -5

      Kernel.negate(0.0)
      #=> -0.0

  """
  @spec negate(integer) :: integer
  @spec negate(float) :: float
  def negate(x :: integer), do: arithmetic_result(fz_op_neg_i(x))
  def negate(x :: float), do: fz_op_neg_f(x)
  def negate(_), do: arithmetic_error()

  extern "C" defp fz_op_neg_i(integer) :: {integer, boolean}
  extern "C" defp fz_op_neg_f(float) :: float

  @doc """
  Returns the sum of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      1 + 2
      #=> 3

      1 + 2.0
      #=> 3.0

  """
  @spec integer + integer :: integer
  @spec float + float :: float
  @spec integer + float :: float
  @spec float + integer :: float
  def (left :: integer) + (right :: integer), do: arithmetic_result(fz_op_add_ii(left, right))
  def (left :: integer) + (right :: float), do: arithmetic_result(fz_op_add_if(left, right))
  def (left :: float) + (right :: integer), do: arithmetic_result(fz_op_add_if(right, left))
  def (left :: float) + (right :: float), do: arithmetic_result(fz_op_add_ff(left, right))
  def _left + _right, do: arithmetic_error()

  extern "C" defp fz_op_add_ii(integer, integer) :: {integer, boolean}
  extern "C" defp fz_op_add_if(integer, float) :: {float, boolean}
  extern "C" defp fz_op_add_ff(float, float) :: {float, boolean}

  @doc """
  Returns the difference of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      5 - 3
      #=> 2

      5 - 3.0
      #=> 2.0

  """
  @spec integer - integer :: integer
  @spec float - float :: float
  @spec integer - float :: float
  @spec float - integer :: float
  def (left :: integer) - (right :: integer), do: arithmetic_result(fz_op_sub_ii(left, right))
  def (left :: integer) - (right :: float), do: arithmetic_result(fz_op_sub_if(left, right))
  def (left :: float) - (right :: integer), do: arithmetic_result(fz_op_sub_fi(left, right))
  def (left :: float) - (right :: float), do: arithmetic_result(fz_op_sub_ff(left, right))
  def _left - _right, do: arithmetic_error()

  extern "C" defp fz_op_sub_ii(integer, integer) :: {integer, boolean}
  extern "C" defp fz_op_sub_if(integer, float) :: {float, boolean}
  extern "C" defp fz_op_sub_fi(float, integer) :: {float, boolean}
  extern "C" defp fz_op_sub_ff(float, float) :: {float, boolean}

  @doc """
  Returns the product of `left` and `right`.

  Raises `ArithmeticError` when an operand is not a number.

  Mixing an integer and a float returns a float.

  ## Examples

      3 * 4
      #=> 12

      3 * 4.0
      #=> 12.0

  """
  @spec integer * integer :: integer
  @spec float * float :: float
  @spec integer * float :: float
  @spec float * integer :: float
  def (left :: integer) * (right :: integer), do: arithmetic_result(fz_op_mul_ii(left, right))
  def (left :: integer) * (right :: float), do: arithmetic_result(fz_op_mul_if(left, right))
  def (left :: float) * (right :: integer), do: arithmetic_result(fz_op_mul_if(right, left))
  def (left :: float) * (right :: float), do: arithmetic_result(fz_op_mul_ff(left, right))
  def _left * _right, do: arithmetic_error()

  extern "C" defp fz_op_mul_ii(integer, integer) :: {integer, boolean}
  extern "C" defp fz_op_mul_if(integer, float) :: {float, boolean}
  extern "C" defp fz_op_mul_ff(float, float) :: {float, boolean}

  # `/` always returns a float, as in Elixir: `1 / 2` is `0.5`, not `0`. The
  # truncating form is `div/2` below. Getting this wrong is silent -- integer
  # division simply loses the fraction -- and a JSON number parser building
  # `3 + 5 / 10` needs `3.5`.
  @doc """
  Returns the quotient of `left` and `right`, as a float.

  Raises `ArithmeticError` when an operand is not a number.

  For the truncating integer quotient, see `div/2`.

  ## Examples

      1 / 2
      #=> 0.5

      4 / 2
      #=> 2.0

  """
  @spec integer / integer :: float
  @spec float / float :: float
  @spec integer / float :: float
  @spec float / integer :: float
  def (left :: integer) / (right :: integer), do: arithmetic_result(fz_op_div_ii_to_float(left, right))
  def (left :: integer) / (right :: float), do: arithmetic_result(fz_op_div_if(left, right))
  def (left :: float) / (right :: integer), do: arithmetic_result(fz_op_div_fi(left, right))
  def (left :: float) / (right :: float), do: arithmetic_result(fz_op_div_ff(left, right))
  def _left / _right, do: arithmetic_error()

  extern "C" defp fz_op_div_ii_to_float(integer, integer) :: {float, boolean}
  extern "C" defp fz_op_div_if(integer, float) :: {float, boolean}
  extern "C" defp fz_op_div_fi(float, integer) :: {float, boolean}
  extern "C" defp fz_op_div_ff(float, float) :: {float, boolean}

  @doc """
  Returns the truncating integer quotient of `left` divided by `right`.

  Raises `ArithmeticError` when an operand is not an integer, or `right` is zero.

  Unlike `/`, which always returns a float, `div/2` discards the remainder.

  ## Examples

      Kernel.div(7, 2)
      #=> 3

  """
  @spec div(integer, integer) :: integer
  def div(left :: integer, right :: integer), do: arithmetic_result(fz_op_div_ii(left, right))
  def div(_, _), do: arithmetic_error()

  extern "C" defp fz_op_div_ii(integer, integer) :: {integer, boolean}

  @doc """
  Returns the remainder of `left` divided by `right`, with the sign of
  `left`.

  Raises `ArithmeticError` when an operand is not an integer, or `right` is zero.

  ## Examples

      Kernel.rem(7, 2)
      #=> 1

      Kernel.rem(-7, 2)
      #=> -1

  """
  @spec rem(integer, integer) :: integer
  def rem(left :: integer, right :: integer), do: arithmetic_result(fz_op_rem_ii(left, right))
  def rem(_, _), do: arithmetic_error()

  @doc """
  Returns the remainder of `left` divided by `right`; the operator form of
  `rem/2`.

  Raises `ArithmeticError` when an operand is not a number.

  ## Examples

      7 % 2
      #=> 1

      -7 % 2
      #=> -1

  """
  @spec integer % integer :: integer
  @spec float % float :: float
  @spec integer % float :: float
  @spec float % integer :: float
  def (left :: integer) % (right :: integer), do: arithmetic_result(fz_op_rem_ii(left, right))
  def (left :: integer) % (right :: float), do: arithmetic_result(fz_op_rem_if(left, right))
  def (left :: float) % (right :: integer), do: arithmetic_result(fz_op_rem_fi(left, right))
  def (left :: float) % (right :: float), do: arithmetic_result(fz_op_rem_ff(left, right))
  def _left % _right, do: arithmetic_error()

  extern "C" defp fz_op_rem_ii(integer, integer) :: {integer, boolean}
  extern "C" defp fz_op_rem_if(integer, float) :: {float, boolean}
  extern "C" defp fz_op_rem_fi(float, integer) :: {float, boolean}
  extern "C" defp fz_op_rem_ff(float, float) :: {float, boolean}

  # Comparing an integer against a float is a comparison of two floats, and
  # widening the integer is this module's job. Arithmetic already spells its
  # four numeric combinations out one clause at a time; comparison does the
  # same, so a mixed pair is answered by a typed clause on unboxed lanes
  # rather than by codegen boxing an operand and coercing it behind our back.
  # Every comparison operator is a typed clause family over those numeric
  # pairs, and every one of them is total, so each keeps an `any`/`any` clause
  # beside the typed ones: two numbers are answered on unboxed lanes, and
  # every other pair falls through to the structural comparator, which orders
  # by the total term order, widens numerics for `==` and stays strict for
  # `===`.

  # NOTE/TODO: the `binary` clauses of the four ordering operators are
  # commented out below rather than deleted.
  #
  # A `binary` clause compiles to a runtime test that proves only
  # "bitstring". Seated ahead of an `any`/`any` clause, that test would send
  # an unresolved operand to the byte compare without proving the surface the
  # clause names, so the blind-escape census cannot justify the seat. Binaries
  # reach the comparator's bitstring branch through the final clause instead.
  #
  # Each clause returns, as the fast path, once the binary axis of the runtime
  # test is precise: see `RuntimeTestAxis::precision` in
  # `src/runtime_type_predicate.rs`, where `Binaries` is `Erasing`. The
  # `fz_op_lt_bb`, `fz_op_lte_bb`, `fz_op_gt_bb` and `fz_op_gte_bb`
  # declarations stay, so restoring a clause is the uncomment.
  @doc """
  Returns whether `left` is less than `right`.

  Every pair of values has an answer: two numbers are compared on a typed
  clause, and every other pair goes through `compare/2`, the total term
  order.

  ## Examples

      1 < 2
      #=> true

      1 < 1.5
      #=> true

      "abc" < "abd"
      #=> true

      1 < :atom
      #=> true

  """
  @spec integer < integer :: boolean
  @spec float < float :: boolean
  @spec integer < float :: boolean
  @spec float < integer :: boolean
  # @spec binary < binary :: boolean
  @spec any < any :: boolean
  def (left :: integer) < (right :: integer), do: fz_op_lt_ii(left, right)
  def (left :: float) < (right :: float), do: fz_op_lt_ff(left, right)
  def (left :: integer) < (right :: float), do: fz_op_lt_if(left, right)
  def (left :: float) < (right :: integer), do: fz_op_lt_fi(left, right)
  # def (left :: binary) < (right :: binary), do: fz_op_lt_bb(left, right)
  def left < right, do: compare(left, right) < 0

  extern "C" defp fz_op_lt_ii(integer, integer) :: boolean
  extern "C" defp fz_op_lt_ff(float, float) :: boolean
  extern "C" defp fz_op_lt_if(integer, float) :: boolean
  extern "C" defp fz_op_lt_fi(float, integer) :: boolean
  extern "fz" defp fz_op_lt_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is less than or equal to `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      1 <= 1
      #=> true

      :atom <= "bin"
      #=> true

  """
  @spec integer <= integer :: boolean
  @spec float <= float :: boolean
  @spec integer <= float :: boolean
  @spec float <= integer :: boolean
  # @spec binary <= binary :: boolean
  @spec any <= any :: boolean
  def (left :: integer) <= (right :: integer), do: fz_op_lte_ii(left, right)
  def (left :: float) <= (right :: float), do: fz_op_lte_ff(left, right)
  def (left :: integer) <= (right :: float), do: fz_op_lte_if(left, right)
  def (left :: float) <= (right :: integer), do: fz_op_lte_fi(left, right)
  # def (left :: binary) <= (right :: binary), do: fz_op_lte_bb(left, right)
  def left <= right, do: compare(left, right) <= 0

  extern "C" defp fz_op_lte_ii(integer, integer) :: boolean
  extern "C" defp fz_op_lte_ff(float, float) :: boolean
  extern "C" defp fz_op_lte_if(integer, float) :: boolean
  extern "C" defp fz_op_lte_fi(float, integer) :: boolean
  extern "fz" defp fz_op_lte_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is greater than `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      2 > 1
      #=> true

      "abc" > "abb"
      #=> true

      [1] > {1}
      #=> true

  """
  @spec integer > integer :: boolean
  @spec float > float :: boolean
  @spec integer > float :: boolean
  @spec float > integer :: boolean
  # @spec binary > binary :: boolean
  @spec any > any :: boolean
  def (left :: integer) > (right :: integer), do: fz_op_gt_ii(left, right)
  def (left :: float) > (right :: float), do: fz_op_gt_ff(left, right)
  def (left :: integer) > (right :: float), do: fz_op_gt_if(left, right)
  def (left :: float) > (right :: integer), do: fz_op_gt_fi(left, right)
  # def (left :: binary) > (right :: binary), do: fz_op_gt_bb(left, right)
  def left > right, do: compare(left, right) > 0

  extern "C" defp fz_op_gt_ii(integer, integer) :: boolean
  extern "C" defp fz_op_gt_ff(float, float) :: boolean
  extern "C" defp fz_op_gt_if(integer, float) :: boolean
  extern "C" defp fz_op_gt_fi(float, integer) :: boolean
  extern "fz" defp fz_op_gt_bb(binary, binary) :: boolean

  @doc """
  Returns whether `left` is greater than or equal to `right`.

  Total over every pair of values, like `</2`.

  ## Examples

      1 >= 1
      #=> true

      :atom >= 1
      #=> true

  """
  @spec integer >= integer :: boolean
  @spec float >= float :: boolean
  @spec integer >= float :: boolean
  @spec float >= integer :: boolean
  # @spec binary >= binary :: boolean
  @spec any >= any :: boolean
  def (left :: integer) >= (right :: integer), do: fz_op_gte_ii(left, right)
  def (left :: float) >= (right :: float), do: fz_op_gte_ff(left, right)
  def (left :: integer) >= (right :: float), do: fz_op_gte_if(left, right)
  def (left :: float) >= (right :: integer), do: fz_op_gte_fi(left, right)
  # def (left :: binary) >= (right :: binary), do: fz_op_gte_bb(left, right)
  def left >= right, do: compare(left, right) >= 0

  extern "C" defp fz_op_gte_ii(integer, integer) :: boolean
  extern "C" defp fz_op_gte_ff(float, float) :: boolean
  extern "C" defp fz_op_gte_if(integer, float) :: boolean
  extern "C" defp fz_op_gte_fi(float, integer) :: boolean
  extern "fz" defp fz_op_gte_bb(binary, binary) :: boolean

  @doc """
  Returns the number of bytes in `bytes`.

  For the number of codepoints, see `String.length/1`.

  ## Examples

      Kernel.byte_size("hello")
      #=> 5

      Kernel.byte_size("héllo")
      #=> 6

  """
  @spec byte_size(any) :: integer
  def byte_size(bytes :: binary), do: fz_bitstring_byte_size(bytes)
  def byte_size(_), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: not a bitstring\n")

  extern "C" defp fz_bitstring_byte_size(any) :: integer

  @doc """
  Returns the number of entries in `map`.

  Raises `BadMapError` when `map` is not a map. In a guard, a non-map makes
  the guard false.

  ## Examples

      Kernel.map_size(%{a: 1, b: 2})
      #=> 2

      Kernel.map_size(%{})
      #=> 0

  """
  @spec map_size(any) :: integer
  def map_size(map :: map), do: fz_map_count(map)
  def map_size(map), do: raise(BadMapError, "expected a map, got:\n\n    " <> inspect(map) <> "\n")

  extern "C" defp fz_map_count(any) :: integer

  @doc """
  Returns the number of elements in `tuple`.

  Raises `ArgumentError` when `tuple` is not a tuple. In a guard, a non-tuple
  makes the guard false.

  ## Examples

      Kernel.tuple_size({:a, :b, :c})
      #=> 3

      Kernel.tuple_size({})
      #=> 0

  """
  @spec tuple_size(any) :: integer
  def tuple_size(tuple :: tuple), do: fz_tuple_size(tuple)
  def tuple_size(_), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: not a tuple\n")

  extern "fz" defp fz_tuple_size(any) :: integer

  @doc """
  Returns the element of `tuple` at the zero-based `index`.

  Raises `ArgumentError` when `tuple` is not a tuple or `index` is outside it,
  and `ArithmeticError` when `index` is not an integer.
  In a guard, either makes the guard false.

  ## Examples

      Kernel.elem({:a, :b, :c}, 1)
      #=> :b

  """
  @spec elem(any, any) :: any
  def elem(tuple :: tuple, index) when is_integer(index) and index >= 0 and index < tuple_size(tuple),
    do: fz_tuple_elem(tuple, index)

  def elem(tuple :: tuple, index) when is_integer(index), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: out of range\n")
  def elem(_, index) when is_integer(index), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 2nd argument: not a tuple\n")
  def elem(_, _), do: arithmetic_error()

  extern "fz" defp fz_tuple_elem(any, integer) :: any

  @doc """
  Returns the number of elements in `list`.

  Raises `ArgumentError` when `list` is not a proper list. In a guard, an
  improper list or a non-list makes the guard false.

  ## Examples

      Kernel.length([1, 2, 3])
      #=> 3

      Kernel.length([])
      #=> 0

  """
  @spec length(any) :: integer
  def length(list :: list), do: proper_length(fz_list_length(list))
  def length(_), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: not a list\n")

  @spec proper_length(integer) :: integer
  defp proper_length(count) when count >= 0, do: count
  defp proper_length(_), do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: not a list\n")

  extern "C" defp fz_list_length(any) :: integer

  @doc """
  Returns `true` when `term` is a tuple of any arity.

  ## Examples

      Kernel.is_tuple({1, 2})
      #=> true

      Kernel.is_tuple([1, 2])
      #=> false

  """
  @spec is_tuple(any) :: boolean
  def is_tuple(_ :: tuple), do: true
  def is_tuple(_), do: false

  @doc """
  Returns `true` when `term` is an integer.

  ## Examples

      Kernel.is_integer(1)
      #=> true

      Kernel.is_integer(1.0)
      #=> false

  """
  @spec is_integer(any) :: boolean
  def is_integer(_ :: integer), do: true
  def is_integer(_), do: false

  @doc """
  Returns `true` when `term` is a float.

  ## Examples

      Kernel.is_float(1.0)
      #=> true

      Kernel.is_float(1)
      #=> false

  """
  @spec is_float(any) :: boolean
  def is_float(_ :: float), do: true
  def is_float(_), do: false

  @doc """
  Returns `true` when `term` is a binary.

  ## Examples

      Kernel.is_binary("hello")
      #=> true

      Kernel.is_binary(:hello)
      #=> false

  """
  @spec is_binary(any) :: boolean
  def is_binary(_ :: binary), do: true
  def is_binary(_), do: false

  @doc """
  Returns `true` when `term` is a list, proper or not.

  ## Examples

      Kernel.is_list([1, 2])
      #=> true

      Kernel.is_list({1, 2})
      #=> false

  """
  @spec is_list(any) :: boolean
  def is_list(_ :: list), do: true
  def is_list(_), do: false

  @doc """
  Returns `true` when `term` is a map.

  ## Examples

      Kernel.is_map(%{a: 1})
      #=> true

      Kernel.is_map([a: 1])
      #=> false

  """
  @spec is_map(any) :: boolean
  def is_map(_ :: map), do: true
  def is_map(_), do: false

  @doc """
  Returns `true` when `term` is an atom, including `true`, `false` and `nil`.

  ## Examples

      Kernel.is_atom(:ok)
      #=> true

      Kernel.is_atom("ok")
      #=> false

  """
  @spec is_atom(any) :: boolean
  def is_atom(_ :: atom), do: true
  def is_atom(_), do: false

  @doc """
  Returns `true` when `term` is `true` or `false`.

  ## Examples

      Kernel.is_boolean(false)
      #=> true

      Kernel.is_boolean(nil)
      #=> false

  """
  @spec is_boolean(any) :: boolean
  def is_boolean(_ :: boolean), do: true
  def is_boolean(_), do: false

  @doc """
  Returns `true` when `term` is `nil`.

  ## Examples

      Kernel.is_nil(nil)
      #=> true

      Kernel.is_nil(false)
      #=> false

  """
  @spec is_nil(any) :: boolean
  def is_nil(_ :: nil), do: true
  def is_nil(_), do: false

  # `</2` and its siblings carry this order through `compare/2`.
  @doc """
  Compares `left` and `right` by the total term order, and returns a
  negative integer, `0`, or a positive integer.

  Unlike `===/2`, numbers compare by value across types: `1` and `1.0`
  compare equal. Every value has a place in this order, which is what
  `Enum.sort/1` uses to order a mixed list.

  ## Examples

      Kernel.compare(1, 2)
      #=> -1

      Kernel.compare(1, 1.0)
      #=> 0

      Kernel.compare(:a, 1)
      #=> 1

  """
  @spec compare(any, any) :: integer
  def compare(left, right), do: fz_value_cmp_ref(left, right)

  # The total term order over every value. Takes the process (the `fz` ABI)
  # because atoms order by name, not by the id they were interned with.
  extern "fz" defp fz_value_cmp_ref(any, any) :: integer

  @doc """
  Returns whether `left` and `right` are equal, comparing numbers by value.

  `1 == 1.0` is true; for identity instead, see `===/2`.

  ## Examples

      1 == 1.0
      #=> true

      [1, 2] == [1, 2]
      #=> true

  """
  @spec integer == integer :: boolean
  @spec float == float :: boolean
  @spec integer == float :: boolean
  @spec float == integer :: boolean
  @spec any == any :: boolean
  def (left :: integer) == (right :: integer), do: fz_op_eq_ii(left, right)
  def (left :: float) == (right :: float), do: fz_op_eq_ff(left, right)
  def (left :: integer) == (right :: float), do: fz_op_eq_if(left, right)
  def (left :: float) == (right :: integer), do: fz_op_eq_fi(left, right)
  def left == right, do: fz_op_eq(left, right)

  extern "C" defp fz_op_eq_ii(integer, integer) :: boolean
  extern "C" defp fz_op_eq_ff(float, float) :: boolean
  extern "C" defp fz_op_eq_if(integer, float) :: boolean
  extern "C" defp fz_op_eq_fi(float, integer) :: boolean
  extern "fz" defp fz_op_eq(any, any) :: boolean

  @doc """
  Returns whether `left` and `right` are not equal; the negation of `==/2`.

  ## Examples

      1 != 2
      #=> true

      1 != 1.0
      #=> false

  """
  @spec integer != integer :: boolean
  @spec float != float :: boolean
  @spec integer != float :: boolean
  @spec float != integer :: boolean
  @spec any != any :: boolean
  def (left :: integer) != (right :: integer), do: fz_op_neq_ii(left, right)
  def (left :: float) != (right :: float), do: fz_op_neq_ff(left, right)
  def (left :: integer) != (right :: float), do: fz_op_neq_if(left, right)
  def (left :: float) != (right :: integer), do: fz_op_neq_fi(left, right)
  def left != right, do: fz_op_neq(left, right)

  extern "C" defp fz_op_neq_ii(integer, integer) :: boolean
  extern "C" defp fz_op_neq_ff(float, float) :: boolean
  extern "C" defp fz_op_neq_if(integer, float) :: boolean
  extern "C" defp fz_op_neq_fi(float, integer) :: boolean
  extern "fz" defp fz_op_neq(any, any) :: boolean

  # `===` asks whether two values are the same value, where `==` compares
  # numbers by value: `1 == 1.0` is true and `1 === 1.0` is false. Membership,
  # `--` and a map key all mean identity.
  @doc """
  Returns whether `left` and `right` are the same value.

  Unlike `==/2`, `===` does not compare numbers across types: `1 === 1.0`
  is false. Membership, `--` and map keys all mean identity.

  ## Examples

      1 === 1.0
      #=> false

      [1, 2] === [1, 2]
      #=> true

  """
  @spec integer === integer :: boolean
  @spec float === float :: boolean
  @spec integer === float :: boolean
  @spec float === integer :: boolean
  @spec any === any :: boolean
  def (left :: integer) === (right :: integer), do: fz_op_identical_ii(left, right)
  def (left :: float) === (right :: float), do: fz_op_identical_ff(left, right)
  def (_left :: integer) === (_right :: float), do: false
  def (_left :: float) === (_right :: integer), do: false
  def left === right, do: fz_op_identical(left, right)

  extern "C" defp fz_op_identical_ii(integer, integer) :: boolean
  extern "C" defp fz_op_identical_ff(float, float) :: boolean
  extern "fz" defp fz_op_identical(any, any) :: boolean

  @doc """
  Returns whether `left` and `right` are not the same value; the negation
  of `===/2`.

  ## Examples

      1 !== 1.0
      #=> true

      1 !== 1
      #=> false

  """
  @spec integer !== integer :: boolean
  @spec float !== float :: boolean
  @spec integer !== float :: boolean
  @spec float !== integer :: boolean
  @spec any !== any :: boolean
  def (left :: integer) !== (right :: integer), do: fz_op_not_identical_ii(left, right)
  def (left :: float) !== (right :: float), do: fz_op_not_identical_ff(left, right)
  def (_left :: integer) !== (_right :: float), do: true
  def (_left :: float) !== (_right :: integer), do: true
  def left !== right, do: fz_op_not_identical(left, right)

  extern "C" defp fz_op_not_identical_ii(integer, integer) :: boolean
  extern "C" defp fz_op_not_identical_ff(float, float) :: boolean
  extern "fz" defp fz_op_not_identical(any, any) :: boolean
end
