defmodule Kernel do
  @moduledoc """
  The functions and operators available everywhere, without a `Kernel.` prefix.

  `Kernel` supplies:

    * the arithmetic operators `+`, `-`, `*`, `/`, `%` and unary minus
    * the comparison operators `<`, `<=`, `>`, `>=`, plus `==`, `!=`, `===`,
      `!==` and the total term order `compare/2`
    * process primitives: `self/0`, `send/2`, `spawn/1`, `spawn/2`,
      `make_ref/0` and `make_resource/2`
    * `panic/1`, `assert/1`, `assert/2`, `refute/1` and `refute/2`, for
      aborting the current process
    * `dbg/1`, `to_string/1`, `byte_size/1`, `div/2`, `rem/2` and `range/3`

  Every arithmetic and comparison operator is a typed clause family: one
  clause per pair of operand types it supports, and no catch-all. A pair
  outside that set is refused at compile time rather than answered.
  """

  extern "fz" fn fz_dbg_value(any) :: any
  intrinsic "panic" fn fz_panic(any) :: never
  intrinsic "spawn" fn fz_spawn(() -> any) :: pid
  intrinsic "spawn_opt" fn fz_spawn_opt(() -> any, integer) :: pid
  intrinsic "self" fn fz_self() :: pid
  intrinsic "send" fn fz_send(pid, t) :: t when t: any
  intrinsic "make_ref" fn fz_make_ref() :: ref
  intrinsic "make_resource" fn fz_make_resource(t, (t) -> nil) :: resource(t) when t: integer | cpointer
  extern "fz" fn fz_binary_concat(binary, binary) :: binary
  intrinsic "neg_i" fn fz_op_neg_i(integer) :: integer
  intrinsic "neg_f" fn fz_op_neg_f(float) :: float
  intrinsic "add_ii" fn fz_op_add_ii(integer, integer) :: integer
  intrinsic "add_if" fn fz_op_add_if(integer, float) :: float
  intrinsic "add_ff" fn fz_op_add_ff(float, float) :: float
  intrinsic "sub_ii" fn fz_op_sub_ii(integer, integer) :: integer
  intrinsic "sub_if" fn fz_op_sub_if(integer, float) :: float
  intrinsic "sub_fi" fn fz_op_sub_fi(float, integer) :: float
  intrinsic "sub_ff" fn fz_op_sub_ff(float, float) :: float
  intrinsic "mul_ii" fn fz_op_mul_ii(integer, integer) :: integer
  intrinsic "mul_if" fn fz_op_mul_if(integer, float) :: float
  intrinsic "mul_ff" fn fz_op_mul_ff(float, float) :: float
  intrinsic "div_ii" fn fz_op_div_ii(integer, integer) :: integer
  intrinsic "div_ii_to_float" fn fz_op_div_ii_to_float(integer, integer) :: float
  intrinsic "div_if" fn fz_op_div_if(integer, float) :: float
  intrinsic "div_fi" fn fz_op_div_fi(float, integer) :: float
  intrinsic "div_ff" fn fz_op_div_ff(float, float) :: float
  intrinsic "rem_ii" fn fz_op_rem_ii(integer, integer) :: integer
  intrinsic "rem_if" fn fz_op_rem_if(integer, float) :: float
  intrinsic "rem_fi" fn fz_op_rem_fi(float, integer) :: float
  intrinsic "rem_ff" fn fz_op_rem_ff(float, float) :: float
  extern "C" fn fz_bitstring_byte_size(any) :: integer
  # The total term order over every value, which the cross-type clauses below
  # are written in terms of. Takes the process (the `fz` ABI) because atoms
  # order by name, not by the id they were interned with.
  extern "fz" fn fz_value_cmp_ref(any, any) :: integer
  intrinsic "lt_ii" fn fz_op_lt_ii(integer, integer) :: bool
  intrinsic "lt_ff" fn fz_op_lt_ff(float, float) :: bool
  intrinsic "lt_bb" fn fz_op_lt_bb(binary, binary) :: bool
  intrinsic "lte_ii" fn fz_op_lte_ii(integer, integer) :: bool
  intrinsic "lte_ff" fn fz_op_lte_ff(float, float) :: bool
  intrinsic "lte_bb" fn fz_op_lte_bb(binary, binary) :: bool
  intrinsic "gt_ii" fn fz_op_gt_ii(integer, integer) :: bool
  intrinsic "gt_ff" fn fz_op_gt_ff(float, float) :: bool
  intrinsic "gt_bb" fn fz_op_gt_bb(binary, binary) :: bool
  intrinsic "gte_ii" fn fz_op_gte_ii(integer, integer) :: bool
  intrinsic "gte_ff" fn fz_op_gte_ff(float, float) :: bool
  intrinsic "gte_bb" fn fz_op_gte_bb(binary, binary) :: bool
  intrinsic "eq" fn fz_op_eq(any, any) :: bool
  intrinsic "neq" fn fz_op_neq(any, any) :: bool
  intrinsic "identical" fn fz_op_identical(any, any) :: bool
  intrinsic "not_identical" fn fz_op_not_identical(any, any) :: bool
  intrinsic "lt_if" fn fz_op_lt_if(integer, float) :: bool
  intrinsic "lt_fi" fn fz_op_lt_fi(float, integer) :: bool
  intrinsic "lte_if" fn fz_op_lte_if(integer, float) :: bool
  intrinsic "lte_fi" fn fz_op_lte_fi(float, integer) :: bool
  intrinsic "gt_if" fn fz_op_gt_if(integer, float) :: bool
  intrinsic "gt_fi" fn fz_op_gt_fi(float, integer) :: bool
  intrinsic "gte_if" fn fz_op_gte_if(integer, float) :: bool
  intrinsic "gte_fi" fn fz_op_gte_fi(float, integer) :: bool

  @doc """
  Aborts the current process with `msg` as the reason.

  There is no return value: the process stops before this call returns.
  """
  @spec panic(any) :: never
  fn panic(msg), do: fz_panic(msg)

  # In Elixir, `to_string/1` is a macro expanding to `String.Chars.to_string/1`.
  # Here it is an ordinary function, since the macro's expansion has nothing
  # to do at compile time.
  @doc """
  Converts `term` to a binary via the `StringChars` protocol.

  ## Examples

      Kernel.to_string(42)
      #=> "42"

      Kernel.to_string(:hello)
      #=> "hello"

  """
  @spec to_string(any) :: binary
  fn to_string(term), do: StringChars.to_string(term)

  @doc """
  Prints `x` to standard output and returns it unchanged.

  ## Examples

      Kernel.dbg(1 + 2)
      #=> 3

  """
  @spec dbg(t) :: t when t: any
  fn dbg(x), do: fz_dbg_value(x)

  @doc """
  Aborts the current process if `x` is `nil` or `false`.

  Returns `nil` when `x` is truthy.

  ## Examples

      Kernel.assert(1 == 1)
      #=> nil

  """
  @spec assert(any) :: nil
  fn assert(x), do: if x, do: nil, else: panic("assertion failed")

  @doc """
  Aborts the current process with `msg` as the reason if `x` is `nil` or
  `false`.

  Like `assert/1`, but with a custom message.
  """
  @spec assert(any, any) :: nil
  fn assert(x, msg), do: if x, do: nil, else: panic(msg)

  @doc """
  Aborts the current process if `x` is truthy.

  Returns `nil` when `x` is `nil` or `false`.

  ## Examples

      Kernel.refute(1 == 2)
      #=> nil

  """
  @spec refute(any) :: nil
  fn refute(x), do: if x, do: panic("refutation failed"), else: nil

  @doc """
  Aborts the current process with `msg` as the reason if `x` is truthy.

  Like `refute/1`, but with a custom message.
  """
  @spec refute(any, any) :: nil
  fn refute(x, msg), do: if x, do: panic(msg), else: nil

  @doc """
  Starts a process that applies the zero-argument function `fun`, and
  returns its pid.

  ## Examples

      me = Kernel.self()
      Kernel.spawn(fn () -> Kernel.send(me, 1 + 2) end)
      receive do
        x -> x
      end
      #=> 3

  """
  @spec spawn(() -> any) :: pid
  fn spawn(fun), do: fz_spawn(fun)

  @doc """
  Starts a process like `spawn/1`, plus a minimum heap size hint in bytes.

  The hint is accepted but not yet acted on.

  ## Examples

      parent = Kernel.self()
      Kernel.spawn(fn () -> Kernel.send(parent, 42) end, 4096)
      receive do
        x -> x
      end
      #=> 42

  """
  @spec spawn(() -> any, integer) :: pid
  fn spawn(fun, min_heap_size), do: fz_spawn_opt(fun, min_heap_size)

  @doc """
  Returns the pid of the calling process.
  """
  @spec self() :: pid
  fn self(), do: fz_self()

  @doc """
  Sends `msg` to `pid` and returns `msg`.

  The receiver is a pid or its raw integer index; the runtime addresses
  processes by index and has no registry.

  ## Examples

      Kernel.send(1, 42)
      #=> 42

      receive do
        x -> x
      end
      #=> 42

  """
  @spec send(pid | integer, t) :: t when t: any
  fn send(pid, msg), do: fz_send(pid, msg)

  @doc """
  Returns a fresh, opaque reference; no two calls in a process return the
  same one.

  ## Examples

      Kernel.make_ref()
      #=> 1

  """
  @spec make_ref() :: ref
  fn make_ref(), do: fz_make_ref()

  @doc """
  Wraps a host handle `value` and destructor `dtor` in a resource.

  `value` is an integer or a C pointer. `dtor` runs once, when the
  resource is garbage-collected, even if the handle has been bound to
  more than one name.
  """
  @spec make_resource(t, (t) -> nil) :: resource(t) when t: integer | cpointer
  fn make_resource(value, dtor), do: fz_make_resource(value, dtor)

  @doc """
  Constructs a `Range` from `first` to `last`, stepping by `step`.

  ## Examples

      Kernel.range(1, 5, 1)
      #=> 1..5

      Kernel.range(1, 10, 2)
      #=> 1..10//2

  """
  @spec range(integer, integer, integer) :: any
  fn range(first, last, step), do: Range.new(first, last, step)

  # Unary minus. Every binary operator is a typed clause family, so a
  # dynamically-typed operand dispatches; unary minus was lowered straight to
  # one machine instruction and read one lane, so `-x` aborted natively where
  # `0 - x` worked. The front door rewrites `-x` to this call, except for a
  # literal, which folds to a negative literal and never becomes a call at
  # all.
  #
  # Not `0 - x`: that answers `0.0` for `-0.0`, and the sign of zero is
  # observable.
  @doc """
  Returns the negation of `x`.

  This is what `-x` compiles to when `x` is not a literal.

  ## Examples

      Kernel.negate(5)
      #=> -5

      Kernel.negate(0.0)
      #=> -0.0

  """
  @spec negate(integer) :: integer
  @spec negate(float) :: float
  fn negate(x :: integer), do: fz_op_neg_i(x)
  fn negate(x :: float), do: fz_op_neg_f(x)

  @doc """
  Returns the sum of `left` and `right`.

  Mixing an integer and a float returns a float.

  ## Examples

      1 + 2
      #=> 3

      1 + 2.0
      #=> 3.0

  """
  @spec integer + integer :: integer
  @spec float + float :: float
  @spec integer + float :: float
  @spec float + integer :: float
  fn left :: integer + right :: integer, do: fz_op_add_ii(left, right)
  fn left :: integer + right :: float, do: fz_op_add_if(left, right)
  fn left :: float + right :: integer, do: fz_op_add_if(right, left)
  fn left :: float + right :: float, do: fz_op_add_ff(left, right)

  @doc """
  Returns the difference of `left` and `right`.

  Mixing an integer and a float returns a float.

  ## Examples

      5 - 3
      #=> 2

      5 - 3.0
      #=> 2.0

  """
  @spec integer - integer :: integer
  @spec float - float :: float
  @spec integer - float :: float
  @spec float - integer :: float
  fn left :: integer - right :: integer, do: fz_op_sub_ii(left, right)
  fn left :: integer - right :: float, do: fz_op_sub_if(left, right)
  fn left :: float - right :: integer, do: fz_op_sub_fi(left, right)
  fn left :: float - right :: float, do: fz_op_sub_ff(left, right)

  @doc """
  Returns the product of `left` and `right`.

  Mixing an integer and a float returns a float.

  ## Examples

      3 * 4
      #=> 12

      3 * 4.0
      #=> 12.0

  """
  @spec integer * integer :: integer
  @spec float * float :: float
  @spec integer * float :: float
  @spec float * integer :: float
  fn left :: integer * right :: integer, do: fz_op_mul_ii(left, right)
  fn left :: integer * right :: float, do: fz_op_mul_if(left, right)
  fn left :: float * right :: integer, do: fz_op_mul_if(right, left)
  fn left :: float * right :: float, do: fz_op_mul_ff(left, right)

  # `/` always returns a float, as in Elixir: `1 / 2` is `0.5`, not `0`. The
  # truncating form is `div/2` below. Getting this wrong is silent -- integer
  # division simply loses the fraction -- and a JSON number parser building
  # `3 + 5 / 10` needs `3.5`.
  @doc """
  Returns the quotient of `left` and `right`, as a float.

  For the truncating integer quotient, see `div/2`.

  ## Examples

      1 / 2
      #=> 0.5

      4 / 2
      #=> 2.0

  """
  @spec integer / integer :: float
  @spec float / float :: float
  @spec integer / float :: float
  @spec float / integer :: float
  fn left :: integer / right :: integer, do: fz_op_div_ii_to_float(left, right)
  fn left :: integer / right :: float, do: fz_op_div_if(left, right)
  fn left :: float / right :: integer, do: fz_op_div_fi(left, right)
  fn left :: float / right :: float, do: fz_op_div_ff(left, right)

  @doc """
  Returns the truncating integer quotient of `left` divided by `right`.

  Unlike `/`, which always returns a float, `div/2` discards the remainder.

  ## Examples

      Kernel.div(7, 2)
      #=> 3

  """
  @spec div(integer, integer) :: integer
  fn div(left, right), do: fz_op_div_ii(left, right)

  @doc """
  Returns the remainder of `left` divided by `right`, with the sign of
  `left`.

  ## Examples

      Kernel.rem(7, 2)
      #=> 1

      Kernel.rem(-7, 2)
      #=> -1

  """
  @spec rem(integer, integer) :: integer
  fn rem(left, right), do: fz_op_rem_ii(left, right)

  @doc """
  Returns the remainder of `left` divided by `right`; the operator form of
  `rem/2`.

  ## Examples

      7 % 2
      #=> 1

      -7 % 2
      #=> -1

  """
  @spec integer % integer :: integer
  @spec float % float :: float
  @spec integer % float :: float
  @spec float % integer :: float
  fn left :: integer % right :: integer, do: fz_op_rem_ii(left, right)
  fn left :: integer % right :: float, do: fz_op_rem_if(left, right)
  fn left :: float % right :: integer, do: fz_op_rem_fi(left, right)
  fn left :: float % right :: float, do: fz_op_rem_ff(left, right)

  # Comparing an integer against a float is a comparison of two floats, and
  # widening the integer is this module's job. Arithmetic already spells its
  # four numeric combinations out one clause at a time; comparison does the
  # same, so a mixed pair is answered by a typed clause on unboxed lanes
  # rather than by codegen boxing an operand and coercing it behind our back.
  # Ordering is a partial function: there is a clause per pair it can order and
  # no `any`/`any` default, so an unsupported combination has no matching clause
  # and is refused rather than answered wrongly. Equality is total and keeps its
  # single structural clause; `==` widens numerics inside the comparator, where
  # structural identity can stay strict beside it.

  @doc """
  Returns whether `left` is less than `right`.

  Declared per orderable pair (numbers and binaries); comparing an
  unsupported pair, such as a number and an atom, is refused at compile
  time rather than answered. For a total order over every value, see
  `compare/2`.

  ## Examples

      1 < 2
      #=> true

      1 < 1.5
      #=> true

      "abc" < "abd"
      #=> true

  """
  @spec integer < integer :: bool
  @spec float < float :: bool
  @spec integer < float :: bool
  @spec float < integer :: bool
  @spec binary < binary :: bool
  fn left :: integer < right :: integer, do: fz_op_lt_ii(left, right)
  fn left :: float < right :: float, do: fz_op_lt_ff(left, right)
  fn left :: integer < right :: float, do: fz_op_lt_if(left, right)
  fn left :: float < right :: integer, do: fz_op_lt_fi(left, right)
  fn left :: binary < right :: binary, do: fz_op_lt_bb(left, right)

  @doc """
  Returns whether `left` is less than or equal to `right`.

  Declared per orderable pair, like `</2`; see its documentation for the
  partial-ordering note.

  ## Examples

      1 <= 1
      #=> true

  """
  @spec integer <= integer :: bool
  @spec float <= float :: bool
  @spec integer <= float :: bool
  @spec float <= integer :: bool
  @spec binary <= binary :: bool
  fn left :: integer <= right :: integer, do: fz_op_lte_ii(left, right)
  fn left :: float <= right :: float, do: fz_op_lte_ff(left, right)
  fn left :: integer <= right :: float, do: fz_op_lte_if(left, right)
  fn left :: float <= right :: integer, do: fz_op_lte_fi(left, right)
  fn left :: binary <= right :: binary, do: fz_op_lte_bb(left, right)

  @doc """
  Returns whether `left` is greater than `right`.

  Declared per orderable pair, like `</2`.

  ## Examples

      2 > 1
      #=> true

      "abc" > "abb"
      #=> true

  """
  @spec integer > integer :: bool
  @spec float > float :: bool
  @spec integer > float :: bool
  @spec float > integer :: bool
  @spec binary > binary :: bool
  fn left :: integer > right :: integer, do: fz_op_gt_ii(left, right)
  fn left :: float > right :: float, do: fz_op_gt_ff(left, right)
  fn left :: integer > right :: float, do: fz_op_gt_if(left, right)
  fn left :: float > right :: integer, do: fz_op_gt_fi(left, right)
  fn left :: binary > right :: binary, do: fz_op_gt_bb(left, right)

  @doc """
  Returns whether `left` is greater than or equal to `right`.

  Declared per orderable pair, like `</2`.

  ## Examples

      1 >= 1
      #=> true

  """
  @spec integer >= integer :: bool
  @spec float >= float :: bool
  @spec integer >= float :: bool
  @spec float >= integer :: bool
  @spec binary >= binary :: bool
  fn left :: integer >= right :: integer, do: fz_op_gte_ii(left, right)
  fn left :: float >= right :: float, do: fz_op_gte_ff(left, right)
  fn left :: integer >= right :: float, do: fz_op_gte_if(left, right)
  fn left :: float >= right :: integer, do: fz_op_gte_fi(left, right)
  fn left :: binary >= right :: binary, do: fz_op_gte_bb(left, right)

  # Erlang's total term order:
  #   number < atom < reference < fun < port < pid < tuple < map < list < bitstring
  #
  # This is the separate entry point the comparison operators deliberately do
  # not become. `<` and its siblings stay declared for the operand pairs fz can
  # prove -- numbers and binaries -- because giving them an `any`/`any` clause
  # makes every comparison callsite with an unresolved operand blind to the
  # dispatcher, which the blind-escape census catches as a latent miscompile.
  # Sorting does not need the operators: it needs an order.
  @doc """
  Returns the number of bytes in `bytes`.

  For the number of codepoints, see `String.length/1`.

  ## Examples

      Kernel.byte_size("hello")
      #=> 5

      Kernel.byte_size("héllo")
      #=> 6

  """
  @spec byte_size(binary) :: integer
  fn byte_size(bytes), do: fz_bitstring_byte_size(bytes)

  @doc """
  Compares `left` and `right` by the total term order, and returns a
  negative integer, `0`, or a positive integer.

  Unlike `===/2`, numbers compare by value across types: `1` and `1.0`
  compare equal. Every value has a place in this order, including pairs
  `</2` and its siblings cannot order: `compare/2` is the entry point
  `Enum.sort/1` uses to order a mixed list.

  ## Examples

      Kernel.compare(1, 2)
      #=> -1

      Kernel.compare(1, 1.0)
      #=> 0

      Kernel.compare(:a, 1)
      #=> 1

  """
  @spec compare(any, any) :: integer
  fn compare(left, right), do: fz_value_cmp_ref(left, right)

  @doc """
  Returns whether `left` and `right` are equal, comparing numbers by value.

  `1 == 1.0` is true; for identity instead, see `===/2`.

  ## Examples

      1 == 1.0
      #=> true

      [1, 2] == [1, 2]
      #=> true

  """
  @spec any == any :: bool
  fn left == right, do: fz_op_eq(left, right)

  @doc """
  Returns whether `left` and `right` are not equal; the negation of `==/2`.

  ## Examples

      1 != 2
      #=> true

      1 != 1.0
      #=> false

  """
  @spec any != any :: bool
  fn left != right, do: fz_op_neq(left, right)

  # `===` asks whether two values are the same value, where `==` compares
  # numbers by value: `1 == 1.0` is true and `1 === 1.0` is false. Membership,
  # `--` and a map key all mean identity.
  @doc """
  Returns whether `left` and `right` are the same value.

  Unlike `==/2`, `===` does not compare numbers across types: `1 === 1.0`
  is false. Membership, `--` and map keys all mean identity.

  ## Examples

      1 === 1.0
      #=> false

      [1, 2] === [1, 2]
      #=> true

  """
  @spec any === any :: bool
  fn left === right, do: fz_op_identical(left, right)

  @doc """
  Returns whether `left` and `right` are not the same value; the negation
  of `===/2`.

  ## Examples

      1 !== 1.0
      #=> true

      1 !== 1
      #=> false

  """
  @spec any !== any :: bool
  fn left !== right, do: fz_op_not_identical(left, right)
end
