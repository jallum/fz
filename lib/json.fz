defmodule Json do
  @moduledoc """
  JSON decoding and encoding over fz values, following Elixir's `JSON` module.

  Values map between JSON and fz as follows:

    * a number becomes an integer when it has no fraction, and a float
      otherwise
    * `true`, `false` and `null` become `true`, `false` and `nil`
    * a string becomes a binary
    * an array becomes a list
    * an object becomes a map with binary keys

  Decoding can fail, so there is both `decode/1` and `decode!/1`. Encoding
  cannot fail for the values it accepts, so `encode!/1` is the only
  spelling.

  ## Examples

      Json.decode("{\\"a\\": 1}")
      #=> {:ok, %{"a" => 1}}

      Json.encode!(%{"a" => 1, "b" => [1, 2, true, nil, "x"]})
      #=> "{\\"a\\":1,\\"b\\":[1,2,true,null,\\"x\\"]}"

  """

  # Values map like this:
  #
  #   true / false / null   ->  true / false / nil
  #   number                ->  integer when it has no fraction, else float
  #   string                ->  binary
  #   array                 ->  list
  #   object                ->  map with binary keys
  #
  # Object keys are binaries rather than atoms, so a decoded object orders by
  # key content and prints the same way its Elixir counterpart does.
  #
  # Encoding cannot fail for the values it accepts and raises for the ones it
  # does not, so `encode!/1` is the only spelling. Decoding can fail, so there
  # is both `decode/1` and `decode!/1`.
  #
  # A failure reason carries a position rather than the leftover input:
  #
  #     {:unexpected_end, offset}
  #     {:invalid_byte, offset, byte}
  #     {:unexpected_sequence, offset, sequence}
  #
  # Inside the parser a failure carries the rest of the input, which is what a
  # recursive-descent parser has in hand. The offset is recovered once, at the
  # boundary, as `byte_size(input) - byte_size(rest)`, so no position needs to
  # be threaded through the parser.
  @doc """
  Decodes a JSON binary.

  Returns `{:ok, value}`, or `{:error, reason}` where `reason` carries the
  byte offset at which decoding stopped:

      {:unexpected_end, offset}
      {:invalid_byte, offset, byte}
      {:unexpected_sequence, offset, sequence}

  `unexpected_end` means the input ran out before a complete value.
  `invalid_byte` names the offending byte at `offset`, including trailing
  input left over after an otherwise complete value. `unexpected_sequence`
  means a `\\uXXXX` escape's four digits were not all hex; `sequence` is
  the six bytes read for it, starting at the backslash.

  ## Examples

      Json.decode("{\\"a\\": 1}")
      #=> {:ok, %{"a" => 1}}

      Json.decode("[1, 2")
      #=> {:error, {:unexpected_end, 5}}

      Json.decode("[1, 2] junk")
      #=> {:error, {:invalid_byte, 6, 32}}

      Json.decode("\\"a\\\\uZZZZb\\"")
      #=> {:error, {:unexpected_sequence, 2, "\\\\uZZZZ"}}

  """
  @spec decode(binary) :: {:ok, any} | {:error, any}
  def decode(input), do: decode_done(value(input), input)

  @spec decode_done({:ok, any, binary} | {:error, any}, binary) :: {:ok, any} | {:error, any}
  defp decode_done({:ok, v, rest}, input), do: decode_trailing(rest, skip_ws(rest), v, input)
  defp decode_done({:error, rest}, input), do: {:error, reason(rest, input)}

  # Trailing whitespace is accepted; trailing anything else is not. The error
  # points at the raw remainder's first byte, so `"[1] "` is ok and
  # `"[1] junk"` is an invalid_byte at the space.
  @spec decode_trailing(binary, binary, any, binary) :: {:ok, any} | {:error, any}
  defp decode_trailing(_raw, "", v, _input), do: {:ok, v}
  defp decode_trailing(raw, _skipped, _v, input), do: {:error, reason(raw, input)}

  @doc """
  Decodes a JSON binary, or halts.

  Returns the decoded value, like `decode/1`, but halts the process instead
  of returning an `{:error, reason}` tuple.

  ## Examples

      Json.decode!("[1,2,3]")
      #=> [1, 2, 3]

  On invalid input, `decode!/1` halts the process rather than returning; for
  example `Json.decode!("not json")` halts with `"JSON.decode!: invalid JSON"`.

  """
  @spec decode!(binary) :: any
  def decode!(input), do: decode_result(decode(input))

  @spec decode_result({:ok, any} | {:error, any}) :: any
  defp decode_result({:ok, v}), do: v
  defp decode_result({:error, _reason}), do: Kernel.panic("JSON.decode!: invalid JSON")

  # The parser skips whitespace before deciding, so the rest at a failure
  # starts at the offending byte: the offset is the difference in lengths and
  # the byte is the first one left.
  @spec reason(any, binary) :: any
  defp reason({:sequence, at}, input), do: {:unexpected_sequence, offset(at, input), String.take_bytes(at, 6)}
  defp reason("", input), do: {:unexpected_end, Kernel.byte_size(input)}
  defp reason(rest, input), do: invalid_byte(rest, offset(rest, input))

  @spec offset(binary, binary) :: integer
  defp offset(rest, input), do: Kernel.byte_size(input) - Kernel.byte_size(rest)

  @spec invalid_byte(binary, integer) :: any
  defp invalid_byte(<<c, _r :: binary>>, at), do: {:invalid_byte, at, c}
  defp invalid_byte(_rest, at), do: {:unexpected_end, at}

  @doc """
  Encodes an fz value as a JSON binary, or halts.

  Accepts `true`, `false`, `nil`, an integer, a float, a binary, a list, or
  a map. Any other value halts the process, so there is no plain
  `encode/1`. Binaries must be byte-aligned; a non-byte-aligned bitstring
  halts instead of being encoded as a JSON string. A map's keys are encoded
  with `encode!/1` too, so a binary key becomes a quoted JSON string; other
  key types will not produce valid JSON.

  ## Examples

      Json.encode!(%{"a" => 1, "b" => [1, 2, true, nil, "x"]})
      #=> "{\\"a\\":1,\\"b\\":[1,2,true,null,\\"x\\"]}"

      Json.encode!(1.5)
      #=> "1.5"

  """
  @spec encode!(any) :: binary
  def encode!(true), do: "true"
  def encode!(false), do: "false"
  def encode!(nil), do: "null"
  def encode!(v :: integer), do: Integer.to_string(v)
  def encode!(v :: float), do: Float.to_string(v)
  def encode!(v :: binary), do: "\"" <> escape(v, "") <> "\""
  def encode!(v :: [any]), do: "[" <> elements(v, "") <> "]"
  def encode!(v :: map), do: "{" <> pairs(Map.to_list(v), "") <> "}"
  def encode!(_v), do: Kernel.panic("JSON.encode!: unsupported value")

  @spec escape(binary, binary) :: binary
  defp escape("", acc), do: acc
  defp escape(<<"\"", r :: binary>>, acc), do: escape(r, acc <> "\\\"")
  defp escape(<<"\\", r :: binary>>, acc), do: escape(r, acc <> "\\\\")
  defp escape(<<"\n", r :: binary>>, acc), do: escape(r, acc <> "\\n")
  defp escape(<<"\t", r :: binary>>, acc), do: escape(r, acc <> "\\t")
  defp escape(<<c, r :: binary>>, acc), do: escape(r, acc <> <<c>>)
  defp escape(_bits, _acc), do: Kernel.panic("JSON.encode!: binary is not byte-aligned")

  @spec elements([any], binary) :: binary
  defp elements([], acc), do: acc
  defp elements([h], acc), do: acc <> encode!(h)
  defp elements([h | t], acc), do: elements(t, acc <> encode!(h) <> ",")

  @spec pairs([{any, any}], binary) :: binary
  defp pairs([], acc), do: acc
  defp pairs([{k, v}], acc), do: acc <> encode!(k) <> ":" <> encode!(v)
  defp pairs([{k, v} | t], acc), do: pairs(t, acc <> encode!(k) <> ":" <> encode!(v) <> ",")

  @spec skip_ws(binary) :: binary
  defp skip_ws(<<" ", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\n", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\t", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\r", r :: binary>>), do: skip_ws(r)
  defp skip_ws(b), do: b

  @spec value(binary) :: {:ok, any, binary} | {:error, any}
  defp value(b), do: val(skip_ws(b))

  @spec val(binary) :: {:ok, any, binary} | {:error, any}
  defp val(<<"true", r :: binary>>), do: {:ok, true, r}
  defp val(<<"false", r :: binary>>), do: {:ok, false, r}
  defp val(<<"null", r :: binary>>), do: {:ok, nil, r}
  defp val(<<"\"", r :: binary>>), do: string(r, "")
  defp val(<<"[", r :: binary>>), do: array(skip_ws(r), [])
  defp val(<<"{", r :: binary>>), do: object(skip_ws(r), %{})
  defp val(<<"-", r :: binary>>), do: negate(number(r))
  defp val(b = <<c, _ :: binary>>) when c >= 48 and c <= 57, do: number(b)
  # Once a token starts with `t`, `f` or `n` the decoder is committed to a
  # keyword: it either reads the whole one or runs out, and a token that does
  # not finish is reported as running out. So `truX` is an unexpected_end at
  # the end of the input rather than an invalid_byte at the `X`. These clauses
  # sit after the three that match, so only failures reach them, and
  # `{:error, ""}` is what makes `reason/2` say end-of-input.
  defp val(<<116, _r :: binary>>), do: {:error, ""}
  defp val(<<102, _r :: binary>>), do: {:error, ""}
  defp val(<<110, _r :: binary>>), do: {:error, ""}
  defp val(b), do: {:error, b}

  @spec negate(any) :: any
  defp negate({:ok, n, r}), do: {:ok, -n, r}
  defp negate(other), do: other

  # An integer unless a fraction follows, which is how JSON distinguishes them.
  @spec number(binary) :: any
  defp number(b), do: fraction(digits(b, 0))

  @spec digits(binary, integer) :: {integer, binary}
  defp digits(<<c, r :: binary>>, acc) when c >= 48 and c <= 57, do: digits(r, acc * 10 + (c - 48))
  defp digits(b, acc), do: {acc, b}

  @spec fraction({integer, binary}) :: any
  defp fraction({whole, <<".", r :: binary>>}), do: fraction_digits(r, whole, 0, 1)
  defp fraction({whole, b}), do: exponent(whole, b)

  @spec fraction_digits(binary, integer, integer, integer) :: any
  defp fraction_digits(<<c, r :: binary>>, whole, num, den) when c >= 48 and c <= 57 do
    fraction_digits(r, whole, num * 10 + (c - 48), den * 10)
  end
  defp fraction_digits(b, whole, num, den), do: exponent(whole + num / den, b)

  # `1e3`, `1.5E-2`. JSON allows an exponent on an integer too, and the result
  # is a float either way: `1e3` is `1.0e3`, not `1000`.
  @spec exponent(integer | float, binary) :: any
  defp exponent(n, <<"e", r :: binary>>), do: exponent_sign(n, r)
  defp exponent(n, <<"E", r :: binary>>), do: exponent_sign(n, r)
  defp exponent(n, b), do: {:ok, n, b}

  @spec exponent_sign(integer | float, binary) :: any
  defp exponent_sign(n, <<"-", r :: binary>>), do: exponent_digits(n, r, 0, -1)
  defp exponent_sign(n, <<"+", r :: binary>>), do: exponent_digits(n, r, 0, 1)
  defp exponent_sign(n, b), do: exponent_digits(n, b, 0, 1)

  @spec exponent_digits(integer | float, binary, integer, integer) :: any
  defp exponent_digits(n, <<c, r :: binary>>, acc, sign) when c >= 48 and c <= 57 do
    exponent_digits(n, r, acc * 10 + (c - 48), sign)
  end
  defp exponent_digits(n, b, acc, sign), do: {:ok, scale(n * 1.0, acc, sign), b}

  # One multiply or divide by an exact power of ten, rather than `e` of them.
  # Scaling step by step accumulates rounding: seven divisions by 10.0 turn
  # `1.0e-7` into `1.0000000000000002e-7`, a different double that renders
  # differently. Powers of ten up to 10^22 are exact in a float, so building
  # the power first and applying it once is correctly rounded over the range
  # JSON numbers use.
  @spec scale(float, integer, integer) :: float
  defp scale(n, 0, _sign), do: n
  defp scale(n, e, sign), do: apply_scale(n, pow10(e, 1.0), sign)

  @spec apply_scale(float, float, integer) :: float
  defp apply_scale(n, p, sign) when sign > 0, do: n * p
  defp apply_scale(n, p, _sign), do: n / p

  @spec pow10(integer, float) :: float
  defp pow10(0, acc), do: acc
  defp pow10(e, acc), do: pow10(e - 1, acc * 10.0)

  # A byte at a time rather than scan-then-slice. Every `<<c, r :: binary>>`
  # step copies the remainder, so the traversal is already quadratic, and a
  # second pass to measure a run costs more than the appends it saves: both
  # shapes measured 435 allocations. Scanning first becomes worthwhile once a
  # sub-binary is a view onto its source rather than a copy.
  @spec string(binary, binary) :: any
  defp string(<<"\"", r :: binary>>, acc), do: {:ok, acc, r}
  defp string(b = <<"\\", r :: binary>>, acc), do: escaped(r, acc, b)
  defp string(<<c, r :: binary>>, acc), do: string(r, acc <> <<c>>)
  defp string(b, _acc), do: {:error, b}

  @spec escaped(binary, binary, binary) :: any
  defp escaped(<<"\"", r :: binary>>, acc, _at), do: string(r, acc <> "\"")
  defp escaped(<<"\\", r :: binary>>, acc, _at), do: string(r, acc <> "\\")
  defp escaped(<<"/", r :: binary>>, acc, _at), do: string(r, acc <> "/")
  defp escaped(<<"n", r :: binary>>, acc, _at), do: string(r, acc <> "\n")
  defp escaped(<<"t", r :: binary>>, acc, _at), do: string(r, acc <> "\t")
  defp escaped(<<"r", r :: binary>>, acc, _at), do: string(r, acc <> "\r")
  defp escaped(<<"b", r :: binary>>, acc, _at), do: string(r, acc <> <<8>>)
  defp escaped(<<"f", r :: binary>>, acc, _at), do: string(r, acc <> <<12>>)
  defp escaped(<<"u", a, b, c, d, r :: binary>>, acc, at), do: unicode(r, acc, hex4(a, b, c, d), at)
  defp escaped(b, _acc, _at), do: {:error, b}

  # A bad `\uXXXX` is an unexpected_sequence, reported at the backslash's
  # offset with the six-byte sequence, so it is the one failure that carries
  # where it started rather than where it stopped. An unknown simple escape is
  # an ordinary invalid_byte and needs none of this.
  @spec unicode(binary, binary, integer | :error, binary) :: any
  defp unicode(_r, _acc, :error, at), do: {:error, {:sequence, at}}
  defp unicode(r, acc, cp, _at), do: string(r, acc <> utf8(cp))

  @spec hex4(integer, integer, integer, integer) :: integer | :error
  defp hex4(a, b, c, d), do: hex4_join(hex(a), hex(b), hex(c), hex(d))
  @spec hex4_join(integer | :error, integer | :error, integer | :error, integer | :error) :: integer | :error
  defp hex4_join(:error, _b, _c, _d), do: :error
  defp hex4_join(_a, :error, _c, _d), do: :error
  defp hex4_join(_a, _b, :error, _d), do: :error
  defp hex4_join(_a, _b, _c, :error), do: :error
  defp hex4_join(a, b, c, d), do: ((a * 16 + b) * 16 + c) * 16 + d

  @spec hex(integer) :: integer | :error
  defp hex(c) when c >= 48 and c <= 57, do: c - 48
  defp hex(c) when c >= 97 and c <= 102, do: c - 87
  defp hex(c) when c >= 65 and c <= 70, do: c - 55
  defp hex(_c), do: :error

  # UTF-8 for the basic multilingual plane. Surrogate pairs are not joined, so
  # a lone surrogate encodes as itself.
  @spec utf8(integer) :: binary
  defp utf8(cp) when cp < 128, do: <<cp>>
  defp utf8(cp) when cp < 2048 do
    <<192 + div(cp, 64), 128 + rem(cp, 64)>>
  end
  defp utf8(cp) do
    <<224 + div(cp, 4096), 128 + rem(div(cp, 64), 64), 128 + rem(cp, 64)>>
  end

  # `]` closes an empty array only at the start. After a comma a value is
  # required, so `[1,]` is an error.
  @spec array(binary, [any]) :: any
  defp array(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  defp array(b, acc), do: array_element(b, acc)

  @spec array_element(binary, [any]) :: any
  defp array_element(b, acc), do: array_item(value(b), acc)

  @spec array_item(any, [any]) :: any
  defp array_item({:ok, v, r}, acc), do: array_next(skip_ws(r), [v | acc])
  defp array_item(other, _acc), do: other

  @spec array_next(binary, [any]) :: any
  defp array_next(<<",", r :: binary>>, acc), do: array_element(skip_ws(r), acc)
  defp array_next(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  defp array_next(b, _acc), do: {:error, b}

  # `}` closes an empty object only at the start. After a comma a key is
  # required, so `{"a": 1,}` is an error.
  @spec object(binary, any) :: any
  defp object(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  defp object(b, acc), do: object_entry(b, acc)

  @spec object_entry(binary, any) :: any
  defp object_entry(<<"\"", r :: binary>>, acc), do: object_key(string(r, ""), acc)
  defp object_entry(b, _acc), do: {:error, b}

  @spec object_key(any, any) :: any
  defp object_key({:ok, k, r}, acc), do: object_colon(skip_ws(r), k, acc)
  defp object_key(other, _acc), do: other

  @spec object_colon(binary, binary, any) :: any
  defp object_colon(<<":", r :: binary>>, k, acc), do: object_value(value(r), k, acc)
  defp object_colon(b, _k, _acc), do: {:error, b}

  @spec object_value(any, binary, any) :: any
  defp object_value({:ok, v, r}, k, acc), do: object_next(skip_ws(r), Map.put(acc, k, v))
  defp object_value(other, _k, _acc), do: other

  @spec object_next(binary, any) :: any
  defp object_next(<<",", r :: binary>>, acc), do: object_entry(skip_ws(r), acc)
  defp object_next(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  defp object_next(b, _acc), do: {:error, b}

  @spec reverse([a], [b]) :: [a | b]
  defp reverse([], acc), do: acc
  defp reverse([h | t], acc), do: reverse(t, [h | acc])
end
