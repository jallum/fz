defmodule JSON do
  @moduledoc """
  JSON decoding and encoding over fz values, following Elixir's `JSON` module.

  Values map between JSON and fz as follows:

    * a number becomes an integer when it has no fraction, and a float
      otherwise
    * `true`, `false` and `null` become `true`, `false` and `nil`
    * a string becomes a binary
    * an array becomes a list
    * an object becomes a map with binary keys

  Decoding can fail, so there is both `decode/1` and `decode!/1`. Encoding
  raises for unsupported values or invalid string binaries, so `encode!/1`
  is the only spelling.

  ## Examples

      JSON.decode("{\\"a\\": 1}")
      #=> {:ok, %{"a" => 1}}

      JSON.encode!(%{"a" => 1, "b" => [1, 2, true, nil, "x"]})
      #=> "{\\"a\\":1,\\"b\\":[1,2,true,null,\\"x\\"]}"

  """

  # Values map like this:
  #
  #   true / false / null   ->  true / false / nil
  #   number                ->  integer when it has no fraction, else float
  #   string                ->  binary
  #   array                 ->  list
  #   object                ->  map with binary keys
  #
  # Object keys are binaries rather than atoms, so a decoded object orders by
  # key content and prints the same way its Elixir counterpart does.
  #
  # Encoding cannot fail for the values it accepts and raises for the ones it
  # does not, so `encode!/1` is the only spelling. Decoding can fail, so there
  # is both `decode/1` and `decode!/1`.
  #
  # A failure reason carries a position rather than the leftover input:
  #
  #     {:unexpected_end, offset}
  #     {:invalid_byte, offset, byte}
  #     {:unexpected_sequence, offset, sequence}
  #
  # Inside the parser a failure carries the rest of the input, which is what a
  # recursive-descent parser has in hand. The offset is recovered once, at the
  # boundary, as `byte_size(input) - byte_size(rest)`, so no position needs to
  # be threaded through the parser.
  @doc """
  Decodes a JSON binary.

  Returns `{:ok, value}`, or `{:error, reason}` where `reason` carries the
  byte offset at which decoding stopped:

      {:unexpected_end, offset}
      {:invalid_byte, offset, byte}
      {:unexpected_sequence, offset, sequence}

  `unexpected_end` means the input ran out before a complete value.
  `invalid_byte` names the offending byte at `offset`, including trailing
  input left over after an otherwise complete value, malformed UTF-8, and
  unescaped control bytes inside a string. `unexpected_sequence` means a
  `\\uXXXX` escape is not valid Unicode: its digits are not all hex, it is a
  lone low surrogate, or a high surrogate is followed by a complete Unicode
  escape that is not a low surrogate. `sequence` is the offending escape or
  pair of escapes, starting at the backslash. A high surrogate without a
  complete following Unicode escape is `unexpected_end`.

  A number is also an `unexpected_sequence` when its value does not fit: a
  float beyond the double range, or an integer beyond 64 bits. `offset` is
  where the number starts and `sequence` is its text. Elixir decodes such an
  integer as a big integer; fz integers are 64-bit, so it is an error here.

  ## Examples

      JSON.decode("{\\"a\\": 1}")
      #=> {:ok, %{"a" => 1}}

      JSON.decode("[1, 2")
      #=> {:error, {:unexpected_end, 5}}

      JSON.decode("[1, 2] junk")
      #=> {:error, {:invalid_byte, 6, 32}}

      JSON.decode("\\"a\\\\uZZZZb\\"")
      #=> {:error, {:unexpected_sequence, 2, "\\\\uZZZZ"}}

      JSON.decode("[1, 1e400]")
      #=> {:error, {:unexpected_sequence, 4, "1.0e400"}}

      JSON.decode(<<34, 255, 34>>)
      #=> {:error, {:invalid_byte, 1, 255}}

      JSON.decode(<<34, 10, 34>>)
      #=> {:error, {:invalid_byte, 1, 10}}

      JSON.decode("\\"\\\\uD83D\\\\uDE00\\"")
      #=> {:ok, "😀"}

      JSON.decode("\\"\\\\uDE00\\"")
      #=> {:error, {:unexpected_sequence, 1, "\\\\uDE00"}}

  """
  @spec decode(binary) :: {:ok, any} | {:error, any}
  def decode(input), do: decode_done(value(input), input)

  @spec decode_done({:ok, any, binary} | {:error, any}, binary) :: {:ok, any} | {:error, any}
  defp decode_done({:ok, v, rest}, input), do: decode_trailing(rest, skip_ws(rest), v, input)
  defp decode_done({:error, rest}, input), do: {:error, reason(rest, input)}

  # Trailing whitespace is accepted; trailing anything else is not. The error
  # points at the raw remainder's first byte, so `"[1] "` is ok and
  # `"[1] junk"` is an invalid_byte at the space.
  @spec decode_trailing(binary, binary, any, binary) :: {:ok, any} | {:error, any}
  defp decode_trailing(_raw, "", v, _input), do: {:ok, v}
  defp decode_trailing(raw, _skipped, _v, input), do: {:error, reason(raw, input)}

  @doc """
  Decodes a JSON binary, or raises `JSON.DecodeError`.

  Returns the decoded value, like `decode/1`, but raises instead of returning an `{:error, reason}` tuple.

  ## Examples

      JSON.decode!("[1,2,3]")
      #=> [1, 2, 3]

  On invalid input, `decode!/1` raises rather than returning; for example
  `JSON.decode!("not json")` raises `JSON.DecodeError`.

  """
  @spec decode!(binary) :: any
  def decode!(input), do: decode_result(decode(input), input)

  @spec decode_result({:ok, any} | {:error, any}, binary) :: any
  defp decode_result({:ok, v}, _input), do: v

  defp decode_result({:error, reason}, input),
    do: raise(%JSON.DecodeError{message: decode_message(reason), data: input, offset: Kernel.elem(reason, 1)})

  @spec decode_message(any) :: binary
  defp decode_message({:unexpected_end, at}),
    do: "unexpected end of JSON binary at position (byte offset) #{at}"

  defp decode_message({:invalid_byte, at, byte}),
    do: "invalid byte #{byte} at position (byte offset) #{at}"

  defp decode_message({:unexpected_sequence, at, bytes}),
    do: "unexpected sequence #{Kernel.inspect(bytes)} at position (byte offset) #{at}"

  # The parser skips whitespace before deciding, so the rest at a failure
  # starts at the offending byte: the offset is the difference in lengths and
  # the byte is the first one left.
  @spec reason(any, binary) :: any
  defp reason({:sequence, at, bytes}, input), do: {:unexpected_sequence, offset(at, input), bytes}
  defp reason("", input), do: {:unexpected_end, Kernel.byte_size(input)}
  defp reason(rest, input), do: invalid_byte(rest, offset(rest, input))

  @spec offset(binary, binary) :: integer
  defp offset(rest, input), do: Kernel.byte_size(input) - Kernel.byte_size(rest)

  @spec invalid_byte(binary, integer) :: any
  defp invalid_byte(<<c, _r :: binary>>, at), do: {:invalid_byte, at, c}
  defp invalid_byte(_rest, at), do: {:unexpected_end, at}

  @doc """
  Encodes an fz value as a JSON binary, or raises.

  Accepts `true`, `false`, `nil`, an integer, a float, a binary, an atom
  (encoded as the string of its name), a list, or a map. Map keys may be
  binaries, atoms, integers, or floats; every key is converted to a JSON
  string. Any other value raises `Protocol.UndefinedError` for `JSON.Encoder`
  and any other map key for `String.Chars`, so there is no plain `encode/1`.
  Binary string values and binary keys must be byte-aligned, valid UTF-8. An
  invalid UTF-8 binary fails with Elixir's raw `ErlangError`
  (`{:invalid_byte, byte}` or `:unexpected_end`) and a non-byte-aligned
  bitstring with a `FunctionClauseError`, instead of being encoded as a JSON
  string. Quotes, backslashes, and every control byte are escaped in both
  string values and object keys.

  ## Examples

      JSON.encode!(%{"a" => 1, "b" => [1, 2, true, nil, "x"]})
      #=> "{\\"a\\":1,\\"b\\":[1,2,true,null,\\"x\\"]}"

      JSON.encode!(%{answer: 42})
      #=> "{\\"answer\\":42}"

      JSON.encode!(1.5)
      #=> "1.5"

      JSON.encode!(<<0, 10, 31>>)
      #=> "\\\"\\\\u0000\\\\n\\\\u001F\\\""

  """
  @spec encode!(any) :: binary
  def encode!(v), do: encode_into(v, "")

  # Appends the encoding of `v` to `acc`: lists and maps append their children
  # to the same accumulator, so no value is built apart and joined.
  @spec encode_into(any, binary) :: binary
  defp encode_into(true, acc), do: acc <> "true"
  defp encode_into(false, acc), do: acc <> "false"
  defp encode_into(nil, acc), do: acc <> "null"
  defp encode_into(v, acc) when is_integer(v), do: acc <> Integer.to_string(v)
  defp encode_into(v, acc) when is_float(v), do: acc <> Float.to_string(v)
  defp encode_into(v, acc) when is_binary(v), do: walk(v, v, acc <> "\"") <> "\""
  defp encode_into(v, _acc) when is_bitstring(v), do: raise(%FunctionClauseError{module: :elixir_json, function: :encode_binary, arity: 1})
  defp encode_into(v, acc) when is_atom(v), do: encode_into(Atom.to_string(v), acc)
  defp encode_into(v, acc) when is_list(v), do: elements(v, acc <> "[") <> "]"
  defp encode_into(v, acc) when is_map(v), do: pairs(Map.to_list(v), acc <> "{") <> "}"
  defp encode_into(v, _acc), do: unsupported_value(v)

  @spec unsupported_value(any) :: never
  defp unsupported_value(v) do
    raise(
      Protocol.UndefinedError,
      protocol: JSON.Encoder,
      value: v,
      description:
        "the protocol must be explicitly implemented.\n\n" <>
        "If you have a struct, you can derive the implementation specifying which fields should be encoded to JSON:\n\n" <>
        "    @derive {JSON.Encoder, only: [....]}\n    defstruct ...\n\n" <>
        "It is also possible to encode all fields, although this should be used carefully to avoid accidentally leaking private information when new fields are added:\n\n" <>
        "    @derive JSON.Encoder\n    defstruct ...\n\n" <>
        "Finally, if you don't own the struct you want to encode to JSON, you may use Protocol.derive/3 placed outside of any module:\n\n" <>
        "    Protocol.derive(JSON.Encoder, NameOfTheStruct, only: [...])\n    Protocol.derive(JSON.Encoder, NameOfTheStruct)"
    )
  end

  # Validates and escapes in one walk. `start` is where the current run of
  # bytes needing no escape began and `rest` what is left of it; a byte that
  # needs an escape ends the run, which is appended as one slice of `start`.
  @spec walk(binary, binary, binary) :: binary
  defp walk(start, "", acc), do: append_run(start, "", acc)
  defp walk(start, b = <<c, r :: binary>>, acc) when c < 32 or c == 34 or c == 92,
    do: walk(r, r, append_run(start, b, acc) <> escape(c))
  defp walk(start, <<c, r :: binary>>, acc) when c < 128, do: walk(start, r, acc)
  defp walk(start, b, acc), do: walk_scalar(start, b, acc)

  @spec walk_scalar(binary, binary, binary) :: binary
  defp walk_scalar(start, <<_c :: utf8, r :: binary>>, acc), do: walk(start, r, acc)
  defp walk_scalar(_start, b, _acc), do: invalid_utf8(b)

  @spec append_run(binary, binary, binary) :: binary
  defp append_run(start, rest, acc) do
    n = byte_size(start) - byte_size(rest)
    <<run :: binary-size(n), _ :: binary>> = start
    acc <> run
  end

  # What Elixir's encoder fails with where a UTF-8 sequence goes wrong: the
  # first byte no sequence can contain, or the end of input when a sequence is
  # cut short. `Utf8.next` makes the same decision the `utf8` match just failed.
  @spec invalid_utf8(binary) :: never
  defp invalid_utf8(b), do: invalid_utf8_at(Utf8.next(b))

  @spec invalid_utf8_at({:error, binary} | nil | {:ok, utf8, binary}) :: never
  defp invalid_utf8_at({:error, <<byte, _rest :: binary>>}), do: invalid_byte(byte)
  defp invalid_utf8_at(_truncated), do: Kernel.panic(:unexpected_end)

  @spec invalid_byte(integer) :: never
  defp invalid_byte(byte), do: Kernel.panic({:invalid_byte, byte})

  @spec escape(integer) :: binary
  defp escape(34), do: "\\\""
  defp escape(92), do: "\\\\"
  defp escape(8), do: "\\b"
  defp escape(9), do: "\\t"
  defp escape(10), do: "\\n"
  defp escape(12), do: "\\f"
  defp escape(13), do: "\\r"
  defp escape(c), do: control_escape(c)

  @spec control_escape(integer) :: binary
  defp control_escape(c), do: "\\u00" <> <<hex_digit(div(c, 16)), hex_digit(rem(c, 16))>>

  @spec hex_digit(integer) :: integer
  defp hex_digit(n) when n < 10, do: 48 + n
  defp hex_digit(n), do: 55 + n

  @spec elements([any], binary) :: binary
  defp elements([], acc), do: acc
  defp elements([h], acc), do: encode_into(h, acc)
  defp elements([h | t], acc), do: elements(t, encode_into(h, acc) <> ",")

  @spec pairs([{any, any}], binary) :: binary
  defp pairs([], acc), do: acc
  defp pairs([{k, v}], acc), do: encode_into(v, key_into(k, acc) <> ":")
  defp pairs([{k, v} | t], acc), do: pairs(t, encode_into(v, key_into(k, acc) <> ":") <> ",")

  @spec key_into(any, binary) :: binary
  defp key_into(key, acc) when is_binary(key), do: encode_into(key, acc)
  defp key_into(key, acc) when is_atom(key), do: encode_into(Atom.to_string(key), acc)
  defp key_into(key, acc) when is_integer(key), do: encode_into(Integer.to_string(key), acc)
  defp key_into(key, acc) when is_float(key), do: encode_into(Float.to_string(key), acc)
  defp key_into(key, _acc),
    do: raise(%Protocol.UndefinedError{protocol: String.Chars, value: key})

  @spec skip_ws(binary) :: binary
  defp skip_ws(<<" ", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\n", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\t", r :: binary>>), do: skip_ws(r)
  defp skip_ws(<<"\r", r :: binary>>), do: skip_ws(r)
  defp skip_ws(b), do: b

  @spec value(binary) :: {:ok, any, binary} | {:error, any}
  defp value(b), do: val(skip_ws(b))

  @spec val(binary) :: {:ok, any, binary} | {:error, any}
  defp val(<<"true", r :: binary>>), do: {:ok, true, r}
  defp val(<<"false", r :: binary>>), do: {:ok, false, r}
  defp val(<<"null", r :: binary>>), do: {:ok, nil, r}
  defp val(<<"\"", r :: binary>>), do: string(r, r, "")
  defp val(<<"[", r :: binary>>), do: array(skip_ws(r), [])
  defp val(<<"{", r :: binary>>), do: object(skip_ws(r), %{})
  defp val(b = <<"-", _ :: binary>>), do: number(b)
  defp val(b = <<c, _ :: binary>>) when c >= 48 and c <= 57, do: number(b)
  # Once a token starts with `t`, `f` or `n` the decoder is committed to a
  # keyword: it either reads the whole one or runs out, and a token that does
  # not finish is reported as running out. So `truX` is an unexpected_end at
  # the end of the input rather than an invalid_byte at the `X`. These clauses
  # sit after the three that match, so only failures reach them, and
  # `{:error, ""}` is what makes `reason/2` say end-of-input.
  defp val(<<116, _r :: binary>>), do: {:error, ""}
  defp val(<<102, _r :: binary>>), do: {:error, ""}
  defp val(<<110, _r :: binary>>), do: {:error, ""}
  defp val(b), do: {:error, b}

  # A number is read in two steps. The grammar alone finds where it ends:
  #
  #     -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
  #
  # and its value comes from its text. An integer's digits are added up as
  # they are scanned. A float's text goes to `Float.parse/1`, which rounds
  # correctly; building a float out of digit arithmetic does not. Every
  # function here carries `start`, where the number began, so the text is one
  # slice taken once at the end.
  @spec number(binary) :: any
  defp number(start = <<"-", r :: binary>>), do: integer_lead(start, r, -1)
  defp number(start), do: integer_lead(start, start, 1)

  @spec integer_lead(binary, binary, integer) :: any
  defp integer_lead(start, <<"0", r :: binary>>, _sign), do: after_integer(start, r, 0)
  defp integer_lead(start, <<c, r :: binary>>, sign) when c >= 49 and c <= 57 do
    integer_digits(start, r, sign * (c - 48), sign)
  end
  defp integer_lead(_start, b, _sign), do: {:error, b}

  @spec integer_digits(binary, binary, integer | :overflow, integer) :: any
  defp integer_digits(start, <<c, r :: binary>>, acc, sign) when c >= 48 and c <= 57 do
    integer_digits(start, r, integer_step(acc, c - 48, sign), sign)
  end
  defp integer_digits(start, b, acc, _sign), do: after_integer(start, b, acc)

  # Integers are 64-bit, so a digit that would carry the value past either end
  # turns it into `:overflow` instead of raising. The scan still finds where
  # the number ends, and the whole number is reported.
  @spec integer_step(integer | :overflow, integer, integer) :: integer | :overflow
  defp integer_step(:overflow, _d, _sign), do: :overflow
  defp integer_step(acc, _d, 1) when acc > 922337203685477580, do: :overflow
  defp integer_step(922337203685477580, d, 1) when d > 7, do: :overflow
  defp integer_step(acc, d, 1), do: acc * 10 + d
  defp integer_step(acc, _d, _sign) when acc < -922337203685477580, do: :overflow
  defp integer_step(-922337203685477580, d, _sign) when d > 8, do: :overflow
  defp integer_step(acc, d, _sign), do: acc * 10 - d

  # A digit can only follow the integer part when that part is a lone `0`, so
  # `01` stops at the `1`.
  @spec after_integer(binary, binary, integer | :overflow) :: any
  defp after_integer(_start, b = <<c, _r :: binary>>, _acc) when c >= 48 and c <= 57, do: {:error, b}
  defp after_integer(start, <<".", r :: binary>>, _acc), do: fraction_first(start, r)
  defp after_integer(start, <<"e", r :: binary>>, acc), do: exponent_sign(start, r, {:exponent_only, acc})
  defp after_integer(start, <<"E", r :: binary>>, acc), do: exponent_sign(start, r, {:exponent_only, acc})
  defp after_integer(start, b, :overflow), do: {:error, {:sequence, start, token(start, b)}}
  defp after_integer(_start, b, acc), do: {:ok, acc, b}

  @spec fraction_first(binary, binary) :: any
  defp fraction_first(start, <<c, r :: binary>>) when c >= 48 and c <= 57, do: fraction_digits(start, r)
  defp fraction_first(_start, b), do: {:error, b}

  @spec fraction_digits(binary, binary) :: any
  defp fraction_digits(start, <<c, r :: binary>>) when c >= 48 and c <= 57, do: fraction_digits(start, r)
  defp fraction_digits(start, <<"e", r :: binary>>), do: exponent_sign(start, r, :fraction)
  defp fraction_digits(start, <<"E", r :: binary>>), do: exponent_sign(start, r, :fraction)
  defp fraction_digits(start, b), do: float(start, b, :fraction)

  @spec exponent_sign(binary, binary, any) :: any
  defp exponent_sign(start, <<"-", r :: binary>>, shape), do: exponent_first(start, r, shape)
  defp exponent_sign(start, <<"+", r :: binary>>, shape), do: exponent_first(start, r, shape)
  defp exponent_sign(start, b, shape), do: exponent_first(start, b, shape)

  @spec exponent_first(binary, binary, any) :: any
  defp exponent_first(start, <<c, r :: binary>>, shape) when c >= 48 and c <= 57, do: exponent_digits(start, r, shape)
  defp exponent_first(_start, b, _shape), do: {:error, b}

  @spec exponent_digits(binary, binary, any) :: any
  defp exponent_digits(start, <<c, r :: binary>>, shape) when c >= 48 and c <= 57, do: exponent_digits(start, r, shape)
  defp exponent_digits(start, b, shape), do: float(start, b, shape)

  # Elixir converts an exponent without a fraction as `<integer>.0e<exponent>`.
  # Two things follow, and fz keeps both: a float out of range reports that
  # rewritten text (`1E400` is reported as `"1.0e400"`), and an integer part of
  # zero is converted without its sign, so `-0e0` is `0.0`.
  @spec float(binary, binary, any) :: any
  defp float(_start, b, {:exponent_only, 0}), do: {:ok, 0.0, b}
  defp float(start, b, shape), do: float_value(Float.parse(token(start, b)), start, b, shape)

  @spec float_value({float, binary} | :error, binary, binary, any) :: any
  defp float_value({f, ""}, _start, b, _shape), do: {:ok, f, b}
  defp float_value(_error, start, b, :fraction), do: {:error, {:sequence, start, token(start, b)}}
  defp float_value(_error, start, b, _exponent_only) do
    text = token(start, b)
    {:error, {:sequence, start, with_point(text, text)}}
  end

  @spec with_point(binary, binary) :: binary
  defp with_point(text, <<c, exponent :: binary>>) when c == 101 or c == 69 do
    String.take_bytes(text, byte_size(text) - byte_size(exponent) - 1) <> ".0e" <> exponent
  end
  defp with_point(text, <<_c, r :: binary>>), do: with_point(text, r)

  @spec token(binary, binary) :: binary
  defp token(start, rest), do: String.take_bytes(start, byte_size(start) - byte_size(rest))

  # `string(start, rest, acc)` is one pass over a string. `start` is where the
  # current run began and `rest` what is left of it. A run is every byte but
  # `"`, `\` and a control byte, and a multi-byte character is one step of it,
  # matched by the `utf8` segment. The run is taken with one slice when it
  # ends, so a string with no escape is a view of the input and an escape costs
  # one append for the run before it and one for itself.
  @spec string(binary, binary, binary) :: any
  defp string(s, b = <<"\"", r :: binary>>, acc), do: {:ok, run_join(s, b, acc), r}
  defp string(s, b = <<"\\", r :: binary>>, acc), do: escaped(r, run_join(s, b, acc), b)
  defp string(_s, b = <<c, _r :: binary>>, _acc) when c < 32, do: {:error, b}
  defp string(s, <<c, r :: binary>>, acc) when c < 128, do: string(s, r, acc)
  defp string(_s, "", _acc), do: {:error, ""}
  defp string(s, b, acc), do: string_scalar(s, b, acc)

  # Where the `utf8` match fails, `Utf8.next` answers `{:error, rest}`: `rest`
  # begins at the first byte no sequence can contain, and is `""` when the
  # input ends inside one.
  @spec string_scalar(binary, binary, binary) :: any
  defp string_scalar(s, <<_c :: utf8, r :: binary>>, acc), do: string(s, r, acc)
  defp string_scalar(_s, b, _acc), do: Utf8.next(b)

  @spec run_join(binary, binary, binary) :: binary
  defp run_join(s, b, acc) do
    n = byte_size(s) - byte_size(b)
    <<run :: binary-size(n), _ :: binary>> = s
    join_run(acc, run)
  end

  @spec join_run(binary, binary) :: binary
  defp join_run(<<>>, run), do: run
  defp join_run(acc, run), do: acc <> run

  @spec escaped(binary, binary, binary) :: any
  defp escaped(<<"u", a, b, c, d, r :: binary>>, acc, at), do: unicode(r, acc, hex4(a, b, c, d), at)
  defp escaped(b = <<c, r :: binary>>, acc, _at) do
    case simple_escape(c) do
      nil -> {:error, b}
      byte -> string(r, r, acc <> <<byte>>)
    end
  end
  defp escaped(b, _acc, _at), do: {:error, b}

  @spec simple_escape(integer) :: integer | nil
  defp simple_escape(34), do: 34
  defp simple_escape(92), do: 92
  defp simple_escape(?/), do: 47
  defp simple_escape(?n), do: 10
  defp simple_escape(?t), do: 9
  defp simple_escape(?r), do: 13
  defp simple_escape(?b), do: 8
  defp simple_escape(?f), do: 12
  defp simple_escape(_c), do: nil

  # A bad `\uXXXX` is an unexpected_sequence, reported at the backslash's
  # offset with the six- or twelve-byte sequence, so it is the one failure that
  # carries where it started rather than where it stopped. An unknown simple
  # escape is an ordinary invalid_byte and needs none of this.
  @spec unicode(binary, binary, integer | :error, binary) :: any
  defp unicode(_r, _acc, :error, at), do: {:error, {:sequence, at, String.take_bytes(at, 6)}}
  defp unicode(r, acc, cp, at) when cp >= 0xd800 and cp <= 0xdbff, do: unicode_high(r, acc, cp, at)
  defp unicode(_r, _acc, cp, at) when cp >= 0xdc00 and cp <= 0xdfff, do: {:error, {:sequence, at, String.take_bytes(at, 6)}}
  defp unicode(r, acc, cp, _at), do: string(r, r, acc <> <<cp :: utf8>>)

  @spec unicode_high(binary, binary, integer, binary) :: any
  defp unicode_high(<<"\\u", a, b, c, d, r :: binary>>, acc, high, at) do
    unicode_low(r, acc, high, hex4(a, b, c, d), at)
  end
  defp unicode_high(_r, _acc, _high, _at), do: {:error, ""}

  @spec unicode_low(binary, binary, integer, integer | :error, binary) :: any
  defp unicode_low(_r, _acc, _high, :error, at), do: {:error, {:sequence, at, String.take_bytes(at, 12)}}
  defp unicode_low(r, acc, high, low, _at) when low >= 0xdc00 and low <= 0xdfff do
    codepoint = 0x10000 + (high - 0xd800) * 0x400 + (low - 0xdc00)
    string(r, r, acc <> <<codepoint :: utf8>>)
  end
  defp unicode_low(_r, _acc, _high, _low, at), do: {:error, {:sequence, at, String.take_bytes(at, 12)}}

  @spec hex4(integer, integer, integer, integer) :: integer | :error
  defp hex4(a, b, c, d), do: hex4_join(hex(a), hex(b), hex(c), hex(d))
  @spec hex4_join(integer | :error, integer | :error, integer | :error, integer | :error) :: integer | :error
  defp hex4_join(:error, _b, _c, _d), do: :error
  defp hex4_join(_a, :error, _c, _d), do: :error
  defp hex4_join(_a, _b, :error, _d), do: :error
  defp hex4_join(_a, _b, _c, :error), do: :error
  defp hex4_join(a, b, c, d), do: ((a * 16 + b) * 16 + c) * 16 + d

  @spec hex(integer) :: integer | :error
  defp hex(c) when c >= 48 and c <= 57, do: c - 48
  defp hex(c) when c >= 97 and c <= 102, do: c - 87
  defp hex(c) when c >= 65 and c <= 70, do: c - 55
  defp hex(_c), do: :error

  # `]` closes an empty array only at the start. After a comma a value is
  # required, so `[1,]` is an error.
  @spec array(binary, [any]) :: any
  defp array(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  defp array(b, acc), do: array_element(b, acc)

  @spec array_element(binary, [any]) :: any
  defp array_element(b, acc), do: array_item(value(b), acc)

  @spec array_item(any, [any]) :: any
  defp array_item({:ok, v, r}, acc), do: array_next(skip_ws(r), [v | acc])
  defp array_item(other, _acc), do: other

  @spec array_next(binary, [any]) :: any
  defp array_next(<<",", r :: binary>>, acc), do: array_element(skip_ws(r), acc)
  defp array_next(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  defp array_next(b, _acc), do: {:error, b}

  # `}` closes an empty object only at the start. After a comma a key is
  # required, so `{"a": 1,}` is an error.
  @spec object(binary, any) :: any
  defp object(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  defp object(b, acc), do: object_entry(b, acc)

  @spec object_entry(binary, any) :: any
  defp object_entry(<<"\"", r :: binary>>, acc), do: object_key(string(r, r, ""), acc)
  defp object_entry(b, _acc), do: {:error, b}

  @spec object_key(any, any) :: any
  defp object_key({:ok, k, r}, acc), do: object_colon(skip_ws(r), k, acc)
  defp object_key(other, _acc), do: other

  @spec object_colon(binary, binary, any) :: any
  defp object_colon(<<":", r :: binary>>, k, acc), do: object_value(value(r), k, acc)
  defp object_colon(b, _k, _acc), do: {:error, b}

  @spec object_value(any, binary, any) :: any
  defp object_value({:ok, v, r}, k, acc), do: object_next(skip_ws(r), Map.put(acc, k, v))
  defp object_value(other, _k, _acc), do: other

  @spec object_next(binary, any) :: any
  defp object_next(<<",", r :: binary>>, acc), do: object_entry(skip_ws(r), acc)
  defp object_next(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  defp object_next(b, _acc), do: {:error, b}

  @spec reverse([a], [b]) :: [a | b] when a: var, b: var
  defp reverse([], acc), do: acc
  defp reverse([h | t], acc), do: reverse(t, [h | acc])
end
