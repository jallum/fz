defmodule :lists do
  @moduledoc "The Erlang `:lists` functions, as OTP's lists.erl defines them."

  @doc """
  Returns the elements of `list` in reverse order.

  ## Examples

      :lists.reverse([1, 2, 3])
      #=> [3, 2, 1]

  """
  @spec reverse([t]) :: [t] when t: var
  def reverse([] = l), do: l
  def reverse([_] = l), do: l
  def reverse([a, b]), do: [b, a]
  def reverse([a, b | l]), do: :lists.reverse(l, [b, a])

  @doc """
  Returns the elements of `list` in reverse order, followed by `tail`.

  ## Examples

      :lists.reverse([1, 2, 3], [4, 5])
      #=> [3, 2, 1, 4, 5]

  """
  @spec reverse([t], any) :: [t] when t: var
  def reverse([], tail), do: tail
  def reverse([head | rest], tail), do: reverse(rest, [head | tail])

  @doc """
  Returns `true` when `elem` matches (`===`) an element of `list`, otherwise
  `false`. OTP implements it as a BIF; here it is written in fz.

  ## Examples

      :lists.member(2, [1, 2, 3])
      #=> true

  """
  @spec member(t, [t]) :: boolean when t: var
  def member(_, []), do: false
  def member(elem, [head | rest]), do: if(elem === head, do: true, else: member(elem, rest))

  @doc """
  Returns a list of `n` copies of `elem`. `n` is a non-negative integer.

  ## Examples

      :lists.duplicate(3, :a)
      #=> [:a, :a, :a]

  """
  @spec duplicate(non_neg_integer, t) :: [t] when t: var
  def duplicate(n, x) when is_integer(n) and n >= 0, do: duplicate(n, x, [])

  @spec duplicate(non_neg_integer, t, [t]) :: [t] when t: var
  defp duplicate(0, _, l), do: l
  defp duplicate(n, x, l), do: duplicate(n - 1, x, [x | l])

  @doc """
  Returns the list of `fun` applied to each element of `list`, in order.

  ## Examples

      :lists.map(fn x -> x * 2 end, [1, 2, 3])
      #=> [2, 4, 6]

  """
  @spec map((a -> b), [a]) :: [b] when a: var, b: var
  def map(f, list) when is_function(f, 1) do
    case list do
      [hd | tail] -> [f.(hd) | map_1(f, tail)]
      [] -> []
    end
  end

  @spec map_1((a -> b), [a]) :: [b] when a: var, b: var
  defp map_1(f, [hd | tail]), do: [f.(hd) | map_1(f, tail)]
  defp map_1(_f, []), do: []

  @doc """
  Calls `fun` on each element of `list` and the accumulator, starting from
  `acc0`, and returns the final accumulator. The list is walked from left to
  right.

  ## Examples

      :lists.foldl(fn x, sum -> x + sum end, 0, [1, 2, 3])
      #=> 6

  """
  @spec foldl((t, any -> any), any, [t]) :: any when t: var
  def foldl(f, accu, list) when is_function(f, 2) do
    case list do
      [hd | tail] -> foldl_1(f, f.(hd, accu), tail)
      [] -> accu
    end
  end

  @spec foldl_1((t, any -> any), any, [t]) :: any when t: var
  defp foldl_1(f, accu, [hd | tail]), do: foldl_1(f, f.(hd, accu), tail)
  defp foldl_1(_f, accu, []), do: accu

  @doc """
  Searches `tuple_list` for the first tuple whose `n`th element compares equal
  to `key`, and returns it, or `false` if there is none. Elements that are not
  tuples, or are tuples with fewer than `n` elements, are skipped.

  ## Examples

      :lists.keyfind(:b, 1, [{:a, 10}, {:b, 20}, {:c, 30}])
      #=> {:b, 20}

      :lists.keyfind(:unknown, 1, [{:a, 10}, {:b, 20}, {:c, 30}])
      #=> false

  """
  @spec keyfind(any, pos_integer, [any]) :: tuple | false
  def keyfind(key, n, tuple_list) when is_integer(n) and n > 0 and is_list(tuple_list),
    do: keyfind_walk(key, n, tuple_list)

  def keyfind(_key, n, tuple_list),
    do: raise(%ArgumentError{message: "errors were found at the given arguments:\n\n" <> keyfind_position_complaint(n) <> keyfind_list_complaint(tuple_list)})

  @spec keyfind_walk(any, pos_integer, [any]) :: tuple | false
  defp keyfind_walk(key, n, [head | tail]) do
    if is_tuple(head) and tuple_size(head) >= n and elem(head, n - 1) == key,
      do: head,
      else: keyfind_walk(key, n, tail)
  end

  defp keyfind_walk(_key, _n, []), do: false
  defp keyfind_walk(_key, _n, _improper), do: raise(%ArgumentError{message: "errors were found at the given arguments:\n\n  * 3rd argument: not a proper list\n"})

  @spec keyfind_position_complaint(any) :: binary
  defp keyfind_position_complaint(n) when is_integer(n) and n > 0, do: ""
  defp keyfind_position_complaint(n) when is_integer(n), do: "  * 2nd argument: out of range\n"
  defp keyfind_position_complaint(_n), do: "  * 2nd argument: not an integer\n"

  @spec keyfind_list_complaint(any) :: binary
  defp keyfind_list_complaint(tuple_list) when is_list(tuple_list), do: ""
  defp keyfind_list_complaint(_tuple_list), do: "  * 3rd argument: not a list\n"

  @doc """
  Returns a copy of `tuple_list1` without its first tuple whose `n`th element
  compares equal to `key`, if there is one.

  ## Examples

      :lists.keydelete(:b, 1, [{:a, 1}, {:b, 2}, {:b, 3}])
      #=> [{:a, 1}, {:b, 3}]

  """
  @spec keydelete(any, pos_integer, [tuple]) :: [tuple]
  def keydelete(key, n, list) when is_integer(n) and n > 0, do: keydelete3(key, n, list)

  @spec keydelete3(any, pos_integer, [tuple]) :: [tuple]
  defp keydelete3(key, n, [head | tail]) when is_tuple(head) and tuple_size(head) >= n and elem(head, n - 1) == key, do: tail
  defp keydelete3(key, n, [head | tail]), do: [head | keydelete3(key, n, tail)]
  defp keydelete3(_key, _n, []), do: []

  @doc """
  Turns a list of pairs into a pair of lists: the first elements and the
  second elements, each in order.

  ## Examples

      :lists.unzip([{:a, 1}, {:b, 2}])
      #=> {[:a, :b], [1, 2]}

  """
  @spec unzip([{a, b}]) :: {[a], [b]} when a: var, b: var
  def unzip(ts), do: unzip(ts, [], [])

  @spec unzip([{a, b}], [a], [b]) :: {[a], [b]} when a: var, b: var
  defp unzip([{x, y} | ts], xs, ys), do: unzip(ts, [x | xs], [y | ys])
  defp unzip([], xs, ys), do: {reverse(xs), reverse(ys)}
end
