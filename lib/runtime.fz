  sigil_C: 2,
  sigil_S: 2,
  sigil_W: 2,
  sigil_c: 2,
  sigil_s: 2,
  sigil_w: 2,
  spawn: 1,
  struct: 1,
  struct: 2,
  struct!: 2,
