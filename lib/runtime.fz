@type keyword() :: [{atom, any}]
@type keyword(t) :: [{atom, t}]

alias String.Chars

import Kernel, only: [
  +: 1,
  +: 2,
  -: 2,
  *: 2,
  /: 2,
  %: 2,
  <: 2,
  <=: 2,
  >: 2,
  >=: 2,
  ==: 2,
  !=: 2,
  ===: 2,
  !==: 2,
  &&: 2,
  ||: 2,
  !: 1,
  abs: 1,
  apply: 3,
  dbg: 1,
  defexception: 1,
  div: 2,
  exit: 1,
  floor: 1,
  hd: 1,
  make_ref: 0,
  bit_size: 1,
  byte_size: 1,
  ceil: 1,
  elem: 2,
  inspect: 1,
  inspect: 2,
  is_atom: 1,
  is_binary: 1,
  is_bitstring: 1,
  is_boolean: 1,
  is_exception: 1,
  is_float: 1,
  is_function: 1,
  is_function: 2,
  is_integer: 1,
  is_list: 1,
  is_map: 1,
  is_nil: 1,
  is_number: 1,
  is_pid: 1,
  is_reference: 1,
  is_struct: 1,
