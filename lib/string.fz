defmodule String do
  @moduledoc """
  UTF-8 encoded binaries, and the operations Elixir groups under `String`.

  An fz string is an ordinary binary holding UTF-8 bytes. Two strings
  concatenate with `<>`, the same as any other binary:

      "hello" <> " " <> "world"
      #=> "hello world"

  ## Codepoints, graphemes, and bytes

  `length/1` counts graphemes, not bytes. A grapheme is an extended grapheme
  cluster (Unicode Standard Annex #29), as in Elixir: what a reader sees as one
  character, however many codepoints and bytes it takes. "e" followed by a
  combining accent is one grapheme, and so is a family emoji joined by
  zero-width joiners:

      String.length(<<101, 204, 129>>)
      #=> 1

      String.graphemes(<<101, 204, 129, 120>>)
      #=> [<<101, 204, 129>>, "x"]

  A codepoint is one Unicode scalar value, which UTF-8 encodes in one to four
  bytes, so `codepoints/1` and `byte_size/1` count differently from
  `length/1`:

      String.codepoints(<<101, 204, 129>>)
      #=> ["e", <<204, 129>>]

      byte_size("héllo")
      #=> 6

  ## Case mapping

  `upcase/1` and `downcase/1` are full Unicode case mapping, not ASCII --
  some codepoints expand into several on upcasing, such as German "ß":

      String.upcase("straße")
      #=> "STRASSE"

  ## Patterns

  Where Elixir's `split/3`, `replace/4`, `contains?/2` and friends accept
  a string, a list of strings, a regex, or a compiled pattern, the fz
  versions here take a single binary. An empty pattern matches at every
  grapheme boundary, including before and after the string.

  ## Byte-level operations

  Not every function here needs codepoints. `to_byte_list/1` lists the bytes
  of a string where `to_charlist/1` lists its codepoints. `take_bytes/2`,
  `drop_bytes/2`, and `byte_slice/3` work in bytes directly, for callers who
  already know their boundaries line up with codepoints.

  ## Invalid UTF-8

  fz does not assume its binaries are valid UTF-8. `valid?/1` checks a
  whole binary, `chunk/1` splits one into maximal valid/invalid runs, and
  `replace_invalid/2` replaces every invalid byte.
  """

  # A string is a binary; `String.t()` names it in a `@spec`.
  @type t :: binary

  # Almost everything here is a byte scanner over binaries. A tail is a view
  # of the original binary rather than a copy, and a segment whose size is
  # computed can still be matched, so ordinary fz recursion over a binary --
  # `split/2` and friends -- costs what it should.
  #
  # The module declares three primitives of its own, beyond what Kernel
  # already gives it: `fz_binary_to_atom`, `fz_binary_upcase` and
  # `fz_binary_downcase`. Everything else, including `byte_size/1`, comes from
  # Kernel.
  #
  # Case mapping is full Unicode, not ASCII -- see `upcase/1` and `downcase/1`
  # below for what "full" means and why the table lives in the runtime.

  @doc """
  Returns the number of graphemes in `s`.

  This is not `byte_size/1`: a grapheme can take several bytes, so a
  string's length and its byte size can differ.

  ## Examples

      String.length("hello")
      #=> 5

      String.length("héllo")
      #=> 5

      String.length(<<101, 204, 129>>)
      #=> 1

      byte_size("héllo")
      #=> 6

  """
  @spec length(binary) :: integer
  def length(s) when is_binary(s), do: grapheme_count(s, 0)

  @spec grapheme_count(binary, integer) :: integer
  defp grapheme_count(s, acc), do: grapheme_count_step(next_grapheme(s), acc)

  @spec grapheme_count_step({binary, binary} | nil, integer) :: integer
  defp grapheme_count_step(nil, acc), do: acc
  defp grapheme_count_step({_g, rest}, acc), do: grapheme_count(rest, acc + 1)

  @doc """
  Returns whether `s` starts with `prefix`.

  `prefix` is a single binary, not a list of alternatives.

  ## Examples

      String.starts_with?("hello", "he")
      #=> true

      String.starts_with?("hello", "xx")
      #=> false

  """
  @spec starts_with?(binary, binary) :: boolean
  def starts_with?(s, prefix), do: starts_with_size?(s, prefix, byte_size(prefix))

  @spec starts_with_size?(binary, binary, integer) :: boolean
  defp starts_with_size?(s, prefix, n) do
    if byte_size(s) < n do
      false
    else
      take_bytes(s, n) === prefix
    end
  end

  @doc """
  Returns whether `s` ends with `suffix`.

  `suffix` is a single binary, not a list of alternatives.

  ## Examples

      String.ends_with?("hello", "lo")
      #=> true

      String.ends_with?("hello", "xx")
      #=> false

  """
  @spec ends_with?(binary, binary) :: boolean
  def ends_with?(s, suffix), do: ends_with_size?(s, suffix, byte_size(s), byte_size(suffix))

  @spec ends_with_size?(binary, binary, integer, integer) :: boolean
  defp ends_with_size?(s, suffix, total, n) do
    if total < n do
      false
    else
      drop_bytes(s, total - n) === suffix
    end
  end

  @doc """
  Returns the first `n` bytes of `s`.

  This is a byte offset, not a codepoint count -- pass a boundary that
  does not fall inside a multi-byte codepoint and the result stays valid
  UTF-8. When `s` has fewer than `n` bytes, `s` is returned unchanged.

  ## Examples

      String.take_bytes("hello world", 5)
      #=> "hello"

      String.take_bytes("hi", 10)
      #=> "hi"

  """
  @spec take_bytes(binary, integer) :: binary
  def take_bytes(s, n), do: take_bytes_result(s, n)

  @spec take_bytes_result(binary, integer) :: binary
  defp take_bytes_result(s, n) do
    case s do
      <<head :: binary-size(n), _rest :: binary>> -> head
      _other -> s
    end
  end

  @doc """
  Returns everything in `s` after the first `n` bytes.

  When `s` has fewer than `n` bytes, the result is `""`.

  ## Examples

      String.drop_bytes("hello world", 6)
      #=> "world"

      String.drop_bytes("hi", 10)
      #=> ""

  """
  @spec drop_bytes(binary, integer) :: binary
  def drop_bytes(s, n), do: drop_bytes_result(s, n)

  @spec drop_bytes_result(binary, integer) :: binary
  defp drop_bytes_result(s, n) do
    case s do
      <<_head :: binary-size(n), rest :: binary>> -> rest
      _other -> ""
    end
  end

  @doc """
  Returns `len` bytes of `s` starting at byte offset `start`.

  ## Examples

      String.byte_slice("hello world", 6, 5)
      #=> "world"

  """
  @spec byte_slice(binary, integer, integer) :: binary
  def byte_slice(s, start, len), do: take_bytes(drop_bytes(s, start), len)

  @doc """
  Returns the graphemes of `s` that `range` selects.

  A negative end counts from the end of `s`, and a first before the
  beginning is clamped to 0. A range that selects nothing gives `""`. A
  `step` above 1 keeps every `step`-th grapheme of the selection. A
  negative `step` raises `ArgumentError`, including `first..last//-1` with
  `first > last`, which Elixir accepts with a deprecation warning.

  ## Examples

      String.slice("héllo", 1..3)
      #=> "éll"

      String.slice("héllo", -4..-2)
      #=> "éll"

      String.slice("héllo", 0..4//2)
      #=> "hlo"

      String.slice("héllo", 3..1//1)
      #=> ""

  """
  @spec slice(binary, Range.t) :: binary
  def slice(s, %Range{first: first, last: last, step: step}) when step > 0 do
    if first < 0 || last < 0 do
      len = length(s)
      slice_range(s, clamp_start(from_end(first, len)), from_end(last, len), step)
    else
      slice_range(s, first, last, step)
    end
  end
  def slice(_s, %Range{} = range),
    do: raise(%ArgumentError{message: "String.slice/2 does not accept ranges with negative steps, got: " <> inspect(range)})

  @spec from_end(integer, integer) :: integer
  defp from_end(index, len) when index < 0, do: len + index
  defp from_end(index, _len), do: index

  @spec clamp_start(integer) :: integer
  defp clamp_start(start) when start < 0, do: 0
  defp clamp_start(start), do: start

  @spec slice_range(binary, integer, integer, integer) :: binary
  defp slice_range(_s, first, last, _step) when last < first, do: ""
  defp slice_range(s, first, last, 1), do: slice(s, first, last - first + 1)
  defp slice_range(s, first, last, step), do: every_nth(slice(s, first, last - first + 1), step, "")

  # Keeps the first grapheme of s, then skips step - 1 and repeats.
  @spec every_nth(binary, integer, binary) :: binary
  defp every_nth(s, step, acc), do: every_nth_step(next_grapheme(s), step, acc)

  @spec every_nth_step({binary, binary} | nil, integer, binary) :: binary
  defp every_nth_step(nil, _step, acc), do: acc
  defp every_nth_step({g, rest}, step, acc),
    do: every_nth(drop_bytes(rest, grapheme_bytes(rest, step - 1, 0)), step, acc <> g)

  @doc """
  Returns `len` graphemes of `s` starting at the grapheme `start`.

  A negative `start` counts from the end of `s`, and one before the
  beginning is clamped to 0. A `start` past the end gives `""`, and fewer
  than `len` graphemes remaining gives all of them. A negative `len`, or a
  non-integer argument, raises `FunctionClauseError`.

  ## Examples

      String.slice("héllo", 1, 3)
      #=> "éll"

      String.slice("héllo", -3, 2)
      #=> "ll"

      String.slice("héllo", 10, 2)
      #=> ""

  """
  @spec slice(binary, integer, integer) :: binary
  def slice(s, start, len) when is_integer(start) and start >= 0 and is_integer(len) and len >= 0 do
    rest = drop_bytes(s, grapheme_bytes(s, start, 0))
    take_bytes(rest, grapheme_bytes(rest, len, 0))
  end
  def slice(s, start, len) when is_integer(start) and start < 0 and is_integer(len) and len >= 0,
    do: slice(s, clamp_start(length(s) + start), len)

  # The bytes the first n graphemes of s take: all of s when it has fewer.
  @spec grapheme_bytes(binary, integer, integer) :: integer
  defp grapheme_bytes(_s, 0, acc), do: acc
  defp grapheme_bytes(s, n, acc), do: grapheme_bytes_step(next_grapheme_size(s), n, acc)

  @spec grapheme_bytes_step({integer, binary} | nil, integer, integer) :: integer
  defp grapheme_bytes_step(nil, _n, acc), do: acc
  defp grapheme_bytes_step({size, rest}, n, acc), do: grapheme_bytes(rest, n - 1, acc + size)

  @doc """
  Returns `s` with `padding` repeated in front until it has `count` graphemes.

  `padding` is a binary, whose graphemes are the units, or a list, whose
  elements are the units; the units cycle until the missing graphemes are
  filled. A `s` that already has `count` graphemes or more is returned
  unchanged, and only its first `count` graphemes are read. A negative
  `count` or an empty `padding` raises `FunctionClauseError`, and a list
  element that is not a binary raises `ArgumentError` when the padding
  reaches it.

  ## Examples

      String.pad_leading("abc", 6)
      #=> "   abc"

      String.pad_leading("abc", 6, "12")
      #=> "121abc"

      String.pad_leading("héllo", 3)
      #=> "héllo"

  """
  @spec pad_leading(binary, integer) :: binary
  def pad_leading(s, count), do: pad_leading(s, count, " ")

  @spec pad_leading(binary, integer, binary | [binary]) :: binary
  def pad_leading(s, count, [_ | _] = padding) when is_integer(count) and count >= 0,
    do: padding_for(s, count, padding) <> s
  def pad_leading(s, count, padding) when is_integer(count) and count >= 0 and is_binary(padding) and padding != "",
    do: padding_for(s, count, padding) <> s

  @doc """
  Returns `s` with `padding` repeated after it until it has `count` graphemes.

  `padding` is a binary, whose graphemes are the units, or a list, whose
  elements are the units; the units cycle until the missing graphemes are
  filled. A `s` that already has `count` graphemes or more is returned
  unchanged, and only its first `count` graphemes are read. A negative
  `count` or an empty `padding` raises `FunctionClauseError`, and a list
  element that is not a binary raises `ArgumentError` when the padding
  reaches it.

  ## Examples

      String.pad_trailing("abc", 6)
      #=> "abc   "

      String.pad_trailing("abc", 6, ["x", "yz"])
      #=> "abcxyzx"

      String.pad_trailing("é", 3, "ë")
      #=> "éëë"

  """
  @spec pad_trailing(binary, integer) :: binary
  def pad_trailing(s, count), do: pad_trailing(s, count, " ")

  @spec pad_trailing(binary, integer, binary | [binary]) :: binary
  def pad_trailing(s, count, [_ | _] = padding) when is_integer(count) and count >= 0,
    do: s <> padding_for(s, count, padding)
  def pad_trailing(s, count, padding) when is_integer(count) and count >= 0 and is_binary(padding) and padding != "",
    do: s <> padding_for(s, count, padding)

  # The units still missing for s to reach count graphemes: "" when none are.
  @spec padding_for(binary, integer, binary | [any]) :: binary
  defp padding_for(s, count, padding) do
    missing = count - grapheme_count_upto(s, count, 0)
    if missing > 0 do
      units = padding_units(padding)
      cycle_units(units, units, missing, "")
    else
      ""
    end
  end

  # The graphemes of s, counting no further than limit.
  @spec grapheme_count_upto(binary, integer, integer) :: integer
  defp grapheme_count_upto(_s, limit, acc) when acc >= limit, do: acc
  defp grapheme_count_upto(s, limit, acc), do: grapheme_count_upto_step(next_grapheme_size(s), limit, acc)

  @spec grapheme_count_upto_step({integer, binary} | nil, integer, integer) :: integer
  defp grapheme_count_upto_step(nil, _limit, acc), do: acc
  defp grapheme_count_upto_step({_size, rest}, limit, acc), do: grapheme_count_upto(rest, limit, acc + 1)

  @spec padding_units(binary | [any]) :: [any]
  defp padding_units(padding) when is_binary(padding), do: graphemes(padding)
  defp padding_units(padding), do: padding

  @spec cycle_units([any], [any], integer, binary) :: binary
  defp cycle_units(_units, _rest, 0, acc), do: acc
  defp cycle_units(units, [], n, acc), do: cycle_units(units, units, n, acc)
  defp cycle_units(units, [unit | rest], n, acc) when is_binary(unit), do: cycle_units(units, rest, n - 1, acc <> unit)
  defp cycle_units(_units, [unit | _rest], _n, _acc),
    do: raise(%ArgumentError{message: "expected a string padding element, got: " <> inspect(unit)})

  @doc """
  Replaces `prefix` with `replacement` when `s` starts with it.

  Returns `s` unchanged when it does not.

  ## Examples

      String.replace_prefix("hello", "he", "HE")
      #=> "HEllo"

      String.replace_prefix("hello", "xx", "HE")
      #=> "hello"

  """
  @spec replace_prefix(binary, binary, binary) :: binary
  def replace_prefix(s, prefix, replacement) do
    if starts_with?(s, prefix) do
      replacement <> drop_bytes(s, byte_size(prefix))
    else
      s
    end
  end

  @doc """
  Replaces `suffix` with `replacement` when `s` ends with it.

  Returns `s` unchanged when it does not.

  ## Examples

      String.replace_suffix("hello", "lo", "LO")
      #=> "helLO"

      String.replace_suffix("hello", "xx", "LO")
      #=> "hello"

  """
  @spec replace_suffix(binary, binary, binary) :: binary
  def replace_suffix(s, suffix, replacement) do
    if ends_with?(s, suffix) do
      take_bytes(s, byte_size(s) - byte_size(suffix)) <> replacement
    else
      s
    end
  end

  @doc """
  Replaces every leading occurrence of `match` in `s` with `replacement`.

  Stops at the first position that does not start with `match`.

  ## Examples

      String.replace_leading("aaabc", "a", "X")
      #=> "XXXbc"

  """
  @spec replace_leading(binary, binary, binary) :: binary
  def replace_leading(s, match, replacement), do: replace_leading_guard(s, match, replacement, byte_size(match))

  @spec replace_leading_guard(binary, binary, binary, integer) :: binary
  defp replace_leading_guard(s, _match, _replacement, 0), do: s
  defp replace_leading_guard(s, match, replacement, n) do
    if starts_with?(s, match) do
      replacement <> replace_leading_guard(drop_bytes(s, n), match, replacement, n)
    else
      s
    end
  end

  @doc """
  Replaces every trailing occurrence of `match` in `s` with `replacement`.

  Stops at the first position, scanning from the end, that does not end
  with `match`.

  ## Examples

      String.replace_trailing("abccc", "c", "Y")
      #=> "abYYY"

  """
  @spec replace_trailing(binary, binary, binary) :: binary
  def replace_trailing(s, match, replacement), do: replace_trailing_guard(s, match, replacement, byte_size(match))

  @spec replace_trailing_guard(binary, binary, binary, integer) :: binary
  defp replace_trailing_guard(s, _match, _replacement, 0), do: s
  defp replace_trailing_guard(s, match, replacement, n) do
    if ends_with?(s, match) do
      replace_trailing_guard(take_bytes(s, byte_size(s) - n), match, replacement, n) <> replacement
    else
      s
    end
  end

  @doc """
  Removes leading and trailing whitespace from `s`.

  This trims the Unicode whitespace set, not just ASCII space -- the
  ideographic space (U+3000) below is trimmed along with plain spaces.

  ## Examples

      String.trim("  hi  ")
      #=> "hi"

      String.trim("　hi　")
      #=> "hi"

  """
  @spec trim(binary) :: binary
  def trim(s), do: trim_trailing(trim_leading(s))

  @doc """
  Removes leading whitespace from `s`.

  ## Examples

      String.trim_leading("  hi")
      #=> "hi"

  """
  @spec trim_leading(binary) :: binary
  def trim_leading(s), do: trim_leading_step(s, next_codepoint(s))

  @spec trim_leading_step(binary, {binary, binary} | nil) :: binary
  defp trim_leading_step(s, nil), do: s
  defp trim_leading_step(s, {cp, rest}) do
    if whitespace?(cp), do: trim_leading(rest), else: s
  end

  @doc """
  Removes trailing whitespace from `s`.

  ## Examples

      String.trim_trailing("hi  ")
      #=> "hi"

  """
  @spec trim_trailing(binary) :: binary
  def trim_trailing(s), do: reverse(trim_leading(reverse(s)))

  @spec first_byte(binary) :: integer
  defp first_byte(<<c, _rest :: binary>>), do: c
  defp first_byte(_s), do: 0

  # This trims the Unicode whitespace set, not just ASCII, hence the table
  # below -- 25 codepoints. The other table this module relies on is case
  # mapping; see `upcase/1`.
  @spec whitespace?(binary) :: boolean
  defp whitespace?(" "), do: true
  defp whitespace?("\t"), do: true
  defp whitespace?("\n"), do: true
  defp whitespace?("\r"), do: true
  defp whitespace?(<<11>>), do: true
  defp whitespace?(<<12>>), do: true
  defp whitespace?(<<194, 133>>), do: true
  defp whitespace?(<<194, 160>>), do: true
  defp whitespace?(<<225, 154, 128>>), do: true
  defp whitespace?(<<226, 128, 128>>), do: true
  defp whitespace?(<<226, 128, 129>>), do: true
  defp whitespace?(<<226, 128, 130>>), do: true
  defp whitespace?(<<226, 128, 131>>), do: true
  defp whitespace?(<<226, 128, 132>>), do: true
  defp whitespace?(<<226, 128, 133>>), do: true
  defp whitespace?(<<226, 128, 134>>), do: true
  defp whitespace?(<<226, 128, 135>>), do: true
  defp whitespace?(<<226, 128, 136>>), do: true
  defp whitespace?(<<226, 128, 137>>), do: true
  defp whitespace?(<<226, 128, 138>>), do: true
  defp whitespace?(<<226, 128, 168>>), do: true
  defp whitespace?(<<226, 128, 169>>), do: true
  defp whitespace?(<<226, 128, 175>>), do: true
  defp whitespace?(<<226, 129, 159>>), do: true
  defp whitespace?(<<227, 128, 128>>), do: true
  defp whitespace?(_cp), do: false

  # Unicode case mapping, not ASCII. The table is 2,723 codepoint pairs; as fz
  # clauses it would go through the dispatch matrix and make compile work
  # proportional to the table rather than to the program, so it lives in the
  # runtime. It could move into fz once a table can be represented as data
  # rather than as clauses.
  #
  # This is full casing: the 103 special casings expand one codepoint into
  # several, so "straße" upcases to "STRASSE".
  @doc """
  Converts every codepoint in `s` to uppercase.

  This is full Unicode casing, so a single codepoint can expand into
  several -- German "ß" upcases to two letters, "SS".

  ## Examples

      String.upcase("héllo")
      #=> "HÉLLO"

      String.upcase("straße")
      #=> "STRASSE"

  """
  @spec upcase(binary) :: binary
  def upcase(s :: binary), do: fz_binary_upcase(s)

  extern "fz" defp fz_binary_upcase(binary) :: binary

  @doc """
  Converts every codepoint in `s` to lowercase.

  This is full Unicode casing: the Turkish dotted capital "İ" downcases
  to two codepoints, a plain "i" followed by a combining dot above.

  ## Examples

      String.downcase("HÉLLO")
      #=> "héllo"

      String.downcase("İ")
      #=> "i̇"

  """
  @spec downcase(binary) :: binary
  def downcase(s :: binary), do: fz_binary_downcase(s)

  extern "fz" defp fz_binary_downcase(binary) :: binary

  @doc """
  Returns `s` repeated `n` times.

  ## Examples

      String.duplicate("ab", 3)
      #=> "ababab"

      String.duplicate("ab", 0)
      #=> ""

  """
  @spec duplicate(binary, integer) :: binary
  def duplicate(s, n), do: :binary.copy(s, n)

  @doc """
  Returns whether `s` contains `pattern`.

  `pattern` is a single binary. An empty pattern always matches, including
  in an empty string.

  ## Examples

      String.contains?("hello", "ell")
      #=> true

      String.contains?("hello", "zz")
      #=> false

      String.contains?("hello", "")
      #=> true

  """
  @spec contains?(binary, binary) :: boolean
  def contains?(s, pattern), do: index_of(s, pattern) >= 0

  @doc """
  Returns the byte offset of the first occurrence of `pattern` in `s`.

  Returns `-1` when `pattern` does not occur. An empty pattern occurs at
  byte offset `0`.

  ## Examples

      String.index_of("hello", "ll")
      #=> 2

      String.index_of("hello", "zz")
      #=> -1

      String.index_of("hello", "")
      #=> 0

  """
  @spec index_of(binary, binary) :: integer
  def index_of(s, pattern), do: index_from(s, pattern, 0, byte_size(pattern))

  @spec index_from(binary, binary, integer, integer) :: integer
  defp index_from(_s, _pattern, at, 0), do: at
  defp index_from(s, pattern, at, n) do
    if byte_size(s) < n do
      -1
    else
      if starts_with?(s, pattern) do
        at
      else
        index_from(drop_bytes(s, 1), pattern, at + 1, n)
      end
    end
  end

  @doc """
  Returns how many non-overlapping times `pattern` occurs in `s`.

  An empty pattern occurs at every grapheme boundary, so its count is one
  greater than the string's length.

  ## Examples

      String.count("banana", "an")
      #=> 2

      String.count("banana", "zz")
      #=> 0

      String.count("hello", "")
      #=> 6

  """
  @spec count(binary, binary) :: integer
  def count(s, ""), do: length(s) + 1
  def count(s, pattern), do: count_from(s, pattern, 0, byte_size(pattern))

  @spec count_from(binary, binary, integer, integer) :: integer
  defp count_from(_s, _pattern, acc, 0), do: acc
  defp count_from(s, pattern, acc, n) do
    index = index_of(s, pattern)
    if index < 0 do
      acc
    else
      count_from(drop_bytes(s, index + n), pattern, acc + 1, n)
    end
  end

  @doc """
  Splits `s` on every occurrence of `pattern`.

  `pattern` is a single binary, not a list of patterns or a regex. When
  `pattern` does not occur, the result is `[s]`. An empty pattern splits at
  every grapheme boundary, retaining an empty binary at either end.

  ## Examples

      String.split("a,b,c", ",")
      #=> ["a", "b", "c"]

      String.split("abc", ",")
      #=> ["abc"]

      String.split("abc", "")
      #=> ["", "a", "b", "c", ""]

  """
  @spec split(binary, binary) :: [binary]
  def split(s, ""), do: [""] ++ graphemes(s) ++ [""]
  def split(s, pattern), do: split_from(s, pattern, byte_size(pattern))

  @spec split_from(binary, binary, integer) :: [binary]
  defp split_from(s, pattern, n) do
    index = index_of(s, pattern)
    if index < 0 do
      [s]
    else
      [take_bytes(s, index) | split_from(drop_bytes(s, index + n), pattern, n)]
    end
  end

  @doc """
  Splits `s` on runs of whitespace, dropping the empty strings that leading,
  trailing and repeated whitespace would leave.

  The separators are Unicode whitespace except the non-breaking spaces
  U+00A0, U+2007 and U+202F, as in Elixir: those stay inside a word.

  ## Examples

      String.split(" a  b\n")
      #=> ["a", "b"]

      String.split("")
      #=> []

  """
  @spec split(binary) :: [binary]
  def split(s), do: split_words(s)

  # `s` is where a word may start. A byte that is not UTF-8 is a word byte.
  @spec split_words(binary) :: [binary]
  defp split_words(<<>>), do: []

  defp split_words(<<cp :: utf8, rest :: binary>> = s) do
    if separator?(cp), do: split_words(rest), else: split_word(s, byte_size(s) - byte_size(rest), rest)
  end

  defp split_words(<<_byte, rest :: binary>> = s), do: split_word(s, 1, rest)

  # `s` starts at the word, `size` bytes of which are read and `rest` follows.
  @spec split_word(binary, integer, binary) :: [binary]
  defp split_word(s, _size, <<>>), do: [s]

  defp split_word(s, size, <<cp :: utf8, rest :: binary>> = tail) do
    if separator?(cp),
      do: [take_bytes(s, size) | split_words(rest)],
      else: split_word(s, size + byte_size(tail) - byte_size(rest), rest)
  end

  defp split_word(s, size, <<_byte, rest :: binary>>), do: split_word(s, size + 1, rest)

  # Unicode whitespace except the non-breaking spaces U+00A0, U+2007 and U+202F.
  @spec separator?(integer) :: boolean
  defp separator?(cp) do
    (cp >= 9 and cp <= 13) or cp == 32 or cp == 133 or cp == 5760 or (cp >= 8192 and cp <= 8198) or
      (cp >= 8200 and cp <= 8202) or cp == 8232 or cp == 8233 or cp == 8287 or cp == 12288
  end

  @doc """
  Replaces every occurrence of `pattern` in `s` with `replacement`.

  `pattern` is a single binary. An empty pattern inserts `replacement` at
  every grapheme boundary. This function is built from `split/2` and
  `join/2`, so both operations share exactly the same boundary rule.

  ## Examples

      String.replace("a-b-c", "-", "+")
      #=> "a+b+c"

      String.replace("abc", "", "-")
      #=> "-a-b-c-"

  """
  @spec replace(binary, binary, binary) :: binary
  def replace(s, pattern, replacement), do: join(split(s, pattern), replacement)

  @doc """
  Joins the binaries in `parts`, with `separator` between each pair.

  ## Examples

      String.join(["a", "b", "c"], "-")
      #=> "a-b-c"

      String.join([], "-")
      #=> ""

      String.join(["only"], "-")
      #=> "only"

  """
  @spec join([binary], binary) :: binary
  def join([], _separator), do: ""
  def join([only], _separator), do: only
  def join([head | tail], separator), do: head <> separator <> join(tail, separator)

  @doc """
  Returns the first codepoint of `s` and the rest, or `nil` when `s` is empty.

  ## Examples

      String.next_codepoint("héllo")
      #=> {"h", "éllo"}

      String.next_codepoint("")
      #=> nil

  """
  @spec next_codepoint(binary) :: {binary, binary} | nil
  def next_codepoint(<<>>), do: nil
  def next_codepoint(s), do: split_codepoint(s, codepoint_size(first_byte(s)))

  @spec split_codepoint(binary, integer) :: {binary, binary} | nil
  defp split_codepoint(s, size), do: {take_bytes(s, size), drop_bytes(s, size)}

  # UTF-8 says how long a codepoint is in its first byte, so a decoder never
  # has to look ahead to know how far to advance.
  @spec codepoint_size(integer) :: integer
  defp codepoint_size(c) when c < 128, do: 1
  defp codepoint_size(c) when c < 224, do: 2
  defp codepoint_size(c) when c < 240, do: 3
  defp codepoint_size(_c), do: 4

  @doc """
  Returns the byte length of the first grapheme of `s` and the rest, or `nil`
  when `s` is empty.

  A grapheme is an extended grapheme cluster, so its size can span several
  codepoints. An invalid byte is a grapheme of its own.

  ## Examples

      String.next_grapheme_size("éllo")
      #=> {2, "llo"}

      String.next_grapheme_size(<<101, 204, 129, "llo">>)
      #=> {3, "llo"}

      String.next_grapheme_size("")
      #=> nil

  """
  @spec next_grapheme_size(binary) :: {integer, binary} | nil
  def next_grapheme_size(""), do: nil

  def next_grapheme_size(s) when is_binary(s) do
    size = fz_grapheme_size(s)
    {size, drop_bytes(s, size)}
  end

  extern "fz" defp fz_grapheme_size(binary) :: integer

  @doc """
  Returns the first grapheme of `s` and the rest, or `nil` when `s` is empty.

  ## Examples

      String.next_grapheme("héllo")
      #=> {"h", "éllo"}

      String.next_grapheme("")
      #=> nil

  """
  @spec next_grapheme(binary) :: {binary, binary} | nil
  def next_grapheme(""), do: nil
  def next_grapheme(s) when is_binary(s), do: split_codepoint(s, fz_grapheme_size(s))

  @doc """
  Returns every grapheme of `s` as its own binary.

  A grapheme is an extended grapheme cluster, so a base letter and its
  combining marks stay together, unlike in `codepoints/1`.

  ## Examples

      String.graphemes("héllo")
      #=> ["h", "é", "l", "l", "o"]

      String.graphemes(<<101, 204, 129, 120>>)
      #=> [<<101, 204, 129>>, "x"]

  """
  @spec graphemes(binary) :: [binary]
  def graphemes(s) when is_binary(s), do: graphemes_step(next_grapheme(s))

  @spec graphemes_step({binary, binary} | nil) :: [binary]
  defp graphemes_step(nil), do: []
  defp graphemes_step({g, rest}), do: [g | graphemes(rest)]

  @doc """
  Returns every codepoint of `s` as its own binary.

  ## Examples

      String.codepoints("héllo")
      #=> ["h", "é", "l", "l", "o"]

  """
  @spec codepoints(binary) :: [binary]
  def codepoints(s), do: codepoints_step(next_codepoint(s))

  @spec codepoints_step({binary, binary} | nil) :: [binary]
  defp codepoints_step(nil), do: []
  defp codepoints_step({cp, rest}), do: [cp | codepoints(rest)]

  @doc """
  Returns whether `s` is valid UTF-8.

  ## Examples

      String.valid?("hi")
      #=> true

      String.valid?(<<255>>)
      #=> false

  """
  @spec valid?(binary) :: boolean
  def valid?(s) when is_binary(s), do: Utf8.valid?(s)

  @doc """
  Returns every byte of `s` as an integer.

  This is `to_charlist/1` for text that is not UTF-8, or whose bytes are
  wanted as they are: a codepoint above 127 is several integers here and one
  there.

  ## Examples

      String.to_byte_list("abc")
      #=> [97, 98, 99]

  """
  @spec to_byte_list(binary) :: [integer]
  def to_byte_list(<<c, rest :: binary>>), do: [c | to_byte_list(rest)]
  def to_byte_list(_s), do: []

  @doc """
  Returns every codepoint of `s` as an integer: the charlist of `s`.

  Raises `UnicodeConversionError` when `s` is not valid UTF-8.

  ## Examples

      String.to_charlist("héllo")
      #=> [104, 233, 108, 108, 111]

      String.to_charlist(<<255>>)
      # ** (UnicodeConversionError) invalid encoding starting at <<255>>

  """
  @spec to_charlist(binary) :: [integer]
  def to_charlist(string) when is_binary(string), do: codepoint_integers(string, [])

  @spec codepoint_integers(binary, [integer]) :: [integer]
  defp codepoint_integers(<<c :: utf8, rest :: binary>>, acc), do: codepoint_integers(rest, [c | acc])
  defp codepoint_integers(<<>>, acc), do: List.reverse(acc, [])

  defp codepoint_integers(invalid, acc) do
    raise UnicodeConversionError, encoded: List.reverse(acc, []), rest: invalid, kind: conversion_kind(Utf8.next(invalid))
  end

  @spec conversion_kind({:error, binary} | any) :: :invalid | :incomplete
  defp conversion_kind({:error, ""}), do: :incomplete
  defp conversion_kind(_next), do: :invalid

  @doc """
  Returns the atom named `s`, interning it if it does not already exist.

  ## Examples

      String.to_atom("hello")
      #=> :hello

  """
  @spec to_atom(binary) :: atom
  def to_atom(s) when is_binary(s) do
    if valid?(s), do: fz_binary_to_atom(s), else: to_atom_refused("invalid UTF8 encoding")
  end

  def to_atom(_s), do: to_atom_refused("not a binary")

  @spec to_atom_refused(binary) :: no_return()
  defp to_atom_refused(reason),
    do: raise(ArgumentError, "errors were found at the given arguments:\n\n  * 1st argument: " <> reason <> "\n")

  extern "fz" defp fz_binary_to_atom(binary) :: atom

  @doc """
  Reverses the codepoints of `s`.

  ## Examples

      String.reverse("héllo")
      #=> "olléh"

  """
  @spec reverse(binary) :: binary
  def reverse(s), do: reverse_onto(s, "")

  @spec reverse_onto(binary, binary) :: binary
  defp reverse_onto(s, acc), do: reverse_step(next_codepoint(s), acc)

  @spec reverse_step({binary, binary} | nil, binary) :: binary
  defp reverse_step(nil, acc), do: acc
  defp reverse_step({cp, rest}, acc), do: reverse_onto(rest, cp <> acc)

  @doc """
  Returns the first codepoint of `s`, or `nil` when `s` is empty.

  ## Examples

      String.first("héllo")
      #=> "h"

      String.first("")
      #=> nil

  """
  @spec first(binary) :: binary | nil
  def first(s), do: first_step(next_codepoint(s))

  @spec first_step({binary, binary} | nil) :: binary | nil
  defp first_step(nil), do: nil
  defp first_step({cp, _rest}), do: cp

  @doc """
  Returns whether `s` is valid UTF-8 and every codepoint in it is printable,
  as in Elixir: the ASCII graphic range and DEL, the controls from bell to
  carriage return and escape, and every codepoint from U+00A0 except U+FFFE
  and U+FFFF.

  ## Examples

      String.printable?("héllo")
      #=> true

      String.printable?(<<0>>)
      #=> false

  """
  @spec printable?(binary) :: boolean
  def printable?(s) when is_binary(s), do: fz_binary_printable(s)

  extern "fz" defp fz_binary_printable(binary) :: boolean

  @doc """
  Returns the integer that `s` names, in base 10.

  `s` must be an optional leading `-` or `+` followed by one or more decimal
  digits; anything else raises `ArgumentError`. There is no base argument, so
  callers wanting another base cannot use this function.

  ## Examples

      String.to_integer("42")
      #=> 42

      String.to_integer("-7")
      #=> -7

  """
  @spec to_integer(binary) :: integer
  def to_integer(s), do: :erlang.binary_to_integer(s)

  @doc """
  Returns the float that `s` names, or raises `ArgumentError`.

  `s` is an optional sign, digits, a decimal point, digits, and an optional
  exponent (`"1.0e3"`). The decimal point is required: `"1"` and `"1e3"` raise
  where `"1.0"` and `"1.0e3"` succeed, matching Elixir's own `to_float/1`.

  ## Examples

      String.to_float("2.5")
      #=> 2.5

      String.to_float("-1.5e-2")
      #=> -0.015

  """
  @spec to_float(binary) :: float
  def to_float(s), do: :erlang.binary_to_float(s)

  @doc """
  Replaces every invalid UTF-8 byte sequence in `s` with `replacement`.

  ## Examples

      String.replace_invalid(<<104, 255, 105>>, "?")
      #=> "h?i"

  """
  @spec replace_invalid(binary, binary) :: binary
  def replace_invalid(s, replacement), do: replace_invalid_step(s, replacement)

  # A codepoint's length is in its first byte, so the candidate slice is known
  # before it is validated. If the slice is valid UTF-8 it is kept whole;
  # otherwise one byte is dropped and replaced, resynchronising a truncated
  # sequence without swallowing the bytes after it.
  @spec replace_invalid_step(binary, binary) :: binary
  defp replace_invalid_step(<<>>, _replacement), do: ""
  defp replace_invalid_step(s, replacement) do
    size = codepoint_size(first_byte(s))
    candidate = take_bytes(s, size)
    if byte_size(candidate) == size and valid?(candidate) do
      candidate <> replace_invalid_step(drop_bytes(s, size), replacement)
    else
      replacement <> replace_invalid_step(drop_bytes(s, 1), replacement)
    end
  end

  @doc """
  Splits `s` into runs that are all valid or all invalid UTF-8.

  ## Examples

      String.chunk("hi")
      #=> ["hi"]

      String.chunk(<<104, 255, 105>>)
      #=> ["h", <<255>>, "i"]

  """
  @spec chunk(binary) :: [binary]
  def chunk(""), do: []
  def chunk(s), do: chunk_run(s, valid_here?(s))

  @spec valid_here?(binary) :: boolean
  defp valid_here?(s) do
    size = codepoint_size(first_byte(s))
    candidate = take_bytes(s, size)
    byte_size(candidate) == size and valid?(candidate)
  end

  @spec chunk_run(binary, boolean) :: [binary]
  defp chunk_run(s, wanted), do: chunk_split(s, wanted, "")

  @spec chunk_split(binary, boolean, binary) :: [binary]
  defp chunk_split(<<>>, _wanted, acc), do: [acc]
  defp chunk_split(s, wanted, acc) do
    if valid_here?(s) == wanted do
      size = chunk_step(s, wanted)
      chunk_split(drop_bytes(s, size), wanted, acc <> take_bytes(s, size))
    else
      [acc | chunk(s)]
    end
  end

  @spec chunk_step(binary, boolean) :: integer
  defp chunk_step(_s, false), do: 1
  defp chunk_step(s, true), do: codepoint_size(first_byte(s))

  @doc """
  Returns the last codepoint of `s`, or `nil` when `s` is empty.

  ## Examples

      String.last("héllo")
      #=> "o"

      String.last("")
      #=> nil

  """
  @spec last(binary) :: binary | nil
  def last(s), do: first(reverse(s))
end
