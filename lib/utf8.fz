defmodule Utf8 do
  @moduledoc """
  Validates and brands byte-aligned binaries as UTF-8.

  `utf8` is a brand on `binary`: the same bytes, tagged at the type level
  so a position declared `utf8` accepts only validated input and rejects a
  plain `binary`. `from_bytes!/1` and `from_bytes/1` mint that brand after
  checking `valid?/1`; `from_codepoint/1` encodes one Unicode scalar;
  `next/1` validates one codepoint while retaining the remaining source;
  `to_bytes/1` drops back to the plain binary.

  ## Examples

      Utf8.valid?("café")
      #=> true

      Utf8.from_bytes(<<255, 254>>)
      #=> {:error, :invalid_utf8}

  """

  extern "C" def fz_bitstring_valid_utf8(any) :: integer
  extern "C" def fz_bitstring_utf8_prefix(any) :: integer
  extern "C" def fz_brand_bitstring_as_utf8(any) :: any

  @doc """
  Returns whether `bytes` is byte-aligned, valid UTF-8.

  ## Examples

      Utf8.valid?("café")
      #=> true

      Utf8.valid?(<<255, 254>>)
      #=> false

  """
  @spec valid?(binary) :: bool
  def valid?(bytes), do: fz_bitstring_valid_utf8(bytes) == 1

  @doc """
  Encodes one Unicode scalar value as UTF-8.

  Returns `{:ok, utf8}`, or `{:error, :invalid_codepoint}` when `codepoint`
  is negative, is in the UTF-16 surrogate range U+D800 through U+DFFF, or
  is greater than U+10FFFF.

  ## Examples

      Utf8.from_codepoint(233)
      #=> {:ok, "é"}

      Utf8.from_codepoint(0xd800)
      #=> {:error, :invalid_codepoint}

  """
  @spec from_codepoint(integer) :: {:ok, utf8} | {:error, :invalid_codepoint}
  def from_codepoint(codepoint), do: encode_codepoint(codepoint, scalar?(codepoint))

  @spec scalar?(integer) :: bool
  defp scalar?(codepoint) when codepoint < 0, do: false
  defp scalar?(codepoint) when codepoint >= 0xd800 and codepoint <= 0xdfff, do: false
  defp scalar?(codepoint) when codepoint > 0x10ffff, do: false
  defp scalar?(_codepoint), do: true

  @spec encode_codepoint(integer, bool) :: {:ok, utf8} | {:error, :invalid_codepoint}
  defp encode_codepoint(codepoint, true), do: {:ok, fz_brand_bitstring_as_utf8(<<codepoint :: utf8>>)}
  defp encode_codepoint(_codepoint, false), do: {:error, :invalid_codepoint}

  @doc """
  Validates and removes the first UTF-8 codepoint from `bytes`.

  Returns `{:ok, codepoint, rest}` with a branded `utf8` codepoint,
  `{:error, rest}` with `rest` beginning at the first offending byte, or
  `nil` for an empty binary. An incomplete codepoint returns
  `{:error, ""}`.

  ## Examples

      Utf8.next(<<195, 169, 120>>)
      #=> {:ok, "é", "x"}

      Utf8.next(<<225, 128, 65>>)
      #=> {:error, "A"}

  """
  @spec next(binary) :: {:ok, utf8, binary} | {:error, binary} | nil
  def next(""), do: nil
  def next(bytes), do: next_result(bytes, fz_bitstring_utf8_prefix(bytes))

  @spec next_result(binary, integer) :: {:ok, utf8, binary} | {:error, binary} | nil
  defp next_result(bytes, status) do
    if status > 0 do
      next_valid(bytes, status)
    else
      next_nonpositive(bytes, status)
    end
  end

  @spec next_nonpositive(binary, integer) :: {:error, binary} | nil
  defp next_nonpositive(_bytes, 0), do: nil
  defp next_nonpositive(bytes, status) do
    offset = 0 - status - 1
    <<_prefix :: binary-size(offset), rest :: binary>> = bytes
    {:error, rest}
  end

  @spec next_valid(binary, integer) :: {:ok, utf8, binary}
  defp next_valid(bytes, width) do
    <<codepoint :: binary-size(width), rest :: binary>> = bytes
    {:ok, fz_brand_bitstring_as_utf8(codepoint), rest}
  end

  @doc """
  Brands `bytes` as `utf8`, or aborts.

  Aborts if `bytes` is not valid UTF-8; see `from_bytes/1` for a version
  that returns an error instead.

  ## Examples

      Utf8.from_bytes!("hello")
      #=> "hello"

  """
  @spec from_bytes!(binary) :: utf8
  def from_bytes!(bytes) do
    assert(valid?(bytes))
    fz_brand_bitstring_as_utf8(bytes)
  end

  @doc """
  Brands `bytes` as `utf8`, or returns an error.

  Returns `{:ok, utf8}` if `bytes` is valid UTF-8, `{:error, :invalid_utf8}`
  otherwise.

  ## Examples

      Utf8.from_bytes("café")
      #=> {:ok, "café"}

      Utf8.from_bytes(<<255, 254>>)
      #=> {:error, :invalid_utf8}

  """
  @spec from_bytes(binary) :: {:ok, utf8} | {:error, :invalid_utf8}
  def from_bytes(bytes) do
    if valid?(bytes) do
      {:ok, fz_brand_bitstring_as_utf8(bytes)}
    else
      {:error, :invalid_utf8}
    end
  end

  @doc """
  Returns the plain binary underlying a `utf8` value, dropping the brand.

  ## Examples

      Utf8.to_bytes(Utf8.from_bytes!("hello"))
      #=> "hello"

  """
  @spec to_bytes(utf8) :: binary
  def to_bytes(s), do: s
end
