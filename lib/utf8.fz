defmodule Utf8 do
  @moduledoc """
  Validates and brands byte-aligned binaries as UTF-8.

  `utf8` is a brand on `binary`: the same bytes, tagged at the type level
  so a position declared `utf8` accepts only validated input and rejects a
  plain `binary`. `from_bytes!/1` and `from_bytes/1` mint that brand after
  checking `valid?/1`; `to_bytes/1` drops back to the plain binary.

  ## Examples

      Utf8.valid?("café")
      #=> true

      Utf8.from_bytes(<<255, 254>>)
      #=> {:error, :invalid_utf8}

  """

  extern "C" def fz_bitstring_valid_utf8(any) :: integer
  extern "C" def fz_brand_bitstring_as_utf8(any) :: any

  @doc """
  Returns whether `bytes` is byte-aligned, valid UTF-8.

  ## Examples

      Utf8.valid?("café")
      #=> true

      Utf8.valid?(<<255, 254>>)
      #=> false

  """
  @spec valid?(binary) :: boolean
  def valid?(bytes), do: fz_bitstring_valid_utf8(bytes) == 1

  @doc """
  Brands `bytes` as `utf8`, or aborts.

  Aborts if `bytes` is not valid UTF-8; see `from_bytes/1` for a version
  that returns an error instead.

  ## Examples

      Utf8.from_bytes!("hello")
      #=> "hello"

  """
  @spec from_bytes!(binary) :: utf8
  def from_bytes!(bytes) do
    assert(valid?(bytes))
    fz_brand_bitstring_as_utf8(bytes)
  end

  @doc """
  Brands `bytes` as `utf8`, or returns an error.

  Returns `{:ok, utf8}` if `bytes` is valid UTF-8, `{:error, :invalid_utf8}`
  otherwise.

  ## Examples

      Utf8.from_bytes("café")
      #=> {:ok, "café"}

      Utf8.from_bytes(<<255, 254>>)
      #=> {:error, :invalid_utf8}

  """
  @spec from_bytes(binary) :: {:ok, utf8} | {:error, :invalid_utf8}
  def from_bytes(bytes) do
    if valid?(bytes) do
      {:ok, fz_brand_bitstring_as_utf8(bytes)}
    else
      {:error, :invalid_utf8}
    end
  end

  @doc """
  Returns the plain binary underlying a `utf8` value, dropping the brand.

  ## Examples

      Utf8.to_bytes(Utf8.from_bytes!("hello"))
      #=> "hello"

  """
  @spec to_bytes(utf8) :: binary
  def to_bytes(s), do: s
end
