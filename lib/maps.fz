defmodule :maps do
  @moduledoc "The Erlang `:maps` functions, as OTP's maps.erl defines them."

  @doc """
  Returns the value stored for `key`. Raises `KeyError` when the key is
  absent and `BadMapError` when `map` is not a map.

  ## Examples

      :maps.get(:a, %{a: 1})
      #=> 1

  """
  @spec get(any, any) :: any
  def get(key, map) do
    case map do
      %{^key => value} -> value
      %{} -> __raise__(%KeyError{key: key, term: map}, {:badkey, key})
      other -> __raise__(%BadMapError{term: other}, {:badmap, other})
    end
  end

  @doc """
  Returns the value stored for `key`, or `default` when the key is absent.
  Raises `BadMapError` when `map` is not a map.

  ## Examples

      :maps.get(:b, %{a: 1}, 0)
      #=> 0

  """
  @spec get(any, any, any) :: any
  def get(key, map, default) do
    case map do
      %{^key => value} -> value
      %{} -> default
      other -> __raise__(%BadMapError{term: other}, {:badmap, other})
    end
  end

  @doc """
  Returns the map's entries as `{key, value}` pairs, in the map's iteration order.

  ## Examples

      :maps.to_list(%{"b" => 2, "a" => 1, "c" => 3})
      #=> [{"a", 1}, {"b", 2}, {"c", 3}]

  """
  @spec to_list(any) :: [{any, any}]
  def to_list(map) when is_map(map), do: fz_map_to_list(map)
  def to_list(map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  extern "fz" defp fz_map_to_list(map) :: any

  @doc """
  Returns the map's keys, in the map's iteration order.

  ## Examples

      :maps.keys(%{"b" => 2, "a" => 1, "c" => 3})
      #=> ["a", "b", "c"]

  """
  @spec keys(any) :: [any]
  def keys(map) when is_map(map), do: fz_map_keys(map)
  def keys(map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  extern "fz" defp fz_map_keys(map) :: any

  @doc """
  Returns the map's values, in the map's iteration order.

  ## Examples

      :maps.values(%{"b" => 2, "a" => 1, "c" => 3})
      #=> [1, 2, 3]

  """
  @spec values(any) :: [any]
  def values(map) when is_map(map), do: fz_map_values(map)
  def values(map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  extern "fz" defp fz_map_values(map) :: any

  @doc """
  Returns an iterator over the map's entries, in the map's iteration order.
  The iterator is the improper list `[0 | map]`: the number of entries gone
  past, and the map. `next/1` and `fold/3` walk it. Raises `BadMapError` when
  `map` is not a map.

  ## Examples

      :maps.iterator(%{"a" => 1})
      #=> [0 | %{"a" => 1}]

  """
  @spec iterator(any) :: any
  def iterator(map) when is_map(map), do: [0 | map]
  def iterator(map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  @doc """
  Returns the next entry of an iterator and the iterator after it, as
  `{key, value, iterator}`, or `:none` when the iterator has gone past every
  entry. The entries of a batch come with no call into the runtime: the
  iterator after an entry is the batch's next tuple. Raises `ArgumentError`
  when `iterator` is not an iterator.

  ## Examples

      :maps.next(:maps.iterator(%{"a" => 1}))
      #=> {"a", 1, :none}

      :maps.next(:none)
      #=> :none

  """
  @spec next(any) :: {any, any, any} | :none
  def next({key, value, iterator}), do: {key, value, iterator}

  def next([path | map]) when (is_integer(path) or is_list(path)) and is_map(map) do
    try do
      :erts_internal.map_next(path, map, :iterator)
    catch
      :error, :badarg -> :erlang.error(:badarg)
    end
  end

  def next(:none), do: :none
  def next(_iterator), do: :erlang.error(:badarg)

  @doc """
  Calls `fun.(key, value, acc)` for each entry of a map, or of an iterator,
  in iteration order, starting with `init` as `acc`, and returns the last
  `acc`. Raises `BadMapError` when the third argument is neither a map nor an
  iterator, and `ArgumentError` when `fun` is not a function of three
  arguments.

  ## Examples

      :maps.fold(fn _k, v, acc -> v + acc end, 0, %{"a" => 1, "b" => 2})
      #=> 3

  """
  @spec fold((any, any, a -> a), a, any) :: a when a: var
  def fold(fun, init, map) when is_map(map) and is_function(fun, 3), do: fold_1(fun, init, next(iterator(map)), :undefined)

  def fold(fun, init, iterator) when is_function(fun, 3) do
    error_tag = make_ref()

    try do
      fold_1(fun, init, try_next(iterator, error_tag), error_tag)
    catch
      :error, ^error_tag -> __raise__(%BadMapError{term: iterator}, {:badmap, iterator})
    end
  end

  def fold(_fun, _init, _map), do: :erlang.error(:badarg)

  @spec fold_1((any, any, a -> a), a, :none | {any, any, any}, any) :: a when a: var
  defp fold_1(fun, acc, {key, value, iterator}, error_tag),
    do: fold_1(fun, fun.(key, value, acc), try_next(iterator, error_tag), error_tag)

  defp fold_1(_fun, acc, :none, _error_tag), do: acc

  @spec try_next(any, any) :: {any, any, any} | :none
  defp try_next({_key, _value, _iterator} = entry, _error_tag), do: entry
  defp try_next(:none, _error_tag), do: :none
  defp try_next(iterator, :undefined), do: next(iterator)

  defp try_next(iterator, error_tag) do
    try do
      next(iterator)
    catch
      :error, :badarg -> :erlang.error(error_tag)
    end
  end

  @doc """
  Returns the map with `value` set for `key`, overwriting any existing entry.
  Raises `BadMapError` when `map` is not a map.

  ## Examples

      :maps.put("k", 2, %{"k" => 1, "j" => 0})
      #=> %{"j" => 0, "k" => 2}

  """
  @spec put(any, any, any) :: map
  def put(key, value, map) when is_map(map), do: fz_map_put(map, key, value)
  def put(_key, _value, map), do: __raise__(%BadMapError{term: map}, {:badmap, map})

  extern "fz" defp fz_map_put(map, stored_value, stored_value) :: map

  @doc """
  Merges `a` and `b` into one map. Where both have a key, `b`'s value wins.
  Raises `BadMapError` naming the first argument that is not a map.

  ## Examples

      :maps.merge(%{"a" => 1, "b" => 2}, %{"b" => 3, "c" => 4})
      #=> %{"a" => 1, "b" => 3, "c" => 4}

  """
  @spec merge(any, any) :: map
  def merge(a, b) when is_map(a) and is_map(b), do: from_list(to_list(a) ++ to_list(b))
  def merge(a, _b) when not is_map(a), do: __raise__(%BadMapError{term: a}, {:badmap, a})
  def merge(_a, b), do: __raise__(%BadMapError{term: b}, {:badmap, b})

  @doc """
  Builds a map from a list of `{key, value}` pairs. When a key repeats, the
  last pair wins.

  ## Examples

      :maps.from_list([{1, :a}, {2, :b}, {1, :c}])
      #=> %{1 => :c, 2 => :b}

  """
  @spec from_list([{any, any}]) :: map
  def from_list(pairs), do: build(pairs, [], [])

  # Splits the pair list into parallel key and value lists, which is what the
  # one-allocation builder takes.
  @spec build([{a, b}], [a], [b]) :: map when a: var, b: var
  defp build([], ks, vs), do: fz_map_from_kv(:lists.reverse(ks, []), :lists.reverse(vs, []))
  defp build([{k, v} | t], ks, vs), do: build(t, [k | ks], [v | vs])

  extern "fz" defp fz_map_from_kv(any, any) :: map
end
