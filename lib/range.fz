defmodule Range do
  @moduledoc """
  A range represents a sequence of integers from `first` to `last`,
  in steps of `step`.

  A range is a struct with three fields — `first`, `last`, and `step`
  — built with `Range.new/3`, or with the `first..last` and
  `first..last//step` syntax that desugars to it (`first..last` is
  short for a `step` of `1`). Ranges are inclusive of both `first` and
  `last`: `1..5` holds `1`, `2`, `3`, `4`, and `5`.

  Ranges implement the `Enumerable` protocol, so they work with every
  function in `Enum`:

      Enum.to_list(1..5)
      #=> [1, 2, 3, 4, 5]

      Enum.to_list(5..1//-1)
      #=> [5, 4, 3, 2, 1]

  The functions in this module beyond `new/3` are `Enumerable`
  callback bodies; they are reached through `Enum`, not called
  directly.
  """

  defstruct [:first, :last, :step]

  @type t :: %Range{first: integer, last: integer, step: integer}

  @doc """
  Creates a new range from `first` to `last`, in steps of `step`.

  This is the function `first..last` and `first..last//step` desugar
  to; `first..last` supplies `1` for `step`. A range is inclusive of
  both `first` and `last`. If `step`'s sign doesn't match the
  direction from `first` to `last`, the range holds no elements.

  ## Examples

      Range.new(1, 5, 1)
      #=> 1..5

      Range.new(1, 5, 2)
      #=> 1..5//2

  """
  @spec new(integer, integer, integer) :: t
  def new(first, last, step), do: %Range{first: first, last: last, step: step}

  @doc """
  Implements the `Enumerable.reduce/3` callback for ranges.

  This is protocol plumbing, not a function to call directly: it is
  reached through `Enum.reduce/2`, `Enum.reduce/3`, and every other
  `Enum` function that folds over a range, by way of `Enum.to_list/1`.
  """
  @spec reduce(integer, integer, integer, {:cont, b} | {:halt, b} | {:suspend, b}, (integer, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  def reduce(first, last, step, {:cont, :first}, reducer), do: reduce_start(first, last, step, first, :first, reducer)
  def reduce(first, last, step, {:cont, acc}, reducer), do: reduce_cont(first, last, step, first, acc, reducer)
  def reduce(_first, _last, _step, {:halt, acc}, _reducer), do: {:halted, acc}
  def reduce(first, last, step, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(first, last, step, first, acc, reducer) end)}
  end
  def reduce(_first, _last, _step, _command, _reducer), do: panic("Enumerable.ReduceProtocolError")

  @doc """
  Implements the `Enumerable.reduce_while/3` callback for ranges.

  This is protocol plumbing, not a function to call directly: it is
  reached through `Enum.reduce_while/3` and the `Enum` functions built
  on it, such as `Enum.take_while/2`, `Enum.all?/1`, and `Enum.find/2`.
  """
  @spec reduce_while(integer, integer, integer, b, (integer, b) -> {:cont, b} | {:halt, c}) :: b | c
  def reduce_while(first, last, step, acc, reducer), do: reduce_while_cont(first, last, step, first, acc, reducer)

  @doc """
  Implements the `Enumerable.count/1` callback for ranges.

  This is protocol plumbing, not a function to call directly: it is
  reached through `Enum.count/1`. Because a range's bounds are known
  up front, this returns the count directly instead of walking the
  range element by element.

  ## Examples

      Range.count(1, 5, 1)
      #=> 5

  """
  @spec count(integer, integer, integer) :: integer
  def count(first, last, step) do
    if done?(last, step, first) do
      0
    else
      # `div/2`, not `/`: a range's count is an integer, and `/` returns a
      # float. Written with `/` this silently made every range's count a
      # float and rippled a new type through everything Enumerable reaches.
      div(last - first, step) + 1
    end
  end

  @doc """
  Implements the `Enumerable.member?/2` callback for ranges.

  This is protocol plumbing, not a function to call directly: it is
  reached through `Enum.member?/2` and the `in` operator. Because a
  range's bounds and step are known up front, membership is decided
  by arithmetic rather than a search; a non-integer can never belong
  to a range of integers.

  ## Examples

      Range.member?(1, 10, 2, 5)
      #=> true

      Range.member?(1, 10, 2, 4)
      #=> false

  """
  @spec member?(integer, integer, integer, any) :: boolean
  # A range holds integers, so nothing else is in it. Without the fallthrough
  # the arithmetic below reached a float and aborted the process on the native
  # doors: `Enum.member?(1..5, 3.0)` is false, not a crash.
  def member?(first, last, step, value :: integer) do
    if done?(last, step, first) do
      false
    else
      if contains?(first, last, step, value) do
        ((value - first) % step) == 0
      else
        false
      end
    end
  end

  def member?(_first, _last, _step, _value), do: false

  @doc """
  Implements the slicing half of the `Enumerable.slice/1` callback for
  ranges: `Enumerable.slice/1` closes over `first`, `last`, and `step`
  and returns this function to be called with `start`, `amount`, and
  `stride`.

  This is protocol plumbing, not a function to call directly, and
  fz's `Enum` module does not yet have a function that reaches it.

  ## Examples

      Range.slice(1, 10, 1, 0, 3, 1)
      #=> [1, 2, 3]

  """
  @spec slice(integer, integer, integer, integer, integer, integer) :: [integer]
  def slice(first, last, step, start, amount, stride) do
    slice_from(last, step + stride - 1, first + (start * step), amount, [])
  end

  @spec reduce_start(integer, integer, integer, integer, b, (integer, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  defp reduce_start(first, last, step, current, acc, reducer) do
    if done?(last, step, current) do
      {:done, acc}
    else
      reduce_step(first, last, step, current, reducer.(current, acc), reducer)
    end
  end

  @spec reduce_cont(integer, integer, integer, integer, b | c, (integer, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  defp reduce_cont(first, last, step, current, acc, reducer) do
    if done?(last, step, current) do
      {:done, acc}
    else
      reduce_step(first, last, step, current, reducer.(current, acc), reducer)
    end
  end

  @spec reduce_step(integer, integer, integer, integer, {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}, (integer, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  defp reduce_step(first, last, step, current, {:cont, acc}, reducer), do: reduce_cont(first, last, step, current + step, acc, reducer)
  defp reduce_step(_first, _last, _step, _current, {:halt, acc}, _reducer), do: {:halted, acc}
  defp reduce_step(first, last, step, current, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(first, last, step, current + step, acc, reducer) end)}
  end
  defp reduce_step(_first, _last, _step, _current, _command, _reducer), do: panic("Enumerable.ReduceProtocolError")

  @spec reduce_while_cont(integer, integer, integer, integer, b, (integer, b) -> {:cont, b} | {:halt, c}) :: b | c
  defp reduce_while_cont(first, last, step, current, acc, reducer) do
    if done?(last, step, current) do
      acc
    else
      reduce_while_step(first, last, step, current, reducer.(current, acc), reducer)
    end
  end

  @spec reduce_while_step(integer, integer, integer, integer, {:cont, b} | {:halt, c}, (integer, b) -> {:cont, b} | {:halt, c}) :: b | c
  defp reduce_while_step(first, last, step, current, {:cont, acc}, reducer), do: reduce_while_cont(first, last, step, current + step, acc, reducer)
  defp reduce_while_step(_first, _last, _step, _current, {:halt, acc}, _reducer), do: acc

  @spec slice_from(integer, integer, integer, integer, [integer]) :: [integer]
  defp slice_from(_last, _step, _current, 0, acc), do: reverse(acc, [])
  defp slice_from(last, step, current, amount, acc) do
    if done?(last, step, current) do
      reverse(acc, [])
    else
      slice_from(last, step, current + step, amount - 1, [current | acc])
    end
  end

  @spec reverse([a], [b]) :: [a | b]
  defp reverse([], acc), do: acc
  defp reverse([head | tail], acc), do: reverse(tail, [head | acc])

  @spec done?(integer, integer, integer) :: boolean
  defp done?(last, step, current) when step > 0, do: current > last
  defp done?(last, _step, current), do: current < last

  @spec contains?(integer, integer, integer, integer) :: boolean
  defp contains?(first, last, step, value) when step > 0, do: value >= first and value <= last
  defp contains?(first, last, _step, value), do: value <= first and value >= last
end
