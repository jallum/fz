defmodule :erlang do
  @moduledoc "The Erlang functions Elixir programs reach by the atom `:erlang`."

  @doc """
  Returns the float in fixed notation with `decimals` digits after the point,
  `decimals` being an integer from 0 to 253. The digits are rounded from the
  float's exact value, and a tie goes away from zero.

  The options `[:short]` give the shortest text that reads back as the same
  float, as `Float.to_string/1` does.

  Any other option raises `FunctionClauseError`.

  ## Examples

      :erlang.float_to_binary(2.675, decimals: 1)
      #=> "2.7"

      :erlang.float_to_binary(1.0e10, decimals: 0)
      #=> "10000000000"

      :erlang.float_to_binary(1.5e-10, [:short])
      #=> "1.5e-10"

  """
  @spec float_to_binary(float, [{:decimals, integer}] | [:short]) :: binary
  def float_to_binary(f, options) when is_float(f) and is_float_format(options), raises: ArgumentError, reason: :badarg,
    do: formatted_float(f, options)

  @spec is_float_format(any) :: boolean
  defp is_float_format([:short]), do: true
  defp is_float_format([decimals: n]), do: is_integer(n) and n >= 0 and n <= 253
  defp is_float_format(_), do: false

  @spec formatted_float(float, [{:decimals, integer}] | [:short]) :: binary
  defp formatted_float(f, [decimals: n]), do: fz_float_to_fixed_binary(f, n)
  defp formatted_float(f, [:short]), do: Float.to_string(f)

  extern "fz" defp fz_float_to_fixed_binary(float, integer) :: binary

  @doc """
  Raises `reason` with the kind `:error`, as `panic/1` does, after
  `Exception.__normalize__/1` has made an exception of it: an Erlang reason
  such as `:badarg` or `{:badmatch, term}` is the exception that names it,
  and any other value is an `ErlangError` whose `original` is that value. A
  `rescue` sees that exception; a `catch :error, value` sees `reason`.

  ## Examples

      try do
        :erlang.error(:boom)
      rescue
        e in ErlangError -> e.original
      end
      #=> :boom

  """
  @spec error(any) :: no_return()
  def error(reason), do: __raise__(Exception.__normalize__(reason), reason)

  @doc """
  Raises `reason` as `error/1` does. `args` is the argument list of the
  failed call, or `:none`, and `options` may carry `error_info:`, which tells
  Erlang's error formatter how to describe the call; neither changes what a
  `rescue` or a `catch` sees, because fz carries no stacktraces.

  ## Examples

      try do
        :erlang.error(:boom, :none, error_info: %{module: :erl_stdlib_errors})
      rescue
        e in ErlangError -> e.original
      end
      #=> :boom

  """
  @spec error(any, :none | [any], [any]) :: no_return()
  def error(reason, _args, _options), do: error(reason)

  @doc """
  Raises again what a `catch kind, reason` clause caught, with the same
  kind: `:error`, `:throw` or `:exit`. The stacktrace is accepted for
  Erlang's sake and ignored: fz carries no stacktraces.

  ## Examples

      try do
        throw(:ball)
      catch
        kind, reason -> :erlang.raise(kind, reason, __STACKTRACE__)
      end
      # ** (throw) :ball

  """
  @spec raise(:error | :throw | :exit, any, any) :: no_return()
  def raise(:error, reason, _stacktrace), do: __raise__(Exception.__normalize__(reason), reason)
  def raise(:throw, value, _stacktrace), do: throw(value)
  def raise(:exit, reason, _stacktrace), do: exit(reason)

  @doc """
  Returns an integer no other call in this run of the program returns. It is
  drawn from the counter `make_ref/0` draws from.

  ## Examples

      :erlang.unique_integer() == :erlang.unique_integer()
      #=> false

  """
  @spec unique_integer() :: integer
  def unique_integer(), do: fz_unique_integer()

  extern "C" defp fz_unique_integer() :: integer

  @doc """
  Returns a copy of `tuple` with the element at the one-based `index`
  replaced by `value`. `tuple` itself is unchanged.

  Raises `ArgumentError` when `index` is not an integer, is outside the
  tuple, or `tuple` is not a tuple; the message lists every argument at fault.

  ## Examples

      :erlang.setelement(2, {:a, :b, :c}, :z)
      #=> {:a, :z, :c}

  """
  @spec setelement(any, any, any) :: tuple
  def setelement(index, tuple, value) when is_integer(index) and is_tuple(tuple) and index >= 1 and index <= tuple_size(tuple),
    raises: ArgumentError, reason: :badarg,
    do: fz_tuple_put(tuple, index - 1, value)

  extern "fz" defp fz_tuple_put(any, integer, any) :: any

  @spec list_to_tuple(any) :: tuple
  def list_to_tuple(list), do: fz_list_to_tuple(list, length(list))

  extern "fz" defp fz_list_to_tuple(any, integer) :: any

  @doc """
  Returns the `index`th element of `tuple`, counting from 1.

  Raises `ArgumentError` for an index below 1 or above the tuple's size, and
  for an index that is not an integer or a tuple that is not a tuple.

  ## Examples

      :erlang.element(2, {10, 20, 30})
      #=> 20

  """
  @spec element(integer, tuple) :: any
  def element(index, tuple) when is_integer(index) and is_tuple(tuple) and index >= 1 and index <= tuple_size(tuple),
    raises: ArgumentError, reason: :badarg,
    do: elem(tuple, index - 1)

  @doc """
  Returns the `length` bytes of `binary` that start at byte `start`. A
  negative `length` takes the bytes that end at `start`, so
  `binary_part(b, 3, -2)` is `binary_part(b, 1, 2)`.

  Raises `ArgumentError` when the part is not inside `binary`, or an argument
  is of the wrong type.

  ## Examples

      :erlang.binary_part("abcd", 1, 2)
      #=> "bc"

      :erlang.binary_part("abcd", 3, -2)
      #=> "bc"

  """
  @spec binary_part(binary, integer, integer) :: binary
  def binary_part(binary, start, length)
      when is_binary(binary) and is_integer(start) and is_integer(length) and start >= 0 and start <= byte_size(binary) and
             length >= -start and length <= byte_size(binary) - start,
      raises: ArgumentError, reason: :badarg,
      do: fz_binary_part(binary, min(start, start + length), abs(length))

  extern "fz" defp fz_binary_part(bitstring, integer, integer) :: bitstring

  @doc """
  Returns the bytes of `iolist` as one binary. An `iolist` is a list whose
  elements are bytes (integers from 0 to 255), binaries and lists of the
  same, and whose tail may be a binary.

  Raises `ArgumentError` for anything else, a bitstring that is not a binary
  included.

  ## Examples

      :erlang.iolist_to_binary([?a, "bc", [100, 101]])
      #=> "abcde"

  """
  @spec iolist_to_binary(iodata) :: binary
  def iolist_to_binary(iodata) when is_binary(iodata), do: iodata
  def iolist_to_binary(iodata), do: iodata_bytes(iodata, "")

  @spec iodata_bytes(any, binary) :: binary
  defp iodata_bytes([], bytes), do: bytes
  defp iodata_bytes([byte | rest], bytes) when is_integer(byte) and byte >= 0 and byte <= 255, do: iodata_bytes(rest, bytes <> <<byte>>)
  defp iodata_bytes([chunk | rest], bytes) when is_binary(chunk), do: iodata_bytes(rest, bytes <> chunk)
  defp iodata_bytes([nested | rest], bytes) when is_list(nested), do: iodata_bytes(rest, iodata_bytes(nested, bytes))
  defp iodata_bytes(tail, bytes) when is_binary(tail), do: bytes <> tail
  defp iodata_bytes(_, _bytes), do: Kernel.__badarg__("not an iodata term")

  @doc """
  Returns the number of bytes `iolist_to_binary/1` would return for
  `iodata`, and raises `ArgumentError` for what it raises for.

  ## Examples

      :erlang.iolist_size([?a, "bc", [100, 101]])
      #=> 5

  """
  @spec iolist_size(iodata) :: integer
  def iolist_size(iodata), do: byte_size(iolist_to_binary(iodata))

  @doc """
  Returns `n` as text in base 10, with a `-` before a negative `n`.

  Raises `ArgumentError` when `n` is not an integer.

  ## Examples

      :erlang.integer_to_binary(255)
      #=> "255"

      :erlang.integer_to_binary(-5)
      #=> "-5"

  """
  @spec integer_to_binary(integer) :: binary
  def integer_to_binary(n), do: integer_to_binary(n, 10)

  @doc """
  Returns `n` as text in `base`, a number from 2 to 36, with the digits above
  9 in capital letters and a `-` before a negative `n`.

  ## Examples

      :erlang.integer_to_binary(255, 16)
      #=> "FF"

      :erlang.integer_to_binary(-5, 2)
      #=> "-101"

  """
  @spec integer_to_binary(integer, integer) :: binary
  def integer_to_binary(n, base) when is_integer(n) and is_radix(base), raises: ArgumentError, reason: :badarg, do: signed_digits(n, base)

  @spec is_radix(any) :: boolean
  defp is_radix(base), do: is_integer(base) and base >= 2 and base <= 36

  @spec signed_digits(integer, integer) :: binary
  defp signed_digits(n, base) when n < 0, do: "-" <> digits(n, base, "")
  defp signed_digits(n, base), do: digits(-n, base, "")

  # `n` is never positive: the most negative integer has no positive
  # counterpart, so every `n` is taken apart on the negative side.
  @spec digits(integer, integer, binary) :: binary
  defp digits(n, base, text) do
    digit = -rem(n, base)
    char = if digit < 10, do: ?0 + digit, else: ?A + digit - 10
    quotient = div(n, base)
    if quotient == 0, do: <<char>> <> text, else: digits(quotient, base, <<char>> <> text)
  end

  @doc """
  Returns the name of `atom` as a binary in `encoding`: `:utf8` and
  `:unicode` give its UTF-8 bytes, `:latin1` gives one byte per character.

  Raises `ArgumentError` when `atom` is not an atom, when `encoding` is not
  one of the three, and for `:latin1` when a character is above 255.

  ## Examples

      :erlang.atom_to_binary(:foo, :utf8)
      #=> "foo"

      :erlang.atom_to_binary(:é, :latin1)
      #=> <<233>>

  """
  @spec atom_to_binary(atom, :utf8 | :unicode | :latin1) :: binary
  def atom_to_binary(atom, encoding) when is_atom(atom) and is_encoding(encoding), raises: ArgumentError, reason: :badarg,
    do: encoded_name(atom, encoding)

  @spec is_encoding(any) :: boolean
  defp is_encoding(encoding), do: encoding == :utf8 or encoding == :unicode or encoding == :latin1

  @spec encoded_name(atom, atom) :: binary
  defp encoded_name(atom, :latin1), do: latin1_bytes(Atom.to_string(atom), "")
  defp encoded_name(atom, _utf8), do: Atom.to_string(atom)

  @spec latin1_bytes(binary, binary) :: binary
  defp latin1_bytes(<<>>, bytes), do: bytes
  defp latin1_bytes(<<c :: utf8, rest :: binary>>, bytes) when c <= 255, do: latin1_bytes(rest, bytes <> <<c>>)
  defp latin1_bytes(_, _bytes), do: Kernel.__badarg__("contains a character not expressible in latin1")

  @doc """
  Returns whether `map` has `key`. Raises `BadMapError` when `map` is not a
  map.

  ## Examples

      :erlang.is_map_key(:a, %{a: 1})
      #=> true

  """
  @spec is_map_key(any, any) :: boolean
  def is_map_key(key, map), do: Map.has_key?(map, key)

  @doc """
  Returns the float `text` spells: an optional sign, digits, a decimal point,
  digits and an optional exponent. The decimal point is required, so `"1"` and
  `"1e3"` raise `ArgumentError` where `"1.0"` and `"1.0e3"` succeed.

  ## Examples

      :erlang.binary_to_float("2.5")
      #=> 2.5

      :erlang.binary_to_float("-1.5e-2")
      #=> -0.015

  """
  @spec binary_to_float(binary) :: float
  def binary_to_float(text) when is_binary(text), raises: ArgumentError, reason: :badarg,
    do: whole_float(Float.parse(text), String.contains?(text, "."))

  # `Float.parse` takes a `.` only when a digit follows it, so once it has
  # consumed the whole text, any `.` in that text is its decimal point.
  @spec whole_float({float, binary} | :error, boolean) :: float
  defp whole_float({float, ""}, true), do: float
  defp whole_float(_partial, _point), do: Kernel.__badarg__("not a textual representation of a float")

  @doc """
  Returns the integer `text` spells in base 10: an optional `-` or `+` and one
  or more digits. Anything else raises `ArgumentError`.

  ## Examples

      :erlang.binary_to_integer("42")
      #=> 42

      :erlang.binary_to_integer("-7")
      #=> -7

  """
  @spec binary_to_integer(binary) :: integer
  def binary_to_integer(text) when is_binary(text), raises: ArgumentError, reason: :badarg, do: whole_integer(Integer.parse(text))

  @spec whole_integer({integer, binary} | :error) :: integer
  defp whole_integer({n, ""}), do: n
  defp whole_integer(_partial), do: Kernel.__badarg__("not a textual representation of an integer")

  @spec arithmetic_error() :: no_return()
  defp arithmetic_error(), do: __raise__(%ArithmeticError{message: "bad argument in arithmetic expression"}, :badarith)

  @doc """
  Returns the bitwise NOT of `expr`.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.bnot(2)
      #=> -3

  """
  @spec bnot(integer) :: integer
  def bnot(expr) when is_integer(expr), do: fz_op_bnot_i(expr)
  def bnot(_), do: arithmetic_error()

  extern "C" defp fz_op_bnot_i(integer) :: integer

  @doc """
  Returns the bitwise AND of `left` and `right`.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.band(9, 3)
      #=> 1

  """
  @spec band(integer, integer) :: integer
  def band(left, right) when is_integer(left) and is_integer(right), do: fz_op_band_ii(left, right)
  def band(_, _), do: arithmetic_error()

  extern "C" defp fz_op_band_ii(integer, integer) :: integer

  @doc """
  Returns the bitwise OR of `left` and `right`.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.bor(9, 3)
      #=> 11

  """
  @spec bor(integer, integer) :: integer
  def bor(left, right) when is_integer(left) and is_integer(right), do: fz_op_bor_ii(left, right)
  def bor(_, _), do: arithmetic_error()

  extern "C" defp fz_op_bor_ii(integer, integer) :: integer

  @doc """
  Returns the bitwise XOR of `left` and `right`.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.bxor(9, 3)
      #=> 10

  """
  @spec bxor(integer, integer) :: integer
  def bxor(left, right) when is_integer(left) and is_integer(right), do: fz_op_bxor_ii(left, right)
  def bxor(_, _), do: arithmetic_error()

  extern "C" defp fz_op_bxor_ii(integer, integer) :: integer

  @doc """
  Returns `left` shifted left by `right` bits; a negative `right` shifts right.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.bsl(1, 2)
      #=> 4

      :erlang.bsl(1, -2)
      #=> 0

  """
  @spec bsl(integer, integer) :: integer
  def bsl(left, right) when is_integer(left) and is_integer(right), do: fz_op_bsl_ii(left, right)
  def bsl(_, _), do: arithmetic_error()

  extern "C" defp fz_op_bsl_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Returns `left` shifted right by `right` bits, keeping the sign; a negative `right` shifts left.

  Raises `ArithmeticError` when an operand is not an integer. A guard may call it.

  ## Examples

      :erlang.bsr(1, 2)
      #=> 0

      :erlang.bsr(1, -2)
      #=> 4

  """
  @spec bsr(integer, integer) :: integer
  def bsr(left, right) when is_integer(left) and is_integer(right), do: fz_op_bsr_ii(left, right)
  def bsr(_, _), do: arithmetic_error()

  extern "C" defp fz_op_bsr_ii(integer, integer) :: integer,
    raises: ArithmeticError,
    reason: :badarith,
    message: "bad argument in arithmetic expression"

  @doc """
  Boolean negation; any operand but a boolean raises `ArgumentError`.

  ## Examples

      :erlang.not(true)
      #=> false

  """
  def not(value) when is_boolean(value), do: Kernel.not(value)
  def not(_value), do: raise(%ArgumentError{message: "argument error"})

  @doc """
  Boolean conjunction. Both operands are evaluated, and both must be booleans,
  or `ArgumentError` is raised.

  ## Examples

      :erlang.and(true, false)
      #=> false

  """
  def left and right when is_boolean(left) and is_boolean(right), do: Kernel.and(left, right)
  def _left and _right, do: raise(%ArgumentError{message: "argument error"})

  @doc """
  Boolean disjunction. Both operands are evaluated, and both must be booleans,
  or `ArgumentError` is raised.

  ## Examples

      :erlang.or(false, true)
      #=> true

  """
  def left or right when is_boolean(left) and is_boolean(right), do: Kernel.or(left, right)
  def _left or _right, do: raise(%ArgumentError{message: "argument error"})
end
