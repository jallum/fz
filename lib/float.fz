defmodule Float do
  @moduledoc "Functions for working with floats."

  # Not the rendering `dbg` uses. `inspect/1` writes a whole float below 1.0e16
  # out in full, as `1000000000000000.0`, where this gives whichever notation is
  # shorter, `1.0e15`. Elixir draws the same distinction, so the runtime carries
  # both renderings and neither is a rounding of the other.
  @doc """
  Returns the float's shortest textual representation as a binary.

  This picks whichever of standard or scientific notation is shorter. That is
  not the rendering `dbg/1` and `inspect/1` use: `inspect/1` writes any float
  below 1.0e16 out in full, so the two can disagree on the same value without
  either being a rounding of the other.

  ## Examples

      Float.to_string(3.14)
      #=> "3.14"

      Float.to_string(1000000000000000.0)
      #=> "1.0e15"

  """
  @spec to_string(float) :: binary
  def to_string(f), do: fz_float_to_binary(f)

  extern "fz" defp fz_float_to_binary(float) :: binary

  @doc """
  Parses the float at the start of a binary and returns it with the text that
  follows, or `:error` when the binary does not start with one.

  A float is an optional `+` or `-`, one or more digits, an optional fraction
  (a `.` and one or more digits) and an optional exponent (`e` or `E`, an
  optional sign and one or more digits). A `.` or `e` that lacks its digits is
  left in the rest, so `"1."` gives `{1.0, "."}`, and `".5"` gives `:error`.
  The result is the float nearest the text, and a value too large for a float
  is `:error`.

  Integers are floats here (`"3"` gives `{3.0, ""}`), and `String.to_float/1`
  is a different, stricter function.

  ## Examples

      Float.parse("2.5kg")
      #=> {2.5, "kg"}

      Float.parse("1e3")
      #=> {1000.0, ""}

      Float.parse("abc")
      #=> :error

  """
  @spec parse(binary) :: {float, binary} | :error
  def parse(s), do: parsed(fz_float_parse(s))

  @spec parsed(any) :: {float, binary} | :error
  defp parsed([float, rest]), do: {float, rest}
  defp parsed(_none), do: :error

  extern "fz" defp fz_float_parse(binary) :: any
end
