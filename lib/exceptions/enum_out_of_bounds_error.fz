defmodule Enum.OutOfBoundsError do
  defexception [:enumerable, :index, :message]

  def message(%{message: nil, index: index, enumerable: enumerable}),
    do: "out of bounds error" <> position(index) <> traversing(enumerable)

  def message(%{message: message}), do: message

  @spec position(any) :: binary
  defp position(nil), do: ""
  defp position(index), do: " at position #{index}"

  @spec traversing(any) :: binary
  defp traversing(nil), do: ""
  defp traversing(enumerable), do: " when traversing enumerable " <> inspect(enumerable)
end
