defmodule Enum do
  @spec reduce(Enumerable.t(a), (a, a) -> a) :: a
  fn reduce(enumerable, reducer) do
    reduce_first_finish(
      Enumerable.reduce(enumerable, {:cont, :first}, fn (entry, state) ->
        reduce_first_step(entry, state, reducer)
      end)
    )
  end

  @spec reduce(Enumerable.t(a), b, (a, b) -> b) :: b
  fn reduce(enumerable, acc, reducer) do
    reduce_finish(
      Enumerable.reduce(enumerable, {:cont, acc}, fn (entry, inner_acc) ->
        {:cont, reducer.(entry, inner_acc)}
      end)
    )
  end

  @spec reduce_while(Enumerable.t(a), b, (a, b) -> {:cont, b} | {:halt, c}) :: b | c
  fn reduce_while(enumerable, acc, reducer) do
    Enumerable.reduce_while(enumerable, acc, reducer)
  end

  @spec each(Enumerable.t(a), (a) -> any) :: :ok
  fn each(enumerable, fun) do
    reduce(enumerable, nil, fn (entry, acc) -> each_step(entry, acc, fun) end)

    :ok
  end

  @spec count(Enumerable.t(a)) :: integer
  fn count(enumerable), do: count_result(Enumerable.count(enumerable), enumerable)

  @spec count(Enumerable.t(a), (a) -> any) :: integer
  fn count(enumerable, fun) do
    reduce(enumerable, 0, fn (entry, acc) ->
      if fun.(entry), do: acc + 1, else: acc
    end)
  end

  @spec member?(Enumerable.t(a), a) :: bool
  fn member?(enumerable, value), do: member_result(Enumerable.member?(enumerable, value), enumerable, value)

  @doc "Returns a list. A list is already one, so it is returned unchanged; any other enumerable is reduced onto a list and reversed back into order."
  @spec to_list(Enumerable.t(a)) :: [a]
  fn to_list(list :: [a]), do: list
  fn to_list(enumerable), do: reverse(reverse(enumerable))

  @spec reverse(Enumerable.t(a)) :: [a]
  fn reverse(enumerable), do: reduce(enumerable, [], fn (entry, acc) -> [entry | acc] end)

  @spec reverse(Enumerable.t(a), [a]) :: [a]
  fn reverse(enumerable, tail), do: reduce(enumerable, to_list(tail), fn (entry, acc) -> [entry | acc] end)

  @spec map(Enumerable.t(a), (a) -> b) :: [b]
  fn map(enumerable, fun), do: map_list(to_list(enumerable), fun)

  @spec filter(Enumerable.t(a), (a) -> any) :: [a]
  fn filter(enumerable, fun), do: filter_list(to_list(enumerable), fun)

  @spec reject(Enumerable.t(a), (a) -> any) :: [a]
  fn reject(enumerable, fun), do: filter(enumerable, fn (entry) -> not fun.(entry) end)

  @spec flat_map(Enumerable.t(a), (a) -> Enumerable.t(b)) :: [b]
  fn flat_map(enumerable, fun), do: flat_map_list(to_list(enumerable), fun)

  @spec map_reduce(Enumerable.t(a), b, (a, b) -> {c, b}) :: {[c], b}
  fn map_reduce(enumerable, acc, fun), do: map_reduce_list(to_list(enumerable), acc, fun)

  @spec scan(Enumerable.t(a), (a, a) -> a) :: [a]
  fn scan(enumerable, fun), do: scan_first(to_list(enumerable), fun)

  @spec scan(Enumerable.t(a), b, (a, b) -> b) :: [b]
  fn scan(enumerable, acc, fun), do: scan_list(to_list(enumerable), acc, fun)

  @spec intersperse(Enumerable.t(a), a) :: [a]
  fn intersperse(enumerable, separator), do: intersperse_list(to_list(enumerable), separator)

  @spec with_index(Enumerable.t(a)) :: [{a, integer}]
  fn with_index(enumerable), do: with_index(enumerable, 0)

  @spec with_index(Enumerable.t(a), integer) :: [{a, integer}]
  @spec with_index(Enumerable.t(a), (a, integer) -> b) :: [b]
  fn with_index(enumerable, offset :: integer), do: with_index_list(to_list(enumerable), offset)
  fn with_index(enumerable, fun), do: with_index_list(to_list(enumerable), 0, fun)

  @spec map_every(Enumerable.t(a), integer, (a) -> a) :: [a]
  fn map_every(enumerable, 0, _fun), do: to_list(enumerable)
  fn map_every(_enumerable, nth, _fun) when nth < 0, do: panic("Enum.OutOfBoundsError")
  fn map_every(enumerable, nth, fun), do: map_every_list(to_list(enumerable), nth, 0, fun)

  @spec map_join(Enumerable.t(a), (a) -> binary) :: binary
  fn map_join(enumerable, mapper), do: map_join(enumerable, "", mapper)

  @spec map_join(Enumerable.t(a), binary, (a) -> binary) :: binary
  fn map_join(enumerable, joiner, mapper), do: map_join_list(to_list(enumerable), joiner, mapper)

  @spec map_intersperse(Enumerable.t(a), b, (a) -> b) :: [b]
  fn map_intersperse(enumerable, separator, mapper), do: map_intersperse_list(to_list(enumerable), separator, mapper)

  @spec all?(Enumerable.t(a)) :: bool
  fn all?(enumerable), do: reduce_while(enumerable, true, fn (entry, _acc) -> all_value_step(entry) end)

  @spec all?(Enumerable.t(a), (a) -> any) :: bool
  fn all?(enumerable, fun), do: reduce_while(enumerable, true, fn (entry, _acc) -> all_value_step(fun.(entry)) end)

  @spec any?(Enumerable.t(a)) :: bool
  fn any?(enumerable), do: reduce_while(enumerable, false, fn (entry, _acc) -> any_value_step(entry) end)

  @spec any?(Enumerable.t(a), (a) -> any) :: bool
  fn any?(enumerable, fun), do: reduce_while(enumerable, false, fn (entry, _acc) -> any_value_step(fun.(entry)) end)

  @spec empty?(Enumerable.t(a)) :: bool
  fn empty?(enumerable), do: reduce_while(enumerable, true, fn (_entry, _acc) -> {:halt, false} end)

  @spec find(Enumerable.t(a), (a) -> any) :: a | nil
  fn find(enumerable, fun), do: find(enumerable, nil, fun)

  @spec find(Enumerable.t(a), b, (a) -> any) :: a | b
  fn find(enumerable, default, fun) do
    reduce_while(enumerable, default, fn (entry, _acc) ->
      if fun.(entry), do: {:halt, entry}, else: {:cont, default}
    end)
  end

  @spec find_index(Enumerable.t(a), (a) -> any) :: integer | nil
  fn find_index(enumerable, fun) do
    find_index_finish(
      reduce_while(enumerable, {:not_found, 0}, fn (entry, state) ->
        find_index_step(fun.(entry), state)
      end)
    )
  end

  @spec find_value(Enumerable.t(a), (a) -> b) :: b | nil
  fn find_value(enumerable, fun), do: find_value(enumerable, nil, fun)

  @spec find_value(Enumerable.t(a), b, (a) -> c) :: b | c
  fn find_value(enumerable, default, fun) do
    reduce_while(enumerable, default, fn (entry, _acc) ->
      find_value_step(fun.(entry), default)
    end)
  end

  @spec take(Enumerable.t(a), integer) :: [a]
  fn take(_enumerable, 0), do: []
  fn take(enumerable, amount) when amount > 0, do: take_positive(enumerable, amount)
  fn take(enumerable, amount), do: drop_positive(enumerable, normalized_prefix_count(enumerable, amount))

  @spec take_while(Enumerable.t(a), (a) -> any) :: [a]
  fn take_while(enumerable, fun) do
    reverse_list(
      reduce_while(enumerable, [], fn (entry, acc) ->
        if fun.(entry), do: {:cont, [entry | acc]}, else: {:halt, acc}
      end)
    )
  end

  @spec take_every(Enumerable.t(a), integer) :: [a]
  fn take_every(_enumerable, 0), do: []
  fn take_every(enumerable, 1), do: to_list(enumerable)
  fn take_every(_enumerable, nth) when nth < 0, do: panic("Enum.OutOfBoundsError")
  fn take_every(enumerable, nth) do
    take_every_finish(
      reduce_while(enumerable, {[], 0}, fn (entry, {acc, countdown}) ->
        {:cont, if countdown == 0, do: {[entry | acc], nth - 1}, else: {acc, countdown - 1}}
      end)
    )
  end

  @spec drop(Enumerable.t(a), integer) :: [a]
  fn drop(enumerable, 0), do: to_list(enumerable)
  fn drop(enumerable, amount) when amount > 0, do: drop_positive(enumerable, amount)
  fn drop(enumerable, amount), do: take_positive(enumerable, normalized_prefix_count(enumerable, amount))

  @spec drop_while(Enumerable.t(a), (a) -> any) :: [a]
  fn drop_while(enumerable, fun) do
    drop_while_finish(
      reduce_while(enumerable, {[], true}, fn (entry, {acc, dropping}) ->
        {:cont,
         if dropping do
           if fun.(entry), do: {acc, true}, else: {[entry | acc], false}
         else
           {[entry | acc], false}
         end}
      end)
    )
  end

  @spec drop_every(Enumerable.t(a), integer) :: [a]
  fn drop_every(_enumerable, 1), do: []
  fn drop_every(enumerable, 0), do: to_list(enumerable)
  fn drop_every(_enumerable, nth) when nth < 0, do: panic("Enum.OutOfBoundsError")
  fn drop_every(enumerable, nth) do
    drop_every_finish(
      reduce_while(enumerable, {[], 0}, fn (entry, {acc, countdown}) ->
        {:cont, if countdown == 0, do: {acc, nth - 1}, else: {[entry | acc], countdown - 1}}
      end)
    )
  end

  @spec split(Enumerable.t(a), integer) :: {[a], [a]}
  fn split(enumerable, count) when count >= 0, do: split_positive(enumerable, count)
  fn split(enumerable, count), do: split_positive(enumerable, normalized_prefix_count(enumerable, count))

  @spec split_while(Enumerable.t(a), (a) -> any) :: {[a], [a]}
  fn split_while(enumerable, fun) do
    split_pair_finish(
      reduce_while(enumerable, {[], []}, fn (entry, {left, right}) ->
        {:cont,
         if right == [] do
           if fun.(entry), do: {[entry | left], []}, else: {left, [entry]}
         else
           {left, [entry | right]}
         end}
      end)
    )
  end

  @spec split_with(Enumerable.t(a), (a) -> any) :: {[a], [a]}
  fn split_with(enumerable, fun) do
    split_pair_finish(
      reduce_while(enumerable, {[], []}, fn (entry, {left, right}) ->
        {:cont, if fun.(entry), do: {[entry | left], right}, else: {left, [entry | right]}}
      end)
    )
  end

  # The default sort is Erlang's total term order, not `<=`. `<=` is declared
  # only for the operand pairs fz can prove, so `Enum.sort/1` over a mixed
  # list could not even be written in terms of it; `Kernel.compare/2` is the
  # entry point that orders anything against anything.
  #
  # A typed clause family rather than one `compare/2` call, because
  # `compare/2` takes `any` and marshalling an unboxed integer as `any` boxes
  # it: routing every comparison through it cost 54 extra scalar boxes on an
  # eleven-element sort. The numeric clauses keep the inline compare the
  # operators already have; only the pairs `<=` cannot express reach the
  # comparator.
  fnp default_order(left :: integer, right :: integer), do: left <= right
  fnp default_order(left :: float, right :: float), do: left <= right
  fnp default_order(left, right), do: Kernel.compare(left, right) <= 0

  @spec sort(Enumerable.t(a)) :: [a]
  fn sort(enumerable), do: sort(enumerable, fn (left, right) -> default_order(left, right) end)

  @spec sort(Enumerable.t(a), (a, a) -> bool) :: [a]
  fn sort(enumerable, sorter), do: sort_list(enumerable, sorter)

  @spec slice(Enumerable.t(a)) :: {:ok, integer, any} | {:error, any}
  fn slice(_enumerable), do: {:error, :unsupported}

  @spec reduce_finish({:done, a} | {:halted, a} | {:suspended, a, () -> any}) :: a
  fnp reduce_finish({:done, acc}), do: acc
  fnp reduce_finish({:halted, acc}), do: acc
  fnp reduce_finish({:suspended, acc, _continuation}), do: acc

  @spec reduce_first_step(a, :first | {:acc, a}, (a, a) -> a) :: {:cont, {:acc, a}}
  fnp reduce_first_step(entry, :first, _reducer), do: {:cont, {:acc, entry}}
  fnp reduce_first_step(entry, {:acc, acc}, reducer), do: {:cont, {:acc, reducer.(entry, acc)}}
  fnp reduce_first_step(_entry, _state, _reducer), do: panic("Enum.ReduceStateError")

  @spec reduce_first_finish({:done, :first | {:acc, a}} | {:halted, :first | {:acc, a}} | {:suspended, :first | {:acc, a}, () -> any}) :: a
  fnp reduce_first_finish({:done, state}), do: reduce_first_acc(state)
  fnp reduce_first_finish({:halted, state}), do: reduce_first_acc(state)
  fnp reduce_first_finish({:suspended, state, _continuation}), do: reduce_first_acc(state)
  fnp reduce_first_finish(_result), do: panic("Enum.ReduceStateError")
  @spec reduce_first_acc(:first | {:acc, a}) :: a
  fnp reduce_first_acc(:first), do: panic("Enum.EmptyError")
  fnp reduce_first_acc({:acc, acc}), do: acc
  fnp reduce_first_acc(_state), do: panic("Enum.ReduceStateError")

  fnp each_step(entry, acc, fun) do
    fun.(entry)
    acc
  end

  @spec count_result({:ok, integer} | {:error, any}, Enumerable.t(a)) :: integer
  fnp count_result({:ok, count}, _enumerable), do: count
  fnp count_result({:error, _module}, enumerable), do: count(enumerable, fn (_entry) -> true end)
  @spec member_result({:ok, bool} | {:error, any}, Enumerable.t(a), a) :: bool
  fnp member_result({:ok, found}, _enumerable, _value), do: found
  fnp member_result({:error, _module}, enumerable, value) do
    reduce_while(enumerable, false, fn (entry, _found) ->
      if entry === value do
        {:halt, true}
      else
        {:cont, false}
      end
    end)
  end

  fnp map_list([], _fun), do: []
  fnp map_list([head | tail], fun), do: [fun.(head) | map_list(tail, fun)]

  fnp filter_list([], _fun), do: []
  fnp filter_list([head | tail], fun) do
    if fun.(head) do
      [head | filter_list(tail, fun)]
    else
      filter_list(tail, fun)
    end
  end

  fnp flat_map_list([], _fun), do: []
  fnp flat_map_list([head | tail], fun) do
    concat_list(to_list(fun.(head)), flat_map_list(tail, fun))
  end

  fnp concat_list([], right), do: right
  fnp concat_list([head | tail], right), do: [head | concat_list(tail, right)]

  fnp map_reduce_list([], acc, _fun), do: {[], acc}
  fnp map_reduce_list([head | tail], acc, fun) do
    {mapped, next_acc} = fun.(head, acc)
    {mapped_tail, final_acc} = map_reduce_list(tail, next_acc, fun)
    {[mapped | mapped_tail], final_acc}
  end

  fnp scan_first([], _fun), do: []
  fnp scan_first([head | tail], fun), do: [head | scan_list(tail, head, fun)]

  fnp scan_list([], _acc, _fun), do: []
  fnp scan_list([head | tail], acc, fun) do
    next = fun.(head, acc)
    [next | scan_list(tail, next, fun)]
  end

  fnp intersperse_list([], _separator), do: []
  fnp intersperse_list([head | tail], separator), do: [head | intersperse_tail(tail, separator)]

  fnp intersperse_tail([], _separator), do: []
  fnp intersperse_tail([head | tail], separator), do: [separator, head | intersperse_tail(tail, separator)]
  @spec with_index_list([a], integer) :: [{a, integer}]
  fnp with_index_list([], _index), do: []
  fnp with_index_list([head | tail], index), do: [{head, index} | with_index_list(tail, index + 1)]
  @spec with_index_list([a], integer, (a, integer) -> b) :: [b]
  fnp with_index_list([], _index, _fun), do: []
  fnp with_index_list([head | tail], index, fun), do: [fun.(head, index) | with_index_list(tail, index + 1, fun)]

  @spec map_every_list([a], integer, integer, (a) -> a) :: [a]
  fnp map_every_list([], _nth, _index, _fun), do: []
  fnp map_every_list([head | tail], nth, index, fun) do
    next = if (index % nth) == 0, do: fun.(head), else: head
    [next | map_every_list(tail, nth, index + 1, fun)]
  end

  fnp map_join_list([], _joiner, _mapper), do: ""
  fnp map_join_list([head | tail], joiner, mapper) do
    map_join_tail(tail, joiner, mapper, mapper.(head))
  end

  fnp map_join_tail([], _joiner, _mapper, acc), do: acc
  fnp map_join_tail([head | tail], joiner, mapper, acc) do
    map_join_tail(tail, joiner, mapper, acc <> joiner <> mapper.(head))
  end

  fnp map_intersperse_list([], _separator, _mapper), do: []
  fnp map_intersperse_list([head | tail], separator, mapper) do
    [mapper.(head) | map_intersperse_tail(tail, separator, mapper)]
  end

  fnp map_intersperse_tail([], _separator, _mapper), do: []
  fnp map_intersperse_tail([head | tail], separator, mapper) do
    [separator, mapper.(head) | map_intersperse_tail(tail, separator, mapper)]
  end

  fnp all_value_step(value) do
    if value, do: {:cont, true}, else: {:halt, false}
  end

  fnp any_value_step(value) do
    if value, do: {:halt, true}, else: {:cont, false}
  end

  fnp find_index_step(value, {:not_found, index}) do
    if value, do: {:halt, {:found, index}}, else: {:cont, {:not_found, index + 1}}
  end

  @spec find_index_finish({:found, integer} | {:not_found, integer}) :: integer | nil
  fnp find_index_finish({:found, index}), do: index
  fnp find_index_finish({:not_found, _index}), do: nil

  fnp find_value_step(value, default) do
    if value, do: {:halt, value}, else: {:cont, default}
  end

  @spec normalized_prefix_count(Enumerable.t(a), integer) :: integer
  fnp normalized_prefix_count(enumerable, amount), do: non_negative(count(enumerable) + amount)
  fnp non_negative(count) when count > 0, do: count
  fnp non_negative(_count), do: 0

  fnp take_positive(enumerable, amount) do
    take_positive_finish(
      reduce_while(enumerable, {[], amount}, fn (entry, {acc, remaining}) ->
        if remaining == 1, do: {:halt, {[entry | acc], 0}}, else: {:cont, {[entry | acc], remaining - 1}}
      end)
    )
  end

  @spec take_positive_step(a, {[a], integer}) :: {:cont, {[a], integer}} | {:halt, {[a], integer}}
  fnp take_positive_step(entry, {acc, 1}), do: {:halt, {[entry | acc], 0}}
  fnp take_positive_step(entry, {acc, amount}), do: {:cont, {[entry | acc], amount - 1}}
  @spec take_positive_finish({[a], integer}) :: [a]
  fnp take_positive_finish({acc, _amount}), do: reverse_list(acc)

  @spec take_every_finish({[a], integer}) :: [a]
  fnp take_every_finish({acc, _countdown}), do: reverse_list(acc)

  fnp drop_positive(enumerable, amount) do
    drop_positive_finish(
      reduce_while(enumerable, {[], amount}, fn (entry, {acc, remaining}) ->
        {:cont, if remaining > 0, do: {acc, remaining - 1}, else: {[entry | acc], 0}}
      end)
    )
  end

  @spec drop_positive_finish({[a], integer}) :: [a]
  fnp drop_positive_finish({acc, _amount}), do: reverse_list(acc)

  @spec drop_while_finish({[a], bool}) :: [a]
  fnp drop_while_finish({acc, _dropping}), do: reverse_list(acc)

  @spec drop_every_finish({[a], integer}) :: [a]
  fnp drop_every_finish({acc, _countdown}), do: reverse_list(acc)

  fnp split_positive(enumerable, count) do
    split_counted_finish(
      reduce_while(enumerable, {[], [], count}, fn (entry, {left, right, remaining}) ->
        {:cont, if remaining > 0, do: {[entry | left], right, remaining - 1}, else: {left, [entry | right], 0}}
      end)
    )
  end

  @spec split_counted_finish({[a], [a], integer}) :: {[a], [a]}
  fnp split_counted_finish({left, right, _count}), do: {reverse_list(left), reverse_list(right)}
  @spec split_pair_finish({[a], [a]}) :: {[a], [a]}
  fnp split_pair_finish({left, right}), do: {reverse_list(left), reverse_list(right)}

  fnp sort_list([], _sorter), do: []
  fnp sort_list([single], _sorter), do: [single]
  fnp sort_list(list, sorter) do
    {left, right} = split_sort_list(list, [], [])
    merge_sort_lists(
      sort_list(reverse_list(left), sorter),
      sort_list(reverse_list(right), sorter),
      sorter
    )
  end

  fnp split_sort_list([], left, right), do: {left, right}
  fnp split_sort_list([single], left, right), do: {[single | left], right}
  fnp split_sort_list([left_head, right_head | tail], left, right) do
    split_sort_list(tail, [left_head | left], [right_head | right])
  end

  @spec reverse_list([a]) :: [a]
  fnp reverse_list(list), do: reverse_list(list, [])
  @spec reverse_list([a], [b]) :: [a | b]
  fnp reverse_list([], acc), do: acc
  fnp reverse_list([head | tail], acc), do: reverse_list(tail, [head | acc])

  fnp merge_sort_lists([], right, _sorter), do: right
  fnp merge_sort_lists(left, [], _sorter), do: left
  fnp merge_sort_lists([left_head | left_tail], [right_head | right_tail], sorter) do
    if sorter.(left_head, right_head) do
      [left_head | merge_sort_lists(left_tail, [right_head | right_tail], sorter)]
    else
      [right_head | merge_sort_lists([left_head | left_tail], right_tail, sorter)]
    end
  end

  # The min/max family is written against `Kernel.compare/2` rather than `<=`,
  # for the same reason `sort/1` is: `<=` is declared only for the operand
  # pairs fz can prove, so `Enum.max(["a", :b])` could not be written in terms
  # of it. Term order is total, so these are too.

  @doc "The largest element by term order."
  @spec max([a]) :: a
  fn max(enumerable), do: extreme(to_list(enumerable), 1, "Enum.max: empty")

  @doc "The smallest element by term order."
  @spec min([a]) :: a
  fn min(enumerable), do: extreme(to_list(enumerable), -1, "Enum.min: empty")

  @doc "{min, max} by term order."
  @spec min_max([a]) :: {a, a}
  fn min_max(enumerable), do: {min(enumerable), max(enumerable)}

  @spec extreme([a], integer, binary) :: a
  fnp extreme([], _want, message), do: Kernel.panic(message)
  fnp extreme([head | tail], want, _message), do: extreme_fold(tail, head, want)

  @spec extreme_fold([a], a, integer) :: a
  fnp extreme_fold([], best, _want), do: best
  fnp extreme_fold([head | tail], best, want) do
    if Kernel.compare(head, best) == want do
      extreme_fold(tail, head, want)
    else
      extreme_fold(tail, best, want)
    end
  end

  @doc "The element whose fun value is largest."
  @spec max_by([a], (a) -> any) :: a
  fn max_by(enumerable, fun), do: extreme_by(to_list(enumerable), fun, 1, "Enum.max_by: empty")

  @doc "The element whose fun value is smallest."
  @spec min_by([a], (a) -> any) :: a
  fn min_by(enumerable, fun), do: extreme_by(to_list(enumerable), fun, -1, "Enum.min_by: empty")

  @doc "{min_by, max_by} for one fun."
  @spec min_max_by([a], (a) -> any) :: {a, a}
  fn min_max_by(enumerable, fun), do: {min_by(enumerable, fun), max_by(enumerable, fun)}

  @spec extreme_by([a], (a) -> any, integer, binary) :: a
  fnp extreme_by([], _fun, _want, message), do: Kernel.panic(message)
  fnp extreme_by([head | tail], fun, want, _message), do: extreme_by_fold(tail, head, fun.(head), fun, want)

  @spec extreme_by_fold([a], a, any, (a) -> any, integer) :: a
  fnp extreme_by_fold([], best, _best_key, _fun, _want), do: best
  fnp extreme_by_fold([head | tail], best, best_key, fun, want) do
    key = fun.(head)
    if Kernel.compare(key, best_key) == want do
      extreme_by_fold(tail, head, key, fun, want)
    else
      extreme_by_fold(tail, best, best_key, fun, want)
    end
  end

  @doc "Sorts by the value fun returns."
  @spec sort_by([a], (a) -> any) :: [a]
  fn sort_by(enumerable, fun) do
    sort(to_list(enumerable), fn (left, right) -> Kernel.compare(fun.(left), fun.(right)) <= 0 end)
  end

  @doc "Concatenates the string representations."
  @spec join([a]) :: binary
  fn join(enumerable), do: join(enumerable, "")

  @doc "Concatenates the string representations with a separator."
  @spec join([a], binary) :: binary
  fn join(enumerable, separator), do: join_list(to_list(enumerable), separator)

  @spec join_list([a], binary) :: binary
  fnp join_list([], _separator), do: ""
  fnp join_list([only], _separator), do: Kernel.to_string(only)
  fnp join_list([head | tail], separator) do
    Kernel.to_string(head) <> separator <> join_list(tail, separator)
  end

  @doc "The sum of the elements."
  @spec sum([a]) :: any
  fn sum(enumerable), do: reduce(to_list(enumerable), 0, fn (entry, acc) -> acc + entry end)

  @doc "The sum of fun over the elements."
  @spec sum_by([a], (a) -> any) :: any
  fn sum_by(enumerable, fun), do: reduce(to_list(enumerable), 0, fn (entry, acc) -> acc + fun.(entry) end)

  @doc "The product of the elements."
  @spec product([a]) :: any
  fn product(enumerable), do: reduce(to_list(enumerable), 1, fn (entry, acc) -> acc * entry end)

  @doc "The product of fun over the elements."
  @spec product_by([a], (a) -> any) :: any
  fn product_by(enumerable, fun), do: reduce(to_list(enumerable), 1, fn (entry, acc) -> acc * fun.(entry) end)

  @doc "{:ok, element} at index, or :error."
  @spec fetch([a], integer) :: {:ok, a} | :error
  fn fetch(enumerable, index), do: fetch_list(to_list(enumerable), index)

  @spec fetch_list([a], integer) :: {:ok, a} | :error
  fnp fetch_list([], _index), do: :error
  fnp fetch_list([head | _tail], 0), do: {:ok, head}
  fnp fetch_list([_head | tail], index), do: fetch_list(tail, index - 1)

  @doc "The element at index, or halts."
  @spec fetch!([a], integer) :: a
  fn fetch!(enumerable, index), do: fetch_result(fetch(enumerable, index))

  @spec fetch_result({:ok, a} | :error) :: a
  fnp fetch_result({:ok, value}), do: value
  fnp fetch_result(:error), do: Kernel.panic("Enum.fetch!: out of range")

  @doc "The element at index, or default."
  @spec at([a], integer) :: a | nil
  fn at(enumerable, index), do: at(enumerable, index, nil)

  @doc "The element at index, or default."
  @spec at([a], integer, any) :: any
  fn at(enumerable, index, default), do: at_result(fetch(enumerable, index), default)

  @spec at_result({:ok, a} | :error, any) :: any
  fnp at_result({:ok, value}, _default), do: value
  fnp at_result(:error, default), do: default

  @doc "Flattens one level."
  @spec concat([[a]]) :: [a]
  fn concat(enumerables), do: concat_list(to_list(enumerables))

  @spec concat_list([[a]]) :: [a]
  fnp concat_list([]), do: []
  fnp concat_list([head | tail]), do: List.concat(to_list(head), concat_list(tail))

  @doc "Concatenates two enumerables."
  @spec concat([a], [b]) :: [a | b]
  fn concat(left, right), do: List.concat(to_list(left), to_list(right))

  @doc "Removes consecutive duplicates."
  @spec dedup([a]) :: [a]
  fn dedup(enumerable), do: dedup_list(to_list(enumerable))

  @spec dedup_list([a]) :: [a]
  fnp dedup_list([]), do: []
  fnp dedup_list([head | tail]), do: [head | dedup_after(tail, head)]

  @spec dedup_after([a], a) :: [a]
  fnp dedup_after([], _last), do: []
  fnp dedup_after([head | tail], last) do
    if head === last, do: dedup_after(tail, last), else: [head | dedup_after(tail, head)]
  end

  @doc "Removes consecutive duplicates by fun."
  @spec dedup_by([a], (a) -> any) :: [a]
  fn dedup_by(enumerable, fun), do: dedup_by_list(to_list(enumerable), fun)

  @spec dedup_by_list([a], (a) -> any) :: [a]
  fnp dedup_by_list([], _fun), do: []
  fnp dedup_by_list([head | tail], fun), do: [head | dedup_by_after(tail, fun.(head), fun)]

  @spec dedup_by_after([a], any, (a) -> any) :: [a]
  fnp dedup_by_after([], _last, _fun), do: []
  fnp dedup_by_after([head | tail], last, fun) do
    key = fun.(head)
    if key === last, do: dedup_by_after(tail, last, fun), else: [head | dedup_by_after(tail, key, fun)]
  end

  @doc "Counts, stopping once limit is reached."
  @spec count_until([a], integer) :: integer
  fn count_until(enumerable, limit), do: count_until_list(to_list(enumerable), limit, 0)

  @spec count_until_list([a], integer, integer) :: integer
  fnp count_until_list([], _limit, seen), do: seen
  fnp count_until_list(_list, limit, seen) when seen >= limit, do: seen
  fnp count_until_list([_head | tail], limit, seen), do: count_until_list(tail, limit, seen + 1)

  @doc "Pairs elements from two enumerables."
  @spec zip([a], [b]) :: [{a, b}]
  fn zip(left, right), do: zip_lists(to_list(left), to_list(right))

  @spec zip_lists([a], [b]) :: [{a, b}]
  fnp zip_lists([], _right), do: []
  fnp zip_lists(_left, []), do: []
  fnp zip_lists([left_head | left_tail], [right_head | right_tail]) do
    [{left_head, right_head} | zip_lists(left_tail, right_tail)]
  end

  @doc "Splits a list of pairs into two lists."
  @spec unzip([{a, b}]) :: {[a], [b]}
  fn unzip(enumerable), do: unzip_list(to_list(enumerable))

  @spec unzip_list([{a, b}]) :: {[a], [b]}
  fnp unzip_list([]), do: {[], []}
  fnp unzip_list([{left, right} | tail]), do: unzip_cons(left, right, unzip_list(tail))

  @spec unzip_cons(a, b, {[a], [b]}) :: {[a], [b]}
  fnp unzip_cons(left, right, {lefts, rights}), do: {[left | lefts], [right | rights]}

  @doc "Groups consecutive elements into lists of at most n."
  @spec chunk_every([a], integer) :: [[a]]
  fn chunk_every(enumerable, n), do: chunk_every_list(to_list(enumerable), n)

  @spec chunk_every_list([a], integer) :: [[a]]
  fnp chunk_every_list([], _n), do: []
  fnp chunk_every_list(list, n), do: [take(list, n) | chunk_every_list(drop(list, n), n)]

  @doc "Groups consecutive elements by what fun returns."
  @spec chunk_by([a], (a) -> any) :: [[a]]
  fn chunk_by(enumerable, fun), do: chunk_by_list(to_list(enumerable), fun)

  @spec chunk_by_list([a], (a) -> any) :: [[a]]
  fnp chunk_by_list([], _fun), do: []
  fnp chunk_by_list([head | tail], fun), do: chunk_by_run(tail, fun, fun.(head), [head])

  @spec chunk_by_run([a], (a) -> any, any, [a]) :: [[a]]
  fnp chunk_by_run([], _fun, _key, acc), do: [reverse_list(acc)]
  fnp chunk_by_run([head | tail], fun, key, acc) do
    if fun.(head) === key do
      chunk_by_run(tail, fun, key, [head | acc])
    else
      [reverse_list(acc) | chunk_by_run(tail, fun, fun.(head), [head])]
    end
  end

  @doc "How many times each element appears."
  @spec frequencies([a]) :: any
  fn frequencies(enumerable), do: frequencies_by(enumerable, fn (entry) -> entry end)

  @doc "How many times each fun value appears."
  @spec frequencies_by([a], (a) -> any) :: any
  fn frequencies_by(enumerable, fun) do
    reduce(to_list(enumerable), %{}, fn (entry, acc) -> bump(acc, fun.(entry)) end)
  end

  @spec bump(any, any) :: any
  fnp bump(counts, key), do: Map.put(counts, key, Map.get(counts, key, 0) + 1)

  @doc "Removes duplicates, keeping the first of each."
  @spec uniq([a]) :: [a]
  fn uniq(enumerable), do: uniq_by(enumerable, fn (entry) -> entry end)

  @doc "Removes duplicates by fun, keeping the first of each."
  @spec uniq_by([a], (a) -> any) :: [a]
  fn uniq_by(enumerable, fun), do: uniq_walk(to_list(enumerable), fun, [])

  @spec uniq_walk([a], (a) -> any, [any]) :: [a]
  fnp uniq_walk([], _fun, _seen), do: []
  fnp uniq_walk([head | tail], fun, seen) do
    key = fun.(head)
    if List.member?(seen, key) do
      uniq_walk(tail, fun, seen)
    else
      [head | uniq_walk(tail, fun, [key | seen])]
    end
  end

  @doc "Groups elements by what fun returns."
  @spec group_by([a], (a) -> any) :: any
  fn group_by(enumerable, fun), do: group_by(enumerable, fun, fn (entry) -> entry end)

  @doc "Groups the value fun by the key fun."
  @spec group_by([a], (a) -> any, (a) -> any) :: any
  fn group_by(enumerable, key_fun, value_fun) do
    grouped = reduce(to_list(enumerable), %{}, fn (entry, acc) -> group_step(acc, key_fun, value_fun, entry) end)
    reduce(Map.keys(grouped), grouped, fn (key, acc) -> group_reverse(acc, key) end)
  end

  @spec group_step(any, (a) -> any, (a) -> any, a) :: any
  fnp group_step(acc, key_fun, value_fun, entry) do
    group_put(acc, key_fun.(entry), value_fun.(entry))
  end

  @spec group_put(any, any, any) :: any
  fnp group_put(acc, key, value), do: Map.put(acc, key, [value | Map.get(acc, key, [])])

  # A group is built by prepending, so each list comes out reversed; one pass
  # over the keys puts them back in encounter order.
  @spec group_reverse(any, any) :: any
  fnp group_reverse(acc, key), do: Map.put(acc, key, reverse_list(Map.get(acc, key)))

end
