defmodule :binary do
  @moduledoc "The Erlang `:binary` functions that read a byte of a binary, search it, make a copy of it, or report what it references."

  @doc """
  Returns the byte of `subject` at the zero-based position `pos`.

  Raises `ArgumentError` when `pos` is at or past the end of `subject`, and
  with Elixir's per-argument wording when `subject` is not a binary or `pos`
  is not a non-negative integer.

  ## Examples

      :binary.at("abc", 1)
      #=> 98

  """
  @spec at(binary, integer) :: integer
  def at(subject, pos)
      when is_bitstring_subject(subject) and is_binary_subject(subject) and is_integer(pos) and pos >= 0,
      raises: ArgumentError, reason: :badarg,
      do: byte_at(subject, pos)

  @spec byte_at(binary, integer) :: integer
  defp byte_at(subject, pos) when pos < byte_size(subject) do
    <<_::binary-size(pos), byte, _::binary>> = subject
    byte
  end

  defp byte_at(_subject, _pos), do: __raise__(%ArgumentError{message: "argument error"}, :badarg)

  @doc """
  Returns the search pattern `pattern` in a form `match/2,3` accepts.

  `pattern` is a non-empty binary or a non-empty proper list of non-empty
  binaries. The result is a tuple, so it can be told apart from a pattern
  given as it is. Raises `ArgumentError` when `pattern` is neither.

  ## Examples

      :binary.compile_pattern("b") |> elem(0)
      #=> :bm

      :binary.compile_pattern(["a", "b"]) |> elem(0)
      #=> :ac

  """
  @spec compile_pattern(binary | [binary]) :: {:bm | :ac, [binary]}
  def compile_pattern(pattern) do
    case patterns(pattern) do
      [one] -> {:bm, [one]}
      [_ | _] = many -> {:ac, many}
      :invalid -> __raise__(%ArgumentError{message: "errors were found at the given arguments:\n\n" <> "  * 1st argument: not a valid pattern\n"}, :badarg)
    end
  end

  @doc """
  Returns the position and length of the first match of `pattern` in `subject`.

  Equivalent to `match(subject, pattern, [])`.
  """
  @spec match(binary, binary | [binary] | tuple) :: {non_neg_integer, pos_integer} | :nomatch
  def match(subject, pattern), do: match(subject, pattern, [])

  @doc """
  Returns the `{position, length}` of the leftmost match of `pattern` in
  `subject`, or `:nomatch`.

  `pattern` is a non-empty binary, a non-empty list of non-empty binaries, or
  the result of `compile_pattern/1`. Among the patterns that match at the
  leftmost position, the longest wins.

  `options` may hold one `{:scope, {start, length}}` that limits the search to
  that part of `subject`. A negative `length` counts back from `start`.

  Raises `ArgumentError` when `subject` is not a binary, `pattern` is not a
  valid pattern, or `options` is not valid or names a part that is not wholly
  inside `subject`.

  ## Examples

      :binary.match("abcde", ["bc", "bcd"])
      #=> {1, 3}

      :binary.match("abcde", "cd", [{:scope, {5, -3}}])
      #=> {2, 2}

      :binary.match("abc", "x")
      #=> :nomatch

  """
  @spec match(binary, binary | [binary] | tuple, [{:scope, {integer, integer}}]) :: {non_neg_integer, pos_integer} | :nomatch
  def match(subject, pattern, options) when is_binary(subject) and is_list(options) do
    case {patterns(pattern), scope(options, byte_size(subject), :whole)} do
      {[_ | _] = found, {first, last}} -> leftmost(subject, found, first, last)
      {found, window} -> raise_match(subject, found, window)
    end
  end

  def match(subject, pattern, _options), do: raise_match(subject, patterns(pattern), :invalid_options)

  @spec leftmost(binary, [binary], integer, integer) :: {non_neg_integer, pos_integer} | :nomatch
  defp leftmost(subject, patterns, at, last) when at < last do
    longest =
      Enum.reduce(patterns, 0, fn pattern, best ->
        size = byte_size(pattern)
        if size > best and at + size <= last and binary_part(subject, at, size) == pattern, do: size, else: best
      end)

    if longest == 0, do: leftmost(subject, patterns, at + 1, last), else: {at, longest}
  end

  defp leftmost(_subject, _patterns, _at, _last), do: :nomatch

  @spec patterns(any) :: [binary] | :invalid
  defp patterns(pattern) when is_binary(pattern) and byte_size(pattern) > 0, do: [pattern]
  defp patterns({tag, [_ | _] = list}) when tag == :bm or tag == :ac, do: patterns(list)
  defp patterns([_ | _] = list), do: if(nonempty_binaries?(list), do: list, else: :invalid)
  defp patterns(_), do: :invalid

  @spec nonempty_binaries?(any) :: boolean
  defp nonempty_binaries?([]), do: true
  defp nonempty_binaries?([pattern | rest]) when is_binary(pattern) and byte_size(pattern) > 0, do: nonempty_binaries?(rest)
  defp nonempty_binaries?(_), do: false

  @spec scope(any, integer, :whole | {integer, integer} | :outside | :invalid_options) :: {integer, integer} | :outside | :invalid_options
  defp scope([{:scope, {start, length}} | rest], size, :whole) when is_integer(start) and is_integer(length),
    do: scope(rest, size, window(start, length, size, :outside))

  defp scope([{:scope, {start, length}} | rest], size, {_, _}) when is_integer(start) and is_integer(length),
    do: scope(rest, size, window(start, length, size, :invalid_options))

  defp scope([_ | _], _size, _window), do: :invalid_options
  defp scope(_end, size, :whole), do: {0, size}
  defp scope(_end, _size, window), do: window

  @spec window(integer, integer, integer, :outside | :invalid_options) :: {integer, integer} | :outside | :invalid_options
  defp window(start, length, size, _outside) when start >= 0 and length >= 0 and start + length <= size, do: {start, start + length}
  defp window(start, length, size, _outside) when length < 0 and start <= size and start + length >= 0, do: {start + length, start}
  defp window(_start, _length, _size, outside), do: outside

  @spec raise_match(any, [binary] | :invalid, any) :: no_return
  defp raise_match(subject, found, window) do
    complaints =
      case {subject_complaint(subject), found} do
        {"", :invalid} -> "  * 2nd argument: not a valid pattern\n"
        {"", _} when window == :outside -> "  * 3rd argument: specified part is not wholly inside binary\n"
        {"", _} -> "  * 3rd argument: invalid options\n"
        {complaint, :invalid} -> complaint <> "  * 2nd argument: not a valid pattern\n"
        {complaint, _} -> complaint
      end

    __raise__(%ArgumentError{message: "errors were found at the given arguments:\n\n" <> complaints}, :badarg)
  end

  @doc """
  Returns a new binary with the bytes of `subject`.

  A binary cut from a large one references the large buffer and keeps it
  alive. The copy references only its own bytes, so it lets the large buffer
  go. It is a new binary even though its bytes are the same.

  ## Examples

      :binary.copy("abc")
      #=> "abc"

  """
  @spec copy(binary) :: binary
  def copy(subject), do: copy(subject, 1)

  @doc """
  Returns a new binary of `n` repetitions of `subject`, built in one buffer.

  Raises `ArgumentError` when `subject` is not a binary or `n` is not a
  non-negative integer.

  ## Examples

      :binary.copy("ab", 3)
      #=> "ababab"

      :binary.copy("ab", 0)
      #=> ""

  """
  @spec copy(binary, integer) :: binary
  def copy(subject, n)
      when is_bitstring_subject(subject) and is_binary_subject(subject) and is_integer(n) and n >= 0,
      raises: ArgumentError, reason: :badarg,
      do: fz_binary_copy(subject, n)

  @doc """
  Returns the byte size of the buffer `binary` references.

  A binary that is a view of a larger one references that larger buffer, so
  its referenced size can exceed its `byte_size/1`. A binary that is not a
  view references exactly its own bytes. Copying a view with `copy/1` gives
  a binary that references only itself.

  ## Examples

      :binary.referenced_byte_size("abc")
      #=> 3

  """
  @spec referenced_byte_size(bitstring) :: integer
  def referenced_byte_size(bitstring) when is_bitstring_subject(bitstring), raises: ArgumentError, reason: :badarg,
    do: fz_binary_referenced_size(bitstring)

  @spec subject_complaint(any) :: binary
  defp subject_complaint(subject) when is_binary(subject), do: ""
  defp subject_complaint(subject) when is_bitstring(subject), do: "  * 1st argument: is a bitstring (expected a binary)\n"
  defp subject_complaint(_), do: "  * 1st argument: not a binary\n"

  # Erlang words a subject that is no bitstring "not a binary", and a bitstring
  # that is no binary "is a bitstring (expected a binary)": the two tests,
  # one after the other, give the failing argument the wording that fits.
  @spec is_bitstring_subject(any) :: boolean
  defp is_bitstring_subject(subject), do: is_bitstring(subject)

  @spec is_binary_subject(any) :: boolean
  defp is_binary_subject(subject), do: is_binary(subject)

  extern "fz" defp fz_binary_copy(binary, integer) :: binary

  extern "C" defp fz_binary_referenced_size(bitstring) :: integer
end
