defmodule MapSet do
  @moduledoc """
  A set of unique values.

  A set is a struct with one field, `map`, whose keys are the members and
  whose values are `[]`. Every function asks `Map` the matching question.

  Sets implement `Enumerable` and `Collectable`, so they work with `Enum`,
  the `in` operator, and `for ..., into: MapSet.new()`:

      set = for x <- [1, 2, 1], into: MapSet.new(), do: x
      2 in set
      #=> true

  The order of `to_list/1` and of enumeration is unspecified. The rest of
  Elixir's `MapSet` (`union`, `intersection`, `difference`, `subset?`,
  `disjoint?`, `equal?`, `filter`, `reject`, `new/2`,
  `symmetric_difference`) is not built.
  """

  defstruct [:map]

  @type t :: %MapSet{map: map}

  @doc """
  Returns a set with no members.

  ## Examples

      MapSet.size(MapSet.new())
      #=> 0

  """
  @spec new() :: t
  def new(), do: %MapSet{map: %{}}

  @doc """
  Returns a set holding each distinct element of `enumerable`.

  ## Examples

      MapSet.size(MapSet.new([1, 2, 1]))
      #=> 2

  """
  @spec new(Enumerable.t(a)) :: t
  def new(enumerable), do: Enum.reduce(enumerable, new(), fn x, set -> put(set, x) end)

  @doc """
  Adds `value` to `set`; a value already present leaves the set unchanged.

  ## Examples

      MapSet.member?(MapSet.put(MapSet.new(), 1), 1)
      #=> true

  """
  @spec put(t, any) :: t
  def put(%MapSet{map: map}, value), do: %MapSet{map: Map.put(map, value, [])}

  @doc """
  Removes `value` from `set`; an absent value leaves the set unchanged.

  ## Examples

      MapSet.size(MapSet.delete(MapSet.new([1, 2]), 1))
      #=> 1

  """
  @spec delete(t, any) :: t
  def delete(%MapSet{map: map}, value), do: %MapSet{map: Map.delete(map, value)}

  @doc """
  Returns `true` if `value` is a member of `set`.

  ## Examples

      MapSet.member?(MapSet.new([1, 2]), 1)
      #=> true

  """
  @spec member?(t, any) :: boolean
  def member?(%MapSet{map: map}, value), do: Map.has_key?(map, value)

  @doc """
  Returns the number of members in `set`.

  ## Examples

      MapSet.size(MapSet.new([1, 2, 1]))
      #=> 2

  """
  @spec size(t) :: integer
  def size(%MapSet{map: map}), do: map_size(map)

  @doc """
  Returns the members of `set` as a list, in unspecified order.

  ## Examples

      Enum.sort(MapSet.to_list(MapSet.new([2, 1, 2])))
      #=> [1, 2]

  """
  @spec to_list(t) :: [any]
  def to_list(%MapSet{map: map}), do: Map.keys(map)
end

defimpl Enumerable, for: MapSet do
  def reduce(set, acc, reducer), do: List.reduce(MapSet.to_list(set), acc, reducer)
  def reduce_while(set, acc, reducer), do: List.reduce_while(MapSet.to_list(set), acc, reducer)
  def count(set), do: {:ok, MapSet.size(set)}
  def member?(set, value), do: {:ok, MapSet.member?(set, value)}
  def slice(_set), do: {:error, :unsupported}
end

defimpl Collectable, for: MapSet do
  def into(set) do
    {set, fn acc, cmd ->
      case cmd do
        {:cont, x} -> MapSet.put(acc, x)
        :done -> acc
        :halt -> :ok
      end
    end}
  end
end
