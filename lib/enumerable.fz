defprotocol Enumerable do
  @moduledoc """
  The protocol behind `Enum`: a common contract for any type whose values can
  be produced one at a time.

  A type becomes enumerable by implementing every callback below, with
  `defimpl Enumerable, for: SomeType`. `Enum`'s own functions -- `Enum.reduce/3`,
  `Enum.count/1`, `Enum.member?/2`, and the rest -- are how these are normally
  reached, rather than calling this protocol directly.
  """

  @doc """
  Reduces the enumerable to a single value, driven by `reducer`'s `:cont`,
  `:halt`, and `:suspend` instructions.

  `Enum.reduce/2` and `Enum.reduce/3` are built on this one callback, so every
  implementation has to get it right: it is what every other `Enum` operation
  -- `map`, `filter`, `count`'s fallback, and so on -- ultimately reduces to.
  """
  @spec reduce(t(a), b, (a, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  def reduce(enumerable, acc, reducer)

  @doc """
  Reduces the enumerable, stopping as soon as `reducer` returns `{:halt, _}`.

  `Enum.reduce_while/3` calls this directly.
  """
  @spec reduce_while(t(a), b, (a, b) -> {:cont, b} | {:halt, c}) :: b | c
  def reduce_while(enumerable, acc, reducer)

  @doc """
  Returns the number of elements, or reports that this enumerable cannot
  count itself without a full traversal.

  `Enum.count/1` falls back to counting by reduction when this returns
  `{:error, _}`.
  """
  @spec count(t(a)) :: {:ok, integer} | {:error, any}
  def count(enumerable)

  @doc """
  Reports whether `value` occurs in the enumerable, or that membership cannot
  be answered without a full traversal.

  `Enum.member?/2` falls back to a reducing search when this returns
  `{:error, _}`.
  """
  @spec member?(t(a), a) :: {:ok, bool} | {:error, any}
  def member?(enumerable, value)

  @doc """
  Returns the enumerable's size together with a slicing function, or reports
  that it cannot be sliced without a full traversal.
  """
  @spec slice(t(a)) :: {:ok, integer, any} | {:error, any}
  def slice(enumerable)
end

# Built-in implementations live with their protocol: a protocol call always
# names the protocol, so referencing it pulls these impls. Each `defimpl` is
# hoisted to its own `Enumerable.<Type>` module and demanded directly by a
# matching receiver — no "scan the receiver type's own module" convention.
defimpl Enumerable, for: List do
  def reduce(list, acc, reducer), do: List.reduce(list, acc, reducer)
  def reduce_while(list, acc, reducer), do: List.reduce_while(list, acc, reducer)
  def count(list), do: {:ok, List.count(list)}
  def member?(list, value), do: {:ok, List.member?(list, value)}
  def slice(_list), do: {:error, :unsupported}
end

defimpl Enumerable, for: Map do
  def reduce(map, acc, reducer), do: Map.reduce(map, acc, reducer)
  def reduce_while(map, acc, reducer), do: Map.reduce_while(map, acc, reducer)
  def count(map), do: {:ok, Map.count(map)}
  def member?(map, pair), do: {:ok, Map.member?(map, pair)}
  def slice(map), do: Map.slice(map)
end

defimpl Enumerable, for: Range do
  def reduce(%Range{first: first, last: last, step: step}, acc, reducer), do: Range.reduce(first, last, step, acc, reducer)
  def reduce_while(%Range{first: first, last: last, step: step}, acc, reducer), do: Range.reduce_while(first, last, step, acc, reducer)
  def count(%Range{first: first, last: last, step: step}), do: {:ok, Range.count(first, last, step)}
  def member?(%Range{first: first, last: last, step: step}, value), do: {:ok, Range.member?(first, last, step, value)}

  def slice(%Range{first: first, last: last, step: step}) do
    {:ok, Range.count(first, last, step), (fn (start, amount, stride) -> Range.slice(first, last, step, start, amount, stride) end)}
  end
end
