defmodule Map do
  @moduledoc "A flat sorted array, not a HAMT -- bulk functions first. See the note below."

  # A map here is a FLAT SORTED ARRAY, and this module's shape says so.
  #
  # Elixir's structural sharing does not transfer. `put/3` and `delete/2` each
  # copy the whole array, so a loop over n keys is O(n^2) -- the exact idiom
  # Elixir's docs encourage. The BULK functions do one pass and one allocation,
  # and they are the surface to reach for. Use `put/3` and `delete/2` when you
  # have ONE key, not in a loop. That emphasis is the opposite of Elixir's and
  # is deliberate.
  #
  # `get` is a binary search (fz-5xp.12), which needs the array's order to agree
  # with its key equality (fz-5xp.48) and every map to actually be sorted
  # (fz-5xp.49).
  #
  # ITERATION ORDER is by key. For BINARY keys that matches Elixir exactly. For
  # ATOM keys it cannot: Elixir orders atoms by an internal identity fz does not
  # share, so `Map.keys(%{a: 1, b: 2, c: 3})` is `[:c, :a, :b]` there and
  # `[:a, :b, :c]` here (fz-5xp.50). JSON object keys are strings, so the goal
  # program is on the side that matches.

  extern "C" fn fz_map_count(any) :: integer
  extern "C" fn fz_map_entry_key(any, integer) :: any
  extern "C" fn fz_map_entry_value(any, integer) :: any
  extern "fz" fn fz_map_delete(any, any) :: any
  extern "fz" fn fz_map_from_kv(any, any) :: any
  extern "fz" fn fz_map_put_ref(any, any, any) :: any
  extern "fz" fn fz_map_put_int(any, any, integer) :: any
  extern "fz" fn fz_map_put_float(any, any, float) :: any
  extern "fz" fn fz_map_put_atom_ref(any, any, atom) :: any

  # ---- BULK: one pass, one allocation. Reach for these. ----

  @doc "A map from a list of {key, value} pairs. Later keys win."
  @spec new([{any, any}]) :: any
  fn new(pairs), do: build(pairs, [], [])

  @doc "Both maps, with `b`'s value winning on a shared key."
  @spec merge(any, any) :: any
  fn merge(a, b), do: build(to_list(a) ++ to_list(b), [], [])

  @doc "Only the given keys, in one pass."
  @spec take(any, [any]) :: any
  fn take(map, keys), do: build(taken(map, keys, []), [], [])

  @doc "Everything except the given keys, in one pass."
  @spec drop(any, [any]) :: any
  fn drop(map, keys), do: build(dropped(to_list(map), keys, []), [], [])

  @doc "The entries whose {key, value} the function keeps."
  @spec filter(any, ({any, any}) -> bool) :: any
  fn filter(map, fun), do: build(kept(to_list(map), fun, []), [], [])

  @doc "{taken, dropped} by the given keys, in one pass each."
  @spec split(any, [any]) :: {any, any}
  fn split(map, keys), do: {take(map, keys), drop(map, keys)}

  # Splits the pair list into parallel key and value lists, which is what the
  # one-allocation builder takes.
  fnp build([], ks, vs), do: fz_map_from_kv(reverse(ks, []), reverse(vs, []))
  fnp build([{k, v} | t], ks, vs), do: build(t, [k | ks], [v | vs])

  fnp taken(_map, [], acc), do: reverse(acc, [])
  fnp taken(map, [k | t], acc), do: taken(map, t, take_one(map, k, acc, has_key?(map, k)))
  fnp take_one(map, k, acc, true), do: [{k, map[k]} | acc]
  fnp take_one(_map, _k, acc, false), do: acc

  fnp dropped([], _keys, acc), do: reverse(acc, [])
  fnp dropped([{k, v} | t], keys, acc), do: dropped(t, keys, drop_one({k, v}, keys, acc, key_listed?(keys, k)))
  fnp drop_one(_pair, _keys, acc, true), do: acc
  fnp drop_one(pair, _keys, acc, false), do: [pair | acc]

  fnp kept([], _fun, acc), do: reverse(acc, [])
  fnp kept([pair | t], fun, acc), do: kept(t, fun, keep_one(pair, acc, fun.(pair)))
  fnp keep_one(pair, acc, true), do: [pair | acc]
  fnp keep_one(_pair, acc, false), do: acc

  fnp key_listed?([], _v), do: false
  fnp key_listed?([h | t], v), do: key_listed_or?(h === v, t, v)
  fnp key_listed_or?(true, _t, _v), do: true
  fnp key_listed_or?(false, t, v), do: key_listed?(t, v)

  # ---- SINGLE KEY: each copies the whole array. Not in a loop. ----

  @doc "The map with `key` set. Copies the whole array; do not use in a loop."
  #
  # A typed clause family, like the arithmetic operators in `Kernel`. A scalar
  # value has to reach the heap through its own writer -- handing an unboxed
  # integer to the ref writer aborts with "requires a heap/sentinel ref" -- and
  # letting the clause heads pick means the caller never has to know that.
  @spec put(any, any, any) :: any
  fn put(map, key, value :: integer), do: fz_map_put_int(map, key, value)
  fn put(map, key, value :: float), do: fz_map_put_float(map, key, value)
  fn put(map, key, value :: atom), do: fz_map_put_atom_ref(map, key, value)
  fn put(map, key, value), do: fz_map_put_ref(map, key, value)

  @doc "The value for `key`, or nil."
  @spec get(any, any) :: any
  fn get(map, key), do: map[key]

  @doc "The value for `key`, or `default`."
  @spec get(any, any, any) :: any
  fn get(map, key, default), do: get_or(map, key, default, has_key?(map, key))

  fnp get_or(map, key, _default, true), do: map[key]
  fnp get_or(_map, _key, default, false), do: default

  @doc "The map without `key`. Copies the whole array; prefer drop/2 for several."
  @spec delete(any, any) :: any
  fn delete(map, key), do: fz_map_delete(map, key)

  @doc "The number of entries."
  @spec size(any) :: integer
  fn size(map), do: fz_map_count(map)

  @doc "Entries as a {key, value} list, in key order."
  @spec to_list(any) :: [{any, any}]
  fn to_list(map), do: to_list(map, fz_map_count(map), 0, [])

  @doc "Just the keys, in order."
  @spec keys(any) :: [any]
  fn keys(map), do: keys(map, fz_map_count(map), 0, [])

  @doc "Just the values, in key order."
  @spec values(any) :: [any]
  fn values(map), do: values(map, fz_map_count(map), 0, [])

  @doc "True when `key` is present."
  @spec has_key?(any, any) :: bool
  fn has_key?(map, key), do: has_key?(map, fz_map_count(map), 0, key)

  fnp has_key?(map, count, index, key) do
    if index >= count do
      false
    else
      if fz_map_entry_key(map, index) === key do
        true
      else
        has_key?(map, count, index + 1, key)
      end
    end
  end

  fnp keys(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      keys(map, count, index + 1, [fz_map_entry_key(map, index) | acc])
    end
  end

  fnp values(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      values(map, count, index + 1, [fz_map_entry_value(map, index) | acc])
    end
  end

  @doc "Enumerable.reduce/3 callback body for maps."
  @spec reduce(any, {:cont, b} | {:halt, b} | {:suspend, b}, (any, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  fn reduce(map, acc, reducer), do: reduce(map, fz_map_count(map), acc, reducer)

  @doc "Enumerable.reduce_while/3 callback body for maps."
  @spec reduce_while(any, b, (any, b) -> {:cont, b} | {:halt, c}) :: b | c
  fn reduce_while(map, acc, reducer), do: reduce_while_cont(map, fz_map_count(map), 0, acc, reducer)

  @doc "Counts a map for Enumerable."
  @spec count(any) :: integer
  fn count(map), do: fz_map_count(map)

  @doc "Returns true when a key-value pair appears in the map for Enumerable."
  @spec member?(any, any) :: bool
  fn member?(map, {key, value}), do: member_pair?(map, fz_map_count(map), 0, key, value)
  fn member?(_map, _value), do: false

  @doc "Returns the slice contract for maps."
  @spec slice(any) :: {:ok, integer, any}
  fn slice(map) do
    {:ok, fz_map_count(map), (fn (_map) -> to_list(map) end)}
  end

  @spec reduce(any, integer, {:cont, b} | {:halt, b} | {:suspend, b}, (any, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  fnp reduce(map, count, {:cont, acc}, reducer), do: reduce_cont(map, count, 0, acc, reducer)
  fnp reduce(_map, _count, {:halt, acc}, _reducer), do: {:halted, acc}
  fnp reduce(map, count, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(map, count, 0, acc, reducer) end)}
  end

  @spec reduce_cont(any, integer, integer, b | c, (any, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  fnp reduce_cont(map, count, index, acc, reducer) do
    if index >= count do
      {:done, acc}
    else
      reduce_step(map, count, index, reducer.(entry(map, index), acc), reducer)
    end
  end

  @spec reduce_step(any, integer, integer, {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}, (any, b | c) -> {:cont, b | c} | {:halt, b | c} | {:suspend, b | c}) :: {:done, b | c} | {:halted, b | c} | {:suspended, b | c, () -> any}
  fnp reduce_step(map, count, index, {:cont, acc}, reducer), do: reduce_cont(map, count, index + 1, acc, reducer)
  fnp reduce_step(_map, _count, _index, {:halt, acc}, _reducer), do: {:halted, acc}
  fnp reduce_step(map, count, index, {:suspend, acc}, reducer) do
    {:suspended, acc, (fn () -> reduce_cont(map, count, index + 1, acc, reducer) end)}
  end

  @spec reduce_while_cont(any, integer, integer, b, (any, b) -> {:cont, b} | {:halt, c}) :: b | c
  fnp reduce_while_cont(map, count, index, acc, reducer) do
    if index >= count do
      acc
    else
      reduce_while_step(map, count, index, reducer.(entry(map, index), acc), reducer)
    end
  end

  @spec reduce_while_step(any, integer, integer, {:cont, b} | {:halt, c}, (any, b) -> {:cont, b} | {:halt, c}) :: b | c
  fnp reduce_while_step(map, count, index, {:cont, acc}, reducer), do: reduce_while_cont(map, count, index + 1, acc, reducer)
  fnp reduce_while_step(_map, _count, _index, {:halt, acc}, _reducer), do: acc

  fnp member_pair?(map, count, index, key, value) do
    if index >= count do
      false
    else
      if fz_map_entry_key(map, index) === key and fz_map_entry_value(map, index) === value do
        true
      else
        member_pair?(map, count, index + 1, key, value)
      end
    end
  end

  fnp entry(map, index) do
    {fz_map_entry_key(map, index), fz_map_entry_value(map, index)}
  end

  fnp to_list(map, count, index, acc) do
    if index >= count do
      reverse(acc, [])
    else
      to_list(map, count, index + 1, [entry(map, index) | acc])
    end
  end

  fnp reverse([], acc), do: acc
  fnp reverse([head | tail], acc), do: reverse(tail, [head | acc])
end
