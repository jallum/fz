defmodule Json do
  @moduledoc "Elixir's JSON surface: decode/1, decode!/1 and encode!/1 over fz values."

  # The goal program of the fz-5xp epic: a real program, written in fz, whose
  # behaviour is checked against an Elixir twin.
  #
  # Values map as Elixir's json libraries map them:
  #
  #   true / false / null   ->  true / false / nil
  #   number                ->  integer when it has no fraction, else float
  #   string                ->  binary
  #   array                 ->  list
  #   object                ->  map with BINARY keys
  #
  # Binary keys matter: fz orders them by content, exactly as Elixir does, so a
  # decoded object prints the same in both. Atom keys could not do that
  # (fz-5xp.50).

  # THE SURFACE IS ELIXIR'S, not a convenient approximation of it. Elixir's
  # `JSON` has no plain `encode/1` -- encoding cannot fail for the values it
  # accepts and can only raise for the ones it does not, so the only spelling
  # is `encode!/1`. Decoding can fail, so it has both `decode/1` and
  # `decode!/1`.
  #
  # The ERROR REASON is Elixir's too, and it is the part that would have been
  # easiest to get wrong: a positioned reason, not the leftover input.
  #
  #     {:unexpected_end, offset}
  #     {:invalid_byte, offset, byte}
  #     {:unexpected_sequence, offset, sequence}
  #
  # Internally a failure still carries the REST of the input, which is the
  # natural thing for a recursive-descent parser to have in hand. The offset is
  # recovered once, at the boundary, as `byte_size(input) - byte_size(rest)` --
  # so no position has to be threaded through the parser to report one.
  @doc "Decodes a JSON binary. {:ok, value} or {:error, reason}."
  @spec decode(binary) :: {:ok, any} | {:error, any}
  fn decode(input), do: decode_done(value(input), input)

  fnp decode_done({:ok, v, rest}, input), do: decode_trailing(rest, skip_ws(rest), v, input)
  fnp decode_done({:error, rest}, input), do: {:error, reason(rest, input)}

  # Trailing WHITESPACE is accepted, trailing anything else is not -- and the
  # error points at the whitespace rather than at the junk after it, because
  # Elixir reports the raw remainder's first byte. `"[1] "` is ok; `"[1] junk"`
  # is an invalid_byte at the SPACE.
  fnp decode_trailing(_raw, "", v, _input), do: {:ok, v}
  fnp decode_trailing(raw, _skipped, _v, input), do: {:error, reason(raw, input)}

  @doc "Decodes a JSON binary, or halts."
  @spec decode!(binary) :: any
  fn decode!(input), do: decode_result(decode(input))

  fnp decode_result({:ok, v}), do: v
  fnp decode_result({:error, _reason}), do: Kernel.panic("JSON.decode!: invalid JSON")

  # The rest at the failure point starts AT the offending byte -- the parser
  # skips whitespace before deciding -- so the offset is the difference in
  # lengths and the byte is the first one left.
  @spec reason(any, binary) :: any
  fnp reason({:sequence, at}, input), do: {:unexpected_sequence, offset(at, input), String.take_bytes(at, 6)}
  fnp reason("", input), do: {:unexpected_end, Kernel.byte_size(input)}
  fnp reason(rest, input), do: invalid_byte(rest, offset(rest, input))

  @spec offset(binary, binary) :: integer
  fnp offset(rest, input), do: Kernel.byte_size(input) - Kernel.byte_size(rest)

  @spec invalid_byte(binary, integer) :: any
  fnp invalid_byte(<<c, _r :: binary>>, at), do: {:invalid_byte, at, c}
  fnp invalid_byte(_rest, at), do: {:unexpected_end, at}

  @doc "Encodes an fz value as a JSON binary, or halts."
  @spec encode!(any) :: binary
  fn encode!(true), do: "true"
  fn encode!(false), do: "false"
  fn encode!(nil), do: "null"
  fn encode!(v :: integer), do: Integer.to_string(v)
  fn encode!(v :: float), do: Float.to_string(v)
  fn encode!(v :: binary), do: "\"" <> escape(v, "") <> "\""
  fn encode!(v :: [any]), do: "[" <> elements(v, "") <> "]"
  fn encode!(v :: map), do: "{" <> pairs(Map.to_list(v), "") <> "}"

  fnp escape("", acc), do: acc
  fnp escape(<<"\"", r :: binary>>, acc), do: escape(r, acc <> "\\\"")
  fnp escape(<<"\\", r :: binary>>, acc), do: escape(r, acc <> "\\\\")
  fnp escape(<<"\n", r :: binary>>, acc), do: escape(r, acc <> "\\n")
  fnp escape(<<"\t", r :: binary>>, acc), do: escape(r, acc <> "\\t")
  fnp escape(<<c, r :: binary>>, acc), do: escape(r, acc <> <<c>>)

  fnp elements([], acc), do: acc
  fnp elements([h], acc), do: acc <> encode!(h)
  fnp elements([h | t], acc), do: elements(t, acc <> encode!(h) <> ",")

  fnp pairs([], acc), do: acc
  fnp pairs([{k, v}], acc), do: acc <> encode!(k) <> ":" <> encode!(v)
  fnp pairs([{k, v} | t], acc), do: pairs(t, acc <> encode!(k) <> ":" <> encode!(v) <> ",")

  fnp skip_ws(<<" ", r :: binary>>), do: skip_ws(r)
  fnp skip_ws(<<"\n", r :: binary>>), do: skip_ws(r)
  fnp skip_ws(<<"\t", r :: binary>>), do: skip_ws(r)
  fnp skip_ws(<<"\r", r :: binary>>), do: skip_ws(r)
  fnp skip_ws(b), do: b

  fnp value(b), do: val(skip_ws(b))

  fnp val(<<"true", r :: binary>>), do: {:ok, true, r}
  fnp val(<<"false", r :: binary>>), do: {:ok, false, r}
  fnp val(<<"null", r :: binary>>), do: {:ok, nil, r}
  fnp val(<<"\"", r :: binary>>), do: string(r, "")
  fnp val(<<"[", r :: binary>>), do: array(skip_ws(r), [])
  fnp val(<<"{", r :: binary>>), do: object(skip_ws(r), %{})
  fnp val(<<"-", r :: binary>>), do: negate(number(r))
  fnp val(b = <<c, _ :: binary>>) when c >= 48 and c <= 57, do: number(b)
  # A token that STARTED as a keyword and did not finish as one is Elixir's
  # `unexpected_end` at the end of the input -- even `truX`, where there is a
  # perfectly good offending byte to point at. Once its decoder commits to
  # `t`/`f`/`n` it reads the keyword or runs out, and reports running out.
  # These clauses sit after the three that match, so only failures reach them,
  # and `{:error, ""}` is what makes `reason/2` say end-of-input.
  fnp val(<<116, _r :: binary>>), do: {:error, ""}
  fnp val(<<102, _r :: binary>>), do: {:error, ""}
  fnp val(<<110, _r :: binary>>), do: {:error, ""}
  fnp val(b), do: {:error, b}

  fnp negate({:ok, n, r}), do: {:ok, -n, r}
  fnp negate(other), do: other

  # An integer unless a fraction follows, which is how JSON distinguishes them
  # and how Elixir's decoders report them.
  fnp number(b), do: fraction(digits(b, 0))

  fnp digits(<<c, r :: binary>>, acc) when c >= 48 and c <= 57, do: digits(r, acc * 10 + (c - 48))
  fnp digits(b, acc), do: {acc, b}

  fnp fraction({whole, <<".", r :: binary>>}), do: fraction_digits(r, whole, 0, 1)
  fnp fraction({whole, b}), do: exponent(whole, b)

  fnp fraction_digits(<<c, r :: binary>>, whole, num, den) when c >= 48 and c <= 57 do
    fraction_digits(r, whole, num * 10 + (c - 48), den * 10)
  end
  fnp fraction_digits(b, whole, num, den), do: exponent(whole + num / den, b)

  # `1e3`, `1.5E-2`. JSON allows an exponent on an integer too, and the result is
  # a float either way -- `1e3` is `1.0e3`, not `1000`, which is what Elixir's
  # decoder reports.
  fnp exponent(n, <<"e", r :: binary>>), do: exponent_sign(n, r)
  fnp exponent(n, <<"E", r :: binary>>), do: exponent_sign(n, r)
  fnp exponent(n, b), do: {:ok, n, b}

  fnp exponent_sign(n, <<"-", r :: binary>>), do: exponent_digits(n, r, 0, -1)
  fnp exponent_sign(n, <<"+", r :: binary>>), do: exponent_digits(n, r, 0, 1)
  fnp exponent_sign(n, b), do: exponent_digits(n, b, 0, 1)

  fnp exponent_digits(n, <<c, r :: binary>>, acc, sign) when c >= 48 and c <= 57 do
    exponent_digits(n, r, acc * 10 + (c - 48), sign)
  end
  fnp exponent_digits(n, b, acc, sign), do: {:ok, scale(n * 1.0, acc, sign), b}

  # ONE multiply or divide by an exact power of ten, not `e` of them. Scaling
  # step by step accumulates rounding: seven divisions by 10.0 turned `1.0e-7`
  # into `1.0000000000000002e-7`, which is a different double and a different
  # rendering. Powers of ten up to 10^22 are exact in a float, so building the
  # power first and applying it once is correctly rounded over the range JSON
  # numbers actually use.
  fnp scale(n, 0, _sign), do: n
  fnp scale(n, e, sign), do: apply_scale(n, pow10(e, 1.0), sign)

  fnp apply_scale(n, p, sign) when sign > 0, do: n * p
  fnp apply_scale(n, p, _sign), do: n / p

  fnp pow10(0, acc), do: acc
  fnp pow10(e, acc), do: pow10(e - 1, acc * 10.0)

  # Byte at a time, because a SLICE would not help: every `<<c, r :: binary>>`
  # step copies the remainder, so the traversal is already quadratic and a
  # second pass to measure a run costs more than the appends save (measured:
  # 435 allocations either way). Once sub-binaries are cheap (fz-5xp.55),
  # scan-then-slice becomes the right shape and this should change with it.
  fnp string(<<"\"", r :: binary>>, acc), do: {:ok, acc, r}
  fnp string(b = <<"\\", r :: binary>>, acc), do: escaped(r, acc, b)
  fnp string(<<c, r :: binary>>, acc), do: string(r, acc <> <<c>>)
  fnp string(b, _acc), do: {:error, b}

  fnp escaped(<<"\"", r :: binary>>, acc, _at), do: string(r, acc <> "\"")
  fnp escaped(<<"\\", r :: binary>>, acc, _at), do: string(r, acc <> "\\")
  fnp escaped(<<"/", r :: binary>>, acc, _at), do: string(r, acc <> "/")
  fnp escaped(<<"n", r :: binary>>, acc, _at), do: string(r, acc <> "\n")
  fnp escaped(<<"t", r :: binary>>, acc, _at), do: string(r, acc <> "\t")
  fnp escaped(<<"r", r :: binary>>, acc, _at), do: string(r, acc <> "\r")
  fnp escaped(<<"b", r :: binary>>, acc, _at), do: string(r, acc <> <<8>>)
  fnp escaped(<<"f", r :: binary>>, acc, _at), do: string(r, acc <> <<12>>)
  fnp escaped(<<"u", a, b, c, d, r :: binary>>, acc, at), do: unicode(r, acc, hex4(a, b, c, d), at)
  fnp escaped(b, _acc, _at), do: {:error, b}

  # A bad `\uXXXX` is Elixir's `unexpected_sequence`, which reports the
  # BACKSLASH's offset and the six-byte sequence -- so this is the one failure
  # that has to carry where it started rather than where it stopped. An unknown
  # SIMPLE escape is an ordinary invalid_byte and needs none of this.
  fnp unicode(_r, _acc, :error, at), do: {:error, {:sequence, at}}
  fnp unicode(r, acc, cp, _at), do: string(r, acc <> utf8(cp))

  fnp hex4(a, b, c, d), do: hex4_join(hex(a), hex(b), hex(c), hex(d))
  fnp hex4_join(:error, _b, _c, _d), do: :error
  fnp hex4_join(_a, :error, _c, _d), do: :error
  fnp hex4_join(_a, _b, :error, _d), do: :error
  fnp hex4_join(_a, _b, _c, :error), do: :error
  fnp hex4_join(a, b, c, d), do: ((a * 16 + b) * 16 + c) * 16 + d

  fnp hex(c) when c >= 48 and c <= 57, do: c - 48
  fnp hex(c) when c >= 97 and c <= 102, do: c - 87
  fnp hex(c) when c >= 65 and c <= 70, do: c - 55
  fnp hex(_c), do: :error

  # UTF-8 for the basic multilingual plane. Surrogate pairs are not joined --
  # a lone surrogate encodes as itself, which is what a decoder without pair
  # handling does, and is the one place this is not yet Elixir.
  fnp utf8(cp) when cp < 128, do: <<cp>>
  fnp utf8(cp) when cp < 2048 do
    <<192 + div(cp, 64), 128 + rem(cp, 64)>>
  end
  fnp utf8(cp) do
    <<224 + div(cp, 4096), 128 + rem(div(cp, 64), 64), 128 + rem(cp, 64)>>
  end

  # `]` closes an EMPTY array only at the start. After a comma a value is
  # required, so `[1,]` is an error -- accepting it was the one place this
  # decoder was more permissive than the grammar and than Elixir.
  fnp array(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  fnp array(b, acc), do: array_element(b, acc)

  fnp array_element(b, acc), do: array_item(value(b), acc)

  fnp array_item({:ok, v, r}, acc), do: array_next(skip_ws(r), [v | acc])
  fnp array_item(other, _acc), do: other

  fnp array_next(<<",", r :: binary>>, acc), do: array_element(skip_ws(r), acc)
  fnp array_next(<<"]", r :: binary>>, acc), do: {:ok, reverse(acc, []), r}
  fnp array_next(b, _acc), do: {:error, b}

  # `}` closes an EMPTY object only at the start; after a comma a key is
  # required, so `{"a": 1,}` is an error.
  fnp object(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  fnp object(b, acc), do: object_entry(b, acc)

  fnp object_entry(<<"\"", r :: binary>>, acc), do: object_key(string(r, ""), acc)
  fnp object_entry(b, _acc), do: {:error, b}

  fnp object_key({:ok, k, r}, acc), do: object_colon(skip_ws(r), k, acc)
  fnp object_key(other, _acc), do: other

  fnp object_colon(<<":", r :: binary>>, k, acc), do: object_value(value(r), k, acc)
  fnp object_colon(b, _k, _acc), do: {:error, b}

  fnp object_value({:ok, v, r}, k, acc), do: object_next(skip_ws(r), Map.put(acc, k, v))
  fnp object_value(other, _k, _acc), do: other

  fnp object_next(<<",", r :: binary>>, acc), do: object_entry(skip_ws(r), acc)
  fnp object_next(<<"}", r :: binary>>, acc), do: {:ok, acc, r}
  fnp object_next(b, _acc), do: {:error, b}

  fnp reverse([], acc), do: acc
  fnp reverse([h | t], acc), do: reverse(t, [h | acc])
end
